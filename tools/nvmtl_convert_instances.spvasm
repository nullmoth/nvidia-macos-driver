%is_t1 = OpIEqual %bool %mtype %c1
%is_t3 = OpIEqual %bool %mtype %c3
%i16_real = OpIAdd %u32 %sb %c16
%i17_real = OpIAdd %u32 %sb %c17
%i_w4 = OpSelect %u32 %is_t1 %i16_real %i_w3
