#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// Zeroes the leading words of every per-slot indirect argument record whose slot lies outside the execution range
// {location, length} that the GPU wrote. A draw or dispatch with a zero count is then a no-op.
layout(buffer_reference, std430) buffer Words { uint v[]; };
layout(push_constant) uniform Args { Words records; Words range; uint count; uint stride; uint zero; } a;
layout(local_size_x = 64) in;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= a.count) return;
    uint location = a.range.v[0], length = a.range.v[1];
    if (i >= location && i - location < length) return;
    for (uint w = 0u; w < a.zero; w++) a.records.v[i * a.stride + w] = 0u;
}
