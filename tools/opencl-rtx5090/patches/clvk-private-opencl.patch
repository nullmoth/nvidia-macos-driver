+    cl_int finish(cl_int result) {
+        status = result;
+        return result;
+    }
+    unsigned long long duration(unsigned stage) const {
+        return times[stage] && times[stage - 1]
+                   ? times[stage] - times[stage - 1] : 0;
+    }
+    ~staging_read_trace() {
+        if (sink.file == nullptr) {
+            return;
+        }
+        const auto end = staging_trace_clock(CLOCK_MONOTONIC);
+        const bool host_write = std::strcmp(operation, "host_write") == 0;
+        const bool staged_write = std::strcmp(operation, "staged_write") == 0;
+        std::lock_guard<std::mutex> guard(sink.lock);
+        const int written = fprintf(sink.file,
+                "%llu,%s,%llu,%llu,%llu,%llu,%p,%p,%p,%s,%u,%zu,%zu,%zu,%zu,"
+                "%llu,%llu,%llu,%llu,%llu,%llu,%llu,%d,%u\n",
+                ++sink.sequence, operation, times[0], epoch, anchor_span, end,
+                static_cast<void*>(queue), static_cast<void*>(buffer),
+                static_cast<const void*>(backing),
+                buffer->parent() ? "subbuffer" : "root", command_type,
+                buffer->size(), backing->size(), buffer_offset, bytes,
+                static_cast<unsigned long long>(backing->flags()),
+                duration(1), duration(staged_write ? 3 : 2),
+                duration(staged_write ? 4 : 3), duration(staged_write ? 2 : 4),
+                host_write ? 0ull : end - times[last_stage],
+                end - times[0], status, last_stage);
