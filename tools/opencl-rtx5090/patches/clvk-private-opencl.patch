+cvk_event::cvk_event(cvk_context* ctx, cvk_command_queue* queue)
+    : api_object(ctx), m_command_type(0), m_queue(queue),
+      m_queue_profiling_enabled(queue != nullptr &&
+                               queue->has_property(CL_QUEUE_PROFILING_ENABLE)) {}
+
+refcounted_holder<cvk_command_queue> cvk_event_command::queue_for_wait() {
+    std::lock_guard<std::mutex> lock(m_lock);
+    // Completion takes this same lock before the command can release its queue.
+    if (m_status <= CL_COMPLETE) {
+        return {};
+    }
+    return m_queue;
+}
+
+refcounted_holder<cvk_command_queue> cvk_event_combine::queue_for_wait() {
+    return m_end_event->queue_for_wait();
+}
+
+void cvk_event_command::log_profiling_mapping() const {
+    if (m_diagnostic_device_end == 0) {
+        return;
+    }
+    const int written = fprintf(stderr,
+        "CLVK_PROFILING_MAP {\"event\":\"%p\",\"queue\":\"%p\","
+        "\"command_type\":%u,\"device_start_ns\":%llu,\"device_end_ns\":%llu,"
+        "\"host_start_ns\":%llu,\"host_end_ns\":%llu,"
+        "\"start_max_deviation_ns\":%llu,\"end_max_deviation_ns\":%llu}\n",
+        static_cast<const void*>(this), static_cast<void*>(queue()),
+        command_type(), static_cast<unsigned long long>(m_diagnostic_device_start),
+        static_cast<unsigned long long>(m_diagnostic_device_end),
+        static_cast<unsigned long long>(get_profiling_info(CL_PROFILING_COMMAND_START)),
+        static_cast<unsigned long long>(get_profiling_info(CL_PROFILING_COMMAND_END)),
+        static_cast<unsigned long long>(m_diagnostic_start_deviation),
+        static_cast<unsigned long long>(m_diagnostic_end_deviation));
+    if (written < 0) {
+        cvk_error("CLVK_PROFILING_MAP_ERROR cannot write record");
+    }
+}
 
