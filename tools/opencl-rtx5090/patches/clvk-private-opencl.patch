+bool cvk_program::pipeline_stats_hashes(std::string& original,
+                                        std::string& shader) const {
+    auto hash = [](const std::vector<uint32_t>& words, std::string& out) {
+        // cvk_sha1 encodes the message bit length in a 32-bit word.
+        if (words.size() > UINT32_MAX / (sizeof(uint32_t) * 8)) {
+            return false;
+        }
+        auto digest = cvk_sha1(words.data(),
+                               static_cast<uint32_t>(words.size() * sizeof(uint32_t)));
+        out = to_hex_string(reinterpret_cast<const uint8_t*>(digest.data()),
+                            SHA1_DIGEST_NUM_BYTES);
+        return true;
+    };
+    return hash(m_binary->code(), original) &&
+           hash(m_stripped_binary.empty() ? m_binary->code() : m_stripped_binary,
+                shader);
+}
+
+static std::string pipeline_stats_json_string(const std::string& input) {
+    static const char hex[] = "0123456789abcdef";
+    std::string out = "\"";
+    for (unsigned char c : input) {
+        if (c == '\"' || c == '\\') {
+            out += '\\';
+            out += static_cast<char>(c);
+        } else if (c < 0x20) {
+            out += "\\u00";
+            out += hex[c >> 4];
+            out += hex[c & 15];
+        } else {
+            out += static_cast<char>(c);
+        }
+    }
+    return out + '\"';
+}
