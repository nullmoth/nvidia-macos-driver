+// Optional process-local diagnostic. CSV I/O is outside the measured spans.
+struct staging_trace_sink {
+    FILE* file = nullptr;
+    std::mutex lock;
+    unsigned long long sequence = 0;
+
+    staging_trace_sink() {
+        const char* path = std::getenv("CLVK_STAGING_TRACE_FILE");
+        if (path == nullptr || *path == '\0') {
+            return;
+        }
+        int fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW,
+                      0600);
+        if (fd < 0 || (file = fdopen(fd, "w")) == nullptr) {
+            if (fd >= 0) {
+                close(fd);
+            }
+            cvk_error("Cannot create CLVK_STAGING_TRACE_FILE");
+            return;
+        }
+        const int header = fputs("seq,operation,mono_start_ns,epoch_start_ns,anchor_span_ns,mono_end_ns,"
+              "queue,buffer,root_buffer,root_kind,command_type,logical_bytes,"
+              "root_bytes,buffer_offset,bytes,root_cl_flags,allocation_ns,"
+              "construction_ns,submit_wait_ns,map_memcpy_ns,destruction_ns,"
+              "total_ns,status,last_completed_stage\n", file);
+        if (header < 0 || fflush(file) != 0) {
+            cvk_error("CLVK_STAGING_TRACE_ERROR cannot write header");
+            fclose(file);
+            file = nullptr;
+        }
+    }
+};
+
+static staging_trace_sink& staging_trace_output() {
+    // Executor threads drain during global-state atexit cleanup. Keep the sink
+    // alive through that cleanup; every row is flushed and the OS closes its FD.
+    static auto* sink = new staging_trace_sink;
+    return *sink;
+}
+
+static unsigned long long staging_trace_clock(clockid_t clock) {
+    struct timespec now{};
+    if (clock_gettime(clock, &now) != 0) {
+        return 0;
+    }
+    return static_cast<unsigned long long>(now.tv_sec) * 1000000000ull +
+           static_cast<unsigned long long>(now.tv_nsec);
+}
+
+struct staging_read_trace {
+    staging_trace_sink& sink;
+    unsigned long long times[5]{};
+    unsigned long long epoch = 0, anchor_span = 0;
+    unsigned last_stage = 0;
+    cl_int status = CL_COMPLETE;
+    cvk_command_queue* queue;
+    cvk_buffer* buffer;
+    const cvk_mem* backing;
+    cl_command_type command_type;
+    size_t buffer_offset, bytes;
+    const char* operation;
+
+    staging_read_trace(cvk_command_queue* q, cvk_buffer* b,
+                       const cvk_mem* root, cl_command_type type,
+                       size_t offset, size_t size,
+                       const char* op = "staged_read")
+        : sink(staging_trace_output()), queue(q), buffer(b), backing(root),
+          command_type(type), buffer_offset(offset), bytes(size), operation(op) {
+        if (sink.file != nullptr) {
+            times[0] = staging_trace_clock(CLOCK_MONOTONIC);
+            epoch = staging_trace_clock(CLOCK_REALTIME);
+            anchor_span = staging_trace_clock(CLOCK_MONOTONIC) - times[0];
+        }
+    }
+    void mark(unsigned stage) {
+        if (sink.file != nullptr) {
+            times[stage] = staging_trace_clock(CLOCK_MONOTONIC);
+            last_stage = stage;
+        }
+    }
+    void mark_host_copy() {
+        if (sink.file != nullptr) {
+            times[1] = times[2] = times[3] = times[0];
