+   nir_def *count = nir_ubitfield_extract_imm(b, flags, NVK_CURVE_COUNT_SHIFT, 3);
+   nir_def *is_flat = nir_ine_imm(b, nir_ubitfield_extract_imm(b, flags, NVK_CURVE_FLAT_SHIFT, 1), 0);
+   nir_def *caps = nir_ubitfield_extract_imm(b, flags, NVK_CURVE_CAPS_SHIFT, 2);
+   nir_def *cp_half = nir_ine_imm(b, nir_ubitfield_extract_imm(b, flags, NVK_CURVE_CPFMT_SHIFT, 1), 0);
+   nir_def *rad_half = nir_ine_imm(b, nir_ubitfield_extract_imm(b, flags, NVK_CURVE_RADFMT_SHIFT, 1), 0);
+   nir_def *idx32 = nir_ine_imm(b, nir_ubitfield_extract_imm(b, flags, NVK_CURVE_IDXTYPE_SHIFT, 1), 0);
