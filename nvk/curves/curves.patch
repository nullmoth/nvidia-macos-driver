+/* NVK_CURVES switches Metal-style curve geometry on (docs/CURVES.md): a box geometry that carries a VkNvkCurveGeometryMESA in
+ * its pNext chain is built as curves. Off, the chain is ignored and the geometry is the plain box geometry it also is. */
+static bool
+nvk_curves_enabled(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = getenv("NVK_CURVES");
+      on = e && e[0] != '\0' && e[0] != '0';
+   }
+   return on;
+}
+
+static const VkAccelerationStructureGeometryKHR *
+nvk_geom_at(const VkAccelerationStructureBuildGeometryInfoKHR *bi, uint32_t i)
+{
+   return bi->pGeometries ? &bi->pGeometries[i] : bi->ppGeometries[i];
+}
+
+static const VkNvkCurveGeometryMESA *
+nvk_curve_of(const VkAccelerationStructureGeometryKHR *g)
+{
+   if (g->geometryType != VK_GEOMETRY_TYPE_AABBS_KHR)
+      return NULL;
+   for (const VkBaseInStructure *s = g->geometry.aabbs.pNext; s; s = s->pNext)
+      if (s->sType == VK_STRUCTURE_TYPE_NVK_CURVE_GEOMETRY_MESA)
+         return (const VkNvkCurveGeometryMESA *)s;
+   return NULL;
+}
+
+static bool
+nvk_build_has_curves(const VkAccelerationStructureBuildGeometryInfoKHR *bi)
+{
+   if (!nvk_curves_enabled() || bi->type != VK_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL_KHR)
+      return false;
+   for (uint32_t i = 0; i < bi->geometryCount; i++)
+      if (nvk_curve_of(nvk_geom_at(bi, i)))
+         return true;
+   return false;
+}
+
+/* The whole structure: software BVH, then (when either switch is on) the appendix with the hardware part and the curve table. */
+struct nvk_as_layout {
+   bool hw, curve;
+   struct nvk_hwrt_place place;     /* hw_size is 0 without the hardware part */
+   uint32_t curve_table;            /* from the appendix */
+   uint64_t total;
+};
+
+static struct nvk_as_layout
+nvk_as_layout(const VkAccelerationStructureBuildGeometryInfoKHR *bi, VkGeometryTypeKHR type, uint32_t leaf_node_count)
+{
+   struct nvk_as_layout l = { .hw = nvk_hwrt_build_enabled(), .curve = nvk_build_has_curves(bi) };
+   if (!l.hw && !l.curve) {
+      l.total = nvk_get_as_size_internal(type, leaf_node_count);
+      return l;
+   }
+   l.place = nvk_hwrt_place(type, leaf_node_count, bi->geometryCount);
+   if (!l.hw) {
+      l.place.hw_size = 0;
+      l.place.geometry_table_offset = NVK_HWRT_STRUCT_OFFSET;
+   }
+   l.curve_table = (uint32_t)align64(l.place.geometry_table_offset + (uint64_t)l.place.geometry_count * sizeof(struct nvk_hwrt_geometry), 16);
+   l.total = (uint64_t)l.place.hw_offset + l.curve_table + (l.curve ? (uint64_t)bi->geometryCount * sizeof(struct nvk_curve_entry) : 0);
+   return l;
+}
