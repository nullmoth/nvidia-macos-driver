+      nir_def *y = curve_load_f(b, nir_iadd(b, a, nir_u2u64(b, es)), cp_half);
+      nir_def *z = curve_load_f(b, nir_iadd(b, a, nir_u2u64(b, nir_imul_imm(b, es, 2))), cp_half);
+      c.p[i] = v3_((V)x, (V)y, (V)z);
