+/* ---- curve geometry --------------------------------------------------------------------------------------------- */
+
+struct nvk_curve_aabb_args {
+   uint64_t control_points, radii, indices, out_boxes;
+   uint32_t control_point_stride, radius_stride, flags, segment_count;
+};
+
+/* Before the build: one box per segment of every curve geometry, written into the tail of the scratch buffer. Returns a copy of
+ * the build info whose curve geometries point at those boxes (the box stride is the 24 bytes the shader wrote); the geometries are
+ * copied into *geoms, freed by the caller. */
+static bool
+nvk_curve_prepare(struct nvk_cmd_buffer *cmd, struct nvk_device *dev, const VkAccelerationStructureBuildGeometryInfoKHR *bi,
+                  const VkAccelerationStructureBuildRangeInfoKHR *ranges, VkAccelerationStructureBuildGeometryInfoKHR *out,
+                  VkAccelerationStructureGeometryKHR **geoms)
+{
+   VkCommandBuffer commandBuffer = nvk_cmd_buffer_to_handle(cmd);
+   uint32_t counts[bi->geometryCount ? bi->geometryCount : 1];
+   for (uint32_t i = 0; i < bi->geometryCount; i++)
+      counts[i] = ranges[i].primitiveCount;
+   VkAccelerationStructureBuildSizesInfoKHR sz = { .sType = VK_STRUCTURE_TYPE_ACCELERATION_STRUCTURE_BUILD_SIZES_INFO_KHR };
+   vk_get_as_build_sizes(nvk_device_to_handle(dev), VK_ACCELERATION_STRUCTURE_BUILD_TYPE_DEVICE_KHR, bi, counts, &sz, &dev->accel.args);
+
+   *geoms = malloc(sizeof(VkAccelerationStructureGeometryKHR) * bi->geometryCount);
+   if (!*geoms) {
+      vk_command_buffer_set_error(&cmd->vk, VK_ERROR_OUT_OF_HOST_MEMORY);
+      return false;
+   }
+   *out = *bi;
+   out->pGeometries = *geoms;
+   out->ppGeometries = NULL;
+   VkDeviceAddress boxes = bi->scratchData.deviceAddress + align64(sz.buildScratchSize, 128);
+
+   VkPipeline pipeline = VK_NULL_HANDLE;
+   VkPipelineLayout layout = VK_NULL_HANDLE;
+   bool bound = false;
+   for (uint32_t i = 0; i < bi->geometryCount; i++) {
+      (*geoms)[i] = *nvk_geom_at(bi, i);
+      const VkNvkCurveGeometryMESA *c = nvk_curve_of(&(*geoms)[i]);
+      if (!c)
+         continue;
+      if (!bound) {
+         VkResult r = vk_get_bvh_build_pipeline_spv(&dev->vk, &dev->meta, (enum vk_meta_object_key_type)NVK_META_OBJECT_KEY_CURVE_AABB,
+                                                    nvk_curve_aabb_spv, sizeof(nvk_curve_aabb_spv), sizeof(struct nvk_curve_aabb_args),
+                                                    &dev->accel.args, 0, &pipeline, false);
+         if (r == VK_SUCCESS)
+            r = vk_get_bvh_build_pipeline_layout(&dev->vk, &dev->meta, sizeof(struct nvk_curve_aabb_args), &layout);
+         if (r != VK_SUCCESS) {
+            vk_command_buffer_set_error(&cmd->vk, r);
+            return false;
+         }
+         dev->vk.dispatch_table.CmdBindPipeline(commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+         bound = true;
+      }
+      const struct nvk_curve_aabb_args args = {
+         .control_points = c->controlPoints, .radii = c->radii, .indices = c->indices, .out_boxes = boxes,
+         .control_point_stride = c->controlPointStride, .radius_stride = c->radiusStride, .flags = c->flags,
+         .segment_count = counts[i],
+      };
+      dev->vk.dispatch_table.CmdPushConstants(commandBuffer, layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(args), &args);
+      dev->vk.dispatch_table.CmdDispatchBase(commandBuffer, 0, 0, 0, DIV_ROUND_UP(MAX2(counts[i], 1), 64), 1, 1);
+      (*geoms)[i].geometry.aabbs.pNext = NULL;
+      (*geoms)[i].geometry.aabbs.data.deviceAddress = boxes;
+      (*geoms)[i].geometry.aabbs.stride = NVK_CURVE_BOX_BYTES;
+      boxes += align64((uint64_t)counts[i] * NVK_CURVE_BOX_BYTES, 128);
+   }
+   if (bound)
+      vk_bvh_build_barrier_compute_to_compute(commandBuffer, true);
+   return true;
+}
+
+/* After the build: the appendix words and the curve table the lowering reads. They are written by the copy engine, so the
+ * compute passes that wrote the header (hw_offset = 0) must be finished first. */
+static void
+nvk_curve_finalize(struct nvk_cmd_buffer *cmd, struct nvk_device *dev, const VkAccelerationStructureBuildGeometryInfoKHR *bi,
+                   const VkAccelerationStructureBuildRangeInfoKHR *ranges)
+{
+   VkCommandBuffer commandBuffer = nvk_cmd_buffer_to_handle(cmd);
+   uint32_t leaves = 0;
+   for (uint32_t i = 0; i < bi->geometryCount; i++)
+      leaves += ranges[i].primitiveCount;
+   const struct nvk_as_layout l = nvk_as_layout(bi, VK_GEOMETRY_TYPE_AABBS_KHR, leaves);
+   VK_FROM_HANDLE(vk_acceleration_structure, dst, bi->dstAccelerationStructure);
+   const uint64_t va = vk_acceleration_structure_get_va(dst);
+   const uint64_t app = va + l.place.hw_offset;
+
+   VkMemoryBarrier2 mb = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2,
+      .srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
+      .srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT,
+      .dstStageMask = VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT,
+      .dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT,
+   };
+   VkDependencyInfo di = { .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO, .memoryBarrierCount = 1, .pMemoryBarriers = &mb };
+   dev->vk.dispatch_table.CmdPipelineBarrier2(commandBuffer, &di);
+
+   if (!l.hw) {
+      /* no hardware part: the appendix is ours alone, generation 0 so the lowering never takes the hardware path */
+      struct nvk_hwrt_appendix a = {
+         .magic = NVK_HWRT_APPENDIX_MAGIC, .generation = 0, .structure_size = 0, .geometry_table_offset = 0, .geometry_count = 0,
+         .has_procedural = 1, .curve_table_offset = l.curve_table, .curve_geometry_count = bi->geometryCount,
+      };
+      nvk_cmd_write_buffer_cp(commandBuffer, app, &a, sizeof a);
+      uint32_t off = l.place.hw_offset;
+      nvk_cmd_write_buffer_cp(commandBuffer, va + offsetof(struct nvk_bvh_header, hw_offset), &off, sizeof off);
+   } else {
+      uint32_t w[2] = { l.curve_table, bi->geometryCount };
+      nvk_cmd_write_buffer_cp(commandBuffer, app + offsetof(struct nvk_hwrt_appendix, curve_table_offset), w, sizeof w);
+   }
+
+   struct nvk_curve_entry *table = calloc(bi->geometryCount ? bi->geometryCount : 1, sizeof *table);
+   if (!table) {
+      vk_command_buffer_set_error(&cmd->vk, VK_ERROR_OUT_OF_HOST_MEMORY);
+      return;
+   }
+   for (uint32_t i = 0; i < bi->geometryCount; i++) {
+      const VkNvkCurveGeometryMESA *c = nvk_curve_of(nvk_geom_at(bi, i));
+      if (!c)
+         continue;
+      table[i] = (struct nvk_curve_entry){
+         .control_points = c->controlPoints, .radii = c->radii, .indices = c->indices,
+         .control_point_stride = c->controlPointStride, .radius_stride = c->radiusStride, .flags = c->flags,
+         .magic = NVK_CURVE_ENTRY_MAGIC, .segment_count = ranges[i].primitiveCount,
+      };
+   }
+   nvk_cmd_write_buffer_cp(commandBuffer, app + l.curve_table, table, bi->geometryCount * sizeof *table);
+   free(table);
+}
