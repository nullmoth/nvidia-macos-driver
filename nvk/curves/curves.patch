+            nvk_curve_finalize(cmd, dev, &pInfos[i], ppBuildRangeInfos[i]);
+   }
+   for (uint32_t i = 0; i < infoCount; i++)
+      free(owned[i]);
+   free(owned);
+   free(infos);
    nvk_accel_restore(cmd, &saved);
 }
 
