+      nir_def *a = nir_iadd(b, idx, nir_u2u64(b, nir_imul_imm(b, intersection->primitive_id, 4)));
+      nir_store_var(b, first_v, nir_build_load_global(b, 1, 32, a, .align_mul = 4), 0x1);
+   }
+   nir_push_else(b, NULL);
+   {
+      nir_def *a = nir_iadd(b, idx, nir_u2u64(b, nir_imul_imm(b, intersection->primitive_id, 2)));
+      nir_store_var(b, first_v, nir_u2u32(b, nir_build_load_global(b, 1, 16, a, .align_mul = 2)), 0x1);
+   }
+   nir_pop_if(b, NULL);
+   nir_def *first = nir_load_var(b, first_v);
