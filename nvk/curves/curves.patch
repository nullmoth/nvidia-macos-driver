+   struct cv_ops ops = cv_nir_ops(b);
+   struct cv_curve c;
+   nir_def *es = nir_bcsel(b, cp_half, nir_imm_int(b, 2), nir_imm_int(b, 4));
+   for (unsigned i = 0; i < 4; i++) {
