+// ═══ HUB CONNECTIONS - many mappings on one connection ═══════════════════════════════════════════════════════════════
+// The kext keeps one pending mapping context per connection, so the old contract (above and below) is one connection
+// per live mapping: Cyberpunk held ~275, every one an IOKit user client opened and closed across the accelerator's
+// arbitration lock. A kext that answers selector 7 with bit0 consumes the context when a mapping is made with a token
+// memory type (bit 31 set, unique per mapping on that connection) and keeps the descriptor under the token, so:
+//   - RM_MAP_MEMORY on a hub fd is accepted again right after its mapping is made;
+//   - the unmap, which IOKit resolves by asking clientMemoryForType for the same type and finding the mapping on the
+//     descriptor it gets back, finds it - type 0 on a reused connection would get a fresh descriptor, find nothing,
+//     and leave the mapping (and its VRAM) until the connection closed;
+//   - selector 8 then forgets the token.
+// A hub is NVRM_XNU_HUBS connections per node type (default 4), each serialised across RM_MAP_MEMORY + map by its own
+// mutex (between the two the context is the only thing naming what to map). Hubs are never closed or pooled.
+// Old kext (selector 7 refused) or NVRM_ONE_CONN_PER_MAP=1: every map takes the old path, code path for code path.
+#define NVRM_XNU_HUBS_MAX 16
+#define NVRM_XNU_HUB_LIVE_MAX 3840   // per hub; the kext keeps at most 4096 tokens per client
+// retired: the kext refused a token map on this hub (its token table full, or the context moved), so its context may still
+// be pending. It keeps serving the unmaps of its live mappings but takes no new map; re-binding it to clear the context is
+// not done, because a re-bind would also drop what those mappings depend on.
+static struct nvrm_hub { int fd; io_connect_t conn; pthread_mutex_t mu; uint32_t next; int live; int retired; } gHub[2][NVRM_XNU_HUBS_MAX];
+// Hubs per type; 0 = old path, -1 = not decided yet. Published with a release store only after every gHub entry is set
+// up, and read with an acquire load: a thread making its first map while another is still in hub_setup used to see the
+// count before the entries existed, lock a zeroed mutex (EINVAL on macOS, so no lock at all) and map through fd 0.
+static int gHubN = -1;
+static pthread_mutex_t gHubInit = PTHREAD_MUTEX_INITIALIZER;
+static unsigned gHubRR;
+static uint64_t gHubMaps, gHubFallbacks;
+static void hub_setup(const char *node)
+{
+    pthread_mutex_lock(&gHubInit);
+    if (gHubN < 0) {
+        const char *off = nvmtl_cfg_getenv("NVRM_ONE_CONN_PER_MAP");
+        const char *hn = nvmtl_cfg_getenv("NVRM_XNU_HUBS");
+        long n = hn && *hn ? strtol(hn, NULL, 10) : 4;
+        if (n < 0) n = 0;
+        if (n > NVRM_XNU_HUBS_MAX) n = NVRM_XNU_HUBS_MAX;
+        uint64_t caps = 0; int asked = 0;
+        if (!(off && off[0] == '1') && n > 0) {
+            int fd = nvrm_xnu_open(node);
+            io_connect_t c = fd >= 0 ? gConn[fd] : 0;
+            uint32_t one = 1;
+            asked = c && IOConnectCallScalarMethod(c, SEL_CAPS, NULL, 0, &caps, &one) == KERN_SUCCESS;
+            if (fd >= 0) nvrm_xnu_close(fd);
+        }
+        const int hubs = (asked && (caps & 1)) ? (int)n : 0;
+        for (int t = 0; t < 2; t++) for (int i = 0; i < NVRM_XNU_HUBS_MAX; i++) {
+            gHub[t][i].fd = -1; pthread_mutex_init(&gHub[t][i].mu, NULL); gHub[t][i].next = 1;
+        }
+        fprintf(stderr, "nvrm_xnu: %s (NVRM_ONE_CONN_PER_MAP=%s, kext token maps %s)\n",
+                hubs ? "CPU mappings share hub connections" : "one connection per CPU mapping",
+                off ? off : "unset", asked ? ((caps & 1) ? "yes" : "no") : "not asked or refused");
+        __atomic_store_n(&gHubN, hubs, __ATOMIC_RELEASE);
+    }
+    pthread_mutex_unlock(&gHubInit);
+}
+// A hub fd for this node with its mutex held, or -1 (take the old path). The hub's connection is opened on first use.
+int nvrm_xnu_hub_begin(const char *node)
+{
+    int hubs = __atomic_load_n(&gHubN, __ATOMIC_ACQUIRE);
+    if (hubs < 0) { hub_setup(node); hubs = __atomic_load_n(&gHubN, __ATOMIC_ACQUIRE); }
+    if (hubs == 0) return -1;
+    const int type = (node && strstr(node, "ctl")) ? 0 : 1;
+    const unsigned start = __atomic_fetch_add(&gHubRR, 1, __ATOMIC_RELAXED);
+    struct nvrm_hub *h = NULL;
+    for (int k = 0; k < hubs && !h; k++) {   // an idle hub first
+        struct nvrm_hub *x = &gHub[type][(start + (unsigned)k) % (unsigned)hubs];
+        if (__atomic_load_n(&x->retired, __ATOMIC_ACQUIRE)) continue;
+        if (pthread_mutex_trylock(&x->mu) == 0) h = x;
+    }
+    for (int k = 0; k < hubs && !h; k++) {   // all busy: wait for the first one that is not retired
+        struct nvrm_hub *x = &gHub[type][(start + (unsigned)k) % (unsigned)hubs];
+        if (!__atomic_load_n(&x->retired, __ATOMIC_ACQUIRE)) { pthread_mutex_lock(&x->mu); h = x; }
+    }
+    if (!h) { __atomic_add_fetch(&gHubFallbacks, 1, __ATOMIC_RELAXED); return -1; }   // every hub retired: old path
+    if (__atomic_load_n(&h->retired, __ATOMIC_ACQUIRE)) {   // retired while this thread waited for it
+        pthread_mutex_unlock(&h->mu); __atomic_add_fetch(&gHubFallbacks, 1, __ATOMIC_RELAXED); return -1;
+    }
+    if (__atomic_load_n(&h->live, __ATOMIC_RELAXED) >= NVRM_XNU_HUB_LIVE_MAX) { pthread_mutex_unlock(&h->mu); __atomic_add_fetch(&gHubFallbacks, 1, __ATOMIC_RELAXED); return -1; }
+    if (h->fd < 0) {
+        int fd = nvrm_xnu_open(node);
+        if (fd < 0) { pthread_mutex_unlock(&h->mu); return -1; }
+        h->fd = fd; h->conn = gConn[fd];
+    }
