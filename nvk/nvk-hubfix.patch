+// Map the context RM just put on this hub (caller holds the hub from nvrm_xnu_hub_begin). On MAP_FAILED, *fallback = 1
+// means the kext kept the context (no room for the token, or the context moved): the hub is retired and the caller
+// makes this mapping on a connection of its own instead. *fallback = 0 is an ordinary failure.
+void *nvrm_xnu_hub_mmap(int fd, size_t length, int writeCombine, int *fallback)
+{
+    *fallback = 0;
+    struct nvrm_hub *h = hub_of_fd(fd);
+    if (!h) { errno = EBADF; return MAP_FAILED; }
+    uint32_t token = 0x80000000u | (h->next++ & 0x7FFFFFFFu);
+    if (token == 0x80000000u) token = 0x80000000u | (h->next++ & 0x7FFFFFFFu);
+    mach_vm_address_t addr = 0; mach_vm_size_t len = 0;
+    kern_return_t kr = IOConnectMapMemory64(h->conn, token, mach_task_self(), &addr, &len,
+                                            kIOMapAnywhere | (writeCombine ? kIOMapWriteCombineCache : 0));
+    if (kr != KERN_SUCCESS) {
+        fprintf(stderr, "nvrm_xnu: IOConnectMapMemory64 (hub token 0x%08x) -> 0x%08x\n", token, kr);
+        // The kext may have kept the token before the mapping itself failed (the descriptor is registered first, then
+        // IOKit maps it): forget it, or the token and its descriptor stay until the process exits and fill the table.
+        // An unknown token is not an error.
+        uint64_t in = token; IOConnectCallScalarMethod(h->conn, SEL_FORGET_TOKEN, &in, 1, NULL, NULL);
+        if (kr == kIOReturnNoResources || kr == kIOReturnBusy) {
+            __atomic_store_n(&h->retired, 1, __ATOMIC_RELEASE);
+            __atomic_add_fetch(&gHubFallbacks, 1, __ATOMIC_RELAXED);
+            fprintf(stderr, "nvrm_xnu: hub fd %d retired (%s); this mapping takes its own connection\n", fd,
+                    kr == kIOReturnNoResources ? "kext token table full" : "mapping context moved");
+            *fallback = 1;
+        }
+        errno = EIO; return MAP_FAILED;
+    }
+    pthread_mutex_lock(&gLock);
+    int stored = 0;
+    for (int i = 0; i < NVRM_XNU_MAX_MAP; i++) if (!gMaps[i].addr) { gMaps[i].addr = (void *)(uintptr_t)addr; gMaps[i].len = (size_t)len; gMaps[i].conn = h->conn; gMaps[i].token = token; stored = 1; break; }
+    pthread_mutex_unlock(&gLock);
+    if (!stored) {
+        // untracked: it could never be unmapped. Undo it now rather than leak it.
+        IOConnectUnmapMemory64(h->conn, token, mach_task_self(), addr);
+        uint64_t in = token; IOConnectCallScalarMethod(h->conn, SEL_FORGET_TOKEN, &in, 1, NULL, NULL);
+        errno = ENOMEM; return MAP_FAILED;
+    }
+    __atomic_add_fetch(&gMapsLive, 1, __ATOMIC_RELAXED);
+    __atomic_add_fetch(&gHubMaps, 1, __ATOMIC_RELAXED);
+    __atomic_add_fetch(&h->live, 1, __ATOMIC_RELAXED);
+    return (void *)(uintptr_t)addr;
+}
+// Release the hub. `stale`: RM_MAP_MEMORY succeeded but no mapping was made, so its context is still pending on this
+// connection and the next RM_MAP_MEMORY would be refused - re-binding the fd is what clears a stale context (sBindFd).
+void nvrm_xnu_hub_end(int fd, int stale)
+{
+    struct nvrm_hub *h = hub_of_fd(fd);
+    if (!h) return;
