+static struct nvrm_hub *hub_of_fd(int fd)
+{
+    for (int t = 0; t < 2; t++) for (int i = 0; i < NVRM_XNU_HUBS_MAX; i++) if (gHub[t][i].fd == fd) return &gHub[t][i];
+    return NULL;
