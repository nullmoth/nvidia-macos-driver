@@ -0,0 +1,328 @@
+/*
+ * Copyright 2026 NullMoth Systems
+ * SPDX-License-Identifier: MIT
+ *
+ * Unit test for hub connections (nvrm_xnu.c + nvRmApi.c, unmodified, linked against this file's mock IOKit + mock
+ * NVRM kext). The mock models the parts of the kext and of IOKit the change depends on:
+ *   - one pending mapping context per connection; RM_MAP_MEMORY on an fd whose connection has one is refused
+ *     (NV_ERR_STATE_IN_USE); binding a connection to a real fd clears a stale one (sBindFd);
+ *   - clientMemoryForType: type 0 maps the pending context and leaves it (old contract); a token type (new kext only)
+ *     consumes it and keeps the descriptor under the token; selector 7 = caps, selector 8 = forget token;
+ *   - IOKit's unmap: clientMemoryForType(type) is asked again and the mapping is found only on the descriptor it
+ *     returns (kIOMapReference); a connection's mappings all go when it is closed.
+ * Run one scenario per process (nvrm_xnu keeps static state):
+ *   new-new | old-kext | old-nvk | forced-old | stress | neg-fresh-md | neg-no-forget
+ *   map-fails | kext-full | rm-fails | race
+ * The last four each have a negative control: built against the sources of 1a6a490 (before these fixes) the arm named
+ * for the fix fails. tools: build with -DHUB_TEST_SRC to say which sources were linked, only for the banner.
+ *   map-fails  every 7th token map: the kext keeps the token, then the mapping fails (createMappingInTask refused)
+ *   kext-full  the kext keeps at most 3 tokens per connection and answers NoResources past that
+ *   rm-fails   every 5th RM_MAP_MEMORY is refused but leaves a context pending on the fd
+ *   race       a second thread makes its first map while the first thread is still inside hub set-up
+ */
+#include <IOKit/IOKitLib.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "nvRmApi.h"
+#include "nv_escape.h"
+#include "nv-unix-nvos-params-wrappers.h"
+#include "nvstatus.h"
+
+/* ---- mock kext ---------------------------------------------------------------------------------------------------- */
+static int KEXT_NEW = 1, KEXT_FRESH_MD = 0, KEXT_IGNORE_FORGET = 0, KEXT_FAIL_AFTER_REG = 0, KEXT_TOKEN_CAP = 0, RM_FAIL_LEAVES = 0;
+static atomic_int rebinds, token_maps, rm_calls;
+#define MAXC 4096
+#define MAXM 65536
+struct mconn { int open, bound; int pending; uint32_t pend_hmem; uint32_t ntok; struct { uint32_t tok, md; } tok[8192]; };
+static struct mconn C[MAXC];
+static struct { int live; io_connect_t conn; uint64_t addr; uint32_t md, hmem; } M[MAXM];
+static uint32_t md_hmem[1 << 20];
+static pthread_mutex_t K = PTHREAD_MUTEX_INITIALIZER;
+static atomic_int conns_open, conns_peak, kmaps_live, kmaps_peak, in_use_refusals, wrong_memory, rm_unmaps, rm_maps;
+static uint32_t next_md = 1; static uint64_t next_addr = 0x200000000ull;
+static void peak(atomic_int *v, atomic_int *p) { int x = atomic_load(v), q = atomic_load(p); while (x > q && !atomic_compare_exchange_weak(p, &q, x)) {} }
+
+const mach_port_t kIOMainPortDefault = 0;
+CFMutableDictionaryRef IOServiceMatching(const char *name) { (void)name; return NULL; }
+io_service_t IOServiceGetMatchingService(mach_port_t p, CFDictionaryRef m) { (void)p; (void)m; return 1; }
+kern_return_t IOObjectRelease(io_object_t o) { (void)o; return 0; }
+kern_return_t IOServiceOpen(io_service_t s, task_port_t t, uint32_t type, io_connect_t *out)
+{
+   (void)s; (void)t; (void)type;
+   pthread_mutex_lock(&K);
+   int i = 1; while (i < MAXC && C[i].open) i++;
+   if (i == MAXC) { pthread_mutex_unlock(&K); return kIOReturnNoResources; }
+   memset(&C[i], 0, sizeof C[i]); C[i].open = 1; C[i].bound = -1;
+   pthread_mutex_unlock(&K);
+   atomic_fetch_add(&conns_open, 1); peak(&conns_open, &conns_peak);
+   *out = (io_connect_t)i; return 0;
+}
+kern_return_t IOServiceClose(io_connect_t c)
+{
+   pthread_mutex_lock(&K);
+   for (int i = 0; i < MAXM; i++) if (M[i].live && M[i].conn == c) { M[i].live = 0; atomic_fetch_sub(&kmaps_live, 1); }
+   C[c].open = 0; C[c].ntok = 0; C[c].pending = 0;
+   pthread_mutex_unlock(&K);
+   atomic_fetch_sub(&conns_open, 1);
+   return 0;
+}
+static int conn_by_fd(int fd) { for (int i = 1; i < MAXC; i++) if (C[i].open && C[i].bound == fd) return i; return 0; }
+kern_return_t IOConnectCallScalarMethod(mach_port_t c, uint32_t sel, const uint64_t *in, uint32_t nin, uint64_t *out, uint32_t *nout)
+{
+   (void)nin;
+   pthread_mutex_lock(&K);
+   kern_return_t r = 0;
+   if (sel == 3) {                     /* bind fd */
+      int64_t v = (int64_t)in[0]; if (v >= 0 && C[c].bound >= 0) atomic_fetch_add(&rebinds, 1); C[c].bound = (int)v;
+      if (v >= 0) C[c].pending = 0;    /* a real bind clears a stale context */
+   } else if (sel == 6) { if (out) out[0] = 0; }
+   else if (sel == 7) { if (KEXT_NEW) { out[0] = 1; if (nout) *nout = 1; } else r = kIOReturnBadArgument; }
+   else if (sel == 8) {
+      if (!KEXT_NEW) r = kIOReturnBadArgument;
+      else if (!KEXT_IGNORE_FORGET)
+         for (uint32_t i = 0; i < C[c].ntok; i++) if (C[c].tok[i].tok == (uint32_t)in[0]) { C[c].tok[i] = C[c].tok[--C[c].ntok]; break; }
+   } else r = kIOReturnBadArgument;
+   pthread_mutex_unlock(&K);
+   return r;
+}
+kern_return_t IOConnectCallMethod(mach_port_t c, uint32_t sel, const uint64_t *in, uint32_t nin, const void *is, size_t isz,
+                                  uint64_t *out, uint32_t *nout, void *os, size_t *osz)
+{
+   (void)c; (void)nin; (void)isz; (void)out; (void)nout; (void)osz; (void)is;
+   if (sel != 1) return kIOReturnBadArgument;
+   const uint32_t cmd = (uint32_t)in[0];
+   pthread_mutex_lock(&K);
+   if (cmd == NV_ESC_RM_MAP_MEMORY) {
+      nv_ioctl_nvos33_parameters_with_fd *p = os;
+      int t = conn_by_fd(p->fd);
+      if (!t) p->params.status = NV_ERR_INVALID_ARGUMENT;
+      else if (C[t].pending) { p->params.status = NV_ERR_STATE_IN_USE; atomic_fetch_add(&in_use_refusals, 1); }
+      else if (RM_FAIL_LEAVES && (atomic_fetch_add(&rm_calls, 1) + 1) % 5 == 0) {
+         C[t].pending = 1; C[t].pend_hmem = 0; p->params.status = NV_ERR_GENERIC;   /* refused, context left behind */
+      }
+      else { C[t].pending = 1; C[t].pend_hmem = p->params.hMemory; p->params.status = NV_OK;
+             p->params.pLinearAddress = (void *)(uintptr_t)(0x1000ull * p->params.hMemory); atomic_fetch_add(&rm_maps, 1); }
+   } else if (cmd == NV_ESC_RM_UNMAP_MEMORY) {
+      NVOS34_PARAMETERS *p = os; p->status = NV_OK; atomic_fetch_add(&rm_unmaps, 1);   /* by handle + address: no fd */
+   }
+   pthread_mutex_unlock(&K);
+   return 0;
+}
+/* the kext's clientMemoryForType; K held */
+static kern_return_t cmft(io_connect_t c, uint32_t type, uint32_t *md)
+{
+   const int token = (type & 0x80000000u) != 0;
+   if (type && !token) return kIOReturnBadArgument;
+   if (token && !KEXT_NEW) return kIOReturnBadArgument;
+   if (token && !KEXT_FRESH_MD)
+      for (uint32_t i = 0; i < C[c].ntok; i++) if (C[c].tok[i].tok == type) { *md = C[c].tok[i].md; return 0; }
+   if (!C[c].pending) return kIOReturnBadArgument;
+   if (token && KEXT_TOKEN_CAP && C[c].ntok >= (uint32_t)KEXT_TOKEN_CAP) return kIOReturnNoResources;   /* context kept */
+   *md = next_md++; md_hmem[*md & ((1 << 20) - 1)] = C[c].pend_hmem;
+   if (token) {
+      C[c].pending = 0;                                         /* consumed */
+      if (!KEXT_FRESH_MD) { C[c].tok[C[c].ntok].tok = type; C[c].tok[C[c].ntok].md = *md; C[c].ntok++; }
+   }
+   return 0;
+}
+kern_return_t IOConnectMapMemory64(io_connect_t c, uint32_t type, task_port_t t, mach_vm_address_t *addr, mach_vm_size_t *len, IOOptionBits o)
+{
+   (void)t; (void)o;
+   pthread_mutex_lock(&K);
+   uint32_t md; kern_return_t r = cmft(c, type, &md);
+   /* the kext registered the token and consumed the context, then IOKit could not map it */
+   if (r == 0 && (type & 0x80000000u) && KEXT_FAIL_AFTER_REG && (atomic_fetch_add(&token_maps, 1) + 1) % 7 == 0) r = kIOReturnNoMemory;
+   if (r == 0) {
+      int i = 0; while (i < MAXM && M[i].live) i++;
+      M[i].live = 1; M[i].conn = c; M[i].addr = next_addr; M[i].md = md; M[i].hmem = md_hmem[md & ((1 << 20) - 1)];
+      *addr = next_addr; *len = 0x10000; next_addr += 0x100000;
+      atomic_fetch_add(&kmaps_live, 1); peak(&kmaps_live, &kmaps_peak);
+   }
+   pthread_mutex_unlock(&K);
+   return r;
+}
+kern_return_t IOConnectUnmapMemory64(io_connect_t c, uint32_t type, task_port_t t, mach_vm_address_t addr)
+{
+   (void)t;
+   pthread_mutex_lock(&K);
+   uint32_t md; kern_return_t r = cmft(c, type, &md);
+   if (r == 0) {
+      r = kIOReturnBadArgument;   /* kIOMapReference: only a mapping of THIS descriptor at this address */
+      for (int i = 0; i < MAXM; i++) if (M[i].live && M[i].conn == c && M[i].addr == addr && M[i].md == md) {
+         M[i].live = 0; atomic_fetch_sub(&kmaps_live, 1); r = 0; break; }
+   }
+   pthread_mutex_unlock(&K);
+   return r;
+}
+static uint32_t hmem_at(void *addr)
+{
+   uint32_t h = 0; pthread_mutex_lock(&K);
+   for (int i = 0; i < MAXM; i++) if (M[i].live && M[i].addr == (uint64_t)(uintptr_t)addr) { h = M[i].hmem; break; }
+   pthread_mutex_unlock(&K); return h;
+}
+
+/* ---- driver ------------------------------------------------------------------------------------------------------- */
+static int fails, arms;
+#define ARM(name, cond) do { arms++; if (!(cond)) { fails++; printf("FAIL  %s\n", name); } else printf("ok    %s\n", name); } while (0)
+static NvRmApi api;
+static void *worker(void *arg)
+{
+   unsigned s = (unsigned)(uintptr_t)arg * 2654435761u;
+   NvRmApiMapping held[16]; uint32_t hm[16]; int n = 0;
+   for (int it = 0; it < 3000; it++) {
+      s = s * 1103515245u + 12345u;
+      if (n < 16 && (n == 0 || (s >> 9) & 1)) {
+         uint32_t h = 1 + (s % 100000);
+         NvRmApiMapping m = { 0 };
+         if (nvRmApiMapMemory(&api, 1, h, 0, 0x10000, (s >> 3) & 1, 0, &m) == NV_OK) {
+            if (hmem_at(m.address) != h) atomic_fetch_add(&wrong_memory, 1);
+            held[n] = m; hm[n] = h; n++;
+         }
+      } else if (n) {
+         int k = (int)((s >> 5) % (unsigned)n);
+         nvRmApiUnmapMemory(&api, 1, hm[k], 0, &held[k]); held[k] = held[n - 1]; hm[k] = hm[n - 1]; n--;
+      }
+   }
+   while (n) { n--; nvRmApiUnmapMemory(&api, 1, hm[n], 0, &held[n]); }
+   return NULL;
+}
+static int total_tokens(void) { int t = 0; for (int i = 1; i < MAXC; i++) if (C[i].open) t += (int)C[i].ntok; return t; }
+
+/* race: stderr is replaced by a stream whose writer, when hub set-up announces its decision, starts a second thread that
+   makes its first map and waits (up to 300 ms) for it. Before the fix the decision was published before that line and
+   the hub entries set up after it, so the second thread saw hubs that did not exist yet. */
+static pthread_mutex_t RaceMu = PTHREAD_MUTEX_INITIALIZER; static pthread_cond_t RaceCv = PTHREAD_COND_INITIALIZER;
+static int race_started, race_done; static NvU32 race_b_status = 0xFFFFFFFF; static uint32_t race_b_hmem; static NvRmApiMapping race_b_map;
+static void *race_b(void *arg)
+{
+   (void)arg;
+   race_b_status = nvRmApiMapMemory(&api, 1, 222, 0, 0x10000, false, 0, &race_b_map);
+   race_b_hmem = race_b_status == NV_OK ? hmem_at(race_b_map.address) : 0;
+   pthread_mutex_lock(&RaceMu); race_done = 1; pthread_cond_broadcast(&RaceCv); pthread_mutex_unlock(&RaceMu);
+   return NULL;
+}
+static int race_write(void *cookie, const char *buf, int n)
+{
+   (void)cookie;
+   write(2, buf, (size_t)n);
+   if (!race_started && memmem(buf, (size_t)n, "share hub connections", 21)) {
+      race_started = 1; pthread_t t; pthread_create(&t, NULL, race_b, NULL); pthread_detach(t);
+      struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); ts.tv_nsec += 300000000; if (ts.tv_nsec >= 1000000000) { ts.tv_sec++; ts.tv_nsec -= 1000000000; }
+      pthread_mutex_lock(&RaceMu); while (!race_done) if (pthread_cond_timedwait(&RaceCv, &RaceMu, &ts)) break; pthread_mutex_unlock(&RaceMu);
+   }
+   return n;
+}
+
+int main(int argc, char **argv)
+{
+   const char *sc = argc > 1 ? argv[1] : "new-new";
+   const int stress = !strcmp(sc, "stress");
+   if (!strcmp(sc, "old-kext")) KEXT_NEW = 0;
+   if (!strcmp(sc, "old-nvk") || !strcmp(sc, "forced-old")) setenv("NVRM_ONE_CONN_PER_MAP", "1", 1);
+   if (!strcmp(sc, "neg-fresh-md")) KEXT_FRESH_MD = 1;
+   if (!strcmp(sc, "neg-no-forget")) KEXT_IGNORE_FORGET = 1;
+   if (!strcmp(sc, "map-fails")) KEXT_FAIL_AFTER_REG = 1;
+   if (!strcmp(sc, "kext-full")) KEXT_TOKEN_CAP = 3;
+   if (!strcmp(sc, "rm-fails")) RM_FAIL_LEAVES = 1;
+#ifdef HUB_TEST_SRC
+   printf("sources: %s\n", HUB_TEST_SRC);
+#endif
+   api.fd = nvrm_xnu_open("/dev/nvidiactl"); api.hClient = 1; api.nodeName = "/dev/nvidia0";
+   const int ctl_conns = atomic_load(&conns_open);
+   printf("scenario %s (kext %s)\n", sc, KEXT_NEW ? "new" : "old");
+
+   if (!strcmp(sc, "race")) {
+      stderr = funopen(NULL, NULL, race_write, NULL, NULL); setvbuf(stderr, NULL, _IONBF, 0);
+      NvRmApiMapping a = { 0 };
+      const NvU32 sa = nvRmApiMapMemory(&api, 1, 111, 0, 0x10000, false, 0, &a);
+      const uint32_t ha = sa == NV_OK ? hmem_at(a.address) : 0;
+      pthread_mutex_lock(&RaceMu); while (race_started && !race_done) pthread_cond_wait(&RaceCv, &RaceMu); pthread_mutex_unlock(&RaceMu);
+      printf("      first map: status 0x%x memory %u; racing first map: status 0x%x memory %u\n", sa, ha, race_b_status, race_b_hmem);
+      ARM("race: the second thread really did start inside hub set-up", race_started && race_done);
+      ARM("race: the first thread's map succeeds and shows its own memory", sa == NV_OK && ha == 111);
+      ARM("race: the racing first map succeeds and shows its own memory (no zeroed hub, no fd 0)", race_b_status == NV_OK && race_b_hmem == 222);
+      if (sa == NV_OK) nvRmApiUnmapMemory(&api, 1, 111, 0, &a);
+      if (race_b_status == NV_OK) nvRmApiUnmapMemory(&api, 1, 222, 0, &race_b_map);
+      ARM("race: nothing left mapped and no token left", atomic_load(&kmaps_live) == 0 && total_tokens() == 0);
+      printf("%d arms, %d failed\n", arms, fails);
+      return fails != 0;
+   }
+   if (!strcmp(sc, "map-fails") || !strcmp(sc, "kext-full") || !strcmp(sc, "rm-fails")) {
+      enum { N = 200 };
+      static NvRmApiMapping m[N]; static int okm[N];
+      int nok = 0, wrong = 0;
+      for (int i = 0; i < N; i++) {
+         okm[i] = nvRmApiMapMemory(&api, 1, 100 + i, 0, 0x10000, i & 1, 0, &m[i]) == NV_OK;
+         if (okm[i]) { nok++; if (hmem_at(m[i].address) != (uint32_t)(100 + i)) wrong++; }
+      }
+      const int tokens_mapped = total_tokens();
+      uint64_t hm = 0, hf = 0; int hubs = 0; nvrm_xnu_hub_stats(&hm, &hf, &hubs);
+      for (int i = 0; i < N; i++) if (okm[i]) nvRmApiUnmapMemory(&api, 1, 100 + i, 0, &m[i]);
+      printf("      %d of %d maps succeeded, %d wrong memory, %d tokens while mapped (%d live maps), %d tokens left, %d refused for a "
+             "pending context, %d re-binds, RM maps %d / unmaps %d, hub maps %llu fallbacks %llu\n", nok, N, wrong, tokens_mapped, nok,
+             total_tokens(), atomic_load(&in_use_refusals), atomic_load(&rebinds), atomic_load(&rm_maps), atomic_load(&rm_unmaps),
+             (unsigned long long)hm, (unsigned long long)hf);
+      ARM("every map that succeeded shows the memory its own RM_MAP_MEMORY named", wrong == 0);
+      ARM("no mapping left in the kernel after unmap", atomic_load(&kmaps_live) == 0);
+      if (!strcmp(sc, "map-fails")) {
+         ARM("map-fails: the maps the kext let fail are the only failures (every 7th token map)", nok == N - (int)(atomic_load(&token_maps) / 7));
+         ARM("map-fails: a failed map leaves no token behind - selector 8 is sent for it", total_tokens() == 0);
+         ARM("map-fails: the hub keeps mapping after a failure (nothing refused for a pending context)", atomic_load(&in_use_refusals) == 0);
+      } else if (!strcmp(sc, "kext-full")) {
+         ARM("kext-full: every map succeeds - past the kext's token limit maps take their own connection", nok == N);
+         ARM("kext-full: no hub was re-bound for it", atomic_load(&rebinds) == 0);
+         ARM("kext-full: RM's half of every retried map was undone (RM maps == RM unmaps)", atomic_load(&rm_maps) == atomic_load(&rm_unmaps));
+         ARM("kext-full: the fallback is counted", hf > 0);
+      } else {
+         ARM("rm-fails: exactly the maps RM refused failed (every 5th RM_MAP_MEMORY)", nok == N - atomic_load(&rm_calls) / 5);
+         ARM("rm-fails: a refused RM_MAP_MEMORY that left a context does not block the next map (re-bound)", atomic_load(&in_use_refusals) == 0);
+         ARM("rm-fails: no token left", total_tokens() == 0);
+      }
+      printf("%d arms, %d failed\n", arms, fails);
+      return fails != 0;
+   }
+   if (stress) {
+      pthread_t t[8];
+      for (int i = 0; i < 8; i++) pthread_create(&t[i], NULL, worker, (void *)(uintptr_t)(i + 1));
+      for (int i = 0; i < 8; i++) pthread_join(t[i], NULL);
+      printf("      stress: %d RM maps, peak %d kernel mappings on peak %d connections\n",
+             atomic_load(&rm_maps), atomic_load(&kmaps_peak), atomic_load(&conns_peak));
+      ARM("stress: every mapping shows the memory its own RM_MAP_MEMORY named (hub serialisation holds)", atomic_load(&wrong_memory) == 0);
+      ARM("stress: no RM_MAP_MEMORY refused for a context still pending", atomic_load(&in_use_refusals) == 0);
+      ARM("stress: every mapping released after unmap", atomic_load(&kmaps_live) == 0);
+      ARM("stress: connections stay at the hubs (<= 2 types x 4 + ctl)", atomic_load(&conns_peak) <= ctl_conns + 8);
+      ARM("stress: tokens all forgotten", total_tokens() == 0);
+      printf("%d arms, %d failed\n", arms, fails);
+      return fails != 0;
+   }
+
+   enum { N = 200 };
+   static NvRmApiMapping m[N];
+   int ok = 1;
+   for (int i = 0; i < N; i++) {
+      ok &= nvRmApiMapMemory(&api, 1, 100 + i, 0, 0x10000, i & 1, 0, &m[i]) == NV_OK;
+      ok &= hmem_at(m[i].address) == (uint32_t)(100 + i);
+   }
+   const int conns_mapped = atomic_load(&conns_open) - ctl_conns;
+   const int maps_mapped = atomic_load(&kmaps_live);
+   for (int i = 0; i < N; i++) ok &= nvRmApiUnmapMemory(&api, 1, 100 + i, 0, &m[i]) == NV_OK;
+   const int conns_after = atomic_load(&conns_open) - ctl_conns;
+   printf("      %d mappings: %d connections while mapped, %d kernel mappings live after unmap, %d connections after, "
+          "%d tokens left, %d RM unmaps\n", N, conns_mapped, atomic_load(&kmaps_live), conns_after, total_tokens(), atomic_load(&rm_unmaps));
+   ARM("every map succeeds and maps the memory RM named", ok);
+   ARM("RM's own unmap ran for every mapping (by handle and address, no fd)", atomic_load(&rm_unmaps) == N);
+   ARM("no mapping left in the kernel after unmap", atomic_load(&kmaps_live) == 0);
+   ARM("no RM_MAP_MEMORY refused for a pending context", atomic_load(&in_use_refusals) == 0);
+   if (!strcmp(sc, "new-new") || !strcmp(sc, "neg-fresh-md") || !strcmp(sc, "neg-no-forget")) {
+      ARM("hubs: 200 live mappings on at most 8 connections (was 200)", maps_mapped == N && conns_mapped <= 8);
+      ARM("hubs: every token forgotten after its unmap", total_tokens() == 0);
+   } else {
+      ARM("old path: one connection per live mapping, exactly as before", conns_mapped == N);
+      ARM("old path: every connection closed with its mapping", conns_after == 0);
+   }
+   printf("%d arms, %d failed\n", arms, fails);
+   return fails != 0;
+}
