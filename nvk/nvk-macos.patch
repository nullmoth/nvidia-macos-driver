+   {
+      NV_STATUS us = NV_ERR_GENERIC;
+      if (nvrm610_on("USERMODE") && nvkmd_nvrm_pdev_is_class_supported(pdev, HOPPER_USERMODE_A)) {
+         NV_HOPPER_USERMODE_A_PARAMS up = { .bBar1Mapping = NV_FALSE, .bPriv = NV_FALSE };
+         us = nvRmApiAlloc(&rm, pdev->hSubdevice, &pdev->hUsermode, HOPPER_USERMODE_A, &up);
+         if (us == NV_OK) {
+            us = nvRmApiMapMemory(&rm, pdev->hSubdevice, pdev->hUsermode, 0, 0x10000, false, 0, &pdev->usermodeMap);
+            if (us != NV_OK) { nvRmApiFree(&rm, pdev->hUsermode); pdev->hUsermode = 0; }
+         }
+         if (us != NV_OK)
+            fprintf(stderr, "nvrm: b81 HOPPER_USERMODE_A rc 0x%x - falling back to class 0x%x\n", (unsigned)us, usermodeClass);
+      }
+      if (us != NV_OK) {
+         NV_CHECK(nvRmApiAlloc(&rm, pdev->hSubdevice, &pdev->hUsermode, usermodeClass, NULL));
+         NV_CHECK(nvRmApiMapMemory(&rm, pdev->hSubdevice, pdev->hUsermode, 0, 4096, false, 0, &pdev->usermodeMap));
+      }
+   }
+   NV_VASPACE_ALLOCATION_PARAMETERS vaSpaceParams = {
+      .flags = NV_VASPACE_ALLOCATION_FLAGS_RETRY_PTE_ALLOC_IN_SYS,
+      .vaBase = 0x200000000ull,
+   };
+   NV_CHECK(nvRmApiAlloc(&rm, pdev->hDevice, &pdev->hVaSpace, FERMI_VASPACE_A, &vaSpaceParams));
+
+
+
+
+   uint64_t os_page_size;
+   os_get_page_size(&os_page_size);
+   assert(os_page_size <= UINT32_MAX);
+   pdev->base.bind_align_B = os_page_size;
+
+
+
+
+   if (nvrm610_on("BOOST")) {
+      NV2080_CTRL_PERF_BOOST_PARAMS bp = {
+         .flags = NV2080_CTRL_PERF_BOOST_FLAGS_CMD_BOOST_TO_MAX | (NV2080_CTRL_PERF_BOOST_FLAGS_CUDA_YES << 4),
+         .duration = NV2080_CTRL_PERF_BOOST_DURATION_INFINITE,
+      };
+      NV_STATUS bs = nvRmApiControl(&rm, pdev->hSubdevice, NV2080_CTRL_CMD_PERF_BOOST, &bp, sizeof bp);
+      fprintf(stderr, "nvrm: b81 PERF_BOOST flags 0x%x INFINITE rc 0x%x\n", (unsigned)bp.flags, (unsigned)bs);
+   }
+
+
+
+   {
+      const char *he = nvmtl_cfg_getenv("NVK_HOST_IMPORT");
+      NV_STATUS hs = NV_ERR_NOT_SUPPORTED;
+      if (!(he && he[0] == '0')) {
+         void *pg = NULL;
+         if (posix_memalign(&pg, os_page_size, os_page_size) == 0) {
+            memset(pg, 0, os_page_size);
+            struct NvRmApi drm = rm;
+            drm.fd = pdev->devFd;
+
+
+
+            nvRmApiRegisterFd(&drm, pdev->ctlFd);
+            hs = nvRmApiAllocMemory(&drm, pdev->hDevice, 0x5eaffff0u, NV01_MEMORY_SYSTEM_OS_DESCRIPTOR,
+                                    NVRM_HOST_OS02_FLAGS, pg, os_page_size - 1);
+            if (hs == NV_OK)
+               nvRmApiFree(&rm, 0x5eaffff0u);
+            free(pg);
+         }
+      }
+      pdev->base.kmd_info.has_host_import = hs == NV_OK;
+      fprintf(stderr, "nvrm: b72 host-pointer import %s (probe NV_STATUS %#x%s)\n", hs == NV_OK ? "ON" : "OFF",
+              (unsigned)hs, he && he[0] == '0' ? ", NVK_HOST_IMPORT=0" : "");
+   }
+
+   pdev->syncobj_sync_type = nvkmd_nvrm_sync_get_type(pdev);
+   pdev->sync_types[0] = &pdev->syncobj_sync_type;
+   pdev->sync_types[1] = NULL;
+   pdev->base.sync_types = pdev->sync_types;
+
+   *pdev_out = &pdev->base;
+
+   return VK_SUCCESS;
+
+error:
+	nvkmd_pdev_destroy(&pdev->base);
+	return vkRes;
+}
+
+VkResult
+nvkmd_nvrm_enum_pdev(struct vk_object_base *log_obj,
+                     enum nvk_debug debug_flags,
+                     nvkmd_enum_pdev_visitor visitor,
+                     void *arg)
+{
+   VkResult result = VK_SUCCESS;
+
+   int ctlFd = NVRM_OPEN(NVRM_CTL_NODE_NAME);
+   if (ctlFd < 0)
+   	return VK_SUCCESS;
+
+   struct NvRmApi rm = {
+   	.fd = ctlFd,
+   };
+
+   nv_ioctl_card_info_t cardInfos[NV_MAX_GPUS];
+   NV_STATUS nvRes = nvRmApiCardInfo(&rm, cardInfos, sizeof(cardInfos));
+   if (nvRes != NV_OK) {
+      fprintf(stderr, "[!] nvRes: %#x\n", nvRes);
+      result = VK_ERROR_UNKNOWN;
+   	goto done;
+   }
+
+   for (uint32_t i = 0; i < NV_MAX_GPUS; i++) {
+   	if (!cardInfos[i].valid)
+   		continue;
+
+	   struct nvkmd_pdev *pdev = NULL;
+	   result = nvkmd_nvrm_create_pdev(log_obj, debug_flags, &cardInfos[i], &pdev);
+	   if (result == VK_ERROR_INCOMPATIBLE_DRIVER) {
+	   	result = VK_SUCCESS;
+	   	continue;
+	   }
+
+	   if (result != VK_SUCCESS)
+	   	goto done;
+
+	   result = visitor(pdev, arg);
+	   if (result == VK_ERROR_INCOMPATIBLE_DRIVER) {
+	   	result = VK_SUCCESS;
+	   	continue;
+	   }
+
+	   if (result != VK_SUCCESS)
+	   	goto done;
+   }
+
+done:
+   NVRM_CLOSE(ctlFd);
+   return result;
+}
