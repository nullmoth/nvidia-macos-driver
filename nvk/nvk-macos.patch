@@ -0,0 +1,27 @@
+/*
+ * nvk_build_interface.h — push constants of NVK's BVH encode shader (rung 3). Shared C / GLSL.
+ */
+#ifndef NVK_BVH_BUILD_INTERFACE_H
+#define NVK_BVH_BUILD_INTERFACE_H
+
+#ifdef VULKAN
+#include "vk_bvh_defines.h"   /* 26.3: was vk_build_interface.h */
+#else
+#include <stdint.h>
+#include "bvh/vk_bvh_defines.h"
+#endif
+
+/* One invocation per index x: x < leaf_node_count encodes leaf x; x < header.ir_internal_node_count also encodes internal
+ * node x (the shared builder's box nodes in reverse order, so the root is x == 0); x == 0 writes the header. */
+struct nvk_encode_args {
+   VOID_REF intermediate_bvh;
+   VOID_REF output_bvh;
+   REF(vk_ir_header) header;
+   uint32_t leaf_node_count;
+   uint32_t geometry_type;
+   /* the whole acceleration structure's size (header + nodes), for compacted_size / serialization_size */
+   uint32_t bvh_size;
+   uint32_t padding;
+};
+
+#endif /* NVK_BVH_BUILD_INTERFACE_H */
