+/* ═══  G-SUB (b79) — ASYNCHRONOUS SUBMISSION ═══════════════════════════════════════════════════════════════════════
+ * WAS: every flush rang the doorbell and then SPUN until the channel semaphore came back, so vkQueueSubmit returned
+ * only after the GPU finished (GB7 R5,: submit ms == GPU busy ms in every subtest, zero CPU/GPU overlap), and
+ * every sync op was a no-op (NVRM_SYNC_ENABLED 0) because nothing was ever left in flight.
+ * NOW the flush returns once the doorbell is rung. Completion is the channel semaphore, read where Vulkan waits:
+ * a signal records (channel, seq) on its sync, wait_many reads the semaphore with the old flush's fault check,
+ * deadline (now: NO PROGRESS for NVRM_FLUSH_TIMEOUT_MS) and back-off, and a wait on another channel's signal is a
+ * SEM_ACQUIRE in the GPFIFO. Same-channel order needs nothing: every flush ends WFI + release (the L2 tail).
+ * Memory freed while a channel may still read it is freed once every channel passes the seq it had flushed then.
+ * The nouveau kernel held that reference for upstream NVK; RM frees at once.
+ * NVRM_ASYNC=0 restores the old synchronous flush and the no-op syncs, code path for code path. */
+struct nvkmd_nvrm_slot nvkmd_nvrm_slots[NVRM_CTX_MAX];
+pthread_mutex_t nvkmd_nvrm_gsub_mtx = PTHREAD_MUTEX_INITIALIZER;
+static uint64_t nvrm_gsub_stats[NVRM_GS_N];
+
+bool
+nvkmd_nvrm_async_on(void)
+{
+   static bool diag_armed; if (!diag_armed) { diag_armed = true; (void)nvkmd_nvrm_diag_on(); }
+   static int on = -1;
+   if (on < 0) {
+      const char *e = nvmtl_conf_getenv("NVRM_ASYNC");
+      on = !(e && e[0] == '0');
+   }
+   return on;
+}
+
+/* ═══ r3-diag  ══════════════════════════════════════════════════════════════════════════════════════
+ * r3 hangs WindowServer: a fence wait times out with NO channel fault, and WindowServer discards stderr, so r3's own
+ * stall diagnostic never reaches anyone. NVK_DIAG=1 (env or nvrm610.conf) sends NVK's stderr to
+ * /private/tmp/nvk-diag-<pid>.log and, when a wait times out, dumps every channel: semaphore vs flushed, GPGet/GPPut,
+ * error notifier, and the last SEM_ACQUIRE it emitted (which channel's semaphore, which value). Off = unchanged r3. */
+#include <fcntl.h>
+#include <unistd.h>
+#include "../../nvmtl_cfg.h"
+bool
+nvkmd_nvrm_diag_on(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = nvmtl_conf_getenv("NVK_DIAG");
+      on = e && e[0] == '1';
+      if (on) {
+         char path[128]; snprintf(path, sizeof path, "/private/tmp/nvk-diag-%d.log", (int)getpid());
+         int fd = open(path, O_WRONLY | O_CREAT | O_APPEND, 0644);
+         if (fd >= 0) { dup2(fd, 2); close(fd); setvbuf(stderr, NULL, _IOLBF, 0); }
+         fprintf(stderr, "nvk-diag: on in %s pid %d, async %d\n", getprogname(), (int)getpid(), (int)nvkmd_nvrm_async_on());
+      }
+   }
+   return on;
+}
+
+void
+nvkmd_nvrm_diag_dump(const char *why, const char *heads)
+{
+   static int64_t last; static int n;
+   const int64_t now = os_time_get_nano();
+   if (!nvkmd_nvrm_diag_on() || n >= 30 || now - last < 1000000000LL) return;
+   last = now; n++;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   fprintf(stderr, "nvk-diag: DUMP %d (%s) waiting on %s\n", n, why, heads);
+   for (unsigned i = 0; i < NVRM_CTX_MAX; i++) {
+      const struct nvkmd_nvrm_slot *sl = &nvkmd_nvrm_slots[i];
+      if (sl->ctx == NULL) continue;
+      const struct nvkmd_nvrm_exec_ctx *c = sl->ctx;
+      const KeplerBControlGPFifo *u = c->userD->map;
+      const NvNotification *err = &((NvNotification *)c->notifier->map)[NV_CHANNELGPFIFO_NOTIFICATION_TYPE_ERROR];
+      int acqOwner = -1;
+      for (unsigned j = 0; j < NVRM_CTX_MAX; j++)
+         if (nvkmd_nvrm_slots[j].ctx != NULL && nvkmd_nvrm_slots[j].semVA == sl->acqVA) acqOwner = (int)j;
+      const uint64_t acqNow = acqOwner >= 0 ? __atomic_load_n(nvkmd_nvrm_slots[acqOwner].sem, __ATOMIC_ACQUIRE) : 0;
+      fprintf(stderr, "nvk-diag:   slot %2u gen %u %s tsg %u sem %llu flushed %llu wSeq %llu | GPGet %u GPPut %u (ctx get %llu put %llu) | err 0x%x faulted %d | last acquire -> slot %d want %llu (that sem now %llu) x%llu%s\n",
+              i, sl->gen, c->ceOnly ? "CE " : "GFX", (unsigned)c->hTsg,
+              (unsigned long long)__atomic_load_n(sl->sem, __ATOMIC_ACQUIRE), (unsigned long long)sl->flushed,
+              (unsigned long long)c->wSeq, u->GPGet, u->GPPut, (unsigned long long)c->gpGet, (unsigned long long)c->gpPut,
+              (unsigned)err->status, (int)sl->faulted, acqOwner, (unsigned long long)sl->acqSeq, (unsigned long long)acqNow,
+              (unsigned long long)sl->acqCount,
+              (acqOwner >= 0 && acqNow < sl->acqSeq) ? "  <== ACQUIRE NOT SATISFIED" : "");
+   }
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+}
