+   const bool gdq_chainable = gdq_ok &&
+                              cs->gdq_prev_qmd != NULL &&
+                              cmd->push.start == cs->gdq_push_start &&
+                              cmd->push.end == cs->gdq_push_after_disp &&
+                              (gdq_waits & ~cs->gdq_chain_fence) == 0;
