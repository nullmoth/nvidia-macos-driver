+static /* 26.3: verbatim from upstream src/nouveau/winsys/nouveau_device.c (17ca6174), which macOS does not build.
+ * NAK's QMD smem sizing (gv100_get_hw_smem_sizes) indexes sm_smem_sizes_kB[count-1] and unwraps .last, so a
+ * zero count PANICS on the first compute dispatch. Keep these in sync with upstream when it changes. */
+static uint8_t
+nvrm_max_blocks_per_mp_for_sm(uint8_t sm)
+{
+   /* Values taken from CUDA programming guide section "Compute Capabilities" */
+   switch (sm) {
+   case 10:
+   case 11:
+   case 12:
+   case 13:
+   case 20:
+   case 21:
+      return 8;
+   case 30:
+   case 32:
+   case 35:
+   case 37:
+   case 75:
+   case 86:
+   case 87:
+      return 16;
+   case 89:
+   case 110:
+   case 120:
+      return 24;
+   case 50:
+   case 52:
+   case 53:
+   case 60:
+   case 61:
+   case 62:
+   case 70:
+   case 72:
+   case 80:
+   case 90:
+   case 100:
+      return 32;
+   default:
+      fprintf(stderr, "nvrm: GPU reported an unknown SM version %u; not using it\n", (unsigned)sm);
+      return 0;
+   }
+}
