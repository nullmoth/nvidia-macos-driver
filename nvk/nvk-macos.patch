+static void
+nvk_cmd_fill_buffer_addr_hook(VkCommandBuffer commandBuffer, VkDeviceAddress addr, VkDeviceSize size, uint32_t data)
+{
+   VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+   nvk_cmd_fill_memory_ce(cmd, addr, size, data);   /* 26.3: upstream's own fill-by-address */
+}
+
+/* ---- the encode pass ---------------------------------------------------------------------------------------------- */
+
+static void
+nvk_get_build_config(VkDevice device, struct vk_acceleration_structure_build_state *state)
+{
+   /* defaults: 32-bit morton keys, no quads (encode.comp writes single triangles), no update path */
+}
+
+/* 26.3: one encode callback for every build (tu_encode's shape): bind the pipeline once, then per build push the args
+ * and dispatch. One invocation per leaf covers every internal node too (internal nodes = active leaves - 1); at least
+ * one for the root box + header of an empty build. encode.comp bounds-checks against args and the IR header itself. */
+static void
+nvk_encode(VkCommandBuffer commandBuffer, struct vk_device *vk_device, struct vk_meta_device *meta,
+           const struct vk_acceleration_structure_build_args *build_args,
+           struct vk_acceleration_structure_build_state *states, uint32_t build_count,
+           bool flushed_compute_after_init_update_scratch)
+{
+   VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+
+   /* the IR the builder just wrote must be visible to the encode pass */
+   vk_bvh_build_barrier_compute_to_compute(commandBuffer, true);
+
+   VkPipeline pipeline;
+   VkResult result = vk_get_bvh_build_pipeline_spv(vk_device, meta,
+                                                   (enum vk_meta_object_key_type)NVK_META_OBJECT_KEY_BVH_ENCODE,
+                                                   nvk_encode_spv, sizeof(nvk_encode_spv),
+                                                   sizeof(struct nvk_encode_args), build_args, 0, &pipeline,
+                                                   false /* exact grid, encode.comp bounds-checks */);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+   VkPipelineLayout layout;
+   result = vk_get_bvh_build_pipeline_layout(vk_device, meta, sizeof(struct nvk_encode_args), &layout);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+
+   dev->vk.dispatch_table.CmdBindPipeline(commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+
+   for (uint32_t i = 0; i < build_count; i++) {
+      const struct vk_acceleration_structure_build_state *state = &states[i];
+      VK_FROM_HANDLE(vk_acceleration_structure, dst, state->build_info->dstAccelerationStructure);
+
+      const VkGeometryTypeKHR geometry_type = vk_get_as_geometry_type(state->build_info);
+      const struct nvk_encode_args args = {
+         .intermediate_bvh = state->build_info->scratchData.deviceAddress + state->scratch.ir_offset,
+         .output_bvh = vk_acceleration_structure_get_va(dst),
+         .header = state->build_info->scratchData.deviceAddress + state->scratch.header_offset,
+         .leaf_node_count = state->leaf_node_count,
+         .geometry_type = geometry_type,
+         .bvh_size = (uint32_t)nvk_get_as_size_internal(geometry_type, state->leaf_node_count),
+      };
+      dev->vk.dispatch_table.CmdPushConstants(commandBuffer, layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(args), &args);
+
+      const uint32_t local_x = 64;
+      const uint32_t groups_x = DIV_ROUND_UP(MAX2(state->leaf_node_count, 1), local_x);
+      dev->vk.dispatch_table.CmdDispatchBase(commandBuffer, 0, 0, 0, groups_x, 1, 1);
+   }
+}
+
+static const struct vk_acceleration_structure_build_ops nvk_as_build_ops = {
+   .get_build_config = nvk_get_build_config,
+   .get_as_size = nvk_get_as_size,
+   .encode = nvk_encode,
+};
+
+VkResult
+nvk_device_init_accel_struct_state(struct nvk_device *dev)
+{
+   simple_mtx_init(&dev->accel.lock, mtx_plain);
+
+   dev->accel.ops = nvk_as_build_ops;
+   dev->vk.as_build_ops = &dev->accel.ops;
+   dev->vk.write_buffer_cp = nvk_cmd_write_buffer_cp;
+   dev->vk.flush_buffer_write_cp = nvk_cmd_flush_buffer_write_cp;
+   dev->vk.cmd_dispatch_unaligned = nvk_cmd_dispatch_unaligned;
+   dev->vk.cmd_fill_buffer_addr = nvk_cmd_fill_buffer_addr_hook;
+
+   dev->accel.args = (struct vk_acceleration_structure_build_args) {
+      .subgroup_size = 32,
+      .bvh_bounds_offset = offsetof(struct nvk_bvh_header, bounds),
+      .root_flags_offset = offsetof(struct nvk_bvh_header, root_flags),
+      /* 26.3: the builder's own morton sort; Turnip's and Intel's sizing (512 x 2), chosen by us here */
+      .morton_sort_workgroup_size = 512,
+      .morton_sort_kvs_per_thread = 2,
+      .propagate_cull_flags = false,
+      .emit_markers = false,
+   };
+
+   return VK_SUCCESS;
+}
+
+void
+nvk_device_finish_accel_struct_state(struct nvk_device *dev)
+{
+   simple_mtx_destroy(&dev->accel.lock);
+}
+
+/* ---- the entry points --------------------------------------------------------------------------------------------- */
+
+VKAPI_ATTR void VKAPI_CALL
+nvk_GetAccelerationStructureBuildSizesKHR(VkDevice _device, VkAccelerationStructureBuildTypeKHR buildType,
+                                          const VkAccelerationStructureBuildGeometryInfoKHR *pBuildInfo,
+                                          const uint32_t *pMaxPrimitiveCounts,
+                                          VkAccelerationStructureBuildSizesInfoKHR *pSizeInfo)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+
+   vk_get_as_build_sizes(_device, buildType, pBuildInfo, pMaxPrimitiveCounts, pSizeInfo, &dev->accel.args);
+}
+
+struct nvk_accel_saved_state {
+   struct nvk_shader *cs_shader;
+   uint8_t push[NVK_MAX_PUSH_SIZE];
+};
+
+/* The shared builder binds its own compute pipelines and push constants through the dispatch table; the app's compute
+ * shader and push data are put back afterwards (the BVH pipelines use no descriptor sets). */
+static void
+nvk_accel_save(struct nvk_cmd_buffer *cmd, struct nvk_accel_saved_state *save)
+{
+   save->cs_shader = cmd->state.cs.shader;
+   nvk_descriptor_state_get_root_array(&cmd->state.cs.descriptors, push, 0, NVK_MAX_PUSH_SIZE, save->push);
+}
+
+static void
+nvk_accel_restore(struct nvk_cmd_buffer *cmd, const struct nvk_accel_saved_state *save)
+{
+   nvk_cmd_bind_compute_shader(cmd, save->cs_shader);
+   nvk_descriptor_state_set_root_array(cmd, &cmd->state.cs.descriptors, push, 0, NVK_MAX_PUSH_SIZE, save->push);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+nvk_CmdBuildAccelerationStructuresKHR(VkCommandBuffer commandBuffer, uint32_t infoCount,
+                                      const VkAccelerationStructureBuildGeometryInfoKHR *pInfos,
+                                      const VkAccelerationStructureBuildRangeInfoKHR *const *ppBuildRangeInfos)
+{
+   VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+
+   struct nvk_accel_saved_state saved;
+   nvk_accel_save(cmd, &saved);
+
+   vk_cmd_build_acceleration_structures(commandBuffer, &dev->vk, &dev->meta, infoCount, pInfos,
+                                        ppBuildRangeInfos, &dev->accel.args);
+
+   nvk_accel_restore(cmd, &saved);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+nvk_GetDeviceAccelerationStructureCompatibilityKHR(VkDevice _device,
+                                                   const VkAccelerationStructureVersionInfoKHR *pVersionInfo,
+                                                   VkAccelerationStructureCompatibilityKHR *pCompatibility)
+{
+   VK_FROM_HANDLE(nvk_device, dev, _device);
+   const struct nvk_physical_device *pdev = nvk_device_physical(dev);
+
+   bool compat = memcmp(pVersionInfo->pVersionData, pdev->vk.properties.driverUUID, VK_UUID_SIZE) == 0;
+   *pCompatibility = compat ? VK_ACCELERATION_STRUCTURE_COMPATIBILITY_COMPATIBLE_KHR
+                            : VK_ACCELERATION_STRUCTURE_COMPATIBILITY_INCOMPATIBLE_KHR;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+nvk_CmdCopyAccelerationStructureKHR(VkCommandBuffer commandBuffer, const VkCopyAccelerationStructureInfoKHR *pInfo)
+{
+   VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(vk_acceleration_structure, src, pInfo->src);
+   VK_FROM_HANDLE(vk_acceleration_structure, dst, pInfo->dst);
+
+   /* CLONE and COMPACT are the same here: the encode writes the structure compacted already. */
+   nvk_cmd_dma_copy_addr(cmd, vk_acceleration_structure_get_va(dst), vk_acceleration_structure_get_va(src),
+                         MIN2(src->size, dst->size));
+}
+
+VKAPI_ATTR void VKAPI_CALL
+nvk_CmdCopyAccelerationStructureToMemoryKHR(VkCommandBuffer commandBuffer,
+                                            const VkCopyAccelerationStructureToMemoryInfoKHR *pInfo)
+{
+   VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(vk_acceleration_structure, src, pInfo->src);
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   const struct nvk_physical_device *pdev = nvk_device_physical(dev);
+
+   /* v1: the header names this driver and copies the structure whole; instance pointers stay absolute (a structure
+    * serialized here deserializes only on this device, which the compatibility query says). */
+   struct vk_accel_struct_serialization_header header = {
+      .serialization_size = sizeof(header) + src->size,
+      .deserialization_size = src->size,
+      .instance_count = 0,
+   };
+   memcpy(header.driver_uuid, pdev->vk.properties.driverUUID, VK_UUID_SIZE);
+   memcpy(header.accel_struct_compat, pdev->vk.properties.driverUUID, VK_UUID_SIZE);
+
+   nvk_cmd_write_buffer_cp(commandBuffer, pInfo->dst.deviceAddress, &header, sizeof(header));
+   nvk_cmd_dma_copy_addr(cmd, pInfo->dst.deviceAddress + sizeof(header), vk_acceleration_structure_get_va(src), src->size);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+nvk_CmdCopyMemoryToAccelerationStructureKHR(VkCommandBuffer commandBuffer,
+                                            const VkCopyMemoryToAccelerationStructureInfoKHR *pInfo)
+{
+   VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(vk_acceleration_structure, dst, pInfo->dst);
+
+   nvk_cmd_dma_copy_addr(cmd, vk_acceleration_structure_get_va(dst),
+                         pInfo->src.deviceAddress + sizeof(struct vk_accel_struct_serialization_header), dst->size);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+nvk_CmdWriteAccelerationStructuresPropertiesKHR(VkCommandBuffer commandBuffer, uint32_t accelerationStructureCount,
+                                                const VkAccelerationStructureKHR *pAccelerationStructures,
+                                                VkQueryType queryType, VkQueryPool queryPool, uint32_t firstQuery)
+{
+   VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+   /* Not built yet: compaction / serialization size queries need the query pool to carry these query types.
+    * Said loudly rather than answered with a zero. */
+   vk_command_buffer_set_error(&cmd->vk, VK_ERROR_FEATURE_NOT_PRESENT);
+}
+
+/* Host commands: accelerationStructureHostCommands is not advertised, so a valid app never calls these. */
