+
+/* ═══  G-SUB (b79) — REAL SYNCS (NVRM_ASYNC, default on; NVRM_ASYNC=0 keeps the no-op ops above) ════════════════
+ * A GPU signal is (channel slot, gen, seq, value): reached once that channel's semaphore passes seq. A CPU signal
+ * sets value. Binary: value 0/1, a signal REPLACES the payload. Timeline: value = the highest completed signal. */
+static inline bool
+nvrm_gsub_is_binary(const struct nvkmd_nvrm_sync *s)
+{
+   return !(s->base.flags & VK_SYNC_IS_TIMELINE);
+}
+
+/* caller holds nvkmd_nvrm_gsub_mtx */
+static void
+nvrm_gsub_reap(struct nvkmd_nvrm_sync *s)
+{
+   uint32_t k = 0;
+   for (uint32_t i = 0; i < s->npend; i++) {
+      const struct nvkmd_nvrm_sync_pend p = s->pend[i];
+      if (nvkmd_nvrm_seq_done(p.slot, p.gen, p.seq)) {
+         if (p.value > s->value)
+            s->value = p.value;
+      } else {
+         s->pend[k++] = p;
+      }
+   }
+   s->npend = k;
+}
+
+static VkResult
+nvrm_gsub_sync_init(struct vk_device *device, struct vk_sync *vs, uint64_t initial_value)
+{
+   struct nvkmd_nvrm_sync *s = to_nvkmd_nvrm_sync(vs);
+   s->sem = NULL;
+   s->index = 0;
+   s->npend = 0;
+   s->value = nvrm_gsub_is_binary(s) ? initial_value != 0 : initial_value;
+   s->pending = s->value;
+   return VK_SUCCESS;
+}
+
+void
+nvkmd_nvrm_sync_add_pending(struct vk_sync *vs, uint64_t value, uint32_t slot, uint32_t gen, uint64_t seq)
+{
+   struct nvkmd_nvrm_sync *s = vk_sync_as_nvkmd_nvrm_sync(vs);
+   if (s == NULL) {
+      fprintf(stderr, "nvrm: G-SUB: a GPU signal on a foreign sync type (%p) - not tracked\n", (void *)vs->type);
+      return;
+   }
+   if (nvrm_gsub_is_binary(s)) {
+      s->value = 0;   // a binary signal replaces the payload: unsignalled until this submission completes
+      s->npend = 0;
+      value = 1;
+   } else {
+      nvrm_gsub_reap(s);
+      if (s->npend == ARRAY_SIZE(s->pend)) {
+         /* full: drop the oldest. Timeline signals only grow, so a newer entry reaches every value the dropped one
+          * covered - a waiter may wait for later work, never for less. */
+         memmove(&s->pend[0], &s->pend[1], sizeof(s->pend[0]) * (s->npend - 1));
+         s->npend--;
+      }
+   }
+   s->pend[s->npend++] = (struct nvkmd_nvrm_sync_pend) { .slot = slot, .gen = gen, .seq = seq, .value = value };
+   if (value > s->pending)
+      s->pending = value;
+}
+
+void
+nvkmd_nvrm_sync_cpu_signal(struct vk_sync *vs, uint64_t value)
+{
+   struct nvkmd_nvrm_sync *s = vk_sync_as_nvkmd_nvrm_sync(vs);
+   if (s == NULL)
+      return;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   if (nvrm_gsub_is_binary(s)) {
+      s->value = 1;
+      s->npend = 0;
+   } else if (value > s->value) {
+      s->value = value;
+   }
+   if (s->value > s->pending)
+      s->pending = s->value;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+}
+
+static VkResult
+nvrm_gsub_sync_signal(struct vk_device *device, struct vk_sync *vs, uint64_t value)
+{
+   nvkmd_nvrm_sync_cpu_signal(vs, value);
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvrm_gsub_sync_get_value(struct vk_device *device, struct vk_sync *vs, uint64_t *value)
+{
+   struct nvkmd_nvrm_sync *s = to_nvkmd_nvrm_sync(vs);
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   nvrm_gsub_reap(s);
+   *value = s->value;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvrm_gsub_sync_reset(struct vk_device *device, struct vk_sync *vs)
+{
+   struct nvkmd_nvrm_sync *s = to_nvkmd_nvrm_sync(vs);
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   s->value = 0;
+   s->pending = 0;
+   s->npend = 0;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvrm_gsub_sync_move(struct vk_device *device, struct vk_sync *dst, struct vk_sync *src)
+{
+   struct nvkmd_nvrm_sync *d = to_nvkmd_nvrm_sync(dst), *s = to_nvkmd_nvrm_sync(src);
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   d->value = s->value;
+   d->pending = s->pending;
+   d->npend = s->npend;
+   memcpy(d->pend, s->pend, sizeof(s->pend[0]) * s->npend);
+   s->value = 0;
+   s->pending = 0;
+   s->npend = 0;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   return VK_SUCCESS;
+}
+
+/* The wait: each pass reaps every sync under the lock and sums the semaphores of the channels it still needs.
+ * A changed error notifier = DEVICE_LOST at once; those semaphores standing still for NVRM_FLUSH_TIMEOUT_MS =
+ * DEVICE_LOST with the old diagnostic; a wait on a CPU signal or an unsubmitted value has only abs_timeout. */
+static VkResult
+nvrm_gsub_wait(uint32_t n, const struct vk_sync_wait *waits, enum vk_sync_wait_flags flags,
+               uint64_t abs_timeout_ns, struct vk_object_base *log_obj)
+{
+   const bool any = flags & VK_SYNC_WAIT_ANY, pending = flags & VK_SYNC_WAIT_PENDING;
+   const int64_t t0 = os_time_get_nano(), budget = nvkmd_nvrm_flush_timeout_ms() * 1000000LL;
+   int64_t tp = t0;
+   uint64_t lastSum = 0;
+   bool seen = false;
+   nvkmd_nvrm_gsub_count(NVRM_GS_WAITS);
+   for (;;) {
+      uint32_t done = 0, nh = 0, hslot[8], hgen[8];
+      uint64_t hseq[8], sum = 0;
+      pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+      for (uint32_t i = 0; i < n; i++) {
+         struct nvkmd_nvrm_sync *s = vk_sync_as_nvkmd_nvrm_sync(waits[i].sync);
+         if (s == NULL) {   // vk_sync_dummy: always signalled
+            done++;
+            continue;
+         }
+         const uint64_t want = nvrm_gsub_is_binary(s) ? 1 : waits[i].wait_value;
+         nvrm_gsub_reap(s);
+         if ((pending ? s->pending : s->value) >= want) {
+            done++;
+            continue;
+         }
+         for (uint32_t p = 0; p < s->npend; p++) {
+            if (s->pend[p].value < want)
+               continue;
+            unsigned h = 0;
+            while (h < nh && (hslot[h] != s->pend[p].slot || hgen[h] != s->pend[p].gen))
+               h++;
+            if (h == nh && nh < ARRAY_SIZE(hslot)) {
+               hslot[nh] = s->pend[p].slot;
+               hgen[nh] = s->pend[p].gen;
+               hseq[nh] = s->pend[p].seq;
+               nh++;
+            }
+         }
+      }
+      for (unsigned h = 0; h < nh; h++) {
+         const struct nvkmd_nvrm_slot *sl = &nvkmd_nvrm_slots[hslot[h]];
+         if (sl->ctx != NULL && sl->gen == hgen[h])
+            sum += __atomic_load_n(sl->sem, __ATOMIC_ACQUIRE);
+      }
+      pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+      if (any ? (done > 0 || n == 0) : done == n) {
+         nvkmd_nvrm_reap_deferred();
+         return VK_SUCCESS;
+      }
+      const int64_t t = os_time_get_nano();
+      if ((uint64_t)t >= abs_timeout_ns) {
+         if (t - t0 >= 200000000LL && nvkmd_nvrm_diag_on()) {   /* r3-diag */
+            char heads[256]; int o = 0;
+            for (unsigned h = 0; h < nh && o < 200; h++)
+               o += snprintf(heads + o, sizeof heads - o, "slot %u seq %llu; ", hslot[h], (unsigned long long)hseq[h]);
+            if (nh == 0) snprintf(heads, sizeof heads, "(no GPU signal pending: CPU/unsubmitted)");
+            nvkmd_nvrm_diag_dump("fence wait timed out", heads);
+         }
+         return VK_TIMEOUT;
+      }
+      for (unsigned h = 0; h < nh; h++) {
+         VkResult r = nvkmd_nvrm_slot_health(hslot[h], hgen[h], log_obj);
+         if (r != VK_SUCCESS)
+            return r;
+      }
+      if (nh == 0 || !seen || sum != lastSum) {
+         seen = nh != 0;
+         lastSum = sum;
+         tp = t;
+      } else if (t - tp > budget) {
+         VkResult r = nvkmd_nvrm_slot_stalled(hslot[0], hgen[0], hseq[0], (long)((t - tp) / 1000000), log_obj);
+         if (r != VK_SUCCESS)
+            return r;
+         tp = t;
+      }
+      nvkmd_nvrm_wait_block(t - t0, nh, hslot, hgen, hseq);   /* b73 */
+   }
+}
+
+static VkResult
+nvrm_gsub_sync_wait_many(struct vk_device *device, uint32_t wait_count, const struct vk_sync_wait *waits,
+                         enum vk_sync_wait_flags wait_flags, uint64_t abs_timeout_ns)
+{
+   return nvrm_gsub_wait(wait_count, waits, wait_flags, abs_timeout_ns, device ? &device->base : NULL);
+}
+
+VkResult
+nvkmd_nvrm_sync_cpu_wait(struct vk_sync *vs, uint64_t wait_value, struct vk_object_base *log_obj)
+{
+   const struct vk_sync_wait w = { .sync = vs, .stage_mask = ~0, .wait_value = wait_value };
+   return nvrm_gsub_wait(1, &w, VK_SYNC_WAIT_COMPLETE, UINT64_MAX, log_obj);
+}
+
+/* 0 = nothing to wait for (reached, or signalled earlier on my own channel); 1 = acquire (*sem_va, *seq);
+ * -1 = no GPU signal on this device reaches it yet: wait on the CPU. */
+int
+nvkmd_nvrm_sync_gpu_target(struct vk_sync *vs, uint64_t wait_value, uint32_t my_slot, struct nvkmd_dev *dev,
+                           uint64_t *sem_va, uint64_t *seq)
+{
+   struct nvkmd_nvrm_sync *s = vk_sync_as_nvkmd_nvrm_sync(vs);
+   if (s == NULL)
+      return 0;
+   int k = -1;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   const uint64_t want = nvrm_gsub_is_binary(s) ? 1 : wait_value;
+   nvrm_gsub_reap(s);
+   if (s->value >= want) {
+      k = 0;
+   } else {
+      const uint32_t my_gen = nvkmd_nvrm_slots[my_slot].gen;
+      for (uint32_t p = 0; p < s->npend; p++) {
+         const struct nvkmd_nvrm_sync_pend *e = &s->pend[p];
+         if (e->value < want)
+            continue;
+         if (e->slot == my_slot && e->gen == my_gen) {   // my own channel ran it first: WFI + release ends every flush
+            k = 0;
+            break;
+         }
+         const struct nvkmd_nvrm_slot *sl = &nvkmd_nvrm_slots[e->slot];
+         if (sl->ctx == NULL || sl->gen != e->gen || sl->dev != dev)
+            continue;
+         if (k < 0) {
+            k = 1;
+            *sem_va = sl->semVA;
+            *seq = e->seq;
+         }
+      }
+   }
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   return k;
+}
+
+struct vk_sync_type
+nvkmd_nvrm_sync_get_type(struct nvkmd_nvrm_pdev *pdev)
+{
+   struct vk_sync_type type = {
+      .size = sizeof(struct nvkmd_nvrm_sync),
+      .features = VK_SYNC_FEATURE_BINARY |
+                  VK_SYNC_FEATURE_GPU_WAIT |
+                  VK_SYNC_FEATURE_CPU_RESET |
+                  VK_SYNC_FEATURE_CPU_SIGNAL |
+                  VK_SYNC_FEATURE_WAIT_PENDING |
+                  VK_SYNC_FEATURE_CPU_WAIT |
+                  VK_SYNC_FEATURE_TIMELINE,
+      .init = nvkmd_nvrm_sync_init,
+      .finish = nvkmd_nvrm_sync_finish,
+      .signal = nvkmd_nvrm_sync_signal,
+      .get_value = nvkmd_nvrm_sync_get_value,
+      .reset = nvkmd_nvrm_sync_reset,
+      .move = nvkmd_nvrm_sync_move,
+      .wait_many = nvkmd_nvrm_sync_wait_many,
+      .import_opaque_fd = nvkmd_nvrm_sync_import_opaque_fd,
+      .export_opaque_fd = nvkmd_nvrm_sync_export_opaque_fd,
+   };
+   if (nvkmd_nvrm_async_on()) {   // G-SUB (b79): .finish stays: vk_sync_type_is_nvkmd_nvrm_sync keys on it
+      type.init = nvrm_gsub_sync_init;
+      type.signal = nvrm_gsub_sync_signal;
+      type.get_value = nvrm_gsub_sync_get_value;
+      type.reset = nvrm_gsub_sync_reset;
+      type.move = nvrm_gsub_sync_move;
+      type.wait_many = nvrm_gsub_sync_wait_many;
+   }
+   return type;
+}
diff -ruN a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_va.c b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_va.c
--- a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_va.c	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_va.c	2026-10-05 07:44:54
@@ -0,0 +1,219 @@
+/*
+ * Copyright © 2024 Collabora Ltd. and Red Hat Inc.
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nvkmd_nvrm.h"
+
+#include "util/bitscan.h"
+#include "util/u_memory.h"
+#include "vk_log.h"
+
+#include <inttypes.h>
+#include <stdio.h>
+
+#include "class/cl50a0.h" // NV50_MEMORY_VIRTUAL
+
+
+VkResult
+nvkmd_nvrm_alloc_va(struct nvkmd_dev *_dev,
+                       struct vk_object_base *log_obj,
+                       enum nvkmd_va_flags flags, uint8_t pte_kind,
+                       uint64_t size_B, uint64_t align_B,
+                       uint64_t fixed_addr, struct nvkmd_va **va_out)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+
+   //fprintf(stderr, "nvkmd_nvrm_alloc_va(%#x)\n", pte_kind);
+
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+
+   struct nvkmd_nvrm_va *va = CALLOC_STRUCT(nvkmd_nvrm_va);
+   if (va == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   const uint32_t min_align_B = _dev->pdev->bind_align_B;
+   size_B = align64(size_B, min_align_B);
+
+   assert(util_is_power_of_two_or_zero64(align_B));
+   align_B = MAX2(align_B, min_align_B);
+
+   assert((fixed_addr == 0) == !(flags & NVKMD_VA_ALLOC_FIXED));
+
+   va->base.ops = &nvkmd_nvrm_va_ops;
+   va->base.dev = &dev->base;
+   va->base.flags = flags;
+   va->base.pte_kind = pte_kind;
+   va->base.size_B = size_B;
+
+	NvHandle hMemoryVirt = 0;
+	NV_MEMORY_ALLOCATION_PARAMS params = {
+		.owner = pdev->hClient,
+		.type = NVOS32_TYPE_IMAGE,
+		.flags =
+			NVOS32_ALLOC_FLAGS_VIRTUAL |
+			((align_B != 0) ? NVOS32_ALLOC_FLAGS_ALIGNMENT_FORCE : 0),
+		.size = size_B,
+		.alignment = align_B,
+		.hVASpace = pdev->hVaSpace,
+	};
+	switch (pte_kind) {
+		case 0x1:
+			params.type = NVOS32_TYPE_DEPTH;
+			params.attr |= DRF_DEF(OS32, _ATTR, _DEPTH, _16);
+			params.attr |= DRF_DEF(OS32, _ATTR, _FORMAT, _PITCH);
+			params.attr |= DRF_DEF(OS32, _ATTR, _Z_TYPE, _FIXED);
+			params.attr |= DRF_DEF(OS32, _ATTR, _ZS_PACKING, _Z16);
+			params.attr |= DRF_DEF(OS32, _ATTR, _COMPR, _NONE);
+			break;
+		case 0x2:
+			params.type = NVOS32_TYPE_STENCIL;
+			params.attr |= DRF_DEF(OS32, _ATTR, _DEPTH, _8);
+			params.attr |= DRF_DEF(OS32, _ATTR, _FORMAT, _PITCH);
+			params.attr |= DRF_DEF(OS32, _ATTR, _Z_TYPE, _FIXED);
+			params.attr |= DRF_DEF(OS32, _ATTR, _ZS_PACKING, _S8);
+			params.attr |= DRF_DEF(OS32, _ATTR, _COMPR, _NONE);
+			break;
+		case 0x3:
+			params.type = NVOS32_TYPE_STENCIL;
+			params.attr |= DRF_DEF(OS32, _ATTR, _DEPTH, _32);
+			params.attr |= DRF_DEF(OS32, _ATTR, _FORMAT, _BLOCK_LINEAR);
+			params.attr |= DRF_DEF(OS32, _ATTR, _Z_TYPE, _FIXED);
+			params.attr |= DRF_DEF(OS32, _ATTR, _ZS_PACKING, _S8Z24);
+			params.attr |= DRF_DEF(OS32, _ATTR, _COMPR, _NONE);
+			break;
+		case 0x4:
+			params.type = NVOS32_TYPE_DEPTH;
+			params.attr |= DRF_DEF(OS32, _ATTR, _DEPTH, _64);
+			params.attr |= DRF_DEF(OS32, _ATTR, _FORMAT, _BLOCK_LINEAR);
+			params.attr |= DRF_DEF(OS32, _ATTR, _Z_TYPE, _FLOAT);
+			params.attr |= DRF_DEF(OS32, _ATTR, _ZS_PACKING, _Z32_X24S8);
+			params.attr |= DRF_DEF(OS32, _ATTR, _COMPR, _NONE);
+			break;
+		case 0x5:
+			params.type = NVOS32_TYPE_STENCIL;
+			params.attr |= DRF_DEF(OS32, _ATTR, _DEPTH, _32);
+			params.attr |= DRF_DEF(OS32, _ATTR, _FORMAT, _BLOCK_LINEAR);
+			params.attr |= DRF_DEF(OS32, _ATTR, _Z_TYPE, _FIXED);
+			params.attr |= DRF_DEF(OS32, _ATTR, _ZS_PACKING, _Z24S8);
+			params.attr |= DRF_DEF(OS32, _ATTR, _COMPR, _NONE);
+			break;
+		case 0x8:   /* nvk-compress: NVIDIA's virtual recipe for kind 0x8 (rtsurf) */
+			params.type = NVOS32_TYPE_IMAGE;
+			params.attr |= DRF_DEF(OS32, _ATTR, _FORMAT, _BLOCK_LINEAR);
+			params.attr |= DRF_DEF(OS32, _ATTR, _COMPR, _REQUIRED);
+			params.format = pte_kind;
+			break;
+		case 0:
+		case 0x6:
+			break;
+		default:
+			fprintf(stderr, "[!] unsupported pte_kind(%#x)\n", pte_kind);
+      /* NVMTL apps-rmreason: the RM status rides back in the VkResult's message, not only on a stderr nobody reads */
+			return vk_errorf(log_obj, VK_ERROR_UNKNOWN, "NV50_MEMORY_VIRTUAL: unsupported pte_kind %#x", pte_kind);
+	}
+
+   NV_STATUS nvRes = nvRmApiAlloc(&rm, pdev->hDevice, &hMemoryVirt, NV50_MEMORY_VIRTUAL, &params);
+   if (nvRes != NV_OK) {
+      fprintf(stderr, "[!] nvRes: %#x\n", nvRes);
+   	nvkmd_va_free(&va->base);
+      /* NVMTL apps-rmreason: the RM status rides back in the VkResult's message, not only on a stderr nobody reads */
+      return vk_errorf(log_obj, VK_ERROR_UNKNOWN, "nvRmApiAlloc(NV50_MEMORY_VIRTUAL, pte_kind %#x) -> NV_STATUS %#x", pte_kind, nvRes);
+   }
+   if (pte_kind != 0 && params.format != pte_kind) {
+      fprintf(stderr, "[!] params.format(%#x) != pte_kind(%#x)\n", params.format, pte_kind);
+      nvkmd_va_free(&va->base);
+      /* NVMTL apps-rmreason: the RM status rides back in the VkResult's message, not only on a stderr nobody reads */
+      return vk_errorf(log_obj, VK_ERROR_UNKNOWN, "NV50_MEMORY_VIRTUAL: RM gave format %#x for pte_kind %#x", params.format, pte_kind);
+   }
+   va->hMemoryVirt = hMemoryVirt;
+   va->base.addr = params.offset;
+
+   *va_out = &va->base;
+
+   return VK_SUCCESS;
+}
+
+static void
+nvkmd_nvrm_va_free(struct nvkmd_va *_va)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_va->dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   struct nvkmd_nvrm_va *va = nvkmd_nvrm_va(_va);
+
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+
+   nvRmApiFree(&rm, va->hMemoryVirt);
+
+   FREE(va);
+}
+
+static VkResult
+nvkmd_nvrm_va_bind_mem(struct nvkmd_va *_va,
+                          struct vk_object_base *log_obj,
+                          uint64_t va_offset_B,
+                          struct nvkmd_mem *_mem,
+                          uint64_t mem_offset_B,
+                          uint64_t range_B)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_va->dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   struct nvkmd_nvrm_va *va = nvkmd_nvrm_va(_va);
+   struct nvkmd_nvrm_mem *mem = nvkmd_nvrm_mem(_mem);
+
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+
+   NvU32 gpuMapFlags = 0;
+   gpuMapFlags |= DRF_DEF(OS46, _FLAGS, _PAGE_KIND, _VIRTUAL);
+   if (mem->isSystemMem) {
+      gpuMapFlags |= DRF_DEF(OS46, _FLAGS, _CACHE_SNOOP, _ENABLE);
+   } else {
+      gpuMapFlags |= DRF_DEF(OS46, _FLAGS, _CACHE_SNOOP, _DISABLE);
+   }
+   NvU64 dmaOffset = va_offset_B;
+   NV_STATUS nvRes = nvRmApiMapMemoryDma(&rm, pdev->hDevice, va->hMemoryVirt, mem->hMemoryPhys, mem_offset_B, range_B, gpuMapFlags, &dmaOffset);
+   if (nvRes != NV_OK) {
+      fprintf(stderr, "[!] nvRes: %#x\n", nvRes);
+      /* NVMTL apps-rmreason: the RM status rides back in the VkResult's message, not only on a stderr nobody reads */
+      return vk_errorf(log_obj, VK_ERROR_UNKNOWN, "nvRmApiMapMemoryDma(%llu B at +%llu) -> NV_STATUS %#x",
+                       (unsigned long long)range_B, (unsigned long long)mem_offset_B, nvRes);
+   }
+
+   va->hMemoryPhys = mem->hMemoryPhys;
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_nvrm_va_unbind(struct nvkmd_va *_va,
+                        struct vk_object_base *log_obj,
+                        uint64_t va_offset_B,
+                        uint64_t range_B)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_va->dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   struct nvkmd_nvrm_va *va = nvkmd_nvrm_va(_va);
+
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+
+   /* res3: RM unmaps by the mapping's ABSOLUTE GPU VA (WAS the relative va_offset_B, which named no mapping). */
+   NV_STATUS nvRes = nvRmApiUnmapMemoryDma(&rm, pdev->hDevice, va->hMemoryVirt, va->hMemoryPhys, 0, va->base.addr + va_offset_B);
+   if (nvRes != NV_OK)
+      return vk_errorf(log_obj, VK_ERROR_UNKNOWN, "nvRmApiUnmapMemoryDma(VA %#llx) -> NV_STATUS %#x",
+                       (unsigned long long)(va->base.addr + va_offset_B), nvRes);
+
+   va->hMemoryPhys = 0;
+
+   return VK_SUCCESS;
+}
+
+const struct nvkmd_va_ops nvkmd_nvrm_va_ops = {
+   .free = nvkmd_nvrm_va_free,
+   .bind_mem = nvkmd_nvrm_va_bind_mem,
+   .unbind = nvkmd_nvrm_va_unbind,
+};
diff -ruN a/src/nouveau/vulkan/nvkmd/nvrm/nvrm_surfshare_abi.h b/src/nouveau/vulkan/nvkmd/nvrm/nvrm_surfshare_abi.h
--- a/src/nouveau/vulkan/nvkmd/nvrm/nvrm_surfshare_abi.h	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvrm_surfshare_abi.h	2026-10-05 07:44:54
@@ -0,0 +1,60 @@
+// nvrm_surfshare_abi.h — item 7 (b77): an IOSurface's VRAM is the ACCELERATOR FAMILY's device-cache resource, as on Apple.
+// Apple (IOAcceleratorFamily2 485, traced): Metal wraps an IOSurface through IOAccelResourceCreate(kind 0x82, surface id)
+// -> IOAccelSharedUserClient2::new_resource -> IOSurfaceRoot::lookupSurface(id, task) -> newResourceWithIOSurface ->
+// IOGraphicsAccelerator2::deviceCacheForIOSurface: ONE device cache + resource + VRAM per surface, every process on it.
+// Ours: NVK asks NVRM.kext (escape 0xE2 SURF_VRAM) for "the VRAM of this surface"; NVAccel answers with Apple's own calls
+// (lookupSurface(id, caller task) -> deviceCacheForIOSurface(surface, plane) -> the resource's NVVidMemory, wired by
+// IOAccelVidMemory::wire) and NVRM grants that NVKMS memory to the caller's RM client alone. NVK dups it: the VkImage is
+// LINEAR at the surface's bytesPerRow, so every process agrees on the layout by construction.
+// b74s-b76's hand-rolled broker (escapes 0xE0/0xE1, NVAccel's own device caches, the IOSurface record) is GONE.
+// NVRM's Info.plist never gains a library (b74s: IOSurface there moved NVRM after NVAccel and the desktop never came up).
+// Numbers sit outside every RM escape (0x27..0x5F, 200..218). Copied VERBATIM into NVK (nvkmd/nvrm/); versions checked.
+#pragma once
+#define NVRM_ESC_SURF_VRAM     0xE2u   // caller: give my RM client the VRAM of this surface's family resource
+#define NVRM_ESC_SURF_DIRTY    0xE3u   // caller: my GPU work into this surface is COMPLETE — its VRAM is the newest copy
+                                      // (b78: Apple's dirtyLevel -> IOSurfaceDeviceCache::setCurrent; a CPU lock then pages off)
+#define NVRM_SURFSHARE_VERSION 2u
+// status: an RM NV_STATUS, or one of these (bit 31 set so they cannot collide with RM's)
+#define NVRM_SS_BAD_VERSION   0x80000001u
+#define NVRM_SS_OFF           0x80000002u   // no NVAccel / no NVKMS device — the caller keeps its own backing + copies
+#define NVRM_SS_NO_SURFACE    0x80000003u   // the calling task does not hold this surface
+#define NVRM_SS_NO_CACHE      0x80000004u   // the family made no device cache / resource for it
+#define NVRM_SS_NO_VRAM       0x80000005u   // the resource has no VRAM (sys-mem-only surface) or VRAM was refused
+#define NVRM_SS_TOO_SMALL     0x80000006u   // the resource's VRAM is smaller than the caller's image
+struct NVRMSurfShareEsc {
+    unsigned int version;          // [in]  NVRM_SURFSHARE_VERSION
+    unsigned int surfaceID;        // [in]  IOSurfaceGetID
+    unsigned int plane;            // [in]
+    unsigned int hClient;          // [in]  the caller's RM client (gets DUP on the VRAM)
+    unsigned int hSrcClient;       // [out] the RM client that owns the VRAM (NVKMS's)
+    unsigned int hSrcMemory;       // [out] its memory handle
+    unsigned int status;           // [out] 0 = done
+    unsigned int pad;
+    unsigned long long size;       // [in] bytes the caller needs · [out] bytes the VRAM holds
+};
+
+#ifdef NVRM_SS_KERNEL_ABI   /* defined by the two kexts before including this; never by NVK */
+#define NVACCEL_SS_FN   "nvSurfVram"       // NVAccel: p1 = NVRMSurfShareEsc*, p2 = task_t caller, p3 = (uintptr_t)escape
+#define NVRM_SS_FN_PAGEOFF "nvSurfPageoff" // NVRM: p1 = NVRMSurfPageoff* — VRAM -> the surface's pages on the copy engine
+#define NVRM_SS_FN_RM   "nvSurfShareRm"    // NVRM:    p1 = NVRMSurfShareRm*
+#define NVRM_SS_RM_VERSION 2u
+enum { NVRM_SS_RM_SHARE_KAPI = 5 };        // resolve (kapiDevice, kapiMemory) -> (hClient, hMemory); grant DUP to `target`
+struct NVRMSurfShareRm {
+    unsigned int version, op;
+    void *kapiDevice, *kapiMemory;        // [in]  NvKmsKapiDevice*, NvKmsKapiMemory* (opaque outside NVRM)
+    unsigned int target;                  // [in]  the client that may DUP
+    unsigned int hClient, hObject;        // [out] the owner client and memory handle
+    unsigned int status;                  // [out] NV_STATUS
+};
+// b78: Apple's page-off (AMDRadeonX4000_AMDAccelResource::pageoff -> AMDAtomicBlitManager::doMemcpy, a GPU DMA of the VRAM
+// copy into the surface's pages) on NVIDIA's copy engine: RM's own CeUtils (the MemoryManager's, as its scrubber uses).
+struct NVRMSurfPageoff {
+    unsigned int version;                 // [in]  NVRM_SS_RM_VERSION
+    unsigned int status;                  // [out] NV_STATUS
+    void *kapiDevice, *kapiMemory;        // [in]  the VRAM (NVKMS) — resolved by NVRM
+    const unsigned long long *pages;      // [in]  physical address of each 4 KB page of the surface, in order
+    unsigned long long pageCount;         // [in]
+    unsigned long long length;            // [in]  bytes to copy from VRAM offset 0
+    unsigned long long usec;              // [out] copy time
+};
+#endif
diff -ruN a/src/nouveau/vulkan/nvkmd/nvrm/nvrm_xnu.c b/src/nouveau/vulkan/nvkmd/nvrm/nvrm_xnu.c
--- a/src/nouveau/vulkan/nvkmd/nvrm/nvrm_xnu.c	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvrm_xnu.c	2026-10-12 14:51:16
@@ -0,0 +1,264 @@
+#include "../../nvmtl_cfg.h"
+#include "nvrm_xnu.h"
+#include <IOKit/IOKitLib.h>
+#include <mach/mach.h>
+#include <sys/mman.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <string.h>
+#include <stdio.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include "nvtypes.h"
+#include "nvos.h"
+#include "nv-ioctl.h"
+#include "nv_escape.h"
+#include "nv-unix-nvos-params-wrappers.h"
+static int gTrace = -1;   // NVRM_XNU_TRACE=1: one line per escape with the RM's own status — the to-do list when NVK fails
+
+// 4096 was the wall the compositor actually hit. MEASURED: IOAccelNVRMBridge pinned at
+// exactly 4096 with 2,028 live Metal buffers, while WindowServer held only 38 unix fds -- the fd is
+// closed immediately (nvRmApiMapMemory does mmap then NVRM_CLOSE), but the IOKit CONNECTION stays
+// parked because its mapping is still live, and each live mapping is one connection. So this number
+// is not "how many files a process has open", it is "how many GPU mappings a compositor may hold".
+// A desktop wants thousands. Raising 1024 -> 16384 on the mapping table moved the wall from 1029 to
+// exactly this one, which is how we know this is the next one and not a leak.
+#define NVRM_XNU_MAX_FD 32768
+// the mapping table was 1024 and that is a CEILING THE COMPOSITOR REACHES. Measured
+// on a live desktop: IOAccelNVRMBridge count pinned at 1029 for 14 minutes straight while
+// newBufferWithLength failed 816,280 times with vk: vkMapMemory -> -2. Every live NVK mapping
+// pins one entry here, and a real desktop wants ~1000 of them just to sit still.
+// THREE TABLES IN THIS FILE HAD THE SAME SILENT-OVERFLOW SHAPE:
+// for (i...) if (!slot[i]) { slot[i] = x; break; }        // and NO else
+// gMaps (here), gPendingClose, and the kext's own gNvClients. When full they record nothing,
+// report nothing, and the caller carries on believing it was stored -- so a mapping that can
+// never be unmapped, a connection that can never be closed, and a table that never recovers.
+// Every overflow below now SAYS SO, once, with a count.
+#define NVRM_XNU_MAX_MAP 16384
+enum { SEL_GO = 0, SEL_ESC = 1, SEL_GETFD = 2, SEL_BINDFD = 3 };
+static io_connect_t gConn[NVRM_XNU_MAX_FD];
+static struct { void *addr; size_t len; io_connect_t conn; } gMaps[NVRM_XNU_MAX_MAP];
+static pthread_mutex_t gLock = PTHREAD_MUTEX_INITIALIZER;
+// THE CONNECTION POOL — .
+// NVK does open(node) → RM_MAP_MEMORY(fd) → mmap(fd) → close(fd) PER MAPPING, because on Linux an
+// fd is nearly free. Under IOKit each one of those is a full user client: NVAccel::newUserClient →
+// IOServiceOpen → uc->attach(accelerator) → uc->start, and on close a terminate. BOTH ends take
+// the PROVIDER'S ARBITRATION LOCK.
+// MEASURED on a live desktop: 6,532 newUserClient calls in one boot, arriving dozens
+// per MILLISECOND, and WindowServer's main thread parked in exactly that call until the userspace
+// watchdog killed it 40 s later. Symbolicated from the .spin, all 12 samples identical:
+// IOService::newUserClient (IOService.cpp:8072)
+// NVAccel::newUserClient + 239
+// IOService::attach (IOService.cpp:922)
+// thread_block_reason → thread_invoke → machine_switch_context
+// The desktop came up every time and died after ~2 minutes of real compositing. This is what the
+// 64-slot client table was hiding: before, allocation failed so fast we never built enough clients
+// to contend for the lock.
+// A connection is only pooled when it has NO LIVE MAPPINGS at close — i.e. it is already the case
+// today that we would have called IOServiceClose on it and thrown away all its RM state. Reusing it
+// instead is strictly less work and cannot resurrect a mapping that was never there.
+// BOUNDED at NVRM_XNU_POOL. If NVK ever leaves RM objects on a connection it closes, they now
+// survive into the reuse instead of being freed by rm_cleanup_file_private — so this is capped, and
+// the counters below are what to read if anything looks like it is accumulating.
+#define NVRM_XNU_POOL 128
+static io_connect_t gPoolConn[NVRM_XNU_POOL];
+static uint32_t     gPoolType[NVRM_XNU_POOL];
+static int          gPoolN;
+static uint32_t     gConnType[NVRM_XNU_MAX_FD];
+static unsigned long gPoolHit, gPoolMiss, gPoolPut, gPoolDrop;
+
+// take a pooled connection of this type, or 0. gLock MUST be held.
+static io_connect_t pool_take(uint32_t type)
+{
+    for (int i = gPoolN - 1; i >= 0; i--)
+        if (gPoolType[i] == type) {
+            io_connect_t c = gPoolConn[i];
+            gPoolConn[i] = gPoolConn[gPoolN - 1];
+            gPoolType[i] = gPoolType[gPoolN - 1];
+            gPoolN--;
+            return c;
+        }
+    return 0;
+}
+// give one back; returns 0 if the pool is full and the caller must really close it. gLock MUST be held.
+static int pool_put(io_connect_t conn, uint32_t type)
+{
+    if (gPoolN >= NVRM_XNU_POOL) return 0;
+    gPoolConn[gPoolN] = conn; gPoolType[gPoolN] = type; gPoolN++;
+    return 1;
+}
+
+
+int nvrm_xnu_open(const char *node)
+{
+    uint32_t type = (node && strstr(node, "ctl")) ? 0 : 1;
+    // GO THROUGH THE ACCELERATOR, NOT AROUND IT — .
+    // Opening the RM kext directly is what got us refused inside the compositor:
+    // Sandbox: WindowServer deny(1) iokit-open-user-client NVRMUserClient
+    // com.apple.WindowServer.sb ends in prefix rules — (iokit-registry-entry-class-prefix
+    // "IOAccel") among them — so a compositor may open any user client belonging to the graphics
+    // accelerator. It refused ours because we were reaching the hardware behind the accelerator's
+    // back. NVAccel now vends the connection itself (type 0x4E56000n, n = the RM node): the client
+    // is created by NVRM, attached to NVAccel and torn down with it, so the accelerator really is
+    // the thing that owns GPU access rather than a bystander.
+    // The direct NVRM path stays as the fallback: nvrmctl, the bring-up tools and every
+    // unsandboxed harness have used it all along, and they must keep working unchanged.
+    // REUSE BEFORE YOU CREATE. See the pool comment above: every miss here is an IOKit user client
+    // attach/terminate pair on the accelerator's arbitration lock, and that is what stalled the
+    // compositor's main thread into the watchdog.
+    pthread_mutex_lock(&gLock);
+    io_connect_t reuse = pool_take(type);
+    if (reuse) gPoolHit++; else gPoolMiss++;
+    pthread_mutex_unlock(&gLock);
+    if (reuse) {
+        int rfd = open("/dev/null", O_RDONLY | O_CLOEXEC);
+        if (rfd < 0 || rfd >= NVRM_XNU_MAX_FD) {
+            if (rfd >= 0) close(rfd);
+            pthread_mutex_lock(&gLock);
+            if (!pool_put(reuse, type)) { pthread_mutex_unlock(&gLock); IOServiceClose(reuse); pthread_mutex_lock(&gLock); }
+            pthread_mutex_unlock(&gLock);
+            errno = EMFILE; return -1;
+        }
+        uint64_t rin = (uint64_t)rfd;
+        IOConnectCallScalarMethod(reuse, SEL_BINDFD, &rin, 1, NULL, NULL);
+        pthread_mutex_lock(&gLock); gConn[rfd] = reuse; gConnType[rfd] = type; pthread_mutex_unlock(&gLock);
+        return rfd;
+    }
+    io_service_t svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("NVAccel"));
+    uint32_t open_type = 0x4E560000u | type;
+    if (!svc) {
+        svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("NVRM"));
+        open_type = type;
+    }
+    if (!svc) { fprintf(stderr, "nvrm_xnu: no NVAccel and no NVRM service\n"); errno = ENODEV; return -1; }
+    io_connect_t conn = 0;
+    kern_return_t kr = IOServiceOpen(svc, mach_task_self(), open_type, &conn);
+    if (kr != KERN_SUCCESS && open_type != type) {
+        // the accelerator is there but would not vend one — fall back rather than lose the GPU
+        fprintf(stderr, "nvrm_xnu: IOServiceOpen(NVAccel, 0x%08x) 0x%08x — falling back to NVRM\n", open_type, kr);
+        IOObjectRelease(svc);
+        svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("NVRM"));
+        if (svc) kr = IOServiceOpen(svc, mach_task_self(), type, &conn);
+    }
+    if (svc) IOObjectRelease(svc);
+    if (kr != KERN_SUCCESS) { fprintf(stderr, "nvrm_xnu: IOServiceOpen(type %u) 0x%08x\n", type, kr); errno = EIO; return -1; }
+    int fd = open("/dev/null", O_RDONLY | O_CLOEXEC);
+    if (fd < 0 || fd >= NVRM_XNU_MAX_FD) { IOServiceClose(conn); if (fd >= 0) close(fd); errno = EMFILE; return -1; }
+    uint64_t in = (uint64_t)fd;
+    IOConnectCallScalarMethod(conn, SEL_BINDFD, &in, 1, NULL, NULL);
+    pthread_mutex_lock(&gLock); gConn[fd] = conn; gConnType[fd] = type; pthread_mutex_unlock(&gLock);
+    return fd;
+}
+static io_connect_t conn_of(int fd) { return (fd >= 0 && fd < NVRM_XNU_MAX_FD) ? gConn[fd] : 0; }
+/* b73: sleep until this connection's RM event count moves past `seen` (kext NVRMUserClient selector 6), at most
+ * timeout_us (0 = just read the count). Returns the count now, or -1 when the kext has no selector 6 (pre-b73). */
+int64_t nvrm_xnu_wait_event(int fd, uint32_t seen, uint32_t timeout_us)
+{
+    io_connect_t conn = conn_of(fd); if (!conn) return -1;
+    uint64_t in[2] = { seen, timeout_us }, out = 0; uint32_t n = 1;
+    kern_return_t kr = IOConnectCallScalarMethod(conn, 6, in, 2, &out, &n);
+    return kr == KERN_SUCCESS ? (int64_t)(uint32_t)out : -1;
+}
+int nvrm_xnu_ioctl(int fd, uint32_t cmd, void *data, uint32_t size)
+{
+    io_connect_t conn = conn_of(fd); if (!conn) return EBADF;
+    uint64_t in = cmd; size_t out = size;
+    kern_return_t kr = IOConnectCallMethod(conn, SEL_ESC, &in, 1, data, size, NULL, NULL, data, &out);
+    if (kr != KERN_SUCCESS) { fprintf(stderr, "nvrm_xnu: esc 0x%02x (%u bytes) -> 0x%08x\n", cmd, size, kr); return EINVAL; }
+    if (gTrace < 0) gTrace = nvmtl_cfg_getenv("NVRM_XNU_TRACE") ? 1 : 0;
+    if (gTrace) {
+        switch (cmd) {
+        case NV_ESC_RM_ALLOC: { NVOS21_PARAMETERS *p = data; fprintf(stderr, "nvrm: ALLOC class 0x%04x parent 0x%08x -> 0x%08x status 0x%x\n", p->hClass, p->hObjectParent, p->hObjectNew, p->status); break; }
+        case NV_ESC_RM_FREE: { NVOS00_PARAMETERS *p = data; fprintf(stderr, "nvrm: FREE 0x%08x status 0x%x\n", p->hObjectOld, p->status); break; }
+        case NV_ESC_RM_CONTROL: { NVOS54_PARAMETERS *p = data; fprintf(stderr, "nvrm: CONTROL 0x%08x cmd 0x%08x status 0x%x\n", p->hObject, p->cmd, p->status); break; }
+        case NV_ESC_RM_MAP_MEMORY: { nv_ioctl_nvos33_parameters_with_fd *p = data; fprintf(stderr, "nvrm: MAP_MEMORY 0x%08x len 0x%llx fd %d status 0x%x\n", p->params.hMemory, (unsigned long long)p->params.length, p->fd, p->params.status); break; }
+        case NV_ESC_RM_UNMAP_MEMORY: { NVOS34_PARAMETERS *p = data; fprintf(stderr, "nvrm: UNMAP_MEMORY 0x%08x status 0x%x\n", p->hMemory, p->status); break; }
+        case NV_ESC_RM_MAP_MEMORY_DMA: { NVOS46_PARAMETERS *p = data; fprintf(stderr, "nvrm: MAP_MEMORY_DMA mem 0x%08x dma 0x%08x len 0x%llx -> 0x%llx status 0x%x\n", p->hMemory, p->hDma, (unsigned long long)p->length, (unsigned long long)p->dmaOffset, p->status); break; }
+        case NV_ESC_RM_UNMAP_MEMORY_DMA: { NVOS47_PARAMETERS *p = data; fprintf(stderr, "nvrm: UNMAP_MEMORY_DMA mem 0x%08x status 0x%x\n", p->hMemory, p->status); break; }
+        case NV_ESC_ALLOC_OS_EVENT: { nv_ioctl_alloc_os_event_t *p = data; fprintf(stderr, "nvrm: ALLOC_OS_EVENT fd %u status 0x%x\n", p->fd, p->Status); break; }
+        case NV_ESC_FREE_OS_EVENT: { nv_ioctl_free_os_event_t *p = data; fprintf(stderr, "nvrm: FREE_OS_EVENT fd %u status 0x%x\n", p->fd, p->Status); break; }
+        case NV_ESC_REGISTER_FD: { nv_ioctl_register_fd_t *p = data; fprintf(stderr, "nvrm: REGISTER_FD ctl_fd %d on fd %d\n", p->ctl_fd, fd); break; }
+        default: fprintf(stderr, "nvrm: esc 0x%02x (%u bytes)\n", cmd, size); break;
+        }
+    }
+    return 0;
+}
+void *nvrm_xnu_mmap(int fd, size_t length) { return nvrm_xnu_mmap_wc(fd, length, 0); }
+// batch 56 (patch_nvk_wc.py): the cache mode of a user mapping is the CALLER's. mapClientMemory64 replaces the kext's
+// cache bits with ours (kIOMapUserOptionsMask 0xfff contains kIOMapCacheMask 0xf00), so kIOMapAnywhere alone made
+// every BAR1 mapping uncached: CPU memcpy write 6 MB/s. nvRmApiMapMemory decides writeCombine from RM's answer.
+void *nvrm_xnu_mmap_wc(int fd, size_t length, int writeCombine)
+{
+    io_connect_t conn = conn_of(fd); if (!conn) { errno = EBADF; return MAP_FAILED; }
+    mach_vm_address_t addr = 0; mach_vm_size_t len = 0;
+    kern_return_t kr = IOConnectMapMemory64(conn, 0, mach_task_self(), &addr, &len,
+                                            kIOMapAnywhere | (writeCombine ? kIOMapWriteCombineCache : 0));
+    if (kr != KERN_SUCCESS) { fprintf(stderr, "nvrm_xnu: IOConnectMapMemory64 -> 0x%08x\n", kr); errno = EIO; return MAP_FAILED; }
+    pthread_mutex_lock(&gLock);
+    int stored = 0;
+    for (int i = 0; i < NVRM_XNU_MAX_MAP; i++) if (!gMaps[i].addr) { gMaps[i].addr = (void *)(uintptr_t)addr; gMaps[i].len = (size_t)len; gMaps[i].conn = conn; stored = 1; break; }
+    pthread_mutex_unlock(&gLock);
+    if (!stored) {
+        // an untracked mapping can never be unmapped and its connection can never be closed. Say it.
+        static int told; if (!told) { told = 1;
+            fprintf(stderr, "nvrm_xnu: MAPPING TABLE FULL (%d) -- this mapping is untracked and its "
+                            "connection can never be closed\n", NVRM_XNU_MAX_MAP); }
+    }
+    return (void *)(uintptr_t)addr;
+}
+// NVK does open(node) → RM_MAP_MEMORY(fd) → mmap(fd) → close(fd) and keeps using the mapping: on Linux a mapping
+// outlives its fd. Here a mapping belongs to the IOKit CONNECTION, and IOServiceClose unmaps it (first triangle run
+// died in memset on a page that had just been mapped). So close only releases the fd number; the connection is
+// closed when its last mapping is unmapped.
+static io_connect_t gPendingClose[NVRM_XNU_MAX_MAP];
+static int maps_on(io_connect_t conn) { int n = 0; for (int i = 0; i < NVRM_XNU_MAX_MAP; i++) if (gMaps[i].addr && gMaps[i].conn == conn) n++; return n; }
+static int pending_close(io_connect_t conn) { for (int i = 0; i < NVRM_XNU_MAX_MAP; i++) if (gPendingClose[i] == conn) return i; return -1; }
+int nvrm_xnu_munmap(void *addr, size_t length)
+{
+    io_connect_t conn = 0;
+    pthread_mutex_lock(&gLock);
+    for (int i = 0; i < NVRM_XNU_MAX_MAP; i++) if (gMaps[i].addr == addr) { conn = gMaps[i].conn; gMaps[i].addr = NULL; break; }
+    int closeNow = 0, pi = -1;
+    if (conn && maps_on(conn) == 0 && (pi = pending_close(conn)) >= 0) { gPendingClose[pi] = 0; closeNow = 1; }
+    pthread_mutex_unlock(&gLock);
+    if (!conn) { errno = EINVAL; return -1; }
+    IOConnectUnmapMemory64(conn, 0, mach_task_self(), (mach_vm_address_t)(uintptr_t)addr);
+    if (closeNow) IOServiceClose(conn);
+    return 0;
+}
+int nvrm_xnu_close(int fd)
+{
+    io_connect_t conn = conn_of(fd);
+    if (conn) {
+        pthread_mutex_lock(&gLock);
+        gConn[fd] = 0;
+        int live = maps_on(conn);
+        if (live) {
+            int parked = 0;
+            for (int i = 0; i < NVRM_XNU_MAX_MAP; i++) if (!gPendingClose[i]) { gPendingClose[i] = conn; parked = 1; break; }
+            if (!parked) {
+                static int told; if (!told) { told = 1;
+                    fprintf(stderr, "nvrm_xnu: PENDING-CLOSE TABLE FULL (%d) -- this connection will "
+                                    "never be closed\n", NVRM_XNU_MAX_MAP); }
+            }
+        }
+        pthread_mutex_unlock(&gLock);
+        if (live) {
+            uint64_t in = (uint64_t)(int64_t)-2;
+            IOConnectCallScalarMethod(conn, SEL_BINDFD, &in, 1, NULL, NULL);
+        }
+        if (!live) {
+            // Detach before publishing to the pool: another thread can take a
+            // pooled connection immediately, and the fd will soon be reused.
+            uint64_t unbound = (uint64_t)(int64_t)-2;
+            kern_return_t kr = IOConnectCallScalarMethod(conn, SEL_BINDFD, &unbound, 1, NULL, NULL);
+            pthread_mutex_lock(&gLock);
+            int pooled = kr == KERN_SUCCESS && pool_put(conn, gConnType[fd]);
+            if (pooled) gPoolPut++; else gPoolDrop++;
+            pthread_mutex_unlock(&gLock);
+            if (!pooled) IOServiceClose(conn);
+        }
+    }
+    return close(fd);
+}
diff -ruN a/src/nouveau/vulkan/nvkmd/nvrm/nvrm_xnu.h b/src/nouveau/vulkan/nvkmd/nvrm/nvrm_xnu.h
--- a/src/nouveau/vulkan/nvkmd/nvrm/nvrm_xnu.h	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvrm_xnu.h	2026-10-05 07:44:54
@@ -0,0 +1,21 @@
+/* nvrm_xnu — the /dev/nvidiactl + /dev/nvidia0 contract on macOS, over the NVRM kext's IOUserClient.
+ * open  → IOServiceOpen(type 0 = ctl, 1 = device) + a real fd (dup of /dev/null) bound to the connection (selector 3)
+ * so the fd numbers NVK writes into escape params resolve inside the kext with no translation.
+ * ioctl → selector 1: rm_ioctl(cmd, params) with in/out copy.   mmap(fd, 0) → IOConnectMapMemory64 on that connection.
+ */
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+int   nvrm_xnu_open(const char *node);
+int   nvrm_xnu_ioctl(int fd, uint32_t cmd, void *data, uint32_t size);   /* 0 or an errno */
+void *nvrm_xnu_mmap(int fd, size_t length);                              /* MAP_FAILED on error */
+void *nvrm_xnu_mmap_wc(int fd, size_t length, int writeCombine);         /* patch_nvk_wc.py: kIOMapWriteCombineCache */
+int   nvrm_xnu_munmap(void *addr, size_t length);
+int   nvrm_xnu_close(int fd);
+int64_t nvrm_xnu_wait_event(int fd, uint32_t seen, uint32_t timeout_us);   /* b73: kext selector 6; -1 = no such selector */
+#ifdef __cplusplus
+}
+#endif
diff -ruN a/src/nouveau/vulkan/nvmtl_cfg.h b/src/nouveau/vulkan/nvmtl_cfg.h
--- a/src/nouveau/vulkan/nvmtl_cfg.h	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/nvmtl_cfg.h	2026-10-11 22:45:53
@@ -0,0 +1,27 @@
+/* r3-cfgall: every NVK/NVRM/NVMTL switch also reads /Library/GPUBundles/nvmtl/nvrm610.conf
+ * ("NAME=value" lines) when the env var is unset, so WindowServer (no shell env) can bisect the r3 hang. */
+#ifndef NVMTL_CFG_H
+#define NVMTL_CFG_H
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+static inline const char *nvmtl_cfg_getenv(const char *name)
+{
+   const char *e = getenv(name);
+   if (e) return e;
+   static char conf[8192]; static int loaded;
+   if (!loaded) {
+      loaded = 1;
+      FILE *f = fopen("/Library/GPUBundles/nvmtl/nvrm610.conf", "r");
+      if (f) { size_t n = fread(conf, 1, sizeof conf - 1, f); conf[n] = 0; fclose(f); }
+   }
+   char key[96]; snprintf(key, sizeof key, "%s=", name);
+   const char *h = strstr(conf, key);
+   if (!h || (h != conf && h[-1] != '\n')) return NULL;
+   static char val[8][64]; static unsigned vi; char *v = val[vi++ % 8]; size_t i = 0; h += strlen(key);
+   while (h[i] && h[i] != '\n' && i < 63) { v[i] = h[i]; i++; }
+   v[i] = 0;
+   fprintf(stderr, "nvk-cfg: %s=%s (nvrm610.conf)\n", name, v);
+   return v;
+}
+#endif
diff -ruN a/src/nouveau/vulkan/nvmtl_nvk_sass.c b/src/nouveau/vulkan/nvmtl_nvk_sass.c
--- a/src/nouveau/vulkan/nvmtl_nvk_sass.c	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/nvmtl_nvk_sass.c	2026-10-15 21:15:16
@@ -0,0 +1,487 @@
+#include <stdatomic.h>
+/*
+ * nvmtl_nvk_sass.c — dispatch RAW sm_120 SASS on NVK's OWN channel, in NVK's OWN VA space.
+ * SPDX-License-Identifier: MIT
+ *
+ * WHY THIS EXISTS.  proved a Metal kernel's cubin runs on the 5060 — but through
+ * `nvdisp`, which allocates its own VA space and its own channel. A real Metal dispatch has to
+ * run against the MTLBuffer's memory, which lives in NVK's VA space, on the channel NVK owns.
+ * Two channels in two VA spaces is exactly why that was an oracle and not a pipeline. This hook
+ * closes that seam: NVK already has the VA space, the channel, an upload heap and the QMD
+ * builder, so the only thing missing was a door that takes machine code NAK did not produce.
+ *
+ * It follows the shape NVK and this driver already use for each other: an exported
+ * `nvmtl_nvk_*_v1` symbol the Metal driver dlsyms (see nvmtl_nvk_stage_import,
+ * nvmtl_nvk_surface_dirty, nvmtl_nvk_sparse_bind_v1, nvmtl_nvk_sample_depth_*). Nothing in NVK
+ * calls it, so a build without the Metal driver is unchanged.
+ *
+ * THE CBUF0 IS NVIDIA'S, NOT NVK'S. `nvk_root_descriptor_table` is NAK's own convention: it has
+ * nothing at 0x358, 0x37c or 0x380 and no global memory descriptor at all. An nvcc/ptxas cubin
+ * reads all four. So this builds a SECOND, nvcc-shaped constant buffer and binds it to the QMD's
+ * cbuf0 slot — never the root table. Offsets below were measured by disassembling cubins
+ * (reference_nvcc_cbuf0_layout_sm120), and cross-checked from the other side on: a cubin
+ * our own compiler produced has .nv.constant0 = 904 bytes = 0x380 + 8 for one 8-byte parameter,
+ * and 912 = 0x380 + 16 for two.
+ *
+ * THE DESCRIPTOR AT 0x358 IS NOT OPTIONAL AND IT MUST NOT BE ZERO. Every nvcc global access on
+ * sm_90+ assembles to `STG.E desc[UR4][R2.64]`, with UR4:UR5 loaded by
+ * `LDCU.64 UR4, c[0x0][0x358]`. With the pair zero the SM raises "Invalid Address Space" before
+ * touching memory — that cost a GPU run (18:14:35, Xid 13, ESR 0x505730=0x10).
+ * 1 << 60 is the smallest valid descriptor with no cache policy attached.
+ */
+
+#include "nvk_buffer.h"
+#include "nvk_cmd_buffer.h"
+#include "nvk_device.h"
+#include "nvk_physical_device.h"
+#include "nvk_shader.h"
+
+#include "cla0c0.h"
+#include "clc5c0.h"    /* TURING_COMPUTE_A */
+#include "clc6c0.h"
+#include "clcbc0.h"    /* HOPPER_COMPUTE_A */
+#include "nv_push_cla0c0.h"
+#include "nv_push_clc6c0.h"
+
+#include <string.h>
+
+/* the nvcc constant-bank-0 layout — MEASURED, every offset */
+#define NVMTL_CB0_SHARED_WINDOW 0x2f0
+#define NVMTL_CB0_LOCAL_WINDOW  0x2f8
+#define NVMTL_CB0_DESCRIPTOR    0x358
+#define NVMTL_CB0_BLOCKDIM      0x360
+#define NVMTL_CB0_GRIDDIM       0x370
+#define NVMTL_CB0_STACK         0x37c
+#define NVMTL_CB0_PARAMS        0x380
+#define NVMTL_CB0_STACK_VALUE   0x00fffdc0u   /* tinygrad ops_nv.py cbuf_0[223], @574a2c9 */
+#define NVMTL_CB0_DESC_VALUE    (1ULL << 60)  /* bit 60 = the policy field's validity bit */
+
+/* The windows NVK itself programs for Hopper+ in nvk_push_dispatch_state_init. A kernel that
+ * uses neither shared nor local memory never reads them, but a launcher that fills them wrong
+ * for one that does would be a silent wrong answer, so they are taken from NVK's own values and
+ * gated on the same class comparison rather than hard-coded. */
+#define NVMTL_SHARED_WINDOW_HOPPER (1ULL << 32)
+#define NVMTL_SHARED_WINDOW_VOLTA  (0xfeULL << 24)
+#define NVMTL_LOCAL_WINDOW         (0xffULL << 24)
+
+#define NVMTL_SASS_MAX_PARAMS 64
+
+static void nvmtl_put32(uint8_t *p, uint32_t off, uint32_t v) { memcpy(p + off, &v, 4); }
+static void nvmtl_put64(uint8_t *p, uint32_t off, uint64_t v) { memcpy(p + off, &v, 8); }
+
+/*
+ * Returns 0 on success, or a negative number naming WHICH precondition failed — never a bare -1,
+ * because the caller is in another binary and a number is all it gets.
+ * -1 bad arguments        -2 too many params      -3 program upload failed
+ * -4 cbuf0 upload failed  -5 QMD allocation failed
+ */
+/* BOTH of these are required, and this is NVK's own pattern for a driver-facing hook (see
+ * nvmtl_nvk_sparse_bind_v1 in nvkmd_nvrm_ctx.c): mesa compiles with -fvisibility=hidden, so
+ * without visibility("default") the symbol builds but is NOT exported — measured: the first
+ * build linked cleanly and `nm -gU` read MISS — and it compiles with
+ * -Werror=missing-prototypes, so without the declaration it does not build at all. */
+
+static int
+nvmtl_sass_occupancy(const struct nv_device_info *dev,
+                    const struct nak_compiler *nak, uint32_t regs,
+                    uint32_t shared, const uint32_t block[3], uint32_t *out)
+{
+   if (!dev || !nak || !out || !regs || regs > 255 ||
+       !dev->sm_smem_size_count)
+      return -6;
+   uint64_t threads = 1;
+   for (uint32_t axis = 0; axis < 3; axis++) {
+      if (!block[axis] || block[axis] > 1024)
+         return -6;
+      threads *= block[axis];
+   }
+   if (threads > 1024)
+      return -6;
+   uint32_t budget = nak_max_warps_per_sm(regs, nak);
+   if (!budget || (threads + 31) / 32 > budget)
+      return -7;
+   if (shared > 1024u * dev->sm_smem_sizes_kB[dev->sm_smem_size_count - 1])
+      return -8;
+   *out = budget;
+   return 0;
+}
+
+__attribute__((visibility("default"))) int
+nvmtl_nvk_dispatch_sass_v1(VkCommandBuffer _cmd,
+                           const void *sass, uint32_t sass_len,
+                           uint32_t num_gprs, uint32_t smem_size, uint32_t num_barriers,
+                           const uint64_t *params, uint32_t num_params,
+                           const uint32_t block[3], const uint32_t grid[3]);
+
+/* Everything beyond the program, its parameters and its grid. Carries its own `size` so the
+ * plugin and this backend can be built from different trees without disagreeing silently: a field
+ * added here is invisible to an older caller, and a shorter struct from one is read only as far as
+ * it goes. Pointers are borrowed for the duration of the call. */
+struct nvmtl_sass_extra {
+   uint32_t        size;
+   const void     *bank2;             /* a jump table of self-relative offsets: verbatim */
+   uint32_t        bank2_len;
+   const void     *bank4;             /* pointers to global data: RELOCATED below */
+   uint32_t        bank4_len;
+   const void     *global_init;       /* `.nv.global.init` - what those pointers point at */
+   uint32_t        global_init_len;
+   const uint32_t *bank4_relocs;      /* pairs: offset in bank 4, offset inside global_init */
+   uint32_t        bank4_reloc_count;
+   uint32_t        slm_size;          /* scratch per thread */
+   uint32_t        crs_size;          /* call/return stack per warp */
+};
+
+__attribute__((visibility("default"))) int
+nvmtl_nvk_dispatch_sass_v3(VkCommandBuffer _cmd,
+                           const void *sass, uint32_t sass_len,
+                           uint32_t num_gprs, uint32_t smem_size, uint32_t num_barriers,
+                           const uint64_t *params, uint32_t num_params,
+                           const uint32_t block[3], const uint32_t grid[3],
+                           const struct nvmtl_sass_extra *x);
+
+__attribute__((visibility("default"))) int
+nvmtl_nvk_dispatch_sass_v2(VkCommandBuffer _cmd,
+                           const void *sass, uint32_t sass_len,
+                           uint32_t num_gprs, uint32_t smem_size, uint32_t num_barriers,
+                           const uint64_t *params, uint32_t num_params,
+                           const uint32_t block[3], const uint32_t grid[3],
+                           const void *bank2, uint32_t bank2_len,
+                           uint32_t slm_size, uint32_t crs_size);
+
+__attribute__((visibility("default"))) int
+nvmtl_nvk_dispatch_sass_v1(VkCommandBuffer _cmd,
+                           const void *sass, uint32_t sass_len,
+                           uint32_t num_gprs, uint32_t smem_size, uint32_t num_barriers,
+                           const uint64_t *params, uint32_t num_params,
+                           const uint32_t block[3], const uint32_t grid[3])
+{
+   /* unchanged behaviour: nothing but the program */
+   return nvmtl_nvk_dispatch_sass_v3(_cmd, sass, sass_len, num_gprs, smem_size, num_barriers,
+                                     params, num_params, block, grid, NULL);
+}
+
+__attribute__((visibility("default"))) int
+nvmtl_nvk_dispatch_sass_v2(VkCommandBuffer _cmd,
+                           const void *sass, uint32_t sass_len,
+                           uint32_t num_gprs, uint32_t smem_size, uint32_t num_barriers,
+                           const uint64_t *params, uint32_t num_params,
+                           const uint32_t block[3], const uint32_t grid[3],
+                           const void *bank2, uint32_t bank2_len,
+                           uint32_t slm_size, uint32_t crs_size)
+{
+   /* unchanged behaviour: bank 2, scratch and the call stack, nothing else */
+   struct nvmtl_sass_extra x = {
+      .size = sizeof(x), .bank2 = bank2, .bank2_len = bank2_len,
+      .slm_size = slm_size, .crs_size = crs_size,
+   };
+   return nvmtl_nvk_dispatch_sass_v3(_cmd, sass, sass_len, num_gprs, smem_size, num_barriers,
+                                     params, num_params, block, grid, &x);
+}
+
+__attribute__((visibility("default"))) int
+nvmtl_nvk_dispatch_sass_v3(VkCommandBuffer _cmd,
+                           const void *sass, uint32_t sass_len,
+                           uint32_t num_gprs, uint32_t smem_size, uint32_t num_barriers,
+                           const uint64_t *params, uint32_t num_params,
+                           const uint32_t block[3], const uint32_t grid[3],
+                           const struct nvmtl_sass_extra *x)
+{
+   VK_FROM_HANDLE(nvk_cmd_buffer, cmd, _cmd);
+   static const struct nvmtl_sass_extra none = { .size = sizeof(none) };
+   if (x == NULL || x->size < sizeof(struct nvmtl_sass_extra))
+      x = &none;
+   const void *bank2    = x->bank2;
+   const uint32_t bank2_len = x->bank2_len;
+   /* NAK ASSERTS `crs_size == 0` ON THIS PART (`nak/qmd.rs:828`, a non-unwinding panic that
+    * aborts the app before any GPU work). The call/return stack is a PRE-VOLTA structure; on
+    * Blackwell the ABI stack lives in LOCAL memory, which is what cbuf0 bytes 0x37c already point
+    * into. So the two numbers are not added either: EIATTR_FRAME_SIZE is this function's own frame
+    * and EIATTR_MAX_STACK_SIZE is the maximum over its call tree (both read 144 on the BVH
+    * kernels, which is NOT one frame counted twice: 0x11 is FRAME_SIZE and 0x12 is
+    * MIN_STACK_SIZE, and they were read under each other's names. A call puts the
+    * callee's frame BELOW the caller's, so the launcher passes the SUM of every
+    * EIATTR_FRAME_SIZE and this takes it as given; crs is still folded in with a max
+    * because it is always 0 on this part. */
+   const uint32_t slm_size  = x->slm_size > x->crs_size ? x->slm_size : x->crs_size;
+   const uint32_t crs_size  = 0;
+
+   if (cmd == NULL || sass == NULL || sass_len == 0 || block == NULL || grid == NULL)
+      return -1;
+   if (num_params > NVMTL_SASS_MAX_PARAMS)
+      return -2;
+
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   const struct nvk_physical_device *pdev = nvk_device_physical(dev);
+   /* The compiled kernels are sm_120 machine code. On any other architecture refuse before anything
+    * is allocated or recorded; the caller then runs the kernel's Vulkan pipeline instead. */
+   if (pdev->info.sm != 120)
+      return -20;
+   const uint32_t min_cbuf_alignment = nvk_min_cbuf_alignment(&pdev->info);
+   const uint32_t qmd_size_B = nak_qmd_size_B(&pdev->info);
+   uint32_t max_warps = 0;
+   int occupancy = nvmtl_sass_occupancy(&pdev->info, pdev->nak,
+                                      num_gprs, smem_size, block, &max_warps);
+   if (occupancy)
+      return occupancy;
+   for (uint32_t axis = 0; axis < 3; axis++)
+      if (!grid[axis])
+         return -6;
+
+   VkResult result;
+
+   /* 1 · the program.  0x100-aligned: the QMD's PROGRAM_ADDRESS is a shifted field, so an
+    * unaligned address would be silently truncated into someone else's memory. */
+   uint64_t sass_addr;
+   void *sass_map;
+   result = nvk_cmd_buffer_upload_alloc(cmd, sass_len, 0x100, &sass_addr, &sass_map);
+   if (result != VK_SUCCESS)
+      return -3;
+   memcpy(sass_map, sass, sass_len);
+
+   /* 2 · the nvcc-shaped cbuf0 */
+   uint32_t cb_size = NVMTL_CB0_PARAMS + num_params * 8;
+   cb_size = (cb_size + min_cbuf_alignment - 1) & ~(min_cbuf_alignment - 1);
+   uint64_t cb_addr;
+   void *cb_map;
+   result = nvk_cmd_buffer_upload_alloc(cmd, cb_size, min_cbuf_alignment, &cb_addr, &cb_map);
+   if (result != VK_SUCCESS)
+      return -4;
+
+   uint8_t *cb = cb_map;
+   memset(cb, 0, cb_size);
+   nvmtl_put64(cb, NVMTL_CB0_SHARED_WINDOW,
+               pdev->info.cls_compute >= HOPPER_COMPUTE_A ? NVMTL_SHARED_WINDOW_HOPPER
+                                                          : NVMTL_SHARED_WINDOW_VOLTA);
+   nvmtl_put64(cb, NVMTL_CB0_LOCAL_WINDOW, NVMTL_LOCAL_WINDOW);
+   nvmtl_put64(cb, NVMTL_CB0_DESCRIPTOR,   NVMTL_CB0_DESC_VALUE);
+   for (uint32_t i = 0; i < 3; i++) {
+      nvmtl_put32(cb, NVMTL_CB0_BLOCKDIM + 4 * i, block[i]);
+      nvmtl_put32(cb, NVMTL_CB0_GRIDDIM  + 4 * i, grid[i]);
+   }
+   /* THE STACK POINTER MUST POINT INTO THE LOCAL MEMORY WE ACTUALLY BACK. This slot
+    * is read by the kernel's first instruction (`LDC R1, c[0x0][0x37c]`) and every frame hangs
+    * off it: the entry does `IADD R1, R1, -0x90` and its callee subtracts another frame below
+    * that. It used to be written as NVMTL_CB0_STACK_VALUE, the constant tinygrad records from
+    * libcuda - ptxas's ABI stack, which sits near the top of the 16 MB local window and grows
+    * DOWN. NAK puts all scratch in SHADER_LOCAL_MEMORY_LOW_SIZE, addressed from 0 UP, and backs
+    * nothing at the top of that window, so the constant aimed every frame at memory this
+    * dispatch does not own. A kernel with no frame loads R1 and never dereferences it, which is
+    * why every kernel before `trace_bvh` ran: with 144 bytes backed it faulted at `compute
+    * shader VA 0x0`, and with 288 the same wild offset landed inside mapped memory instead,
+    * returned garbage, and its traversal loop never terminated - a 60 s fence timeout rather
+    * than a fault. The top of this thread's own slice is the only value both halves agree on. */
+   nvmtl_put32(cb, NVMTL_CB0_STACK, slm_size);
+   if (params != NULL && num_params > 0)
+      memcpy(cb + NVMTL_CB0_PARAMS, params, num_params * 8);
+
+   /* the jump table, uploaded verbatim: its entries are instruction offsets inside this
+    * kernel's own text and BRX subtracts its own PC base, so it is position independent. The
+    * compiler refuses a table that carries relocations, so none can reach here. */
+   uint64_t bank2_addr = 0;
+   uint32_t bank2_size = 0;
+   if (bank2 != NULL && bank2_len > 0) {
+      void *bank2_map;
+      /* The QMD stores a constant buffer's size SHIFTED, so an unrounded size trips NAK's own
+       * assertion before anything reaches the GPU (`qmd.rs:831` on 28 bytes). Round up, zero the
+       * tail, and keep the table's live entries at the front. */
+      bank2_size = (bank2_len + min_cbuf_alignment - 1) & ~(min_cbuf_alignment - 1);
+      result = nvk_cmd_buffer_upload_alloc(cmd, bank2_size, min_cbuf_alignment,
+                                           &bank2_addr, &bank2_map);
+      if (result != VK_SUCCESS)
+         return -9;
+      memset(bank2_map, 0, bank2_size);
+      memcpy(bank2_map, bank2, bank2_len);
+   }
+
+   /* the data a `constant` array lives in, and bank 4's pointers AT it. The pointers are
+    * absolute, so they can only be written once the data has an address - which is why this
+    * cannot be uploaded verbatim the way bank 2 is. */
+   uint64_t bank4_addr = 0;
+   uint32_t bank4_size = 0;
+   if (x->bank4_len > 0 && x->bank4_reloc_count > 0) {
+      uint64_t init_addr = 0;
+      if (x->global_init_len > 0) {
+         void *init_map;
+         result = nvk_cmd_buffer_upload_alloc(cmd, x->global_init_len, 16,
+                                              &init_addr, &init_map);
+         if (result != VK_SUCCESS)
+            return -10;
+         memcpy(init_map, x->global_init, x->global_init_len);
+      }
+      void *bank4_map;
+      bank4_size = (x->bank4_len + min_cbuf_alignment - 1) & ~(min_cbuf_alignment - 1);
+      result = nvk_cmd_buffer_upload_alloc(cmd, bank4_size, min_cbuf_alignment,
+                                           &bank4_addr, &bank4_map);
+      if (result != VK_SUCCESS)
+         return -11;
+      memset(bank4_map, 0, bank4_size);
+      memcpy(bank4_map, x->bank4, x->bank4_len);
+      for (uint32_t i = 0; i < x->bank4_reloc_count; i++) {
+         uint32_t at  = x->bank4_relocs[2 * i];
+         uint32_t sym = x->bank4_relocs[2 * i + 1];
+         /* a patch that would run off the end of the bank, or name data past the end of the
+          * uploaded section, is a wrong pointer the shader WILL dereference */
+         if (at + 8 > x->bank4_len || sym > x->global_init_len)
+            return -12;
+         uint64_t value = init_addr + sym;
+         memcpy((uint8_t *)bank4_map + at, &value, sizeof value);
+      }
+   }
+
+   /* 3 · the shader info NAK would have produced, filled from the cubin's own .nv.info instead.
+    * slm_size and crs_size stay 0: a cubin that needs local memory or a call stack has
+    * EIATTR_MAX_STACK_SIZE / FRAME_SIZE set, and the caller must pass those before this hook
+    * can honour them. Running such a kernel with 0 here would corrupt memory silently, so the
+    * caller refuses it rather than this function guessing. */
+   struct nak_shader_info info;
+   memset(&info, 0, sizeof info);
+   info.stage                = MESA_SHADER_COMPUTE;
+   info.sm                   = pdev->info.sm;
+   info.num_gprs             = num_gprs;
+   info.max_warps_per_sm      = max_warps;
+   info.num_control_barriers = num_barriers;
+   /* The scratch and the call stack the cubin itself declares (EIATTR_FRAME_SIZE and
+    * EIATTR_MAX_STACK_SIZE, carried in the launch record). nvk_device_ensure_slm below grows the
+    * device's scratch region to cover them, and NAK's packer puts both in the QMD. Zero for the
+    * kernels that need neither, which is most of them. */
+   info.slm_size             = slm_size;
+   info.crs_size             = crs_size;
+   info.cs.local_size[0]     = block[0];
+   info.cs.local_size[1]     = block[1];
+   info.cs.local_size[2]     = block[2];
+   info.cs.smem_size         = smem_size;
+
+   /* 4 · the QMD, built by NAK's own packer so every reserved field is whatever NVK ships */
+   struct nak_qmd_info qmd_info;
+   memset(&qmd_info, 0, sizeof qmd_info);
+   qmd_info.addr           = sass_addr;
+   qmd_info.smem_size      = smem_size;
+   /* 26.3: no smem_max in nak_qmd_info - NAK derives MAX from the device's carveout ladder */
+   qmd_info.global_size[0] = grid[0];
+   qmd_info.global_size[1] = grid[1];
+   qmd_info.global_size[2] = grid[2];
+   qmd_info.num_cbufs      = 1;
+   qmd_info.cbufs[0]       = (struct nak_qmd_cbuf) {
+      .index = 0,
+      .addr  = cb_addr,
+      .size  = cb_size,
+   };
+   if (bank4_addr) {
+      qmd_info.cbufs[qmd_info.num_cbufs++] = (struct nak_qmd_cbuf) {
+         .index = 4,            /* c[0x4] - where a `constant` array's pointers are relocated */
+         .addr  = bank4_addr,
+         .size  = bank4_size,
+      };
+   }
+   if (bank2_addr) {
+      qmd_info.cbufs[qmd_info.num_cbufs++] = (struct nak_qmd_cbuf) {
+         .index = 2,            /* c[0x2] - where OCG puts an indirect branch's targets */
+         .addr  = bank2_addr,
+         .size  = bank2_size,
+      };
+   }
+
+   uint32_t qmd[NAK_MAX_QMD_DWORDS];
+   assert(qmd_size_B <= sizeof(qmd));
+   memset(qmd, 0, sizeof(qmd));
+   nak_fill_qmd(&pdev->info, &info, &qmd_info, qmd, qmd_size_B);
+
+   uint64_t qmd_addr;
+   void *qmd_map;
+   result = nvk_cmd_buffer_alloc_qmd(cmd, qmd_size_B, 0x100, &qmd_addr, &qmd_map);
+   if (result != VK_SUCCESS)
+      return -5;
+   memcpy(qmd_map, qmd, qmd_size_B);
+
+   { /* stdatomic for the counters below */
+     const char *upath = getenv("NVMTL_SASS_UPLOADLOG");
+     static _Atomic unsigned long long served, bytes;
+     unsigned long long n = atomic_fetch_add(&served, 1) + 1;
+     unsigned long long b = atomic_fetch_add(&bytes, sass_len + cb_size + qmd_size_B)
+                            + sass_len + cb_size + qmd_size_B;
+     if (upath && *upath) {
+        FILE *uf = fopen(upath, "a");
+        if (uf) {
+           fprintf(uf, "UPLOAD %llu prog 0x%llx+%u cbuf 0x%llx+%u qmd 0x%llx+%u total %llu\n",
+                   n, (unsigned long long)sass_addr, sass_len,
+                   (unsigned long long)cb_addr, cb_size,
+                   (unsigned long long)qmd_addr, qmd_size_B, b);
+           fclose(uf);
+        }
+     }
+   }
+   /* 5 · and send it, exactly as nvk_cmd_dispatch_shader does for NVK's own internal shaders */
+   nvk_device_ensure_slm(dev, info.slm_size, info.crs_size);
+
+   struct nv_push *p = nvk_cmd_buffer_push(cmd, 8);
+   P_IMMD(p, NVA0C0, SET_RENDER_ENABLE_OVERRIDE, MODE_ALWAYS_RENDER);
+   P_MTHD(p, NVA0C0, SEND_PCAS_A);
+   P_NVA0C0_SEND_PCAS_A(p, qmd_addr >> 8);
+   if (pdev->info.cls_compute <= TURING_COMPUTE_A) {
+      P_IMMD(p, NVA0C0, SEND_SIGNALING_PCAS_B, {
+         .invalidate = INVALIDATE_TRUE,
+         .schedule   = SCHEDULE_TRUE,
+      });
+   } else {
+      P_IMMD(p, NVC6C0, SEND_SIGNALING_PCAS2_B, PCAS_ACTION_INVALIDATE_COPY_SCHEDULE);
+   }
+   P_IMMD(p, NVA0C0, SET_RENDER_ENABLE_OVERRIDE, MODE_USE_RENDER_ENABLE);
+
+   /* The compute state NVK tracks is now stale — it has no idea a QMD went out with a shader
+    * it never bound. Invalidate it so the next real vkCmdDispatch re-emits everything rather
+    * than trusting a cached binding that no longer matches the hardware. */
+   nvk_cmd_invalidate_compute_state(cmd);
+
+   return 0;
+}
+
+#if defined(NVMTL_SASS_QMD_TEST)
+__attribute__((visibility("default"))) int nvmtl_sass_qmd_cpu_v1(void);
+__attribute__((visibility("default"))) int nvmtl_sass_qmd_cpu_v1(void)
+{
+   struct nv_device_info dev;
+   memset(&dev, 0, sizeof dev);
+   dev.sm = 120;
+   dev.cls_compute = 0xcec0;
+   dev.max_warps_per_mp = 48;
+   dev.sm_smem_size_count = 5;
+   const uint16_t sizes[5] = {8, 16, 32, 64, 96};
+   memcpy(dev.sm_smem_sizes_kB, sizes, sizeof sizes);
+   struct nak_compiler *nak = nak_compiler_create(&dev);
+   if (!nak) return 1;
+   uint32_t successes = 0, refusals = 0;
+   const uint32_t registers[6] = {8, 14, 32, 64, 128, 255};
+   const uint32_t threads[6] = {32, 64, 128, 256, 512, 1024};
+   for (uint32_t r = 0; r < 6; r++) {
+      for (uint32_t t = 0; t < 6; t++) {
+         uint32_t block[3] = {threads[t], 1, 1}, budget = 0;
+         int result = nvmtl_sass_occupancy(&dev, nak, registers[r], 0, block, &budget);
+         if (result) { refusals++; continue; }
+         struct nak_shader_info info;
+         memset(&info, 0, sizeof info);
+         info.stage = MESA_SHADER_COMPUTE;
+         info.sm = dev.sm;
+         info.num_gprs = registers[r];
+         info.max_warps_per_sm = budget;
+         info.cs.local_size[0] = block[0];
+         info.cs.local_size[1] = info.cs.local_size[2] = 1;
+         struct nak_qmd_info qmd_info;
+         memset(&qmd_info, 0, sizeof qmd_info);
+         qmd_info.addr = 0x10000;
+         qmd_info.global_size[0] = qmd_info.global_size[1] = qmd_info.global_size[2] = 1;
+         uint32_t qmd[NAK_MAX_QMD_DWORDS];
+         memset(qmd, 0, sizeof qmd);
+         uint32_t bytes = nak_qmd_size_B(&dev);
+         if (bytes != 384) return 2;
+         nak_fill_qmd(&dev, &info, &qmd_info, qmd, bytes);
+         bool nonzero = false;
+         for (uint32_t i = 0; i < bytes / 4; i++) nonzero |= qmd[i] != 0;
+         if (!nonzero) return 3;
+         successes++;
+      }
+   }
+   nak_compiler_destroy(nak);
+   printf("qmd_cpu_valid=%u occupancy_refused=%u gpu_created=0\n", successes, refusals);
+   return successes && refusals ? 0 : 4;
+}
+#endif
diff -ruN a/src/nouveau/vulkan/nvmtl_nvk_sass_bind.c b/src/nouveau/vulkan/nvmtl_nvk_sass_bind.c
--- a/src/nouveau/vulkan/nvmtl_nvk_sass_bind.c	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/nvmtl_nvk_sass_bind.c	2026-10-15 21:15:16
@@ -0,0 +1,170 @@
+/*
+ * nvmtl_nvk_sass_bind.c — the handles a raw-SASS kernel needs for textures and samplers.
+ * SPDX-License-Identifier: MIT
+ *
+ * WHAT THIS CLOSES. A compiled Metal compute kernel reads its textures through a bindless handle,
+ * not through a descriptor set: the machine code holds an index into the image descriptor table and,
+ * for a sample, an index into the sampler table. Measured over 400 of the kernels that now compile,
+ * 86% need a texture handle and 48% need a sampler handle, so without these the launcher can run
+ * about 1% of them.
+ *
+ * NVK already keeps exactly those indices: an image view carries `sampled`/`storage` descriptor
+ * indices per plane, and a sampler carries one per plane. This hands them to the Metal driver so it
+ * can write them into the kernel's parameter words. Nothing new is allocated and no descriptor is
+ * written here — the index is the one NVK gave the view when the Metal driver created it, which is
+ * why this cannot disagree with what the texture unit will read.
+ *
+ * The packing is the one the shader lowering assumes (and the Vulkan descriptor layout NVK uses):
+ * texture handle = image index in bits 0..19
+ * sampler handle = sampler index in bits 20..31
+ * A sample combines them in the shader; a read, a write and a size query use the image alone.
+ *
+ * Exported as `nvmtl_nvk_*_v1` and dlsym'd by the Metal driver, the way the two already talk to each
+ * other. Nothing inside NVK calls it, so a build without the Metal driver is unchanged.
+ */
+
+#include "nvk_device.h"
+#include "nvk_image_view.h"
+#include "nvk_physical_device.h"
+#include "nvk_sampler.h"
+
+#include "vk_log.h"
+
+#include <string.h>
+
+#define NVMTL_SASS_IMAGE_BITS   20
+#define NVMTL_SASS_IMAGE_MASK   ((1u << NVMTL_SASS_IMAGE_BITS) - 1)
+#define NVMTL_SASS_SAMPLER_MASK 0xFFFu
+
+/* which descriptor of an image view a kernel's use of it needs */
+enum nvmtl_sass_image_use {
+   NVMTL_SASS_IMAGE_SAMPLED = 0,   /* sample, read and the size queries */
+   NVMTL_SASS_IMAGE_STORAGE = 1,   /* write and read_write access */
+};
+
+__attribute__((visibility("default"))) int
+nvmtl_nvk_sass_image_handle_v1(VkImageView _view, uint32_t use, uint32_t plane,
+                               uint32_t *handle_out);
+
+__attribute__((visibility("default"))) int
+nvmtl_nvk_sass_image_handle_v1(VkImageView _view, uint32_t use, uint32_t plane,
+                               uint32_t *handle_out)
+{
+   if (_view == VK_NULL_HANDLE || handle_out == NULL)
+      return -1;
+   if (use != NVMTL_SASS_IMAGE_SAMPLED && use != NVMTL_SASS_IMAGE_STORAGE)
+      return -2;
+
+   VK_FROM_HANDLE(nvk_image_view, view, _view);
+   if (plane >= view->plane_count)
+      return -3;
+
+   const struct nvk_image_view_descriptor *desc =
+      (use == NVMTL_SASS_IMAGE_SAMPLED) ? &view->planes[plane].sampled
+                                        : &view->planes[plane].storage;
+
+   /* index 0 is NVK's "no descriptor": a kernel handed it would read another resource's
+    * descriptor rather than fail, so it is refused here instead of being packed. */
+   if (desc->desc_index == 0)
+      return -4;
+   if (desc->desc_index > NVMTL_SASS_IMAGE_MASK)
+      return -5;
+
+   *handle_out = desc->desc_index & NVMTL_SASS_IMAGE_MASK;
+   return 0;
+}
+
+__attribute__((visibility("default"))) int
+nvmtl_nvk_sass_sampler_handle_v1(VkSampler _sampler, uint32_t plane, uint32_t *handle_out);
+
+__attribute__((visibility("default"))) int
+nvmtl_nvk_sass_sampler_handle_v1(VkSampler _sampler, uint32_t plane, uint32_t *handle_out)
+{
+   if (_sampler == VK_NULL_HANDLE || handle_out == NULL)
+      return -1;
+
+   VK_FROM_HANDLE(nvk_sampler, sampler, _sampler);
+   if (plane >= sampler->plane_count)
+      return -3;
+
+   const uint32_t index = sampler->planes[plane].desc_index;
+   if (index > NVMTL_SASS_SAMPLER_MASK)
+      return -5;
+
+   /* A sampler index of 0 is legitimate (NVK's first sampler slot is usable), unlike an image
+    * index of 0, so it is NOT refused here. The two tables are separate. */
+   *handle_out = index & NVMTL_SASS_SAMPLER_MASK;
+   return 0;
+}
+
+/*
+ * The two halves a sample needs, in the one word the shader reads. Kept here rather than in the
+ * Metal driver so the packing has exactly one definition on the side that owns the tables.
+ */
+__attribute__((visibility("default"))) int
+nvmtl_nvk_sass_combined_handle_v1(VkImageView _view, VkSampler _sampler, uint32_t use,
+                                  uint32_t plane, uint64_t *handle_out);
+
+__attribute__((visibility("default"))) int
+nvmtl_nvk_sass_combined_handle_v1(VkImageView _view, VkSampler _sampler, uint32_t use,
+                                  uint32_t plane, uint64_t *handle_out)
+{
+   if (handle_out == NULL)
+      return -1;
+
+   uint32_t image = 0;
+   int rc = nvmtl_nvk_sass_image_handle_v1(_view, use, plane, &image);
+   if (rc)
+      return rc;
+
+   uint32_t sampler = 0;
+   if (_sampler != VK_NULL_HANDLE) {
+      rc = nvmtl_nvk_sass_sampler_handle_v1(_sampler, plane, &sampler);
+      if (rc)
+         return rc;
+   }
+
+   *handle_out = (uint64_t)image | ((uint64_t)sampler << NVMTL_SASS_IMAGE_BITS);
+   return 0;
+}
+
+#if defined(NVMTL_SASS_BIND_TEST)
+#include <stdio.h>
+
+/*
+ * The packing, checked on the CPU: the two indices must come back out of the word unchanged, and
+ * the values a kernel must never be handed must be refused. No device and no GPU.
+ */
+__attribute__((visibility("default"))) int nvmtl_sass_bind_cpu_v1(void);
+__attribute__((visibility("default"))) int nvmtl_sass_bind_cpu_v1(void)
+{
+   unsigned pass = 0, fail = 0;
+   const uint32_t images[] = { 1, 2, 4095, 4096, 0xFFFFE, NVMTL_SASS_IMAGE_MASK };
+   const uint32_t samplers[] = { 0, 1, 7, 4094, NVMTL_SASS_SAMPLER_MASK };
+
+   for (unsigned i = 0; i < sizeof images / sizeof images[0]; i++) {
+      for (unsigned s = 0; s < sizeof samplers / sizeof samplers[0]; s++) {
+         uint64_t word = (uint64_t)images[i] | ((uint64_t)samplers[s] << NVMTL_SASS_IMAGE_BITS);
+         uint32_t back_image = (uint32_t)(word & NVMTL_SASS_IMAGE_MASK);
+         uint32_t back_sampler = (uint32_t)(word >> NVMTL_SASS_IMAGE_BITS);
+         if (back_image == images[i] && back_sampler == samplers[s])
+            pass++;
+         else {
+            fail++;
+            printf("FAIL image %u sampler %u came back as %u / %u\n",
+                   images[i], samplers[s], back_image, back_sampler);
+         }
+      }
+   }
+   /* the refusals: a null view, an out-of-range use, and the null image descriptor */
+   uint32_t h = 0;
+   if (nvmtl_nvk_sass_image_handle_v1(VK_NULL_HANDLE, NVMTL_SASS_IMAGE_SAMPLED, 0, &h) == -1) pass++; else fail++;
+   if (nvmtl_nvk_sass_image_handle_v1(VK_NULL_HANDLE, 7, 0, &h) == -1) pass++; else fail++;
+   uint64_t w = 0;
+   if (nvmtl_nvk_sass_combined_handle_v1(VK_NULL_HANDLE, VK_NULL_HANDLE, 0, 0, &w) == -1) pass++; else fail++;
+   if (nvmtl_nvk_sass_combined_handle_v1(VK_NULL_HANDLE, VK_NULL_HANDLE, 0, 0, NULL) == -1) pass++; else fail++;
+
+   printf("nvmtl_sass_bind_cpu: %u pass %u fail gpu_used=0\n", pass, fail);
+   return fail ? 1 : 0;
+}
+#endif
diff -ruN a/src/nouveau/vulkan/nvmtl_sample_depth_contract.h b/src/nouveau/vulkan/nvmtl_sample_depth_contract.h
--- a/src/nouveau/vulkan/nvmtl_sample_depth_contract.h	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/nvmtl_sample_depth_contract.h	2026-10-05 07:44:54
@@ -0,0 +1,17 @@
+/* Private NVMTL/NVK v1 ABI. This is stronger than portable Vulkan's
+ * sample-location depth-layout requirements, and requires direct ICD handles.
+ * Flags guarantee independent stored depth/stencil sample values, no plane
+ * compression, and position-independent transitions/blits when historical
+ * sample-location metadata is omitted. Layout transitions never discard existing
+ * independent values, including barriers naming oldLayout UNDEFINED. This
+ * deliberately does not assert portable Vulkan definedness or correct generic
+ * host layout tracking. Per-image verification is mandatory.
+ * It does not change the meaning of ordinary Vulkan implementations. */
+#ifndef NVMTL_SAMPLE_DEPTH_CONTRACT_H
+#define NVMTL_SAMPLE_DEPTH_CONTRACT_H
+#define NVMTL_SAMPLE_DEPTH_INDEPENDENT_VALUES 0x1u
+#define NVMTL_SAMPLE_DEPTH_UNCOMPRESSED_PLANES 0x2u
+#define NVMTL_SAMPLE_DEPTH_LOCATION_INDEPENDENT_LAYOUT 0x4u
+#define NVMTL_SAMPLE_DEPTH_NON_DISCARDING_LAYOUT_TRANSITIONS 0x8u
+#define NVMTL_SAMPLE_DEPTH_CONTRACT_REQUIRED 0xfu
+#endif
