+/* NVMTL_GDQ: the waits (enum nvk_barrier src bits) a dependency makes, exactly as nvk_cmd_flush_wait_dep pushes them.
+ * *chain_ok: no image barrier and no queue-family transfer, so the dependency is only waits, flushes, and invalidates.
+ */
+static uint32_t
+nvk_gdq_dep_waits(const VkDependencyInfo *dep, bool *chain_ok)
+{
+   uint32_t src = 0;
+   *chain_ok = dep->imageMemoryBarrierCount == 0;
+
+   for (uint32_t i = 0; i < dep->memoryBarrierCount; i++) {
+      const VkMemoryBarrier2 *bar = &dep->pMemoryBarriers[i];
+      src |= nvk_barrier_flushes_waits(bar->srcStageMask, bar->srcAccessMask);
+   }
+
+   for (uint32_t i = 0; i < dep->bufferMemoryBarrierCount; i++) {
+      const VkBufferMemoryBarrier2 *bar = &dep->pBufferMemoryBarriers[i];
+      src |= nvk_barrier_flushes_waits(bar->srcStageMask, bar->srcAccessMask);
+      if (bar->srcQueueFamilyIndex != bar->dstQueueFamilyIndex)
+         *chain_ok = false;
+   }
+
+   for (uint32_t i = 0; i < dep->imageMemoryBarrierCount; i++) {
+      const VkImageMemoryBarrier2 *bar = &dep->pImageMemoryBarriers[i];
+      src |= nvk_barrier_flushes_waits(bar->srcStageMask, bar->srcAccessMask);
+   }
+
+   return src;
+}
+
+/* NVMTL_GDQ k6: a dependency's dst side as chained-QMD invalidate bits (bit - 472, clcdc0qmd.h) - exactly the caches
+ * the push path invalidates for it: nvk_barrier_invalidates (TEX_DATA 474, SHADER_DATA 475, CONSTANT 477), plus 475
+ * when the src side flushed shader data (INVALIDATE_SHADER_CACHES .data=TRUE).  *membar: 3 L1_MEMBAR (GPU scope, 610's
+ * and the CUDA graph's), 1 L1_SYSMEMBAR when a dst stage is HOST.  Image barriers never chain, so they are not read.
+ */
+static uint32_t
+nvk_gdq_dep_qmd_inv(const VkDependencyInfo *dep, uint32_t waits, uint32_t *membar)
+{
+   uint32_t inv = 0;
+   bool host = false;
+
+   for (uint32_t i = 0; i < dep->memoryBarrierCount; i++) {
+      const VkMemoryBarrier2 *bar = &dep->pMemoryBarriers[i];
+      inv |= nvk_barrier_invalidates(bar->dstStageMask, bar->dstAccessMask);
+      host |= (bar->dstStageMask & VK_PIPELINE_STAGE_2_HOST_BIT) != 0;
+   }
+
+   for (uint32_t i = 0; i < dep->bufferMemoryBarrierCount; i++) {
+      const VkBufferMemoryBarrier2 *bar = &dep->pBufferMemoryBarriers[i];
+      inv |= nvk_barrier_invalidates(bar->dstStageMask, bar->dstAccessMask);
+      host |= (bar->dstStageMask & VK_PIPELINE_STAGE_2_HOST_BIT) != 0;
+   }
+
+   uint32_t bits = 0;
+   if (inv & NVK_BARRIER_INVALIDATE_TEX_DATA)
+      bits |= 1u << 2;
+   if ((inv & NVK_BARRIER_INVALIDATE_SHADER_DATA) || (waits & NVK_BARRIER_FLUSH_SHADER_DATA))
+      bits |= 1u << 3;
+   if (inv & NVK_BARRIER_INVALIDATE_CONSTANT)
+      bits |= 1u << 5;
+   *membar = host ? 1 : 3;
+   return bits;
+}
+
 VKAPI_ATTR void VKAPI_CALL
 nvk_CmdPipelineBarrier2(VkCommandBuffer commandBuffer,
                         const VkDependencyInfo *pDependencyInfo)
 {
    VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+   struct nvk_compute_state *cs = &cmd->state.cs;
 
+   /* NVMTL_GDQ: the barrier between A (the chain's last dispatch, nothing pushed since) and the next dispatch B may be
+    * erased and carried by the QMDs when the chain's head was fenced by waits covering this barrier's: everything this
+    * barrier would wait for besides A already finished before the head started, A itself launches B on completion with
+    * a CWD membar, and B's QMD invalidates the caches it reads through.  Every later command gets the barrier re-pushed
+    * by nvk_cmd_gdq_close_chain.
+    */
+   bool gdq_ok;
+   const uint32_t gdq_waits = nvk_gdq_dep_waits(pDependencyInfo, &gdq_ok);
+   const bool gdq_chainable = gdq_ok &&
+                              cs->gdq_prev_qmd != NULL &&
+                              cmd->push.start == cs->gdq_push_start &&
+                              cmd->push.end == cs->gdq_push_after_disp &&
+                              (gdq_waits & ~cs->gdq_chain_fence) == 0;
+
+   /* a chainable barrier inside an open chain is pushed without closing it: the next dispatch erases it again */
+   cs->gdq_hold = gdq_chainable;
    nvk_cmd_flush_wait_dep(cmd, pDependencyInfo, true);
    nvk_cmd_image_layout_transition(cmd, pDependencyInfo);
    nvk_cmd_invalidate_deps(cmd, 1, pDependencyInfo);
+   cs->gdq_hold = false;
+
+   cs->gdq_push_after_bar = NULL;
+   if (gdq_chainable && cmd->push.start == cs->gdq_push_start)
+      cs->gdq_push_after_bar = cmd->push.end;
+
+   /* k6: what a dispatch chained across this barrier must invalidate */
+   cs->gdq_bar_qmd_inv = nvk_gdq_dep_qmd_inv(pDependencyInfo, gdq_waits, &cs->gdq_bar_membar);
+
+   nvk_gdq_stat(NVK_GDQ_STAT_BARRIER);
+   if (gdq_chainable)
+      nvk_gdq_stat(NVK_GDQ_STAT_CHAINABLE);
+   else if (!gdq_ok)
+      nvk_gdq_stat(NVK_GDQ_STAT_NOT_IMAGE);
+   else if (cs->gdq_prev_qmd != NULL && cmd->push.start == cs->gdq_push_start &&
+            (gdq_waits & ~cs->gdq_chain_fence) != 0)
+      nvk_gdq_stat(NVK_GDQ_STAT_NOT_FENCE);
+   else
+      nvk_gdq_stat(NVK_GDQ_STAT_NOT_POS);
+
+   /* this barrier fences a dispatch pushed directly after it */
+   cs->gdq_fence_src = gdq_waits;
+   cs->gdq_fence_start = cmd->push.start;
+   cs->gdq_fence_end = cmd->push.end;
 }
 
