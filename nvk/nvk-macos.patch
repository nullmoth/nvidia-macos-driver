+// (RTX 5060 / GB206): the RM reports NV2080_CTRL_GR_INFO_SM_VERSION 0xa04 and the old formula
+// ((v >> 8) * 10 + (v & 0xf)) turned it into NAK sm 104 = Blackwell A (GB100 datacenter ISA + its latency table).
+// The chip is Blackwell B, sm 120. An empty compute shader launched fine; the first one with a global store
+// died with an SM exception (Xid 13). Mirror nouveau (winsys/nouveau_device.c sm_for_chipset), which keys on
+// the chipset id, and keep the RM formula only for chips that table does not know.
+static uint8_t nvkmd_nvrm_sm_for_chipset(uint16_t chipset, uint32_t smVersion)
+{
+   if (chipset >= 0x1b0) return 120;
+   if (chipset >= 0x1a0) return 100;
+   if (chipset >= 0x190) return 89;
+   if (chipset >= 0x180) return 90;   // GH100 is older than AD10X, but is SM90
+   if (chipset == 0x17b) return 87;
+   if (chipset >= 0x172) return 86;
+   if (chipset >= 0x170) return 80;
+   if (chipset >= 0x160) return 75;
+   if (chipset >= 0x14b) return 72;
+   if (chipset >= 0x140) return 70;
+   return (smVersion >> 8) * 10 + (smVersion & 0xf);
+}
