+/* b81: NVRM_610_<ITEM>=0 turns one recipe item back to the b80 shape (TSG PREEMPT LGPROMO ZCULL USERMODE BOOST CECHAN) */
+static inline bool
+nvrm610_on(const char *item)
+{
+   char k[64];
+   snprintf(k, sizeof k, "NVRM_610_%s", item);
+   const char *e = getenv(k);
+   /* r3-conf: WindowServer gets no shell env, so a root-owned file can also switch an item:
+    * /Library/GPUBundles/nvmtl/nvrm610.conf, lines "ITEM=0" or "ITEM=1". Env wins over the file; absent = r3 default ON.
+    * Purpose: bisect which 610 item crash-looped WindowServer (NVK-only proven 20:24) without rebuilding. */
+   if (!e) {
+      static char conf[8192]; static int loaded;
+      if (!loaded) {
+         loaded = 1;
+         FILE *f = fopen("/Library/GPUBundles/nvmtl/nvrm610.conf", "r");
+         if (f) { size_t n = fread(conf, 1, sizeof conf - 1, f); conf[n] = 0; fclose(f); }
+      }
+      char key[80]; snprintf(key, sizeof key, "%s=", item);
+      const char *hit = strstr(conf, key);
+      if (hit && (hit == conf || hit[-1] == '\n')) {
+         char v = hit[strlen(key)];
+         fprintf(stderr, "nvrm: 610 %s=%c (nvrm610.conf)\n", item, v);
+         return v != '0';
+      }
+   }
+   return !(e && e[0] == '0');
+}
