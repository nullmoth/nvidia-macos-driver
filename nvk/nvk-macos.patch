+
+static bool
+nak_cg_ldsink(nir_shader *nir)
+{
+   if (!nak_cg_ldsink_enabled())
+      return false;
+   bool progress = false;
+   nir_foreach_function_impl(impl, nir) {
+      bool p = false;
+      nir_foreach_block(block, impl)
+         p |= nak_cg_ldsink_block(block);
+      progress |= nir_progress(p, impl, nir_metadata_control_flow);
+   }
+   return progress;
+}
+
+static bool
+nak_cg_sink_loop_incs(nir_shader *nir)
+{
+   if (!nak_cg_sink_enabled())
+      return false;
+   bool progress = false;
+   nir_foreach_function_impl(impl, nir) {
+      nir_metadata_require(impl, nir_metadata_block_index);
+      bool p = false;
+      nir_foreach_block(block, impl) {
+         nir_cf_node *parent = block->cf_node.parent;
+         if (parent->type != nir_cf_node_loop ||
+             nir_loop_first_block(nir_cf_node_as_loop(parent)) != block)
+            continue;
+         nir_foreach_phi(phi, block)
+            p |= nak_cg_sink_one(phi, block);
+      }
+      progress |= nir_progress(p, impl, nir_metadata_control_flow);
+   }
+   return progress;
+}
+
+/* NVMTL b79 (patch_cg_punroll.py): NVMTL_NAK_NO_PUNROLL=1 is the kill switch for nak_cg_punroll. */
+static bool
+nak_cg_punroll_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *e = getenv("NVMTL_NAK_NO_PUNROLL");
+      enabled = !(e != NULL && e[0] == '1');
+   }
+   return enabled;
+}
+
+struct nak_cg_punroll_plan {
+   nir_loop *loop;
+   nir_block *a, *z;
+   nir_phi_instr *iv;        /* the counter's header phi */
+   unsigned d;               /* t = iv + d */
+   nir_def *n;               /* loop-invariant bound */
+   nir_op exit_op;           /* nir_op_ieq, nir_op_ige or nir_op_uge: the loop exits when exit_op(t, n) */
+   unsigned f;
+   unsigned step;            /* the counter's constant increment (speed267 predload: was always 1) */
+};
+
+static bool
+nak_cg_punroll_is_load(nir_intrinsic_instr *intr)
+{
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_global:
+   case nir_intrinsic_load_global_constant:
+   case nir_intrinsic_load_shared:
+   case nir_intrinsic_load_ubo:
+   case nir_intrinsic_load_ssbo:
+   case nir_intrinsic_load_global_nv:   /* speed267: punroll also runs after nak_cg_predload */
+      return true;
+   default:
+      return false;
+   }
+}
+
+/* Counts the instructions of a loop block; -1 if one of them may not be repeated behind a divergent guard. */
+static int
+nak_cg_punroll_block_cost(nir_block *block, bool allow_phis, bool allow_continue, unsigned *loads)
+{
+   int n = 0;
+   nir_foreach_instr(instr, block) {
+      switch (instr->type) {
+      case nir_instr_type_phi:
+         if (!allow_phis)
+            return -1;
+         continue;
+      case nir_instr_type_alu:   /* pure: derivatives are intrinsics in this NIR and the pass is compute-only */
+      case nir_instr_type_load_const:
+      case nir_instr_type_undef:
+         break;
+      case nir_instr_type_intrinsic: {
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (nak_cg_punroll_is_load(intr)) {
+            (*loads)++;
+         } else if (intr->intrinsic == nir_intrinsic_store_global ||
+                    intr->intrinsic == nir_intrinsic_store_shared ||
+                    intr->intrinsic == nir_intrinsic_store_ssbo) {
+            /* repeated in program order: same stores, same order */
+         } else if (!nir_intrinsic_can_reorder(intr)) {
+            return -1;   /* barriers, subgroup ops, atomics, anything convergent or ordered */
+         }
+         break;
+      }
+      case nir_instr_type_jump:
+         if (allow_continue && nir_instr_as_jump(instr)->type == nir_jump_continue &&
+             instr == nir_block_last_instr(block))
+            continue;
+         return -1;
+      default:
+         return -1;
+      }
+      n++;
+   }
+   return n;
+}
+
+static bool
+nak_cg_punroll_lone_break(nir_block *block)
+{
+   nir_instr *last = nir_block_last_instr(block);
+   return last != NULL && last == nir_block_first_instr(block) &&
+          last->type == nir_instr_type_jump &&
+          nir_instr_as_jump(last)->type == nir_jump_break;
+}
+
+static nir_op
+nak_cg_punroll_invert(nir_op op)
+{
+   switch (op) {
+   case nir_op_ieq: return nir_op_ine;
+   case nir_op_ine: return nir_op_ieq;
+   case nir_op_ilt: return nir_op_ige;
+   case nir_op_ige: return nir_op_ilt;
+   case nir_op_ult: return nir_op_uge;
+   case nir_op_uge: return nir_op_ult;
+   default: return nir_num_opcodes;
+   }
+}
+
+/* The header phi p whose back-edge value is p + 1, if def is p (d = 0) or that p + 1 (d = 1). */
+static bool nak_cg_predload_enabled(void);
+
+static nir_phi_instr *
+nak_cg_punroll_counter(nir_block *a, nir_block *z, nir_def *def, unsigned *d, unsigned *step)
+{
+   nir_foreach_phi(phi, a) {
+      if (phi->def.bit_size != 32 || phi->def.num_components != 1)
+         continue;
+      nir_phi_src *back = nir_phi_get_src_from_block(phi, z);
+      if (back == NULL)
+         continue;
+      nir_instr *u = nir_def_instr(back->src.ssa);
+      if (u->type != nir_instr_type_alu)
+         continue;
+      nir_alu_instr *add = nir_instr_as_alu(u);
+      if (add->op != nir_op_iadd || add->def.num_components != 1)
+         continue;
+      bool ok = false;
+      uint64_t st = 0;
+      for (unsigned s = 0; s < 2; s++) {
+         if (add->src[s].src.ssa == &phi->def && add->src[s].swizzle[0] == 0 &&
+             nir_src_is_const(add->src[1 - s].src)) {
+            st = nir_alu_src_as_uint(add->src[1 - s]);
+            /* speed267: a grid-stride loop (i += threads per group) is as countable as i++; particle steps 64 */
+            if (st == 1 || (nak_cg_predload_enabled() && st >= 2 && st <= 4096))
+               ok = true;
+         }
+      }
+      if (!ok)
+         continue;
+      if (def == &phi->def) {
+         *d = 0;
+         *step = st;
+         return phi;
+      }
+      if (def == &add->def) {
+         *d = 1;
+         *step = st;
+         return phi;
+      }
+   }
+   return NULL;
+}
+
+/* NVMTL b79 (patch_cg_punroll2.py): NVMTL_NAK_NO_PUNROLL2=1 = u3's punroll (16-load chunks, no F/2 cascade). */
+static bool
+nak_cg_punroll2_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *e = getenv("NVMTL_NAK_NO_PUNROLL2");
+      enabled = !(e != NULL && e[0] == '1');
+   }
+   return enabled;
+}
+
+static bool
+nak_cg_punroll_plan_loop(nir_loop *loop, struct nak_cg_punroll_plan *p)
+{
+   if (loop->control == nir_loop_control_dont_unroll || nir_loop_has_continue_construct(loop))
+      return false;
+   if (exec_list_length(&loop->body) != 3)
+      return false;
+   nir_cf_node *n0 = exec_node_data(nir_cf_node, exec_list_get_head(&loop->body), node);
+   nir_cf_node *n1 = nir_cf_node_next(n0), *n2 = nir_cf_node_next(n1);
+   if (n0->type != nir_cf_node_block || n1->type != nir_cf_node_if || n2->type != nir_cf_node_block)
+      return false;
+   nir_block *a = nir_cf_node_as_block(n0), *z = nir_cf_node_as_block(n2);
+   nir_if *t = nir_cf_node_as_if(n1);
+   nir_block *tb = nir_if_first_then_block(t), *eb = nir_if_first_else_block(t);
+   if (tb != nir_if_last_then_block(t) || eb != nir_if_last_else_block(t))
+      return false;
+   bool brk_then;
+   if (nak_cg_punroll_lone_break(tb) && exec_list_is_empty(&eb->instr_list))
+      brk_then = true;
+   else if (nak_cg_punroll_lone_break(eb) && exec_list_is_empty(&tb->instr_list))
+      brk_then = false;
+   else
+      return false;
+
+   unsigned loads = 0;
+   int ca = nak_cg_punroll_block_cost(a, true, false, &loads);
+   int cz = nak_cg_punroll_block_cost(z, false, true, &loads);
+   if (ca < 0 || cz < 0 || loads == 0)
+      return false;
+   unsigned cost = ca + cz;
+   unsigned f = cost <= 24 ? 8 : cost <= 48 ? 4 : 0;
+   /* punroll2: 8, not 16 -- NAK has 6 scoreboards, so loads past ~6 wait on the first (f06_2 u3 SASS) */
+   while (f > 1 && f * loads > (nak_cg_punroll2_enabled() ? 8 : 16))
+      f /= 2;
+   if (f < 2)
+      return false;
+
+   /* every header phi is entered from the preheader and from z, nothing else */
+   nir_block *pre = nir_cf_node_as_block(nir_cf_node_prev(&loop->cf_node));
+   nir_foreach_phi(phi, a) {
+      if (exec_list_length(&phi->srcs) != 2 || nir_phi_get_src_from_block(phi, pre) == NULL ||
+          nir_phi_get_src_from_block(phi, z) == NULL)
+         return false;
+   }
+
+   nir_instr *ci = nir_def_instr(t->condition.ssa);
+   if (ci->type != nir_instr_type_alu || ci->block != a)
+      return false;
+   nir_alu_instr *cmp = nir_instr_as_alu(ci);
+   if (cmp->def.num_components != 1 || cmp->src[0].swizzle[0] != 0 || cmp->src[1].swizzle[0] != 0)
+      return false;
+   nir_op op = brk_then ? cmp->op : nak_cg_punroll_invert(cmp->op);
+   if (op != nir_op_ieq && op != nir_op_ige && op != nir_op_uge)
+      return false;
+
+   unsigned d = 0, step = 1;
+   nir_phi_instr *iv = NULL;
+   nir_def *n = NULL;
+   for (unsigned s = 0; s < 2 && iv == NULL; s++) {
+      if (s == 1 && op != nir_op_ieq)
+         break;   /* ige / uge are exit when t >= n: the counter must be the left operand */
+      iv = nak_cg_punroll_counter(a, z, cmp->src[s].src.ssa, &d, &step);
+      n = cmp->src[1 - s].src.ssa;
+   }
+   if (iv == NULL || n->bit_size != 32 || n->num_components != 1)
+      return false;
+   if (step != 1 && op == nir_op_ieq)
+      return false;   /* t == n can be stepped over by a stride > 1 */
+   /* n is loop-invariant: defined in a block that comes before the loop */
+   if (nir_def_block(n)->index >= nir_loop_first_block(loop)->index)
+      return false;
+
+   *p = (struct nak_cg_punroll_plan){ loop, a, z, iv, d, n, op, f, step };
+   return true;
+}
+
+static nir_def *
+nak_cg_punroll_remap(struct hash_table *remap, nir_def *def)
+{
+   struct hash_entry *e = _mesa_hash_table_search(remap, def);
+   return e ? e->data : def;
+}
+
+static void
+nak_cg_punroll_apply(nir_shader *nir, struct nak_cg_punroll_plan *p)
+{
+   nir_loop *loop = p->loop;
+   nir_block *pre = nir_cf_node_as_block(nir_cf_node_prev(&loop->cf_node));
+
+   /* snapshot the header phis and their entry/back values before the CFG changes */
+   unsigned nphi = 0;
+   nir_foreach_phi(phi, p->a)
+      nphi++;
+   nir_phi_instr **lphi = ralloc_array(NULL, nir_phi_instr *, nphi);
+   nir_phi_instr **mphi = ralloc_array(lphi, nir_phi_instr *, nphi);
+   nir_def **init = ralloc_array(lphi, nir_def *, nphi);
+   nir_def **back = ralloc_array(lphi, nir_def *, nphi);
+   nir_def **cur = ralloc_array(lphi, nir_def *, nphi);
+   unsigned k = 0, ivk = 0;
+   nir_foreach_phi(phi, p->a) {
+      lphi[k] = phi;
+      init[k] = nir_phi_get_src_from_block(phi, pre)->src.ssa;
+      back[k] = nir_phi_get_src_from_block(phi, p->z)->src.ssa;
+      if (phi == p->iv)
+         ivk = k;
+      k++;
+   }
+
+   nir_loop *m = nir_loop_create(nir_cf_node_get_function(&loop->cf_node));   /* 26.3: takes the owning impl */
+   m->control = nir_loop_control_dont_unroll;
+   loop->control = nir_loop_control_dont_unroll;
+   nir_cf_node_insert(nir_before_cf_node(&loop->cf_node), &m->cf_node);
+   nir_block *mpre = nir_cf_node_as_block(nir_cf_node_prev(&m->cf_node));
+   nir_block *lpre = nir_cf_node_as_block(nir_cf_node_prev(&loop->cf_node));
+   nir_block *mh = nir_loop_first_block(m);
+
+   for (k = 0; k < nphi; k++) {
+      mphi[k] = nir_phi_instr_create(nir);
+      nir_def_init(&mphi[k]->instr, &mphi[k]->def, lphi[k]->def.num_components, lphi[k]->def.bit_size);
+      nir_instr_insert(nir_after_phis(mh), &mphi[k]->instr);
+      cur[k] = &mphi[k]->def;
+   }
+
+   nir_builder b = nir_builder_at(nir_after_block(mh));
+   /* a chunk of f bodies at iv, iv+step, ... needs iv + (f-1)*step < n; (n - t0) >= f*step is that, conservatively */
+   nir_def *t0 = p->d ? nir_iadd_imm(&b, &mphi[ivk]->def, p->step) : &mphi[ivk]->def;
+   nir_def *g = nir_uge(&b, nir_isub(&b, p->n, t0), nir_imm_int(&b, p->f * p->step));
+   if (p->exit_op == nir_op_ige)
+      g = nir_iand(&b, nir_ilt(&b, t0, p->n), g);
+   else if (p->exit_op == nir_op_uge)
+      g = nir_iand(&b, nir_ult(&b, t0, p->n), g);
+   nir_push_if(&b, nir_inot(&b, g));
+   nir_jump(&b, nir_jump_break);
+   nir_pop_if(&b, NULL);
+
+   struct hash_table *remap = _mesa_pointer_hash_table_create(lphi);
+   for (unsigned c = 0; c < p->f; c++) {
+      _mesa_hash_table_clear(remap, NULL);
+      for (k = 0; k < nphi; k++)
+         _mesa_hash_table_insert(remap, &lphi[k]->def, cur[k]);
+      nir_block *blocks[2] = { p->a, p->z };
+      for (unsigned bi = 0; bi < 2; bi++) {
+         nir_foreach_instr(instr, blocks[bi]) {
+            if (instr->type == nir_instr_type_phi || instr->type == nir_instr_type_jump)
+               continue;
+            nir_builder_instr_insert(&b, nir_instr_clone_deep(nir, instr, remap));
+         }
+      }
+      for (k = 0; k < nphi; k++)
+         cur[k] = nak_cg_punroll_remap(remap, back[k]);
+   }
+
+   nir_block *mlast = nir_loop_last_block(m);
+   for (k = 0; k < nphi; k++) {
+      /* nir_phi_instr_add_src does not link the use: that happens at insertion, and these phis are already in
+       * (they had to exist before the chunk that reads them). Unlinked, validation fails SRC_TAG_SEEN (census u3 v0). */
+      nir_phi_src *ps = nir_phi_instr_add_src(mphi[k], mpre, init[k]);
+      list_addtail(&ps->src.use_link, &init[k]->uses);
+      ps = nir_phi_instr_add_src(mphi[k], mlast, cur[k]);
+      list_addtail(&ps->src.use_link, &cur[k]->uses);
+      /* L is now entered from M's exit, which only leaves from its header: the header phis are the live values */
+      nir_phi_src *ls = nir_phi_get_src_from_block(lphi[k], lpre);
+      /* never an assert: release builds drop it and a stale entry value would read as a wrong answer, not a crash */
+      if (ls == NULL) {
+         nir_foreach_phi_src(s, lphi[k]) {
+            if (s->pred != p->z)
+               ls = s;
+         }
+      }
+      nir_src_rewrite(&ls->src, &mphi[k]->def);
+   }
+   ralloc_free(lphi);
+}
+
+/* speed267 (patch_predload.py): NVMTL_NAK_NO_PREDLOAD=1 turns off nak_cg_predload and the stride-n punroll. */
+static bool
+nak_cg_predload_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *e = getenv("NVMTL_NAK_NO_PREDLOAD");
+      enabled = !(e != NULL && e[0] == '1');
+   }
+   return enabled;
+}
+
+/* Instructions of one if side that nak_cg_predload may move above the if: pure ALU, constants, and global loads
+ * that are neither volatile nor coherent (those become predicated). -1 for anything else. */
+static int
+nak_cg_predload_side(nir_block *blk, unsigned *loads)
+{
+   int n = 0;
+   nir_foreach_instr(instr, blk) {
+      switch (instr->type) {
+      case nir_instr_type_alu:
+         n++;
+         break;
+      case nir_instr_type_load_const:
+      case nir_instr_type_undef:
+         break;
+      case nir_instr_type_intrinsic: {
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic != nir_intrinsic_load_global &&
+             intr->intrinsic != nir_intrinsic_load_global_constant)
+            return -1;
+         if (nir_intrinsic_access(intr) & (ACCESS_VOLATILE | ACCESS_COHERENT))
+            return -1;
+         (*loads)++;
+         n++;
+         break;
+      }
+      default:
+         return -1;
+      }
+   }
+   return n;
+}
+
+static unsigned
+nak_cg_predload_max(void)
+{
+   static int max = -1;
+   if (max < 0) {
+      const char *e = getenv("NVMTL_NAK_PREDLOAD_MAX");
+      max = e && *e ? atoi(e) : 32;
+      if (max < 0)
+         max = 0;
+   }
+   return max;
+}
+
+static void
+nak_cg_predload_hoist(nir_shader *nir, nir_block *side, nir_block *dest, nir_def *pred)
+{
+   nir_builder b = nir_builder_create(nir_cf_node_get_function(&dest->cf_node));
+   nir_foreach_instr_safe(instr, side) {
+      if (instr->type != nir_instr_type_intrinsic) {
+         nir_instr_move(nir_after_block(dest), instr);
+         continue;
+      }
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+      b.cursor = nir_after_block(dest);
+      nir_def *addr = intr->src[0].ssa;
+      nir_def *res = nir_load_global_nv(&b, intr->def.num_components, intr->def.bit_size, addr,
+                                        nir_imm_zero(&b, 1, addr->bit_size), pred);
+      nir_intrinsic_instr *nv = nir_def_as_intrinsic(res);
+      enum gl_access_qualifier access = nir_intrinsic_access(intr);
+      if (intr->intrinsic == nir_intrinsic_load_global_constant)
+         access |= ACCESS_CAN_REORDER;
+      nir_intrinsic_set_access(nv, access);
+      nir_intrinsic_set_align_mul(nv, nir_intrinsic_align_mul(intr));
+      nir_intrinsic_set_align_offset(nv, nir_intrinsic_align_offset(intr));
+      if (nir_intrinsic_has_base(intr))
+         nir_intrinsic_set_base(nv, nir_intrinsic_base(intr));
+      nir_def_rewrite_uses(&intr->def, res);
+      nir_instr_remove(instr);
+   }
+}
+
+/* speed267: a divergent if costs bclear + bssy + bsync + a branch, every trip of a loop, and it keeps the loop
+ * out of nak_cg_punroll (which only takes straight-line bodies). GB7 particle's inner loop is
+ * `if (j != i) { load p[j]; if (0 < d2 < r2) { f += m*rsq(d2)*d; } }` for 64 trips per thread: one load in flight,
+ * two branch regions per trip. NVIDIA's compiler runs it in 47 us; we took 69 us.
+ * A small side with only ALU and plain global loads runs unconditionally instead, each load predicated on the
+ * branch condition, which LDG does in hardware: a false predicate makes no access and returns 0, so nothing
+ * is read that the program would not have read. The phis become selects in peephole_select. */
+static bool
+nak_cg_predload_once(nir_shader *nir)
+{
+   bool progress = false;
+   nir_divergence_analysis(nir);
+   nir_foreach_function_impl(impl, nir) {
+      bool p = false;
