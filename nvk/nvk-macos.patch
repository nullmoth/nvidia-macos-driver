+/* r3-conf2: WindowServer gets no shell env. When NAME is unset, read "NAME=value" from the root file
+ * /Library/GPUBundles/nvmtl/nvrm610.conf. Purpose: bisect the r3 sync/submit switches that hang WindowServer's fence. */
+#include <stdio.h>
+#include <string.h>
+static const char *nvmtl_conf_getenv(const char *name)
+{
+   const char *e = getenv(name);
+   if (e) return e;
+   static char conf[8192]; static int loaded;
+   if (!loaded) {
+      loaded = 1;
+      FILE *f = fopen("/Library/GPUBundles/nvmtl/nvrm610.conf", "r");
+      if (f) { size_t n = fread(conf, 1, sizeof conf - 1, f); conf[n] = 0; fclose(f); }
+   }
+   char key[96]; snprintf(key, sizeof key, "%s=", name);
+   const char *h = strstr(conf, key);
+   if (!h || (h != conf && h[-1] != '\n')) return NULL;
+   static char val[64]; size_t i = 0; h += strlen(key);
+   while (h[i] && h[i] != '\n' && i < sizeof val - 1) { val[i] = h[i]; i++; }
+   val[i] = 0;
+   fprintf(stderr, "nvk: %s=%s (nvrm610.conf)\n", name, val);
+   return val;
+}
