diff -ruN --exclude=subprojects --exclude=ci --exclude=build* --exclude=*.pyc --exclude=__pycache__ --exclude=*.bak* --exclude=*.orig --exclude=.git --exclude=open-gpu-kernel-modules --strip-trailing-cr upmesa/mesa-17ca6174/src/nouveau/vulkan/bvh/encode.comp rebase263/mesa/src/nouveau/vulkan/bvh/encode.comp
--- a/src/nouveau/vulkan/bvh/encode.comp	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/bvh/encode.comp	2026-10-05 09:42:44
@@ -0,0 +1,187 @@
+
+
+
+
+
+
+
+
+#version 460
+
+#extension GL_GOOGLE_include_directive : require
+
+#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_EXT_scalar_block_layout : require
+#extension GL_EXT_buffer_reference : require
+#extension GL_EXT_buffer_reference2 : require
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+#define VK_USED_BUILD_FLAGS 0
+#include "vk_bvh_helpers.h"
+#include "nvk_build_interface.h"
+#include "nvk_bvh.h"
+
+#ifndef VK_GEOMETRY_TYPE_TRIANGLES_KHR
+#define VK_GEOMETRY_TYPE_TRIANGLES_KHR 0
+#define VK_GEOMETRY_TYPE_AABBS_KHR     1
+#define VK_GEOMETRY_TYPE_INSTANCES_KHR 2
+#endif
+
+#define NVK_FLT_EPSILON 1.1920929e-7
+#define NVK_NAN uintBitsToFloat(0x7fc00000u)
+
+layout(push_constant) uniform CONSTS {
+   nvk_encode_args args;
+};
+
+uint32_t
+pack_sbt_offset_and_flags(uint32_t sbt_offset, uint32_t flags)
+{
+   uint32_t ret = sbt_offset;
+   if ((flags & 4u) != 0u)
+      ret |= NVK_INSTANCE_FORCE_OPAQUE;
+   if ((flags & 8u) == 0u)
+      ret |= NVK_INSTANCE_NO_FORCE_NOT_OPAQUE;
+   if ((flags & 1u) != 0u)
+      ret |= NVK_INSTANCE_TRIANGLE_FACING_CULL_DISABLE;
+   if ((flags & 2u) != 0u)
+      ret |= NVK_INSTANCE_TRIANGLE_FLIP_FACING;
+   return ret;
+}
+
+void
+main()
+{
+   uint32_t gid = gl_GlobalInvocationID.x;
+   uint32_t leaf_count = args.leaf_node_count;
+
+   uint32_t ir_leaf_size;
+   uint32_t out_leaf_size;
+   uint32_t leaf_type;
+   switch (args.geometry_type) {
+   case VK_GEOMETRY_TYPE_TRIANGLES_KHR:
+      ir_leaf_size = SIZEOF(vk_ir_triangle_node);
+      out_leaf_size = SIZEOF(nvk_bvh_triangle_node);
+      leaf_type = nvk_bvh_node_triangle;
+      break;
+   case VK_GEOMETRY_TYPE_AABBS_KHR:
+      ir_leaf_size = SIZEOF(vk_ir_aabb_node);
+      out_leaf_size = SIZEOF(nvk_bvh_aabb_node);
+      leaf_type = nvk_bvh_node_aabb;
+      break;
+   default:
+      ir_leaf_size = SIZEOF(vk_ir_instance_node);
+      out_leaf_size = SIZEOF(nvk_bvh_instance_node);
+      leaf_type = nvk_bvh_node_instance;
+      break;
+   }
+
+
+   uint32_t internal_count = max(DEREF(args.header).ir_internal_node_count, 1u);
+   uint32_t leaf_nodes_offset = NVK_BVH_HEADER_SIZE + internal_count * SIZEOF(nvk_bvh_box_node);
+   uint32_t root_offset = leaf_count * ir_leaf_size;
+
+   if (gid < leaf_count) {
+      VOID_REF src = OFFSET(args.intermediate_bvh, gid * ir_leaf_size);
+      VOID_REF dst = OFFSET(args.output_bvh, leaf_nodes_offset + gid * out_leaf_size);
+      switch (args.geometry_type) {
+      case VK_GEOMETRY_TYPE_TRIANGLES_KHR: {
+         vk_ir_triangle_node s = DEREF(REF(vk_ir_triangle_node)(src));
+         REF(nvk_bvh_triangle_node) d = REF(nvk_bvh_triangle_node)(dst);
+         for (uint32_t i = 0; i < 3; i++)
+            for (uint32_t j = 0; j < 3; j++)
+               DEREF(d).coords[i][j] = s.coords[i][j];
+         DEREF(d).padding = 0;
+         DEREF(d).primitive_id = s.triangle_id;
+         DEREF(d).geometry_id_and_flags = s.geometry_id_and_flags;
+         break;
+      }
+      case VK_GEOMETRY_TYPE_AABBS_KHR: {
+         vk_ir_aabb_node s = DEREF(REF(vk_ir_aabb_node)(src));
+         REF(nvk_bvh_aabb_node) d = REF(nvk_bvh_aabb_node)(dst);
+         DEREF(d).bounds = s.base.aabb;
+         DEREF(d).primitive_id = s.primitive_id;
+         DEREF(d).geometry_id_and_flags = s.geometry_id_and_flags;
+         break;
+      }
+      default: {
+         vk_ir_instance_node s = DEREF(REF(vk_ir_instance_node)(src));
+         REF(nvk_bvh_instance_node) d = REF(nvk_bvh_instance_node)(dst);
+         DEREF(d).bvh_ptr = s.base_ptr;
+         DEREF(d).custom_instance_and_mask = s.custom_instance_and_mask;
+         DEREF(d).sbt_offset_and_flags =
+            pack_sbt_offset_and_flags(s.sbt_offset_and_flags & 0xFFFFFFu, s.sbt_offset_and_flags >> 24);
+         DEREF(d).padding = 0;
+         DEREF(d).instance_id = s.instance_id;
+         mat3x4 o = s.otw_matrix;
+         DEREF(d).otw_matrix = o;
+         mat3 M = transpose(mat3(o[0].xyz, o[1].xyz, o[2].xyz));
+         mat3 Mi = inverse(M);
+         vec3 t = vec3(o[0].w, o[1].w, o[2].w);
+         vec3 ti = -(Mi * t);
+         mat3x4 w;
+         for (int i = 0; i < 3; i++)
+            w[i] = vec4(Mi[0][i], Mi[1][i], Mi[2][i], ti[i]);
+         DEREF(d).wto_matrix = w;
+         break;
+      }
+      }
+   }
+
+   if (gid >= internal_count)
+      return;
+
+   uint32_t src_index = internal_count - 1 - gid;
+   REF(vk_ir_box_node) src =
+      REF(vk_ir_box_node)(OFFSET(args.intermediate_bvh, root_offset + src_index * SIZEOF(vk_ir_box_node)));
+   REF(nvk_bvh_box_node) dst =
+      REF(nvk_bvh_box_node)(OFFSET(args.output_bvh, NVK_BVH_HEADER_SIZE + gid * SIZEOF(nvk_bvh_box_node)));
+
+   bool built = DEREF(args.header).ir_internal_node_count > 0;
+
+   for (uint32_t c = 0; c < 2; c++) {
+      uint32_t child = built ? DEREF(src).children[c] : VK_BVH_INVALID_NODE;
+      if (child == VK_BVH_INVALID_NODE) {
+         DEREF(dst).bounds[c].min = vec3(NVK_NAN);
+         DEREF(dst).bounds[c].max = vec3(NVK_NAN);
+         DEREF(dst).children[c] = NVK_BVH_INVALID_NODE;
+         continue;
+      }
+
+      uint32_t child_offset = child & ~3u;
+      vk_aabb aabb = DEREF(REF(vk_ir_node)(OFFSET(args.intermediate_bvh, child_offset))).aabb;
+      aabb.min -= max(abs(aabb.min), vec3(1.0)) * NVK_FLT_EPSILON;
+      aabb.max += max(abs(aabb.max), vec3(1.0)) * NVK_FLT_EPSILON;
+      DEREF(dst).bounds[c] = aabb;
+
+      if (child_offset < root_offset) {
+         uint32_t leaf_index = child_offset / ir_leaf_size;
+         DEREF(dst).children[c] = (leaf_nodes_offset + leaf_index * out_leaf_size) | leaf_type;
+      } else {
+         uint32_t si = (child_offset - root_offset) / SIZEOF(vk_ir_box_node);
+         uint32_t di = internal_count - si - 1;
+         DEREF(dst).children[c] = (NVK_BVH_HEADER_SIZE + di * SIZEOF(nvk_bvh_box_node)) | nvk_bvh_node_internal;
+      }
+   }
+
+   if (gid == 0) {
+      REF(nvk_bvh_header) header = REF(nvk_bvh_header)(args.output_bvh);
+      if (built) {
+         DEREF(header).bounds = DEREF(src).base.aabb;
+      } else {
+         DEREF(header).bounds.min = vec3(NVK_NAN);
+         DEREF(header).bounds.max = vec3(NVK_NAN);
+      }
+      uint32_t instance_count = args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR ? leaf_count : 0;
+      DEREF(header).instance_count = instance_count;
+      DEREF(header).leaf_nodes_offset = leaf_nodes_offset;
+      DEREF(header).compacted_size = args.bvh_size;
+      DEREF(header).serialization_size = 56u + 8u * instance_count + args.bvh_size;
+      DEREF(header).padding = 0;
+   }
+}
diff -ruN --exclude=subprojects --exclude=ci --exclude=build* --exclude=*.pyc --exclude=__pycache__ --exclude=*.bak* --exclude=*.orig --exclude=.git --exclude=open-gpu-kernel-modules --strip-trailing-cr upmesa/mesa-17ca6174/src/nouveau/vulkan/bvh/meson.build rebase263/mesa/src/nouveau/vulkan/bvh/meson.build
--- a/src/nouveau/vulkan/bvh/meson.build	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/bvh/meson.build	2026-10-05 09:23:46
@@ -0,0 +1,36 @@
+# NVK's BVH encode shader (rung 3— compiled by glslang at build time, the RADV bvh/meson.build pattern.
+nvk_bvh_shaders = [
+  [
+    'encode.comp',
+    'nvk_encode',
+  ],
+]
+
+nvk_bvh_include_dir = dir_source_root + '/src/nouveau/vulkan/bvh'
+nvk_dir_include_dir = dir_source_root + '/src/nouveau/vulkan'
+nvk_vk_bvh_include_dir = dir_source_root + '/src/vulkan/runtime/bvh'
+
+nvk_bvh_includes = files(
+  'nvk_build_interface.h',
+  '../nvk_bvh.h',
+  nvk_vk_bvh_include_dir + '/vk_bvh_helpers.h',
+  nvk_vk_bvh_include_dir + '/vk_bvh_defines.h',
+)
+
+nvk_bvh_spv = []
+foreach s : nvk_bvh_shaders
+  command = [
+    prog_glslang, '-V', '-I' + nvk_bvh_include_dir, '-I' + nvk_dir_include_dir, '-I' + nvk_vk_bvh_include_dir,
+    '--target-env', 'spirv1.5', '-x', '-o', '@OUTPUT@', '@INPUT@', glslang_depfile, glslang_quiet,
+  ]
+
+  _nvk_bvh_name = '@0@.spv.h'.format(s[1])
+  nvk_bvh_spv += custom_target(
+    _nvk_bvh_name,
+    input : s[0],
+    output : _nvk_bvh_name,
+    command : command,
+    depfile : f'@_nvk_bvh_name@.d',
+    depend_files: nvk_bvh_includes
+  )
+endforeach
diff -ruN --exclude=subprojects --exclude=ci --exclude=build* --exclude=*.pyc --exclude=__pycache__ --exclude=*.bak* --exclude=*.orig --exclude=.git --exclude=open-gpu-kernel-modules --strip-trailing-cr upmesa/mesa-17ca6174/src/nouveau/vulkan/bvh/nvk_build_interface.h rebase263/mesa/src/nouveau/vulkan/bvh/nvk_build_interface.h
--- a/src/nouveau/vulkan/bvh/nvk_build_interface.h	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/bvh/nvk_build_interface.h	2026-10-05 09:23:46
@@ -0,0 +1,24 @@
+
+
+#ifndef NVK_BVH_BUILD_INTERFACE_H
+#define NVK_BVH_BUILD_INTERFACE_H
+
+#ifdef VULKAN
+#include "vk_bvh_defines.h"
+#else
+#include <stdint.h>
+#include "bvh/vk_bvh_defines.h"
+#endif
+
+
+struct nvk_encode_args {
+   VOID_REF intermediate_bvh;
+   VOID_REF output_bvh;
+   REF(vk_ir_header) header;
+   uint32_t leaf_node_count;
+   uint32_t geometry_type;
+   uint32_t bvh_size;
+   uint32_t padding;
+};
