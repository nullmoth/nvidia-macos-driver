+VkResult
+nvkmd_nvrm_create_dev(struct nvkmd_pdev *_pdev,
+                         struct vk_object_base *log_obj,
+                         struct nvkmd_dev **dev_out)
+{
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(_pdev);
+
+   struct nvkmd_nvrm_dev *dev = CALLOC_STRUCT(nvkmd_nvrm_dev);
+   if (dev == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   dev->base.ops = &nvkmd_nvrm_dev_ops;
+   dev->base.pdev = &pdev->base;
+
+
+   list_inithead(&dev->base.mems);
+   simple_mtx_init(&dev->base.mems_mutex, mtx_plain);
+
+   dev->mappings = _mesa_hash_table_create(NULL, _mesa_hash_pointer, _mesa_key_pointer_equal);
+   if (dev->mappings == NULL) {
+   	  nvkmd_dev_destroy(&dev->base);
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   dev->osEvent = -1;
+   dev->hEvent = 0;
+   {
+      struct NvRmApi rm;
+      nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+      dev->osEvent = NVRM_OPEN(rm.nodeName);
+      if (dev->osEvent >= 0) {
+         struct NvRmApi rmOsEvent = rm;
+         rmOsEvent.fd = dev->osEvent;
+         NV0005_ALLOC_PARAMETERS eventParams = {
+            .hParentClient = pdev->hClient,
+            .hSrcResource = pdev->hSubdevice,
+            .hClass = NV01_EVENT_OS_EVENT,
+            .notifyIndex = NV2080_NOTIFIERS_GRAPHICS | NV01_EVENT_NONSTALL_INTR |
+                           NV01_EVENT_WITHOUT_EVENT_DATA | NV01_EVENT_SUBDEVICE_SPECIFIC |
+                           DRF_NUM(0005, _NOTIFY_INDEX, _SUBDEVICE, 0),
+            .data = (NvP64)(uintptr_t)dev->osEvent,
+         };
+         if (nvRmApiAllocOsEvent(&rmOsEvent, dev->osEvent) != NV_OK ||
+             nvRmApiAlloc(&rm, pdev->hSubdevice, &dev->hEvent, NV01_EVENT_OS_EVENT, &eventParams) != NV_OK) {
+            fprintf(stderr, "nvrm: b73 device event NOT allocated - waits keep polling\n");
+            NVRM_CLOSE(dev->osEvent);
+            dev->osEvent = -1;
+            dev->hEvent = 0;
+         }
+      }
+   }
+
+   *dev_out = &dev->base;
+
+   return VK_SUCCESS;
+}
+
+static void
+nvkmd_nvrm_dev_destroy(struct nvkmd_dev *_dev)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+
+   if (dev->mappings != NULL)
+      _mesa_hash_table_destroy(dev->mappings, NULL);
+
+   if (dev->hEvent != 0) {
+      struct NvRmApi rm;
+      nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+      nvRmApiFree(&rm, dev->hEvent);
+   }
+   if (dev->osEvent >= 0)
+      NVRM_CLOSE(dev->osEvent);
+
+   FREE(dev);
+}
+
+static VkResult
+nvkmd_nvrm_dev_get_gpu_timestamp_checked(struct nvkmd_dev *_dev,
+                                       uint64_t *timestamp)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   struct NvRmApi rm = {0};
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+   NV2080_CTRL_TIMER_GET_TIME_PARAMS params = {0};
+   NvU32 status = nvRmApiControl(&rm, pdev->hSubdevice,
+                                NV2080_CTRL_CMD_TIMER_GET_TIME,
+                                &params, sizeof(params));
+   if (status != NV_OK)
+      return VK_ERROR_UNKNOWN;
+
+
+   *timestamp = params.time_nsec;
+   return VK_SUCCESS;
+}
+
+static int
+nvkmd_nvrm_dev_get_drm_fd(struct nvkmd_dev *_dev)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+
+   return -1;
+}
