+
+/* pass_flags: 1 = a global load of this block, or an ALU fed (inside it) by one. */
+struct nak_cg_ld_state { nir_block *b; bool hit; };
+static bool
+nak_cg_ld_src_cb(nir_src *src, void *data)
+{
+   struct nak_cg_ld_state *st = data;
+   nir_instr *p = nir_def_instr(src->ssa);
+   if (p->block == st->b && p->pass_flags == 1)
+      st->hit = true;
+   return true;
+}
