+      instr->pass_flags = 0;
+      if (nak_cg_is_global_load(instr)) {
+         instr->pass_flags = 1;
+      } else if (instr->type == nir_instr_type_alu) {
+         struct nak_cg_ld_state st = { b, false };
+         nir_foreach_src(instr, nak_cg_ld_src_cb, &st);
+         instr->pass_flags = st.hit;
+      }
+   }
+
+   bool progress = false;
+   nir_foreach_instr_reverse_safe(instr, b) {
+      if (instr->type != nir_instr_type_alu || instr->pass_flags != 1)
+         continue;
+      nir_def *def = &nir_instr_as_alu(instr)->def;
+      /* The last global load before def's first user in b (phi/if/other-block uses sit at the block end). */
+      nir_instr *last_ld = NULL;
+      for (nir_instr *n = nir_instr_next(instr); n != NULL; n = nir_instr_next(n)) {
+         if (nak_cg_reads(n, def))
+            break;
+         if (nak_cg_is_global_load(n))
+            last_ld = n;
+      }
+      if (last_ld == NULL)
+         continue;
+      nir_instr_move(nir_after_instr(last_ld), instr);
+      progress = true;
+   }
+   return progress;
+}
+
+#include "nvmtl_raw_policy.h"
