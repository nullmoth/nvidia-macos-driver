+static bool
+nak_cg_is_global_load(const nir_instr *instr)
+{
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+   switch (nir_instr_as_intrinsic(instr)->intrinsic) {
+   case nir_intrinsic_load_global:
+   case nir_intrinsic_load_global_constant:
+   case nir_intrinsic_load_global_constant_offset:
+   case nir_intrinsic_load_global_constant_bounded:
+   case nir_intrinsic_load_global_bounded:
+   /* b79: GB7 gemm_non_block_size's j-loop is 9 ld.shared + 8 ffma in NIR order ld,ffma,ld,ffma; RA gave every
+    * loaded value and address r1, so all 9 LDS latencies serialised. NVIDIA issues its 12 LDS first. */
+   case nir_intrinsic_load_shared:
+   /* 26.3: nak_nir_lower_load_store runs BEFORE this pass and renames every global/shared load to its _nv form;
+    * without these two cases ldsink matches nothing and silently does nothing. */
+   case nir_intrinsic_load_global_nv:
+   case nir_intrinsic_load_shared_nv:
+      return true;
+   default:
+      return false;
+   }
