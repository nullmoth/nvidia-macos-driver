+/* See the file header: rounded-up workgroups, the exact count in base workgroup Y. */
+static void
+nvk_cmd_dispatch_unaligned(VkCommandBuffer commandBuffer, uint32_t x, uint32_t y, uint32_t z)
+{
+   VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   const struct nvk_shader *shader = cmd->state.cs.shader;
