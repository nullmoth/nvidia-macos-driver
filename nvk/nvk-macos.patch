+// Optional RAW register cap, integrated against the uploaded real allocator.
+// The budget participates after workgroup/hardware limits and before spilling.
+// Disabled by default. The guard catches missing participation or exceeded caps.
+thread_local! {
+    static NVMTL_RA_BUDGET: std::cell::Cell<(u32, bool)> = const {
+        std::cell::Cell::new((0, false))
+    };
+}
+unsafe extern "C" {
+    fn nvmtl_raw_budget(nir: *const nir_shader) -> u32;
+}
+pub fn nvmtl_ra_budget_limit(hw_reserved: u32) -> u32 {
+    NVMTL_RA_BUDGET.with(|v| {
+        let (cap, _) = v.get();
+        if cap == 0 { return u32::MAX; }
+        assert!(cap >= hw_reserved + 18, "RAW cap cannot satisfy NAK allocator floor");
+        v.set((cap, true));
+        cap - hw_reserved
+    })
+}
+struct NvmtlRaBudgetGuard { old: (u32, bool), cap: u32 }
+impl NvmtlRaBudgetGuard {
+    fn new(cap: u32) -> Self {
+        let old = NVMTL_RA_BUDGET.with(|v| v.replace((cap, false)));
+        Self { old, cap }
+    }
+    fn verify(&self, physical_gprs: u32) {
+        if self.cap != 0 {
+            assert!(NVMTL_RA_BUDGET.with(|v| v.get().1),
+                    "RAW cap enabled but integrated assign_regs hook did not participate");
+            assert!(physical_gprs <= self.cap, "RAW physical GPR cap was exceeded");
+            eprintln!("NVMTL_RAW_RA requested={} actual={} (physical GPRs)", self.cap, physical_gprs);
+        }
+    }
+}
+impl Drop for NvmtlRaBudgetGuard {
+    fn drop(&mut self) { NVMTL_RA_BUDGET.with(|v| v.set(self.old)); }
+}
