+// NVMTL b72 (patch_nak_immcse.py): one register per distinct immediate per block. FFMA/IMAD/etc. encode one
+// non-register source, so legalize copies the other immediate into a GPR — a fresh copy per use, which put
+// `mov imm` + a 6-cycle stall in front of every FFMA of a constant-coefficient loop (fma8: 37% of peak).
+// Vector-source components are never merged (legalize made them distinct on purpose); reuse is bounded by
+// IMM_CSE_WINDOW instructions since the kept value's last use, so no live range grows without limit.
+const IMM_CSE_WINDOW: usize = 64;
+
+fn cse_block_imm_copies(f: &mut Function) {
+    if std::env::var_os("NVMTL_NAK_NOIMMCSE").is_some() {
+        return;
+    }
+    let mut vec_used: FxHashSet<SSAValue> = Default::default();
+    for b in &f.blocks {
+        for instr in &b.instrs {
+            for src in instr.srcs() {
+                if let SrcRef::SSA(v) = &src.src_ref {
+                    if v.comps() > 1 {
+                        for c in 0..usize::from(v.comps()) {
+                            vec_used.insert(v[c]);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    let mut remap: FxHashMap<SSAValue, SSAValue> = Default::default();
+    for b in &mut f.blocks {
+        // (imm, file) -> (kept value, index of its last def/use)
+        let mut seen: FxHashMap<(u32, RegFile), (SSAValue, usize)> =
+            Default::default();
+        let mut out = Vec::with_capacity(b.instrs.len());
+        for mut instr in b.instrs.drain(..) {
+            let ip = out.len();
+            instr.for_each_ssa_use_mut(|s| {
+                if let Some(n) = remap.get(s) {
+                    *s = *n;
+                }
+            });
+            let mut key = None;
+            if let Op::Copy(op) = &instr.op {
+                if let (Dst::SSA(d), SrcRef::Imm32(u)) =
+                    (&op.dst, &op.src.src_ref)
+                {
+                    if d.comps() == 1
+                        && op.src.is_unmodified()
+                        && instr.pred.is_true()
+                        && matches!(d[0].file(), RegFile::GPR | RegFile::UGPR)
+                        && !vec_used.contains(&d[0])
+                    {
+                        key = Some(((*u, d[0].file()), d[0]));
+                    }
+                }
+            }
+            if let Some((k, dv)) = key {
+                if let Some(&(keep, last)) = seen.get(&k) {
+                    if ip - last <= IMM_CSE_WINDOW {
+                        remap.insert(dv, keep);
+                        continue;
+                    }
+                }
+                seen.insert(k, (dv, ip));
+            } else {
+                let mut used = Vec::new();
+                instr.for_each_ssa_use(|s| used.push(*s));
+                for e in seen.values_mut() {
+                    if used.contains(&e.0) {
+                        e.1 = ip;
+                    }
+                }
+            }
+            out.push(instr);
+        }
+        b.instrs = out;
+    }
+    if remap.is_empty() {
+        return;
+    }
+    // Uses in other blocks (phi sources): legalize copies are local, but rename everywhere so none can dangle.
+    for b in &mut f.blocks {
