+long
+nvkmd_nvrm_flush_timeout_ms(void)
+{
+   static long ms = -1;
+   if (ms < 0) {
+      const char *e = nvmtl_cfg_getenv("NVRM_FLUSH_TIMEOUT_MS");
+      ms = e ? atol(e) : 5000;
+   }
+   return ms;
+}
