+
+void
+nvkmd_nvrm_wait_backoff(int64_t waited_ns)
+{
+   if (waited_ns < 50000) {
+#if defined(__x86_64__)
+      for (int s = 0; s < 64; s++) __builtin_ia32_pause();
+#endif
+      return;
+   }
+   if (waited_ns < 1000000) { sched_yield(); return; }
+   if (waited_ns < 20000000) { usleep(50); return; }
+   usleep(200);
+}
+
+
+
+
+
+
+static bool
+nvrm_evwait_pending(unsigned n, const uint32_t *slot, const uint32_t *gen, const uint64_t *want, int *fd)
+{
+   bool pending = false;
+   *fd = -1;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   for (unsigned h = 0; h < n; h++) {
+      const struct nvkmd_nvrm_slot *s = &nvkmd_nvrm_slots[slot[h]];
+      if (s->ctx == NULL || s->gen != gen[h] || __atomic_load_n(s->sem, __ATOMIC_ACQUIRE) >= want[h])
+         continue;
+      pending = true;
+      if (*fd < 0 && !s->ctx->ceOnly && s->dev != NULL && nvkmd_nvrm_dev(s->dev)->osEvent >= 0)
+         *fd = nvkmd_nvrm_dev(s->dev)->osEvent;
+   }
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   return pending;
+}
+void
+nvkmd_nvrm_wait_block(int64_t waited_ns, unsigned n, const uint32_t *slot, const uint32_t *gen, const uint64_t *want)
+{
+   static int on = -1;
+
+
+   if (on < 0) {
+      const char *e = nvmtl_cfg_getenv("NVRM_EVENT_WAIT");
+      if (e && e[0]) on = e[0] != '0';
+      else { const char *pn = getprogname(); on = pn && !strcmp(pn, "WindowServer"); }
+   }
+   if (on == 0 || waited_ns < 20000 || n == 0) {
+      nvkmd_nvrm_wait_backoff(waited_ns);
+      return;
+   }
+   int fd;
+   if (!nvrm_evwait_pending(n, slot, gen, want, &fd))
+      return;
+   if (fd < 0) {
+      nvkmd_nvrm_wait_backoff(waited_ns);
+      return;
+   }
+   const int64_t seen = nvrm_xnu_wait_event(fd, 0, 0);
+   if (seen < 0) {
+      if (on) fprintf(stderr, "nvrm: b73 event wait OFF (the kext has no selector 6) - polling\n");
+      on = 0;
+      nvkmd_nvrm_wait_backoff(waited_ns);
+      return;
+   }
+   { static int said; if (!said++) fprintf(stderr, "nvrm: b73 event wait ON - waits sleep on graphics completion events (fd %d)\n", fd); }
+   if (!nvrm_evwait_pending(n, slot, gen, want, &fd) || fd < 0)
+      return;
+   (void)nvrm_xnu_wait_event(fd, (uint32_t)seen, 2000);
+}
+
+
+
+static bool
+nvrm_flush_sleep(struct nvkmd_nvrm_exec_ctx *ctx, const volatile uint64_t *sem, uint64_t want)
+{
+   static int on = -1;
+   if (on < 0) { const char *e = nvmtl_cfg_getenv("NVRM_EVENT_WAIT"); on = !(e && e[0] == '0'); }
+   if (!on || ctx->ceOnly || ctx->base.dev == NULL)
+      return false;
+   const int fd = nvkmd_nvrm_dev(ctx->base.dev)->osEvent;
+   if (fd < 0)
+      return false;
+   const int64_t seen = nvrm_xnu_wait_event(fd, 0, 0);
+   if (seen < 0) {
+      on = 0;
+      return false;
+   }
+   if (__atomic_load_n(sem, __ATOMIC_ACQUIRE) >= want)
+      return true;
+   { static int said; if (!said++) fprintf(stderr, "nvrm: b73 flush waits sleep on the device's graphics event (fd %d)\n", fd); }
+   (void)nvrm_xnu_wait_event(fd, (uint32_t)seen, 2000);
+   return true;
+}
+
+bool
+nvkmd_nvrm_seq_done(uint32_t slot, uint32_t gen, uint64_t seq)
+{
+   const struct nvkmd_nvrm_slot *s = &nvkmd_nvrm_slots[slot];
+   if (s->ctx == NULL || s->gen != gen)
+      return true;
+   return __atomic_load_n(s->sem, __ATOMIC_ACQUIRE) >= seq;
+}
+
+static void
+nvrm_gsub_fault_info(struct nvkmd_nvrm_exec_ctx *ctx)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(ctx->base.dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+   NV906F_CTRL_GET_MMU_FAULT_INFO_PARAMS fi = { 0 };
+   int frc = nvRmApiControl(&rm, ctx->hChannel, NV906F_CTRL_CMD_GET_MMU_FAULT_INFO, &fi, sizeof fi);
+   fprintf(stderr, "nvrm: MMU fault info (rc %d): addr 0x%08x%08x type 0x%x \"%s\" compute shader VA 0x%llx\n", frc,
+           fi.addrHi, fi.addrLo, fi.faultType, fi.faultString,
+           (unsigned long long)fi.shaderProgramVA[NV906F_CTRL_MMU_FAULT_SHADER_TYPE_COMPUTE]);
+}
+
+
+
+VkResult
+nvkmd_nvrm_slot_health(uint32_t slot, uint32_t gen, struct vk_object_base *log_obj)
+{
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   struct nvkmd_nvrm_slot *s = &nvkmd_nvrm_slots[slot];
+   struct nvkmd_nvrm_exec_ctx *ctx = s->gen == gen ? s->ctx : NULL;
+   bool report = false;
+   unsigned base = 0, st = 0, info32 = 0;
+   if (ctx != NULL && !s->faulted) {
+      NvNotification *errN = &((NvNotification *)ctx->notifier->map)[NV_CHANNELGPFIFO_NOTIFICATION_TYPE_ERROR];
+      st = (unsigned)errN->status;
+      info32 = (unsigned)errN->info32;
+      base = s->errBase;
+      if (st != base)
+         s->faulted = report = true;
+   }
+   const bool dead = ctx != NULL && s->faulted;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   if (!dead)
+      return VK_SUCCESS;
+   if (report) {
+      fprintf(stderr, "nvrm: channel FAULTED (error notifier status 0x%x -> 0x%x, info32 0x%x) at sem %llu of %llu flushed\n",
+              base, st, info32, (unsigned long long)__atomic_load_n((uint64_t *)ctx->sem->map, __ATOMIC_ACQUIRE),
+              (unsigned long long)ctx->wSeq);
+      nvrm_gsub_fault_info(ctx);
+   }
+   return vk_errorf(log_obj, VK_ERROR_DEVICE_LOST, "NVRM channel faulted");
+}
+
+VkResult
+nvkmd_nvrm_slot_stalled(uint32_t slot, uint32_t gen, uint64_t want, long ms, struct vk_object_base *log_obj)
+{
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   struct nvkmd_nvrm_exec_ctx *ctx = nvkmd_nvrm_slots[slot].gen == gen ? nvkmd_nvrm_slots[slot].ctx : NULL;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   if (ctx == NULL)
+      return VK_SUCCESS;
+   NvNotification *err = &((NvNotification *)ctx->notifier->map)[NV_CHANNELGPFIFO_NOTIFICATION_TYPE_ERROR];
+   KeplerBControlGPFifo *userD = ctx->userD->map;
+   fprintf(stderr, "nvrm: wait TIMEOUT - no progress in %ld ms: sem %llu want %llu (flushed %llu)  GPGet %u GPPut %u  error notifier status 0x%x info32 0x%x info16 0x%x\n",
+           ms, (unsigned long long)__atomic_load_n((uint64_t *)ctx->sem->map, __ATOMIC_ACQUIRE),
+           (unsigned long long)want, (unsigned long long)ctx->wSeq, userD->GPGet, userD->GPPut,
+           err->status, err->info32, err->info16);
+   nvrm_gsub_fault_info(ctx);
+   fprintf(stderr, "nvrm: NO channel fault was reported in %ld ms. The GPU was still working; this DEADLINE is the only reason the device is being called lost. Raise NVRM_FLUSH_TIMEOUT_MS if the work is legitimate.\n", ms);
+   return vk_errorf(log_obj, VK_ERROR_DEVICE_LOST, "NVRM channel made no progress within NVRM_FLUSH_TIMEOUT_MS");
+}
+
+struct nvrm_deferred {
+   struct nvrm_deferred *next;
+   void (*fn)(void *);
+   void *arg;
+   uint32_t gen[NVRM_CTX_MAX];
+   uint64_t seq[NVRM_CTX_MAX];
+};
+static struct nvrm_deferred *nvrm_deferred_head;
+
+
+bool
+nvkmd_nvrm_defer(struct nvkmd_dev *dev, void (*fn)(void *), void *arg)
+{
+   if (!nvkmd_nvrm_async_on())
+      return false;
+   struct nvrm_deferred *d = calloc(1, sizeof(*d));
+   bool owed = false;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   for (unsigned i = 0; i < NVRM_CTX_MAX; i++) {
+      const struct nvkmd_nvrm_slot *s = &nvkmd_nvrm_slots[i];
+      if (s->ctx != NULL && s->dev == dev && __atomic_load_n(s->sem, __ATOMIC_ACQUIRE) < s->flushed) {
+         owed = true;
+         if (d != NULL) {
+            d->gen[i] = s->gen;
+            d->seq[i] = s->flushed;
+         }
+      }
+   }
+   if (owed && d != NULL) {
+      d->fn = fn;
+      d->arg = arg;
+      d->next = nvrm_deferred_head;
+      nvrm_deferred_head = d;
+   }
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   if (!owed) {
+      free(d);
+      return false;
+   }
+   if (d == NULL) {
+      fprintf(stderr, "nvrm: G-SUB: out of host memory deferring a free - freeing NOW under work in flight\n");
+      return false;
+   }
+   nvkmd_nvrm_gsub_count(NVRM_GS_DEFER);
+   return true;
+}
+
+void
+nvkmd_nvrm_reap_deferred(void)
+{
+   if (__atomic_load_n(&nvrm_deferred_head, __ATOMIC_RELAXED) == NULL)
+      return;
+   struct nvrm_deferred *ready = NULL;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   for (struct nvrm_deferred **pp = &nvrm_deferred_head; *pp != NULL;) {
+      struct nvrm_deferred *d = *pp;
+      bool done = true;
+      for (unsigned i = 0; i < NVRM_CTX_MAX && done; i++)
+         if (d->seq[i] != 0 && !nvkmd_nvrm_seq_done(i, d->gen[i], d->seq[i]))
+            done = false;
+      if (done) {
+         *pp = d->next;
+         d->next = ready;
+         ready = d;
+      } else {
+         pp = &d->next;
+      }
+   }
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   while (ready != NULL) {
+      struct nvrm_deferred *d = ready;
+      ready = d->next;
+      d->fn(d->arg);
+      free(d);
+      nvkmd_nvrm_gsub_count(NVRM_GS_REAPED);
+   }
+}
+
+
+static VkResult
+nvrm_gsub_wait_seq(struct nvkmd_nvrm_exec_ctx *ctx, uint64_t seq, struct vk_object_base *log_obj)
+{
+   const volatile uint64_t *sem = ctx->sem->map;
+   uint64_t last = __atomic_load_n(sem, __ATOMIC_ACQUIRE);
+   if (last >= seq)
+      return VK_SUCCESS;
+   const uint32_t slot = ctx->slot1 - 1, gen = nvkmd_nvrm_slots[slot].gen;
+   const int64_t t0 = os_time_get_nano(), budget = nvkmd_nvrm_flush_timeout_ms() * 1000000LL;
+   int64_t tp = t0;
+   for (;;) {
+      const uint64_t v = __atomic_load_n(sem, __ATOMIC_ACQUIRE);
+      if (v >= seq)
+         return VK_SUCCESS;
+      VkResult r = nvkmd_nvrm_slot_health(slot, gen, log_obj);
+      if (r != VK_SUCCESS)
+         return r;
+      const int64_t t = os_time_get_nano();
+      if (v != last) {
+         last = v;
+         tp = t;
+      } else if (t - tp > budget) {
+         return nvkmd_nvrm_slot_stalled(slot, gen, seq, (long)((t - tp) / 1000000), log_obj);
+      }
+      nvkmd_nvrm_wait_block(t - t0, 1, &slot, &gen, &seq);
+   }
+}
+
+static void
+nvrm_gsub_register(struct nvkmd_nvrm_exec_ctx *ctx)
+{
+   if (!nvkmd_nvrm_async_on())
+      return;
+   volatile uint64_t *sem = ctx->sem->map;
+   *sem = 0;
+   __atomic_thread_fence(__ATOMIC_SEQ_CST);
+   NvNotification *errN = &((NvNotification *)ctx->notifier->map)[NV_CHANNELGPFIFO_NOTIFICATION_TYPE_ERROR];
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   for (unsigned i = 0; i < NVRM_CTX_MAX; i++) {
+      struct nvkmd_nvrm_slot *s = &nvkmd_nvrm_slots[i];
+      if (s->ctx != NULL)
+         continue;
+      s->ctx = ctx;
+      s->sem = sem;
+      s->semVA = ctx->sem->va->addr;
+      s->dev = ctx->base.dev;
+      s->flushed = 0;
+      s->errBase = (unsigned)errN->status;
+      s->faulted = false;
+      ctx->slot1 = i + 1;
+      break;
+   }
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   if (ctx->slot1 == 0) {
+      fprintf(stderr, "nvrm: G-SUB: all %d channel slots in use - this channel stays SYNCHRONOUS\n", NVRM_CTX_MAX);
+      return;
+   }
+   ctx->gsub = true;
+   ctx->curSlot = 0;
+   nv_push_init(&ctx->push, ctx->cmdBuf->map, 0x10000 / 4 / NVRM_CMD_SLOTS, BITFIELD_BIT(SUBC_NV9097));
+   ctx->segStart = ctx->push.start;
+}
+
+static void
+nvrm_gsub_unregister(struct nvkmd_nvrm_exec_ctx *ctx)
+{
+   if (ctx->slot1 == 0)
+      return;
+   if (ctx->wSeq != 0)
+      (void)nvrm_gsub_wait_seq(ctx, ctx->wSeq, NULL);
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   struct nvkmd_nvrm_slot *s = &nvkmd_nvrm_slots[ctx->slot1 - 1];
+   s->ctx = NULL;
+   s->sem = NULL;
+   s->gen++;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   ctx->slot1 = 0;
+   ctx->gsub = false;
+   if (nvmtl_cfg_getenv("NVRM_GSUB_LOG") != NULL) {
+      uint64_t st[1 + NVRM_GS_N];
+      nvkmd_nvrm_gsub_stats(st, 1 + NVRM_GS_N);
+      fprintf(stderr, "nvrm: G-SUB channel closed at seq %llu: submits %llu acquires %llu cpuwaits %llu slotwaits %llu fifowaits %llu deferred %llu reaped %llu waits %llu\n",
+              (unsigned long long)ctx->wSeq, (unsigned long long)st[1], (unsigned long long)st[2],
+              (unsigned long long)st[3], (unsigned long long)st[4], (unsigned long long)st[5],
+              (unsigned long long)st[6], (unsigned long long)st[7], (unsigned long long)st[8]);
+   }
+   nvkmd_nvrm_reap_deferred();
+}
+
+
+static void
+write_gp_fifo_entry(struct nvkmd_nvrm_exec_ctx *ctx, const struct nvkmd_ctx_exec *exec)
+{
+	uint32_t *ptr = (uint32_t*)ctx->gpFifo->map + 2*ctx->gpPut;
+
+	ptr[0] = DRF_NUM(A16F, _GP_ENTRY0, _GET, NvU64_LO32(exec->addr) >> 2);
+	ptr[1] =
+		DRF_NUM(A16F, _GP_ENTRY1, _GET_HI, NvU64_HI32(exec->addr)) |
+		DRF_NUM(A16F, _GP_ENTRY1, _LENGTH, (exec->size_B >> 2)) |
+		DRF_NUM(A16F, _GP_ENTRY1, _SYNC, (exec->no_prefetch ? NVA16F_GP_ENTRY1_SYNC_WAIT : NVA16F_GP_ENTRY1_SYNC_PROCEED));
+
+	ctx->gpPut = (ctx->gpPut + 1) % 0x8000;
+}
