+	};
+	int ret = nvRmIoctl(api->fd, NV_ESC_FREE_OS_EVENT, &p, sizeof(p));
+	if (ret < 0) {
+		return NV_ERR_GENERIC;
+	}
+	return p.Status;
+}
+
+/* item 7 share: another client's object into ours (NV04_DUP_OBJECT). *hObject = 0 lets the RM name it
+ * (serverCopyResource -> clientAssignResourceHandle). The source must carry a share policy granting us DUP. */
+NvU32 nvRmApiDupObject(NvRmApi *api, NvU32 hParent, NvU32 *hObject, NvU32 hClientSrc, NvU32 hObjectSrc)
+{
+	NVOS55_PARAMETERS p = {
+		.hClient = api->hClient,
+		.hParent = hParent,
+		.hObject = *hObject,
+		.hClientSrc = hClientSrc,
+		.hObjectSrc = hObjectSrc,
+		.flags = 0
+	};
+	int ret = nvRmIoctl(api->fd, NV_ESC_RM_DUP_OBJECT, &p, sizeof(p));
+	if (ret < 0) {
+		return NV_ERR_GENERIC;
+	}
+	if (p.status == NV_OK) {
+		*hObject = p.hObject;
+	}
+	return p.status;
+}
+
+/* item 7 share: NVRM.kext's SURF_VRAM (0xE2). The verdict rides back in p->status; a transport failure (an older kext
+ * answers the number with an RM error) reads as NVRM_SS_OFF. */
+NvU32 nvRmApiSurfShare(NvRmApi *api, NvU32 cmd, struct NVRMSurfShareEsc *p)
+{
+	p->version = NVRM_SURFSHARE_VERSION;
+	p->status = NVRM_SS_OFF;
+	int ret = nvRmIoctl(api->fd, cmd, p, sizeof(*p));
+	if (ret != 0) {
+		p->status = NVRM_SS_OFF;
+	}
+	return p->status;
+}
+
+NvU32 nvRmApiCardInfo(NvRmApi *api, nv_ioctl_card_info_t *ci, size_t size)
+{
+	int ret = nvRmIoctl(api->fd, NV_ESC_CARD_INFO, ci, size);
+	if (ret < 0) {
+		return NV_ERR_GENERIC;
+	}
+	return NV_OK;
+}
