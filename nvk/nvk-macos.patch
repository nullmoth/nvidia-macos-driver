+#ifndef NVMTL_RAW_POLICY_H
+#define NVMTL_RAW_POLICY_H
+#include <stdlib.h>
+#include <stdint.h>
+#include <string.h>
+
+static int nvmtl_raw_selected(const char *name, const char *label)
+{
+    if (getenv("NVMTL_NO_RAW_TUNING")) return 0;
+    const char *pattern = getenv("NVMTL_RAW_SHADER_MATCH");
+    if (pattern && *pattern)
+        return (name && strstr(name, pattern)) || (label && strstr(label, pattern));
+    const char *targets[] = { "kNx1RGBA6X1Yf", "k1xNRGBA1X6Yf" };
+    for (unsigned i = 0; i < 2; ++i)
+        if ((name && strstr(name, targets[i])) || (label && strstr(label, targets[i]))) return 1;
+    return 0;
+}
+
+
+static int nvmtl_raw_hex_digit(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+static int nvmtl_raw_selected_identity(const char *name, const char *label,
+                                       const uint8_t source[32])
+{
+    if (getenv("NVMTL_NO_RAW_TUNING")) return 0;
+    const char *hex = getenv("NVMTL_RAW_SOURCE_BLAKE3");
+    if (!hex) return nvmtl_raw_selected(name, label);
+    if (!source || strlen(hex) != 64) return 0;
+    unsigned nonzero = 0;
+    for (unsigned i = 0; i < 32; ++i) {
+        int hi = nvmtl_raw_hex_digit(hex[2*i]), lo = nvmtl_raw_hex_digit(hex[2*i+1]);
+        if (hi < 0 || lo < 0 || source[i] != (unsigned)(hi*16 + lo)) return 0;
+        nonzero |= source[i];
+    }
+    return nonzero != 0;
+}
+static unsigned nvmtl_raw_register_cap(const char *value)
+{
+
+    if (!value) return 0;
+    if (!strcmp(value, "40")) return 40;
+    if (!strcmp(value, "48")) return 48;
+    if (!strcmp(value, "64")) return 64;
+    if (!strcmp(value, "80")) return 80;
+    if (!strcmp(value, "96")) return 96;
+    return 0;
+}
+static inline int nvmtl_raw_pressure_enabled(const char *name, const char *label)
+{
+    const char *e = getenv("NVMTL_RAW_PRESSURE");
+    return e && !strcmp(e, "1") && nvmtl_raw_selected(name, label);
+}
+
+static int nvmtl_raw_hash_list(const char *list, const uint8_t source[32])
+{
+    if (!list || !source || !*list) return 0;
+
+    unsigned count = 0, matched = 0;
+    const char *p = list;
+    while (*p) {
+        unsigned nonzero = 0, equal = 1;
+        if (++count > 32) return 0;
+        for (unsigned i = 0; i < 32; ++i) {
+            if (!p[0] || !p[1]) return 0;
+            int hi = nvmtl_raw_hex_digit(p[0]);
+            int lo = nvmtl_raw_hex_digit(p[1]);
+            if (hi < 0 || lo < 0) return 0;
+            unsigned b = (unsigned)(hi * 16 + lo);
+            nonzero |= b; equal &= b == source[i]; p += 2;
+        }
+        if (!nonzero) return 0;
+        matched |= equal;
+        if (!*p) break;
+        if (*p++ != ',' || !*p) return 0;
+    }
+    return matched != 0;
+}
+static int nvmtl_raw_selected_entrypoint(const char *name, const char *label,
+                                        const char *entrypoint,
+                                        const uint8_t source[32])
+{
+    if (getenv("NVMTL_NO_RAW_TUNING")) return 0;
+    const char *list = getenv("NVMTL_RAW_SOURCE_BLAKE3_LIST");
+    const char *single = getenv("NVMTL_RAW_SOURCE_BLAKE3");
+    if (list) return !single && nvmtl_raw_hash_list(list, source);
+    if (single) return nvmtl_raw_selected_identity(name, label, source);
+    const char *override = getenv("NVMTL_RAW_SHADER_MATCH");
+    if (override && *override)
+        return nvmtl_raw_selected(name, label) ||
+               (entrypoint && strstr(entrypoint, override));
+
+    const char *targets[] = {"kNx1RGBA6X1Yf", "k1xNRGBA1X6Yf"};
+    for (unsigned i = 0; i < 2; ++i)
+        if ((entrypoint && !strcmp(entrypoint, targets[i])) ||
+            (name && !strcmp(name, targets[i])) ||
+            (label && !strcmp(label, targets[i]))) return 1;
+    return 0;
+}
+static unsigned nvmtl_small_array_limit(const char *value)
+{
+    if (!value || getenv("NVMTL_NO_SMALL_ARRAYS")) return 0;
+    if (!strcmp(value, "8")) return 8;
+    if (!strcmp(value, "16")) return 16;
+    if (!strcmp(value, "32")) return 32;
+    return 0;
+}
