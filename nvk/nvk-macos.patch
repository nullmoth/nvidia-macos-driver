+                                                          .zcullMode = NV2080_CTRL_CTXSW_ZCULL_MODE_SEPARATE_BUFFER };
+            NV_STATUS bs = nvRmApiControl(&rm, pdev->hSubdevice, NV2080_CTRL_CMD_GR_CTXSW_ZCULL_BIND, &zb, sizeof zb);
+            if (bs != NV_OK || nvmtl_cfg_getenv("NVK_PREEMPT_LOG"))
+               fprintf(stderr, "nvrm: b81 ZCULL_BIND %u B SEPARATE rc 0x%x\n", (unsigned)zp.size, (unsigned)bs);
+         }
+      } else if (nvmtl_cfg_getenv("NVK_PREEMPT_LOG")) {
+         fprintf(stderr, "nvrm: b81 zcull context properties rc 0x%x size %u - not bound\n", (unsigned)zs, (unsigned)zp.size);
+      }
+   }
+   if (nvmtl_cfg_getenv("NVK_PREEMPT_LOG"))
+      fprintf(stderr, "nvrm: b81 channel 0x%x %s: tsg 0x%x ctxshare 0x%x engineType %u\n", (unsigned)ctx->hChannel,
+              ctx->ceOnly ? "COPY-ENGINE" : "graphics", (unsigned)ctx->hTsg, (unsigned)ctx->hCtxShare, (unsigned)engineType);
+
+   /* b73 (patch_evdev.py): NO per-channel non-stall event. WAS one GRAPHICS event per channel (copy-engine ones too)
+    * in every process; RM notifies every event on the GR list for each interrupt, so 26,214 posts/s at idle (b73b
+    * backtrace). The device's one event (nvkmd_nvrm_dev.c) is what waits sleep on. osEvent stays -1 and
+    * hEvent 0 here, which the teardown below already tolerates. */
+
+   nv_push_init(&ctx->push, ctx->cmdBuf->map, 0x10000 / 4, BITFIELD_BIT(SUBC_NV9097));
+   nvrm_gsub_register(ctx);   // G-SUB (b79): a ring slot push + a channel slot, when NVRM_ASYNC is on
+
+   *ctx_out = &ctx->base;
+   return VK_SUCCESS;
+
+error:
+   nvkmd_ctx_destroy(&ctx->base);
+	return vkRes;
+}
+
+/* (user upload NM-YX7CDV45, RTX 3060 Ti GA104): RM created the COPY4 channel and then refused the copy object on
+ * it ("chandesConstruct_IMPL: bad class 0xc7b5"), so every vkCreateDevice failed (-13) and WindowServer crash-looped
+ * on a black screen. COPY4 is the async copy engine NVIDIA's 610 driver used on the RTX 5060 (Blackwell); copy
+ * engine numbering and the classes each one exposes differ per chip. When the copy-engine context cannot be built
+ * on this GPU, build the copy queue on a graphics channel instead (the b80 shape, which every chip runs). */
+static VkResult
+nvkmd_nvrm_create_exec_ctx(struct nvkmd_dev *_dev,
+                              struct vk_object_base *log_obj,
+                              enum nvkmd_engines engines,
+                              struct nvkmd_ctx **ctx_out)
+{
+   VkResult r = nvkmd_nvrm_create_exec_ctx_on(_dev, log_obj, engines, true, ctx_out);
+   if (r != VK_SUCCESS && engines == NVKMD_ENGINE_COPY && nvrm610_on("CECHAN")) {
+      fprintf(stderr, "nvrm: copy-engine queue could not be built on this GPU (VkResult %d) - copy queue on a graphics channel\n", (int)r);
+      r = nvkmd_nvrm_create_exec_ctx_on(_dev, log_obj, engines, false, ctx_out);
+   }
+   return r;
+}
+
+/* G-SUB (b79): the GPFIFO is a 0x8000-entry ring, and up to NVRM_CMD_SLOTS flushes are in flight now. When it is
+ * full, wait for the oldest flush: the host consumed every entry before that flush's release, so gpGet moves to
+ * the gpPut recorded after it. (USERD's GPGet is never read: a WC read of VRAM, and a guess about who writes it.) */
+static VkResult
+nvrm_gsub_gpfifo_reserve(struct nvkmd_nvrm_exec_ctx *ctx, struct vk_object_base *log_obj)
+{
+   if ((ctx->gpPut + 1) % 0x8000 != ctx->gpGet)
+      return VK_SUCCESS;
+   nvkmd_nvrm_gsub_count(NVRM_GS_FIFOWAIT);
+   for (unsigned k = 1; k <= NVRM_CMD_SLOTS; k++) {
+      const unsigned s = (ctx->curSlot + k) % NVRM_CMD_SLOTS;   // oldest first
+      if (ctx->slotSeq[s] == 0)
+         continue;
+      VkResult r = nvrm_gsub_wait_seq(ctx, ctx->slotSeq[s], log_obj);
+      if (r != VK_SUCCESS)
+         return r;
+      ctx->gpGet = ctx->slotPut[s];
+      if ((ctx->gpPut + 1) % 0x8000 != ctx->gpGet)
+         return VK_SUCCESS;
+   }
+   return vk_errorf(log_obj, VK_ERROR_OUT_OF_DEVICE_MEMORY, "NVRM: one submission needs more than 0x7fff GPFIFO entries");
+}
+
+/* G-SUB (b79): the flush without the wait. Same tail, same release, same doorbell as the synchronous flush; then
+ * the push moves to the next ring slot, waiting only if the host has not passed that slot's own release yet. */
+static VkResult
+nvrm_gsub_submit(struct nvkmd_nvrm_exec_ctx *ctx, struct vk_object_base *log_obj)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(ctx->base.dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   NvNotification *notifiers = ctx->notifier->map;
+   NvNotification *submitTokenNotifier = &notifiers[NV_CHANNELGPFIFO_NOTIFICATION_TYPE_WORK_SUBMIT_TOKEN];
+   KeplerBControlGPFifo *userD = ctx->userD->map;
+
+   VkResult r = nvrm_gsub_gpfifo_reserve(ctx, log_obj);
+   if (r != VK_SUCCESS)
+      return r;
+
+   ctx->wSeq++;
+   write_l2_sysmem_tail(&ctx->push);
+   write_semaphore_release(&ctx->push, ctx->sem->va->addr, ctx->wSeq, true);
+   const struct nvkmd_ctx_exec seg = {
+      .addr = ctx->cmdBuf->va->addr + 4 * (uint64_t)(ctx->segStart - (uint32_t *)ctx->cmdBuf->map),
+      .size_B = 4 * (uint32_t)(ctx->push.end - ctx->segStart),
+   };
+   write_gp_fifo_entry(ctx, &seg);
+   userD->GPPut = ctx->gpPut;
+   // batch 56: USERD and host-visible VRAM are write-combined; drain the fill buffers before the doorbell
+   __atomic_thread_fence(__ATOMIC_SEQ_CST);
+   // With NVK_LOCAL_MAP_SYSMEM=0 USERD sits in VRAM behind BAR1. The fence only empties the CPU's write-combining
+   // buffers: the posted write can still be on its way through BAR1 when the doorbell (BAR0) reaches the host, which
+   // then reads the old GPPut and leaves this submission unseen until the next ring (measured in Cyberpunk: one
+   // channel one semaphore short, CPU readback correct, ringing again recovered it). A read through BAR1 cannot
+   // complete before the earlier writes on that path have landed.
+   (void)*(volatile NvU32 *)&userD->GPPut;
+   volatile NvU32 *doorbell = (void*)((NvU8*)pdev->usermodeMap.address + NVC361_NOTIFY_CHANNEL_PENDING);
+   *doorbell = submitTokenNotifier->info32;
+
+   const unsigned cur = ctx->curSlot, next = (cur + 1) % NVRM_CMD_SLOTS;
+   ctx->slotSeq[cur] = ctx->wSeq;
+   ctx->slotPut[cur] = ctx->gpPut;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   nvkmd_nvrm_slots[ctx->slot1 - 1].flushed = ctx->wSeq;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   nvkmd_nvrm_gsub_count(NVRM_GS_SUBMIT);
+
+   if (ctx->slotSeq[next] != 0 &&
+       __atomic_load_n((uint64_t *)ctx->sem->map, __ATOMIC_ACQUIRE) < ctx->slotSeq[next]) {
+      nvkmd_nvrm_gsub_count(NVRM_GS_SLOTWAIT);
+      r = nvrm_gsub_wait_seq(ctx, ctx->slotSeq[next], log_obj);
+      if (r != VK_SUCCESS)
+         return r;
+   }
+   ctx->curSlot = next;
+   nv_push_init(&ctx->push, (uint32_t *)ctx->cmdBuf->map + next * (0x10000 / 4 / NVRM_CMD_SLOTS),
+                0x10000 / 4 / NVRM_CMD_SLOTS, BITFIELD_BIT(SUBC_NV9097));
+   ctx->segStart = ctx->push.start;
+   nvkmd_nvrm_reap_deferred();
+   return VK_SUCCESS;
+}
+
+/* G-SUB (b79): a wait on another channel's submitted signal is a SEM_ACQUIRE (ACQ_STRICT_GEQ, 64-bit) ahead of
+ * the work; a signal submitted earlier on THIS channel needs nothing; a value no GPU signal will reach yet
+ * (CPU-signalled later, another device, no room in the slot) is waited for on the CPU, as before. */
+static VkResult
+nvrm_gsub_ctx_wait(struct nvkmd_nvrm_exec_ctx *ctx, struct vk_object_base *log_obj,
+                   uint32_t wait_count, const struct vk_sync_wait *waits)
+{
+   bool emitted = false;
+   for (uint32_t i = 0; i < wait_count; i++) {
+      uint64_t semVA = 0, seq = 0;
+      const int k = ctx->gsub ? nvkmd_nvrm_sync_gpu_target(waits[i].sync, waits[i].wait_value, ctx->slot1 - 1,
+                                                          ctx->base.dev, &semVA, &seq) : -1;
+      if (k == 0)
+         continue;
+      if (k > 0 && ctx->push.limit - ctx->push.end >= 6 + 32) {   // the acquire + the tail (<= 30 dw) still fit
+         write_semaphore_acquire(&ctx->push, semVA, seq);
+         nvkmd_nvrm_gsub_count(NVRM_GS_ACQUIRE);
+         pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);   /* r3-diag */
+         nvkmd_nvrm_slots[ctx->slot1 - 1].acqVA = semVA; nvkmd_nvrm_slots[ctx->slot1 - 1].acqSeq = seq;
+         nvkmd_nvrm_slots[ctx->slot1 - 1].acqCount++;
+         pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+         emitted = true;
+         continue;
+      }
+      nvkmd_nvrm_gsub_count(NVRM_GS_CPUWAIT);
+      VkResult r = nvkmd_nvrm_sync_cpu_wait(waits[i].sync, waits[i].wait_value, log_obj);
+      if (r != VK_SUCCESS)
+         return r;
+   }
+   if (emitted) {
+      VkResult r = nvrm_gsub_gpfifo_reserve(ctx, log_obj);
+      if (r != VK_SUCCESS)
+         return r;
+      const struct nvkmd_ctx_exec seg = {
+         .addr = ctx->cmdBuf->va->addr + 4 * (uint64_t)(ctx->segStart - (uint32_t *)ctx->cmdBuf->map),
+         .size_B = 4 * (uint32_t)(ctx->push.end - ctx->segStart),
+      };
+      write_gp_fifo_entry(ctx, &seg);
+      ctx->segStart = ctx->push.end;
+   }
+   return VK_SUCCESS;
+}
+
+/* G-SUB (b79): after the flush, each signal names this channel and the seq its release will write. A channel
+ * left synchronous (no free slot) already waited, so its signals are simply reached. */
+static void
+nvrm_gsub_ctx_signaled(struct nvkmd_nvrm_exec_ctx *ctx, uint32_t signal_count, const struct vk_sync_signal *signals)
+{
+   if (!ctx->gsub) {
+      for (uint32_t i = 0; i < signal_count; i++)
+         nvkmd_nvrm_sync_cpu_signal(signals[i].sync, signals[i].signal_value);
+      return;
+   }
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   const uint32_t slot = ctx->slot1 - 1, gen = nvkmd_nvrm_slots[slot].gen;
+   for (uint32_t i = 0; i < signal_count; i++)
+      nvkmd_nvrm_sync_add_pending(signals[i].sync, signals[i].signal_value, slot, gen, ctx->wSeq);
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+}
+
+static void
+nvkmd_nvrm_exec_ctx_destroy(struct nvkmd_ctx *_ctx)
+{
+   struct nvkmd_nvrm_exec_ctx *ctx = nvkmd_nvrm_exec_ctx(_ctx);
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(ctx->base.dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+
+   nvrm_gsub_unregister(ctx);   // G-SUB (b79): idle, then retire the channel slot and run what it deferred
+   nvRmApiFree(&rm, ctx->hEvent);
+   if (ctx->osEvent >= 0)
+      NVRM_CLOSE(ctx->osEvent);
+   nvRmApiFree(&rm, ctx->subchannels.hCopy);
+   nvRmApiFree(&rm, ctx->subchannels.hEng2d);
+   nvRmApiFree(&rm, ctx->subchannels.hEng3d);
+   nvRmApiFree(&rm, ctx->subchannels.hM2mf);
+   nvRmApiFree(&rm, ctx->subchannels.hCompute);
+   nvRmApiFree(&rm, ctx->hChannel);
+   nvRmApiFree(&rm, ctx->hCtxShare);   /* b81: 0 = never made, nvRmApiFree ignores it */
+   nvRmApiFree(&rm, ctx->hTsg);
+   nvRmApiFree(&rm, ctx->hCtxDma);
+   if (ctx->zcull != NULL)
+      nvkmd_mem_unref(ctx->zcull);      /* after the channel: RM must drop the zcull binding first */
+   for (unsigned b = 0; b < ARRAY_SIZE(ctx->preempt); b++)
+      if (ctx->preempt[b] != NULL)
+         nvkmd_mem_unref(ctx->preempt[b]);   // after the channel: RM must drop its binding first
+   if (ctx->sem != NULL)
+      nvkmd_mem_unref(ctx->sem);
+   if (ctx->cmdBuf != NULL)
+      nvkmd_mem_unref(ctx->cmdBuf);
+   if (ctx->gpFifo != NULL)
+      nvkmd_mem_unref(ctx->gpFifo);
+   if (ctx->userD != NULL)
+      nvkmd_mem_unref(ctx->userD);
+   if (ctx->notifier != NULL)
+      nvkmd_mem_unref(ctx->notifier);
+
+   FREE(ctx);
+}
+
+static VkResult
+nvkmd_nvrm_exec_ctx_wait(struct nvkmd_ctx *_ctx,
+                            struct vk_object_base *log_obj,
+                            uint32_t wait_count,
+                            const struct vk_sync_wait *waits)
+{
+   struct nvkmd_nvrm_exec_ctx *ctx = nvkmd_nvrm_exec_ctx(_ctx);
+
+   if (nvkmd_nvrm_async_on())   // G-SUB (b79): the waits are real now
+      return nvrm_gsub_ctx_wait(ctx, log_obj, wait_count, waits);
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_nvrm_exec_ctx_flush(struct nvkmd_ctx *_ctx,
+                             struct vk_object_base *log_obj)
+{
+   struct nvkmd_nvrm_exec_ctx *ctx = nvkmd_nvrm_exec_ctx(_ctx);
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(ctx->base.dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+
+   NvNotification *notifiers = ctx->notifier->map;
+   NvNotification *submitTokenNotifier = &notifiers[NV_CHANNELGPFIFO_NOTIFICATION_TYPE_WORK_SUBMIT_TOKEN];
+   KeplerBControlGPFifo *userD = ctx->userD->map;
+   uint64_t *semAdr = (uint64_t*)ctx->sem->map;
+   uint64_t semAdrGpu = ctx->sem->va->addr;
+
+   if (ctx->gsub)   // G-SUB (b79): ring the doorbell and return; the waits happen where Vulkan waits
+      return nvrm_gsub_submit(ctx, log_obj);
+
+   ctx->wSeq++;
+
+   write_l2_sysmem_tail(&ctx->push);
+   write_semaphore_release(&ctx->push, semAdrGpu, ctx->wSeq, true);
+
+   struct nvkmd_ctx_exec semExec = {
+   	.addr = ctx->cmdBuf->va->addr,
+   	.size_B = 4*nv_push_dw_count(&ctx->push),
+   };
+
+   write_gp_fifo_entry(ctx, &semExec);
+
+   userD->GPPut = ctx->gpPut;
+
+   // batch 56 (patch_nvk_wc.py): USERD and host-visible VRAM are write-combined, and a WC store can still sit in a
+   // fill buffer when the doorbell store retires. Drain them first (mfence; Linux drivers use wmb here).
+   __atomic_thread_fence(__ATOMIC_SEQ_CST);
+   // With NVK_LOCAL_MAP_SYSMEM=0 USERD sits in VRAM behind BAR1. The fence only empties the CPU's write-combining
+   // buffers: the posted write can still be on its way through BAR1 when the doorbell (BAR0) reaches the host, which
+   // then reads the old GPPut and leaves this submission unseen until the next ring (measured in Cyberpunk: one
+   // channel one semaphore short, CPU readback correct, ringing again recovered it). A read through BAR1 cannot
+   // complete before the earlier writes on that path have landed.
+   (void)*(volatile NvU32 *)&userD->GPPut;
+   volatile NvU32 *doorbell = (void*)((NvU8*)pdev->usermodeMap.address + NVC361_NOTIFY_CHANNEL_PENDING);
+   *doorbell = submitTokenNotifier->info32;
+
+   // bounded wait: unbounded before. On macOS osEvent is a dup of /dev/null (always readable), so
+   // poll returned at once and a hung channel spun a core forever with no diagnostic. NVRM_FLUSH_TIMEOUT_MS (default 5000).
+   struct timespec t0; clock_gettime(CLOCK_MONOTONIC, &t0);
+   const char *toEnv = nvmtl_cfg_getenv("NVRM_FLUSH_TIMEOUT_MS"); long timeoutMs = toEnv ? atol(toEnv) : 5000;
+   // The error notifier is where RM reports a real channel exception. Sample it BEFORE the wait so a
+   // notifier still carrying an older exception cannot kill the first healthy flush after it.
+   NvNotification *errN = &notifiers[NV_CHANNELGPFIFO_NOTIFICATION_TYPE_ERROR];
+   unsigned baseStatus = (unsigned)errN->status;
+   for (;;) {
+      uint64_t rSeq = *semAdr;
+      if (rSeq == ctx->wSeq) {
+         break;
+      }
+      // THE FAULT IS THE DEATH SIGNAL - THE CLOCK IS NOT. Measured on optical flow:
+      // "flush TIMEOUT after 5001 ms: sem 30 want 31 ... error notifier status 0x0" with MMU fault
+      // type 0x0 "NONE". Thirty flushes had already completed on this channel; the thirty-first was
+      // still RUNNING, and calling it lost tore the Metal backend down for the rest of the process.
+      // Before this, the notifier was read ONLY inside the timeout branch, so a channel that really
+      // had faulted still cost a full NVRM_FLUSH_TIMEOUT_MS before anyone looked. A fault is now fatal
+      // at once, and the ABSENCE of one is positive evidence that the GPU is merely busy.
+      if ((unsigned)errN->status != baseStatus) {
+         NV906F_CTRL_GET_MMU_FAULT_INFO_PARAMS fi = { 0 };
+         int frc = nvRmApiControl(&rm, ctx->hChannel, NV906F_CTRL_CMD_GET_MMU_FAULT_INFO, &fi, sizeof fi);
+         struct timespec tf; clock_gettime(CLOCK_MONOTONIC, &tf);
+         long fms = (tf.tv_sec - t0.tv_sec) * 1000 + (tf.tv_nsec - t0.tv_nsec) / 1000000;
+         fprintf(stderr, "nvrm: channel FAULTED after %ld ms (error notifier status 0x%x -> 0x%x, info32 0x%x): addr 0x%08x%08x type 0x%x \"%s\" compute shader VA 0x%llx (rc %d)\n",
+                 fms, baseStatus, (unsigned)errN->status, (unsigned)errN->info32, fi.addrHi, fi.addrLo, fi.faultType, fi.faultString,
+                 (unsigned long long)fi.shaderProgramVA[NV906F_CTRL_MMU_FAULT_SHADER_TYPE_COMPUTE], frc);
+         return vk_errorf(log_obj, VK_ERROR_DEVICE_LOST, "NVRM channel faulted");
+      }
+      struct timespec t1; clock_gettime(CLOCK_MONOTONIC, &t1);
+      long ms = (t1.tv_sec - t0.tv_sec) * 1000 + (t1.tv_nsec - t0.tv_nsec) / 1000000;
+      if (ms > timeoutMs) {
+         NvNotification *err = &notifiers[NV_CHANNELGPFIFO_NOTIFICATION_TYPE_ERROR];
+         fprintf(stderr, "nvrm: flush TIMEOUT after %ld ms: sem %llu want %llu  GPGet %u GPPut %u  error notifier status 0x%x info32 0x%x info16 0x%x\n", ms, (unsigned long long)rSeq, (unsigned long long)ctx->wSeq, userD->GPGet, userD->GPPut, err->status, err->info32, err->info16);
+         {  //: the fault itself, from RM — address, type, string, and the compute shader's VA
+            NV906F_CTRL_GET_MMU_FAULT_INFO_PARAMS fi = { 0 };
+            int frc = nvRmApiControl(&rm, ctx->hChannel, NV906F_CTRL_CMD_GET_MMU_FAULT_INFO, &fi, sizeof fi);
+            fprintf(stderr, "nvrm: MMU fault info (rc %d): addr 0x%08x%08x type 0x%x \"%s\" compute shader VA 0x%llx\n", frc,
+                    fi.addrHi, fi.addrLo, fi.faultType, fi.faultString,
+                    (unsigned long long)fi.shaderProgramVA[NV906F_CTRL_MMU_FAULT_SHADER_TYPE_COMPUTE]);
+         }
+         fprintf(stderr, "nvrm: NO channel fault was reported in %ld ms (error notifier status 0x%x, unchanged since submit). The GPU was still working; this DEADLINE is the only reason the device is being called lost. Raise NVRM_FLUSH_TIMEOUT_MS if the work is legitimate.\n", ms, baseStatus);
+         return vk_errorf(log_obj, VK_ERROR_DEVICE_LOST, "NVRM channel did not complete within NVRM_FLUSH_TIMEOUT_MS");
+      }
+      // batch 27  — THE WAIT WAS THE SLEEP, NOT THE GPU. A warm Vision optical-flow run spent 5.68 s
+      // of 13.2 s inside the usleep below (sample, 1 ms interval), and poll+usleep(200) measured 445 us MEDIAN per
+      // iteration on the test machine (500 trials) — so every flush paid >= 0.445 ms whether the GPU took 20 us or 20 ms.
+      // Tiered by time since submit: pause-spin 50 us, sched_yield to 1 ms, usleep(50) (79 us measured) to 20 ms,
+      // then the old poll+usleep(200). The semaphore, fault and deadline checks above still run EVERY iteration.
+      // CPU bound: at most ~1 ms of yielding per flush; a long dispatch costs what it cost before.
+      {
+         long waitedUs = (t1.tv_sec - t0.tv_sec) * 1000000L + (t1.tv_nsec - t0.tv_nsec) / 1000;
+         if (waitedUs < 20) {
+#if defined(__x86_64__)
+            for (int s = 0; s < 64; s++) __builtin_ia32_pause();
+#endif
+            continue;
+         }
+         // b73: sleep on the device's graphics completion event (kext selector 6) instead of polling
+         if (nvrm_flush_sleep(ctx, semAdr, ctx->wSeq))
+            continue;
+         if (waitedUs < 1000) { sched_yield(); continue; }
+         if (waitedUs < 20000) { usleep(50); continue; }
+      }
+      // b73: WAS poll on ctx->osEvent (a /dev/null dup that returned at once); with no per-channel event the fd
+      // is -1 and poll would sleep its whole 1000 ms timeout. The plain backoff only.
+		usleep(200);
+#if 0
+		printf("poll\n");
+      fprintf(stderr, "rSeq: %#" PRIx64 "\n", rSeq);
+      fprintf(stderr, "GPGet: %" PRIu32 "\n", userD->GPGet);
+      fprintf(stderr, "GPPut: %" PRIu32 "\n", userD->GPPut);
+#endif
+   }
+
+   ctx->gpGet = ctx->gpPut;
+   nv_push_init(&ctx->push, ctx->cmdBuf->map, 0x10000 / 4, BITFIELD_BIT(SUBC_NV9097));
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_nvrm_exec_ctx_exec(struct nvkmd_ctx *_ctx,
+                            struct vk_object_base *log_obj,
+                            uint32_t exec_count,
+                            const struct nvkmd_ctx_exec *execs)
+{
+   struct nvkmd_nvrm_exec_ctx *ctx = nvkmd_nvrm_exec_ctx(_ctx);
+
+   for (uint32_t i = 0; i < exec_count; i++) {
+      if (ctx->gsub) {   // G-SUB (b79): entries of earlier flushes may still be in the ring
+         VkResult r = nvrm_gsub_gpfifo_reserve(ctx, log_obj);
+         if (r != VK_SUCCESS)
+            return r;
+      }
+      write_gp_fifo_entry(ctx, &execs[i]);
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_nvrm_exec_ctx_signal(struct nvkmd_ctx *_ctx,
+                              struct vk_object_base *log_obj,
+                              uint32_t signal_count,
+                              const struct vk_sync_signal *signals)
+{
+   struct nvkmd_nvrm_exec_ctx *ctx = nvkmd_nvrm_exec_ctx(_ctx);
+
+   VkResult r = nvkmd_nvrm_exec_ctx_flush(&ctx->base, log_obj);
+   if (r == VK_SUCCESS && nvkmd_nvrm_async_on())   // G-SUB (b79): record what this submission will signal
+      nvrm_gsub_ctx_signaled(ctx, signal_count, signals);
+   return r;
+}
+
+static VkResult
+nvkmd_nvrm_exec_ctx_sync(struct nvkmd_ctx *_ctx,
+                            struct vk_object_base *log_obj)
+{
+   struct nvkmd_nvrm_exec_ctx *ctx = nvkmd_nvrm_exec_ctx(_ctx);
+
+   VkResult r = nvkmd_nvrm_exec_ctx_flush(&ctx->base, log_obj);
+   if (r == VK_SUCCESS && ctx->gsub)   // G-SUB (b79): sync = submit + wait
+      r = nvrm_gsub_wait_seq(ctx, ctx->wSeq, log_obj);
+   return r;
+}
+
+const struct nvkmd_ctx_ops nvkmd_nvrm_exec_ctx_ops = {
+   .destroy = nvkmd_nvrm_exec_ctx_destroy,
+   .wait = nvkmd_nvrm_exec_ctx_wait,
+   .exec = nvkmd_nvrm_exec_ctx_exec,
+   .signal = nvkmd_nvrm_exec_ctx_signal,
+   .flush = nvkmd_nvrm_exec_ctx_flush,
+   .sync = nvkmd_nvrm_exec_ctx_sync,
+};
+
+static VkResult
+nvkmd_nvrm_create_bind_ctx(struct nvkmd_dev *_dev,
+                              struct vk_object_base *log_obj,
+                              struct nvkmd_ctx **ctx_out)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+
+   struct nvkmd_nvrm_bind_ctx *ctx = CALLOC_STRUCT(nvkmd_nvrm_bind_ctx);
+   if (ctx == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   ctx->base.ops = &nvkmd_nvrm_bind_ctx_ops;
+   ctx->base.dev = &dev->base;
+
+   // TODO: implement using NV_MEMORY_MAPPER
+
+   *ctx_out = &ctx->base;
+
+   return VK_SUCCESS;
+}
+
+static void
+nvkmd_nvrm_bind_ctx_destroy(struct nvkmd_ctx *_ctx)
+{
+   struct nvkmd_nvrm_bind_ctx *ctx = nvkmd_nvrm_bind_ctx(_ctx);
+
+   FREE(ctx);
+}
+
+static VkResult
+nvkmd_nvrm_bind_ctx_wait(struct nvkmd_ctx *_ctx,
+                            struct vk_object_base *log_obj,
+                            uint32_t wait_count,
+                            const struct vk_sync_wait *waits)
+{
+   struct nvkmd_nvrm_bind_ctx *ctx = nvkmd_nvrm_bind_ctx(_ctx);
+
+   if (nvkmd_nvrm_async_on()) {   // G-SUB (b79): binding is immediate, so its waits are honoured on the CPU
+      for (uint32_t i = 0; i < wait_count; i++) {
+         VkResult r = nvkmd_nvrm_sync_cpu_wait(waits[i].sync, waits[i].wait_value, log_obj);
+         if (r != VK_SUCCESS)
+            return r;
+      }
+   }
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_nvrm_bind_ctx_flush(struct nvkmd_ctx *_ctx,
+                             struct vk_object_base *log_obj)
+{
+   struct nvkmd_nvrm_bind_ctx *ctx = nvkmd_nvrm_bind_ctx(_ctx);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+nvkmd_nvrm_bind_ctx_bind(struct nvkmd_ctx *_ctx,
+                            struct vk_object_base *log_obj,
+                            uint32_t bind_count,
+                            const struct nvkmd_ctx_bind *binds)
+{
+   struct nvkmd_nvrm_bind_ctx *ctx = nvkmd_nvrm_bind_ctx(_ctx);
+   (void)ctx;
+
+   /* res3 (patch_nvk_sparse.py): WAS a stub that bound nothing. Each bind is performed now, in order, on the CPU. */
+   for (uint32_t i = 0; i < bind_count; i++) {
+      VkResult r = binds[i].op == NVKMD_BIND_OP_BIND
+         ? nvkmd_va_bind_mem(binds[i].va, log_obj, binds[i].va_offset_B, binds[i].mem, binds[i].mem_offset_B, binds[i].range_B)
+         : nvkmd_va_unbind(binds[i].va, log_obj, binds[i].va_offset_B, binds[i].range_B);
+      if (r != VK_SUCCESS)
+         return r;
+   }
+   return VK_SUCCESS;
+}
+
+/* res3: the plugin's marker - this NVK's sparse buffer binds are real (patch_nvk_sparse.py). */
+__attribute__((visibility("default"))) int nvmtl_nvk_sparse_bind_v1(void);
+__attribute__((visibility("default"))) int nvmtl_nvk_sparse_bind_v1(void) { return 1; }
+
+static VkResult
+nvkmd_nvrm_bind_ctx_signal(struct nvkmd_ctx *_ctx,
+                              struct vk_object_base *log_obj,
+                              uint32_t signal_count,
+                              const struct vk_sync_signal *signals)
+{
+   struct nvkmd_nvrm_bind_ctx *ctx = nvkmd_nvrm_bind_ctx(_ctx);
+
+   if (nvkmd_nvrm_async_on()) {   // G-SUB (b79): binding is immediate, so its signals are reached now
+      for (uint32_t i = 0; i < signal_count; i++)
+         nvkmd_nvrm_sync_cpu_signal(signals[i].sync, signals[i].signal_value);
+   }
+   return nvkmd_nvrm_bind_ctx_flush(&ctx->base, log_obj);
+}
+
+const struct nvkmd_ctx_ops nvkmd_nvrm_bind_ctx_ops = {
+   .destroy = nvkmd_nvrm_bind_ctx_destroy,
+   .wait = nvkmd_nvrm_bind_ctx_wait,
+   .bind = nvkmd_nvrm_bind_ctx_bind,
+   .signal = nvkmd_nvrm_bind_ctx_signal,
+   .flush = nvkmd_nvrm_bind_ctx_flush,
+};
+
+VkResult
+nvkmd_nvrm_create_ctx(struct nvkmd_dev *dev,
+                         struct vk_object_base *log_obj,
+                         enum nvkmd_engines engines,
+                         struct nvkmd_ctx **ctx_out)
+{
+   if (engines == NVKMD_ENGINE_BIND) {
+      return nvkmd_nvrm_create_bind_ctx(dev, log_obj, ctx_out);
+   } else {
+      assert(!(engines & NVKMD_ENGINE_BIND));
+      return nvkmd_nvrm_create_exec_ctx(dev, log_obj, engines, ctx_out);
+   }
+}
diff -ruN a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_dev.c b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_dev.c
--- a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_dev.c	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_dev.c	2026-10-05 13:10:16
@@ -0,0 +1,138 @@
+/*
+ * Copyright © 2024 Collabora Ltd. and Red Hat Inc.
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nvkmd_nvrm.h"
+
+#include "vk_log.h"
+
+#include "util/u_memory.h"
+#include "util/hash_table.h"
+
+#include "nvRmApi.h"
+
+#include "nvos.h"
+#include "ctrl/ctrl2080/ctrl2080tmr.h"
+#include "class/cl0005.h" // NV01_EVENT (b73 device event)
+#include "class/cl2080_notification.h" // NV2080_NOTIFIERS_GRAPHICS
+
+VkResult
+nvkmd_nvrm_create_dev(struct nvkmd_pdev *_pdev,
+                         struct vk_object_base *log_obj,
+                         struct nvkmd_dev **dev_out)
+{
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(_pdev);
+
+   struct nvkmd_nvrm_dev *dev = CALLOC_STRUCT(nvkmd_nvrm_dev);
+   if (dev == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   dev->base.ops = &nvkmd_nvrm_dev_ops;
+   dev->base.pdev = &pdev->base;
+
+   /* 26.3: nvkmd_dev_alloc_mem and friends now add EVERY mem to dev->mems (upstream's nouveau backend inits the
+    * list here); a zeroed list head made the first allocation write through NULL+8 in nvk_upload_queue_init. */
+   list_inithead(&dev->base.mems);
+   simple_mtx_init(&dev->base.mems_mutex, mtx_plain);
+
+   dev->mappings = _mesa_hash_table_create(NULL, _mesa_hash_pointer, _mesa_key_pointer_equal);
+   if (dev->mappings == NULL) {
+   	  nvkmd_dev_destroy(&dev->base);
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   /* b73: the device's ONE graphics non-stall event. Best effort: without it waits keep the polling backoff. */
+   dev->osEvent = -1;
+   dev->hEvent = 0;
+   {
+      struct NvRmApi rm;
+      nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+      dev->osEvent = NVRM_OPEN(rm.nodeName);
+      if (dev->osEvent >= 0) {
+         struct NvRmApi rmOsEvent = rm;
+         rmOsEvent.fd = dev->osEvent;
+         NV0005_ALLOC_PARAMETERS eventParams = {
+            .hParentClient = pdev->hClient,
+            .hSrcResource = pdev->hSubdevice,
+            .hClass = NV01_EVENT_OS_EVENT,
+            .notifyIndex = NV2080_NOTIFIERS_GRAPHICS | NV01_EVENT_NONSTALL_INTR |
+                           NV01_EVENT_WITHOUT_EVENT_DATA | NV01_EVENT_SUBDEVICE_SPECIFIC |
+                           DRF_NUM(0005, _NOTIFY_INDEX, _SUBDEVICE, 0),
+            .data = (NvP64)(uintptr_t)dev->osEvent,
+         };
+         if (nvRmApiAllocOsEvent(&rmOsEvent, dev->osEvent) != NV_OK ||
+             nvRmApiAlloc(&rm, pdev->hSubdevice, &dev->hEvent, NV01_EVENT_OS_EVENT, &eventParams) != NV_OK) {
+            fprintf(stderr, "nvrm: b73 device event NOT allocated - waits keep polling\n");
+            NVRM_CLOSE(dev->osEvent);
+            dev->osEvent = -1;
+            dev->hEvent = 0;
+         }
+      }
+   }
+
+   *dev_out = &dev->base;
+
+   return VK_SUCCESS;
+}
+
+static void
+nvkmd_nvrm_dev_destroy(struct nvkmd_dev *_dev)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+
+   if (dev->mappings != NULL)
+      _mesa_hash_table_destroy(dev->mappings, NULL);
+
+   if (dev->hEvent != 0) {   /* b73 device event */
+      struct NvRmApi rm;
+      nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+      nvRmApiFree(&rm, dev->hEvent);
+   }
+   if (dev->osEvent >= 0)
+      NVRM_CLOSE(dev->osEvent);
+
+   FREE(dev);
+}
+
+static VkResult
+nvkmd_nvrm_dev_get_gpu_timestamp_checked(struct nvkmd_dev *_dev,
+                                       uint64_t *timestamp)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   struct NvRmApi rm = {0};
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+   NV2080_CTRL_TIMER_GET_TIME_PARAMS params = {0};
+   NvU32 status = nvRmApiControl(&rm, pdev->hSubdevice,
+                                NV2080_CTRL_CMD_TIMER_GET_TIME,
+                                &params, sizeof(params));
+   if (status != NV_OK)
+      return VK_ERROR_UNKNOWN;
+
+   /* RM returns PTIMER nanoseconds, matching NVK's 1 ns timestampPeriod.
+    * Domain equivalence with queue report timestamps must be qualified. */
+   *timestamp = params.time_nsec;
+   return VK_SUCCESS;
+}
+
+static int
+nvkmd_nvrm_dev_get_drm_fd(struct nvkmd_dev *_dev)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+
+   return -1;
+}
+
+const struct nvkmd_dev_ops nvkmd_nvrm_dev_ops = {
+   .destroy = nvkmd_nvrm_dev_destroy,
+   .get_gpu_timestamp_checked = nvkmd_nvrm_dev_get_gpu_timestamp_checked,
+   .get_drm_fd = nvkmd_nvrm_dev_get_drm_fd,
+   .alloc_mem = nvkmd_nvrm_alloc_mem,
+   .alloc_tiled_mem = nvkmd_nvrm_alloc_tiled_mem,
+   .import_dma_buf = nvkmd_nvrm_import_dma_buf,
+   .import_host_mem = nvkmd_nvrm_import_host_mem,   /* b72 host-pointer import */
+   .alloc_va = nvkmd_nvrm_alloc_va,
+   .create_ctx = nvkmd_nvrm_create_ctx,
+};
diff -ruN a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_mem.c b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_mem.c
--- a/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_mem.c	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvkmd_nvrm_mem.c	2026-10-07 17:30:15
@@ -0,0 +1,531 @@
+/*
+ * Copyright © 2024 Collabora Ltd. and Red Hat Inc.
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "nvkmd_nvrm.h"
+
+#include "vk_log.h"
+#include <stdlib.h>
+#include <stdio.h>
+
+#include "util/u_memory.h"
+#include "util/hash_table.h"
+
+#include "class/cl003e.h" // NV01_MEMORY_SYSTEM
+#include "class/cl0040.h" // NV01_MEMORY_LOCAL_USER
+#include "class/cl0071.h" // NV01_MEMORY_SYSTEM_OS_DESCRIPTOR (b72 host-pointer import)
+#include "../../nvmtl_cfg.h"
+
+/* nvk69: app memory that may be GPU-cached in L2 when it lands in system RAM. Defined here and in
+ * nvkmd_nvrm_mem.c, not in nvkmd.h (a new enumerator there reaches every object's DWARF).
+ * bit 6 must stay free in enum nvkmd_mem_flags - nvkmd.h has COHERENT = 1 << 5 (26.3) and NVKMD_MEM_BAR = 1 << 7. */
+#define NVK69_MEM_GPU_CACHED ((enum nvkmd_mem_flags)(1u << 6))
+
+
+/* b80 B1/B2: LOCAL memory that NVK also maps (shader heap, descriptor tables and sets, event heap, USERD, zero page)
+ * stays in VRAM behind BAR1 when BAR1 covers the VRAM (the kext's 8 GB placement).  WAS demoted to system RAM with
+ * RM's GPU_CACHEABLE_NO by the CAN_MAP rule below, so shader code and descriptors were fetched over PCIe uncached.
+ * NVK_LOCAL_MAP_SYSMEM=1 restores the demotion (the control arm).
+ *: VRAM placement is now OPT-IN (NVK_LOCAL_MAP_SYSMEM=0). With it on, WindowServer's GFX channel stalled in its
+ * own submission (no fault, err 0x0) within 35-130 s under every other r3 bisect arm; with system RAM it held 180 s
+ * + the 10 min confirm, and GB7 still scored 81k. Apple's own WindowServer (dtrace on a reference Mac) makes ~1,584 textures per
+ * 15 s and keeps that CPU-written churn system-side; NVK's descriptor heap under that churn must not sit behind BAR1 WC. */
+static bool
+nvrm_local_map_stays_vram(struct nvkmd_nvrm_pdev *pdev)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = nvmtl_cfg_getenv("NVK_LOCAL_MAP_SYSMEM");
+      const bool bar_covers_vram = pdev->base.dev_info.bar_size_B >= pdev->base.dev_info.vram_size_B;
+      on = (e && e[0] == '0') && bar_covers_vram;
+      fprintf(stderr, "nvrm: b80 LOCAL+mapped memory -> %s (BAR1 %llu MB, VRAM %llu MB%s)\n",
+              on ? "VRAM through BAR1" : "system RAM (b79 placement)",
+              (unsigned long long)(pdev->base.dev_info.bar_size_B >> 20),
+              (unsigned long long)(pdev->base.dev_info.vram_size_B >> 20),
+              e && e[0] == '0' ? ", NVK_LOCAL_MAP_SYSMEM=0" : ", default");
+   }
+   return on;
+}
+
+/* item 7 share: the import record, staged by the plugin on the thread that then calls vkAllocateMemory. */
+static __thread struct nvmtl_nvk_share nvrm_import_staged;
+static __thread bool nvrm_import_is_staged;
+__attribute__((visibility("default"))) void   /* exported: plugin dlsym */
+nvmtl_nvk_stage_import(const struct nvmtl_nvk_share *in)
+{
+   nvrm_import_is_staged = in != NULL;
+   if (in != NULL)
+      nvrm_import_staged = *in;
+}
+
+/* item 7 b78: report a completed GPU write into (surface, plane) — see nvkmd.h. */
+uint32_t
+nvkmd_nvrm_surface_dirty(struct nvkmd_dev *_dev, uint32_t surfaceID, uint32_t plane)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+   struct NVRMSurfShareEsc e = { .surfaceID = surfaceID, .plane = plane, .hClient = pdev->hClient };
+   return nvRmApiSurfShare(&rm, NVRM_ESC_SURF_DIRTY, &e);
+}
+
+static VkResult
+create_mem_or_close_bo(struct nvkmd_nvrm_dev *dev,
+                       struct vk_object_base *log_obj,
+                       enum nvkmd_mem_flags mem_flags,
+                       NvHandle hMemoryPhys, uint64_t size_B,
+                       enum nvkmd_va_flags va_flags,
+                       uint8_t pte_kind, uint64_t va_align_B,
+                       struct nvkmd_mem **mem_out)
+{
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+
+   VkResult result;
+
+   struct nvkmd_nvrm_mem *mem = CALLOC_STRUCT(nvkmd_nvrm_mem);
+   if (mem == NULL) {
+      result = vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+      goto fail_bo;
+   }
+
+   /* 26.3 syncs every map that is not NVKMD_MEM_COHERENT. Upstream's nouveau backend marks every discrete-GPU
+    * mem coherent (CPU memory or WB VRAM maps); this is the same discrete card, and the live driver never synced.
+    * without it 11 of 40 oracles asserted in nvkmd_mem_sync_from_gpu (query readback) - our ops have no
+    * sync_to_gpu/sync_from_gpu. */
+   mem_flags |= NVKMD_MEM_COHERENT;
+   nvkmd_mem_init(&dev->base, &mem->base, &nvkmd_nvrm_mem_ops,
+                  mem_flags, size_B, dev->base.pdev->bind_align_B);
+   mem->hMemoryPhys = hMemoryPhys;
+   mem->isSystemMem = (mem_flags & NVKMD_MEM_GART) != 0;
+
+   result = nvkmd_dev_alloc_va(&dev->base, log_obj,
+                               va_flags, pte_kind,
+                               size_B, va_align_B,
+                               0 /* fixed_addr */,
+                               &mem->base.va);
+   if (result != VK_SUCCESS)
+      goto fail_mem;
+
+   result = nvkmd_va_bind_mem(mem->base.va, log_obj, 0 /* va_offset_B */,
+                              &mem->base, 0 /* mem_offset_B */, size_B);
+   if (result != VK_SUCCESS)
+      goto fail_va;
+
+   *mem_out = &mem->base;
+
+   return VK_SUCCESS;
+
+fail_va:
+   nvkmd_va_free(mem->base.va);
+fail_mem:
+   FREE(mem);
+fail_bo:
+   nvRmApiFree(&rm, hMemoryPhys);
+
+   return result;
+}
+
+VkResult
+nvkmd_nvrm_alloc_mem(struct nvkmd_dev *dev,
+                        struct vk_object_base *log_obj,
+                        uint64_t size_B, uint64_t align_B,
+                        enum nvkmd_mem_flags flags,
+                        struct nvkmd_mem **mem_out)
+{
+   return nvkmd_nvrm_alloc_tiled_mem(dev, log_obj, size_B, align_B,
+                                        0 /* pte_kind */, 0 /* tile_mode */,
+                                        flags, mem_out);
+}
+
+/* nvk-nvbig: NVIDIA 610 allocates device-local VRAM in BIG 64 KB pages (NV610-MAP.md:249). */
+#define NVK_NV_BIG_PAGE_B (64ull * 1024ull)
+static bool nvkmd_nvrm_vram_big(void)
+{
+   static int on = -1;
+   if (on < 0) { const char *e = getenv("NVK_NO_BIGPAGE"); on = (e && *e && *e != '0') ? 0 : 1; }
+   return on;
+}
+
+VkResult
+nvkmd_nvrm_alloc_tiled_mem(struct nvkmd_dev *_dev,
+                              struct vk_object_base *log_obj,
+                              uint64_t size_B, uint64_t align_B,
+                              uint8_t pte_kind, uint16_t tile_mode,
+                              enum nvkmd_mem_flags flags,
+                              struct nvkmd_mem **mem_out)
+{
+   /* NVMTL apps-rmreason: a tiled allocation is the normal texture path, not an error. Its trace goes to stderr only under
+    * NVRM_XNU_TRACE (nvkmd_nvrm_pdev.c:328): unconditional, it put 2 stray lines into a 2>&1 gate diff (stm vs D300, b56). */
+   if ((pte_kind != 0 || tile_mode != 0) && nvmtl_cfg_getenv("NVRM_XNU_TRACE")) {
+      fprintf(stderr, "alloc_tiled_mem(%#" PRIx64 ", %#" PRIx64 ", %#" PRIx8 ", %#" PRIx16 ", %#x)\n",
+   	   size_B, align_B, pte_kind, tile_mode, flags);
+   }
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+
+   if (dev->base.pdev->debug_flags & NVK_DEBUG_FORCE_GART) {
+      flags &= ~(NVKMD_MEM_LOCAL | NVKMD_MEM_VRAM);
+      flags |= NVKMD_MEM_GART;
+   }
+   /* b80 B1/B2: see nvrm_local_map_stays_vram */
+   if ((flags & NVKMD_MEM_LOCAL) && (flags & NVKMD_MEM_CAN_MAP) && !(flags & NVKMD_MEM_BAR) &&
+       nvrm_local_map_stays_vram(pdev))
+      flags |= NVKMD_MEM_BAR;
+   /* NVMTL batch 36: BAR memory stays in VRAM; the map below goes through BAR1 (isSystemMem = 0). */
+   if ((flags & NVKMD_MEM_CAN_MAP) && !(flags & NVKMD_MEM_BAR)) {
+      flags &= ~(NVKMD_MEM_LOCAL | NVKMD_MEM_VRAM);
+      flags |= NVKMD_MEM_GART;
+   }
+
+   const uint32_t mem_align_B = _dev->pdev->bind_align_B;
+   size_B = align64(size_B, mem_align_B);
+
+   assert(util_is_power_of_two_or_zero64(align_B));
+   const uint64_t va_align_B = MAX2(mem_align_B, align_B);
+
+   enum nvkmd_va_flags va_flags = NVKMD_VA_GART;
+
+	bool isSystemMem = (flags & NVKMD_MEM_GART) != 0;
+	/* nvk-nvbig: a big-page VRAM allocation is a whole number of 64 KB pages, and the GPU mapping of the whole
+	 * allocation starts on a 64 KB VA boundary, as on NVIDIA's driver (NV610-MAP.md:249-255). */
+	uint64_t nvbig_va_align_B = va_align_B;
+	if (!isSystemMem && nvkmd_nvrm_vram_big()) {
+		size_B = align64(size_B, NVK_NV_BIG_PAGE_B);
+		nvbig_va_align_B = MAX2(va_align_B, NVK_NV_BIG_PAGE_B);
+	}
+	const NvU32 hClass = isSystemMem ?
+		NV01_MEMORY_SYSTEM :
+		NV01_MEMORY_LOCAL_USER;
+
+	NV_MEMORY_ALLOCATION_PARAMS params = {
+		.owner = pdev->hClient,
+		.type = NVOS32_TYPE_IMAGE,
+		.flags = (align_B != 0) ? NVOS32_ALLOC_FLAGS_ALIGNMENT_FORCE : 0,
+		.attr = DRF_DEF(OS32, _ATTR, _PAGE_SIZE, _4KB),
+		.size = size_B,
+		.alignment = align_B,
+	};
+	if (isSystemMem) {
+		params.attr |= DRF_DEF(OS32, _ATTR, _LOCATION, _PCI);
+		params.attr |= DRF_DEF(OS32, _ATTR, _COHERENCY, _CACHED);
+		/* nvk69: GPU-cacheable in L2.  WAS the RM default (ATTR2_GPU_CACHEABLE_NO, mem.c:1180): a VOLATILE
+		 * PTE, and a Shared-buffer blur read 1,272 ms where Private read 9.95 ms. Coherence is the tail
+		 * write_l2_sysmem_tail puts on every submission (nvkmd_nvrm_ctx.c). */
+		if (flags & NVK69_MEM_GPU_CACHED)
+			params.attr2 |= DRF_DEF(OS32, _ATTR2, _GPU_CACHEABLE, _YES);
+	} else {
+		params.attr |= DRF_DEF(OS32, _ATTR, _LOCATION, _VIDMEM);
+		params.attr |= DRF_DEF(OS32, _ATTR, _COHERENCY, _UNCACHED);
+		params.flags |= NVOS32_ALLOC_FLAGS_PERSISTENT_VIDMEM;
+		/* \u2b50\u2b50\u2b50 nvk-noncontig - A VRAM IMAGE MAY BE PHYSICALLY SCATTERED.
+		 * NVOS32_ATTR_PHYSICALITY (nvos.h 28:27) was left _DEFAULT, so RM required ONE contiguous block per
+		 * image. Once the heap fragmented, PMA refused with gigabytes free:
+		 * nvRes: 4KB 0x51, rmpage 0x51, noalign 0x51, noncontig 0  (64 MB, align 64 KB, pte_kind 0)
+		 * Four attempts with one variable each - 4 KB pages (what shipped), the page size RM chooses, no
+		 * forced alignment - all returned NV_ERR_NO_MEMORY; only _ALLOW_NONCONTIGUOUS succeeded, 37 of 37.
+		 * HEAP_FREE is pmaGetFreeMemory (kern_mem_sys_ctrl.c:536), so PMA had the bytes and refused the SHAPE.
+		 * It is also the only explanation of 256 MB chunks failing at 1,280 MB held where 64 MB chunks
+		 * reached 2,880 MB: a larger contiguous run is harder to find.
+		 * Oracle at 5,344 MB on an 8,151 MB card: newest textures 25.11 ms in system memory -> 2.04 ms
+		 * resident (12.3x), 0 spills, 49/49 intact. On NMS at ultra the old behaviour put 4,689 MB of
+		 * images and 4,096 private buffers in system memory, read over PCIe every frame.
+		 * \u2b50 _ALLOW_NONCONTIGUOUS = "prefer one run, accept several", so a contiguous block is still used
+		 * when one exists; this cannot make a case that works today worse.
+		 */
+		// nvk-bigpage — A SCATTERED TEXTURE MUST BE MAPPED IN BIG PAGES.
+		// _ALLOW_NONCONTIGUOUS alone allocates (it moved 4.6 GB of NMS textures back into VRAM) and then
+		// CORRUPTS: smearing was seen "as I move" and artifacts in the menu, and the bisection cleared the
+		// Metal plugin - with every plugin behaviour change of the session off through the conf file, the
+		// artifacts remained.
+		// A texture on NVIDIA is BLOCK-LINEAR: a texel's address is a swizzle of its coordinates inside a
+		// tile, defined over a page of the mapping's size. Scattering the image across _4KB pages breaks
+		// that pattern at every page boundary, so neighbouring texels are fetched from the wrong place.
+		// NVIDIA's own driver maps tiled images with big pages, which is why non-contiguous is safe there.
+		// The refusal log already agreed: every refused request carried `align 65536 B`, so 64 KB alignment
+		// was being asked for while the page size still said 4 KB.
+		// Page size alone was measured and fixed NOTHING (1,164 of 1,164 retries still NV_ERR_NO_MEMORY);
+		// non-contiguous alone allocates and corrupts. The two belong together.
+		// NVK_NO_BIGPAGE=1 / NVK_NO_NONCONTIG=1 bisect each half on the installed driver.
+		{
+			static int nonc = -1, big = -1;
+			if (nonc < 0) { const char *e = getenv("NVK_NO_NONCONTIG"); nonc = (e && *e && *e != '0') ? 0 : 1; }
+			if (big < 0) { const char *e = getenv("NVK_NO_BIGPAGE"); big = (e && *e && *e != '0') ? 0 : 1; }
+			if (nonc)
+				params.attr |= DRF_DEF(OS32, _ATTR, _PHYSICALITY, _ALLOW_NONCONTIGUOUS);
+			if (big) {
+				params.attr &= ~(0x3u << 23);     /* NVOS32_ATTR_PAGE_SIZE is 24:23 (nvos.h) */
+				params.attr |= DRF_DEF(OS32, _ATTR, _PAGE_SIZE, _BIG);
+			}
+		}
+	}
+
+	/* nvk-compress — NVIDIA 610's physical recipe for a GB206 render target (rtsurf/nvtrace):
+	 * attr COMPR_REQUIRED + FORMAT_BLOCK_LINEAR, attr2 ZBC_PREFER_ZBC + GPU_CACHEABLE_YES, format = kind 0x8.
+	 * Compressed memory is VRAM only; a system-memory request refuses here and the caller falls back. */
+	if (pte_kind == 0x8 /* NV_MMU_PTE_KIND_GENERIC_MEMORY_COMPRESSIBLE */) {
+		if (isSystemMem)
+			return vk_errorf(log_obj, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+			                 "nvk-compress: compressible kind %#x refused in system memory", pte_kind);
+		params.attr &= ~(0x3u << 12);   /* NVOS32_ATTR_COMPR 13:12 */
+		params.attr |= DRF_DEF(OS32, _ATTR, _COMPR, _REQUIRED);
+		params.attr &= ~(0x3u << 16);   /* NVOS32_ATTR_FORMAT 17:16 */
+		params.attr |= DRF_DEF(OS32, _ATTR, _FORMAT, _BLOCK_LINEAR);
+		params.attr2 &= ~0x3u;          /* NVOS32_ATTR2_ZBC 1:0 */
+		params.attr2 |= DRF_DEF(OS32, _ATTR2, _ZBC, _PREFER_ZBC);
+		params.attr2 &= ~(0x3u << 2);   /* NVOS32_ATTR2_GPU_CACHEABLE 3:2 */
+		params.attr2 |= DRF_DEF(OS32, _ATTR2, _GPU_CACHEABLE, _YES);
+		params.format = pte_kind;
+	}
+
+	NvHandle hMemoryPhys = 0;
+   NV_STATUS nvRes = nvRmApiAlloc(&rm, pdev->hDevice, &hMemoryPhys, hClass, &params);
+   if (nvRes != NV_OK) {
+      fprintf(stderr, "[!] nvRes: %#x\n", nvRes);
+      /* NVMTL apps-rmreason: the RM status rides back in the VkResult's message, not only on a stderr nobody reads */
+      return vk_errorf(log_obj, VK_ERROR_OUT_OF_DEVICE_MEMORY, "nvRmApiAlloc(%s, %llu B, align %llu) -> NV_STATUS %#x",
+                       isSystemMem ? "NV01_MEMORY_SYSTEM" : "NV01_MEMORY_LOCAL_USER",
+                       (unsigned long long)size_B, (unsigned long long)align_B, nvRes);
+   }
+
+   return create_mem_or_close_bo(dev, log_obj, flags, hMemoryPhys, size_B,
+                                 va_flags, pte_kind, nvbig_va_align_B,
+                                 mem_out);
+}
+
+VkResult
+nvkmd_nvrm_import_dma_buf(struct nvkmd_dev *_dev,
+                             struct vk_object_base *log_obj,
+                             int fd, struct nvkmd_mem **mem_out)
+{
+   /* item 7 share: the fd carries nothing on XNU (no dma-buf); the record staged on THIS thread names the surface.
+    * one import per stage — a record left staged must never be imported by an unrelated allocation. */
+   if (!nvrm_import_is_staged)
+      return vk_errorf(log_obj, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "nvkmd_nvrm_import_dma_buf: fd %d has no staged surface record (nvmtl_nvk_stage_import)", fd);
+   const struct nvmtl_nvk_share in = nvrm_import_staged;
+   nvrm_import_is_staged = false;
+   if (in.version != NVMTL_NVK_SHARE_VERSION || in.size_B == 0)
+      return vk_errorf(log_obj, VK_ERROR_INVALID_EXTERNAL_HANDLE, "import: bad surface record v%u size %llu", in.version,
+                       (unsigned long long)in.size_B);
+
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+
+   /* the family's VRAM for this surface, granted to our client — the kernel checks we hold the surface */
+   struct NVRMSurfShareEsc e = { .surfaceID = in.surfaceID, .plane = in.plane, .hClient = pdev->hClient, .size = in.size_B };
+   NvU32 gs = nvRmApiSurfShare(&rm, NVRM_ESC_SURF_VRAM, &e);
+   if (gs != 0 || !e.hSrcClient || !e.hSrcMemory || !e.size || (e.size & (_dev->pdev->bind_align_B - 1)))
+      return vk_errorf(log_obj, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "import: NVRM SURF_VRAM (surface %u plane %u, %llu B) -> %#x client %#x mem %#x size %llu", in.surfaceID,
+                       in.plane, (unsigned long long)in.size_B, gs, e.hSrcClient, e.hSrcMemory, (unsigned long long)e.size);
+   NvHandle h = 0;
+   NV_STATUS st = nvRmApiDupObject(&rm, pdev->hDevice, &h, e.hSrcClient, e.hSrcMemory);
+   if (st != NV_OK)
+      return vk_errorf(log_obj, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "import: RM_DUP_OBJECT(client %#x, mem %#x) -> NV_STATUS %#x", e.hSrcClient, e.hSrcMemory, st);
+
+   /* VRAM, generic pte kind: the plugin places a LINEAR image at the surface's bytesPerRow in it */
+   return create_mem_or_close_bo(dev, log_obj, NVKMD_MEM_LOCAL | NVKMD_MEM_VRAM | NVKMD_MEM_SHARED, h, e.size, NVKMD_VA_GART, 0,
+                                 _dev->pdev->bind_align_B, mem_out);
+}
+
+/* b72 host-pointer import — the GPU reads and writes the CALLER'S pages (Metal newBufferWithBytesNoCopy). The kext
+ * pins them for as long as the RM handle lives; free goes through the usual deferred path, so a channel still reading
+ * them keeps them pinned until it passes. Handles are ours to name (0x5eb00000 range, clear of RM's generated
+ * 0xcaf....; a duplicate retries the next). Placement is always system RAM, GPU-uncached (NVRM_HOST_OS02_FLAGS). */
+static uint32_t nvrm_host_handle_next;
+VkResult
+nvkmd_nvrm_import_host_mem(struct nvkmd_dev *_dev,
+                           struct vk_object_base *log_obj,
+                           void *host_ptr, uint64_t size_B,
+                           enum nvkmd_mem_flags flags,
+                           struct nvkmd_mem **mem_out)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   const uint64_t pg = _dev->pdev->bind_align_B;
+   if (!pdev->base.kmd_info.has_host_import)
+      return vk_errorf(log_obj, VK_ERROR_INVALID_EXTERNAL_HANDLE, "host import: the kext cannot pin user pages (probe failed)");
+   if (host_ptr == NULL || size_B == 0 || ((uintptr_t)host_ptr & (pg - 1)) || (size_B & (pg - 1)))
+      return vk_errorf(log_obj, VK_ERROR_INVALID_EXTERNAL_HANDLE, "host import: %p + %llu B is not %llu-aligned",
+                       host_ptr, (unsigned long long)size_B, (unsigned long long)pg);
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+   struct NvRmApi drm = rm;
+   drm.fd = pdev->devFd;
+   NV_STATUS st = NV_ERR_INSERT_DUPLICATE_NAME;
+   NvHandle h = 0;
+   for (int tries = 0; tries < 16 && st == NV_ERR_INSERT_DUPLICATE_NAME; tries++) {
+      h = 0x5eb00000u | (__atomic_add_fetch(&nvrm_host_handle_next, 1, __ATOMIC_RELAXED) & 0xfffffu);
+      st = nvRmApiAllocMemory(&drm, pdev->hDevice, h, NV01_MEMORY_SYSTEM_OS_DESCRIPTOR, NVRM_HOST_OS02_FLAGS, host_ptr, size_B - 1);
+   }
+   if (st != NV_OK)
+      return vk_errorf(log_obj, VK_ERROR_INVALID_EXTERNAL_HANDLE, "NV_ESC_RM_ALLOC_MEMORY(OS descriptor %p, %llu B) -> NV_STATUS %#x",
+                       host_ptr, (unsigned long long)size_B, st);
+   flags &= ~(NVKMD_MEM_LOCAL | NVKMD_MEM_VRAM | NVKMD_MEM_BAR | NVK69_MEM_GPU_CACHED);
+   flags |= NVKMD_MEM_GART | NVKMD_MEM_CAN_MAP;
+   struct nvkmd_mem *mem = NULL;
+   VkResult r = create_mem_or_close_bo(dev, log_obj, flags, h, size_B, NVKMD_VA_GART, 0 /* pte_kind */, pg, &mem);
+   if (r != VK_SUCCESS)
+      return r;   /* create_mem_or_close_bo already freed h, which unpins */
+   nvkmd_nvrm_mem(mem)->hostPtr = host_ptr;
+   { static uint64_t n; if (n++ == 0 || (n & 0x3ff) == 0)
+        fprintf(stderr, "nvrm: b72 host pointer IMPORTED #%llu: %p, %llu KB, zero copy (handle %#x)\n",
+                (unsigned long long)n, host_ptr, (unsigned long long)(size_B >> 10), h); }
+   *mem_out = mem;
+   return VK_SUCCESS;
+}
+
+static void
+nvkmd_nvrm_mem_free_now(void *arg)
+{
+   struct nvkmd_nvrm_mem *mem = arg;
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(mem->base.dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+
+   nvkmd_va_free(mem->base.va);
+   nvRmApiFree(&rm, mem->hMemoryPhys);
+   FREE(mem);
+}
+
+/* G-SUB (b79): with submission asynchronous a channel may still read this memory. Its CPU map and tracking are
+ * already gone (nvkmd_mem_unref); the VA and the RM allocation go once every channel passes today's flushed seq. */
+static void
+nvkmd_nvrm_mem_free(struct nvkmd_mem *_mem)
+{
+   if (nvkmd_nvrm_defer(_mem->dev, nvkmd_nvrm_mem_free_now, nvkmd_nvrm_mem(_mem)))
+      return;
+   nvkmd_nvrm_mem_free_now(nvkmd_nvrm_mem(_mem));
+}
+
+static VkResult
+nvkmd_nvrm_mem_map(struct nvkmd_mem *_mem,
+                      struct vk_object_base *log_obj,
+                      enum nvkmd_mem_map_flags map_flags,
+                      void *fixed_addr,
+                      void **map_out)
+{
+   struct nvkmd_nvrm_mem *mem = nvkmd_nvrm_mem(_mem);
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_mem->dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+
+   if (mem->hostPtr) {   /* b72 host-pointer import: the CPU mapping IS the caller's pointer */
+      if (fixed_addr != NULL)
+         return vk_errorf(log_obj, VK_ERROR_MEMORY_MAP_FAILED, "host import: a fixed-address map of the caller's pages");
+      *map_out = mem->hostPtr;
+      return VK_SUCCESS;
+   }
+
+   NvRmApiMapping *mapping = CALLOC_STRUCT(NvRmApiMapping);
+   if (mapping == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   /* System memory is mapped DIRECT (NVOS33_FLAGS_MAPPING 16:15 = 1). Turing uses RM's GM107 bus rule
+    * (kern_bus_gm107.c, kbusIsDirectMappingAllowed_GM107): a GPU-cached system allocation may not be mapped
+    * directly unless the caller asks, so every CPU map failed with NV_ERR_NOT_SUPPORTED (assert at
+    * kern_bus_gm107.c:6426) and vkCreateDevice returned VK_ERROR_OUT_OF_DEVICE_MEMORY on RTX 20 / GTX 16 cards.
+    * Ampere and later (GA100 rule) already map these directly, so the flag only states what they do. */
+   const NvU32 map_flags_os33 = mem->isSystemMem ? (1u << 15) : 0;
+   NV_STATUS nvRes = nvRmApiMapMemory(&rm, pdev->hSubdevice, mem->hMemoryPhys, 0, mem->base.size_B, mem->isSystemMem, map_flags_os33, mapping);
+   if (nvRes != NV_OK) {
+      fprintf(stderr, "[!] nvRes: %#x\n", nvRes);
+      free(mapping);
+      /* NVMTL apps-rmreason: the RM status rides back in the VkResult's message, not only on a stderr nobody reads */
+      return vk_errorf(log_obj, VK_ERROR_OUT_OF_DEVICE_MEMORY, "nvRmApiMapMemory(%llu B, %s) -> NV_STATUS %#x",
+                       (unsigned long long)mem->base.size_B, mem->isSystemMem ? "system" : "vidmem", nvRes);
+   }
+
+   if (_mesa_hash_table_insert(dev->mappings, mapping->address, mapping) == NULL) {
+   	nvRmApiUnmapMemory(&rm, pdev->hSubdevice, mem->hMemoryPhys, 0, mapping);
+      free(mapping);
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   *map_out = mapping->address;
+   return VK_SUCCESS;
+}
+
+static void
+nvkmd_nvrm_mem_unmap(struct nvkmd_mem *_mem,
+                        enum nvkmd_mem_map_flags flags,
+                        void *map)
+{
+   struct nvkmd_nvrm_mem *mem = nvkmd_nvrm_mem(_mem);
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_mem->dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+
+   if (mem->hostPtr)
+      return;   /* b72 host-pointer import: the caller's pages were never mapped by us */
+
+   struct hash_entry *ent = _mesa_hash_table_search(dev->mappings, map);
+   if (ent == NULL) {
+      fprintf(stderr, "[!] ent == NULL\n");
+      return;
+   }
+   NvRmApiMapping *mapping = ent->data;
+
+   NV_STATUS nvRes = nvRmApiUnmapMemory(&rm, pdev->hSubdevice, mem->hMemoryPhys, 0, mapping);
+   if (nvRes != NV_OK) {
+      fprintf(stderr, "[!] nvRes: %#x\n", nvRes);
+   }
+
+   free(mapping);
+}
+
+static VkResult
+nvkmd_nvrm_mem_overmap(struct nvkmd_mem *_mem,
+                          struct vk_object_base *log_obj,
+                          enum nvkmd_mem_map_flags flags,
+                          void *map)
+{
+   struct nvkmd_nvrm_mem *mem = nvkmd_nvrm_mem(_mem);
+
+   fprintf(stderr, "nvkmd_nvrm_mem_overmap(%#x)\n", mem->hMemoryPhys);
+
+   /* NVMTL apps-rmreason: the reason rides back in the VkResult's message, not only on a stderr nobody reads */
+   return vk_errorf(log_obj, VK_ERROR_UNKNOWN, "nvkmd_nvrm_mem_overmap(hMemoryPhys %#x): placed mapping is not implemented on nvrm",
+                    mem->hMemoryPhys);
+}
+
+static VkResult
+nvkmd_nvrm_mem_export_dma_buf(struct nvkmd_mem *_mem,
+                                 struct vk_object_base *log_obj,
+                                 int *fd_out)
+{
+   struct nvkmd_nvrm_mem *mem = nvkmd_nvrm_mem(_mem);
+
+   return VK_ERROR_UNKNOWN;
+}
+
+static uint32_t
+nvkmd_nvrm_mem_log_handle(struct nvkmd_mem *_mem)
+{
+   return 0;
+}
+
+const struct nvkmd_mem_ops nvkmd_nvrm_mem_ops = {
+   .free = nvkmd_nvrm_mem_free,
+   .map = nvkmd_nvrm_mem_map,
+   .unmap = nvkmd_nvrm_mem_unmap,
+   .overmap = nvkmd_nvrm_mem_overmap,
+   .export_dma_buf = nvkmd_nvrm_mem_export_dma_buf,
+   .log_handle = nvkmd_nvrm_mem_log_handle,
+};
