+   assert(shader != NULL);
+   assert(y == 1 && z == 1);
+   const uint32_t local_x = MAX2(shader->info.cs.local_size[0], 1);
+   const uint32_t groups_x = DIV_ROUND_UP(x, local_x);
+
+   dev->vk.dispatch_table.CmdDispatchBase(commandBuffer, 0, x, 0, MAX2(groups_x, 1), 1, 1);
+}
