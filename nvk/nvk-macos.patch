+
+typedef uint64_t Elf64_Addr;
+typedef uint64_t Elf64_Off;
+typedef uint16_t Elf64_Half;
+typedef uint32_t Elf64_Word;
+typedef uint64_t Elf64_Xword;
+
+#define EI_NIDENT     16
+#define EI_CLASS      4
+#define EI_DATA       5
+#define EI_VERSION    6
+#define EI_OSABI      7
+#define EI_ABIVERSION 8
+
+typedef struct {
+   unsigned char e_ident[EI_NIDENT];
+   Elf64_Half e_type;
+   Elf64_Half e_machine;
+   Elf64_Word e_version;
+   Elf64_Addr e_entry;
+   Elf64_Off e_phoff;
+   Elf64_Off e_shoff;
+   Elf64_Word e_flags;
+   Elf64_Half e_ehsize;
+   Elf64_Half e_phentsize;
+   Elf64_Half e_phnum;
+   Elf64_Half e_shentsize;
+   Elf64_Half e_shnum;
+   Elf64_Half e_shstrndx;
+} Elf64_Ehdr;
+
+typedef struct {
+   Elf64_Word sh_name;
+   Elf64_Word sh_type;
+   Elf64_Xword sh_flags;
+   Elf64_Addr sh_addr;
+   Elf64_Off sh_offset;
+   Elf64_Xword sh_size;
+   Elf64_Word sh_link;
+   Elf64_Word sh_info;
+   Elf64_Xword sh_addralign;
+   Elf64_Xword sh_entsize;
+} Elf64_Shdr;
+
+typedef struct {
+   Elf64_Word st_name;
+   unsigned char st_info;
+   unsigned char st_other;
+   Elf64_Half st_shndx;
+   Elf64_Addr st_value;
+   Elf64_Xword st_size;
+} Elf64_Sym;
+
+#define EV_NONE    0
+#define EV_CURRENT 1
+
+#define ELFCLASS64  2
+#define ELFDATA2LSB 1
+#define EM_CUDA     190
+
+#define SHN_UNDEF  0
+#define SHN_XINDEX 0xffff
+#define SHT_NULL   0
+#define SHT_SYMTAB 2
+#define SHT_NOBITS 8
+
+#define STB_GLOBAL  1
+#define STT_FUNC    2
+#define STV_DEFAULT 0
+#define ELF64_ST_BIND(i)       ((i) >> 4)
+#define ELF64_ST_TYPE(i)       ((i) & 0xf)
+#define ELF64_ST_VISIBILITY(o) ((o) & 0x3)
+
+typedef enum {
+   ELF_K_NONE = 0,
+   ELF_K_AR,
+   ELF_K_COFF,
+   ELF_K_ELF,
+} Elf_Kind;
+
+typedef struct Elf Elf;
+typedef struct Elf_Scn Elf_Scn;
+
+typedef struct {
+   void *d_buf;
+   int d_type;
+   unsigned int d_version;
+   size_t d_size;
+   int64_t d_off;
+   size_t d_align;
+} Elf_Data;
+
+unsigned elf_version(unsigned version);
+Elf *elf_memory(char *image, size_t size);
+Elf_Kind elf_kind(Elf *elf);
+int elf_end(Elf *elf);
+Elf64_Ehdr *elf64_getehdr(Elf *elf);
+int elf_getshdrstrndx(Elf *elf, size_t *dst);
+Elf_Scn *elf_getscn(Elf *elf, size_t index);
+Elf_Scn *elf_nextscn(Elf *elf, Elf_Scn *scn);
+Elf64_Shdr *elf64_getshdr(Elf_Scn *scn);
+Elf_Data *elf_getdata(Elf_Scn *scn, Elf_Data *data);
+char *elf_strptr(Elf *elf, size_t section, size_t offset);
+int elf_errno(void);
+const char *elf_errmsg(int error);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* NV_MACOS_LIBELF_H */
diff -ruN a/src/nouveau/cubin/macos/nv_libelf_mini.c b/src/nouveau/cubin/macos/nv_libelf_mini.c
--- a/src/nouveau/cubin/macos/nv_libelf_mini.c	1969-12-31 16:00:00
+++ b/src/nouveau/cubin/macos/nv_libelf_mini.c	2026-10-05 09:26:46
@@ -0,0 +1,263 @@
+/*
+ * nv_libelf_mini.c — read-only ELF64 little-endian parsing behind macos/libelf.h (see there for why it exists).
+ * SPDX-License-Identifier: MIT
+ *
+ * Semantics follow libelf where nv_cubin.c depends on them: elf_nextscn(elf, NULL) is section 1, elf_getdata returns
+ * one Elf_Data per section (a second call returns NULL), SHT_NOBITS has d_buf NULL and d_size = sh_size, and the
+ * extended section count / string-table index (e_shnum == 0, e_shstrndx == SHN_XINDEX) come from section 0.
+ * The image is untrusted: every header, table and string is range-checked against the buffer before it is returned.
+ */
+#include "libelf.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+enum {
+   NV_ELF_E_NONE = 0,
+   NV_ELF_E_VERSION,
+   NV_ELF_E_NOMEM,
+   NV_ELF_E_HEADER,
+   NV_ELF_E_RANGE,
+   NV_ELF_E_ARG,
+};
+
+static _Thread_local int nv_elf_err;
+
+struct Elf_Scn {
+   struct Elf *elf;
+   size_t index;
+   Elf_Data data;
+   int data_ready;
+};
+
+struct Elf {
+   const char *image;
+   size_t size;
+   Elf64_Ehdr *ehdr;
+   size_t shnum;
+   size_t shstrndx;
+   Elf_Scn *scns;   /* shnum entries, built at elf_memory */
+};
+
+static unsigned nv_elf_version = EV_NONE;
+
+unsigned
+elf_version(unsigned version)
+{
+   if (version == EV_NONE)
+      return EV_CURRENT;
+   if (version != EV_CURRENT) {
+      nv_elf_err = NV_ELF_E_VERSION;
+      return EV_NONE;
+   }
+   unsigned old = nv_elf_version == EV_NONE ? EV_CURRENT : nv_elf_version;
+   nv_elf_version = version;
+   return old;
+}
+
+/* [off, off + len) inside the image, with no overflow */
+static int
+nv_elf_in_range(const Elf *elf, uint64_t off, uint64_t len)
+{
+   return off <= elf->size && len <= elf->size - off;
+}
+
+static Elf64_Shdr *
+nv_elf_shdr(const Elf *elf, size_t index)
+{
+   const uint64_t off = elf->ehdr->e_shoff + (uint64_t)index * sizeof(Elf64_Shdr);
+   return (Elf64_Shdr *)(elf->image + off);   /* range of the whole table was checked at elf_memory */
+}
+
+Elf *
+elf_memory(char *image, size_t size)
+{
+   if (nv_elf_version != EV_CURRENT) {
+      nv_elf_err = NV_ELF_E_VERSION;
+      return NULL;
+   }
+   if (image == NULL || size < sizeof(Elf64_Ehdr)) {
+      nv_elf_err = NV_ELF_E_HEADER;
+      return NULL;
+   }
+   Elf64_Ehdr *eh = (Elf64_Ehdr *)image;
+   if (memcmp(eh->e_ident, "\177ELF", 4) != 0 || eh->e_ident[4] != ELFCLASS64 || eh->e_ident[5] != ELFDATA2LSB) {
+      nv_elf_err = NV_ELF_E_HEADER;   /* only what a cubin is: 64-bit little-endian */
+      return NULL;
+   }
+
+   Elf *elf = calloc(1, sizeof(*elf));
+   if (elf == NULL) {
+      nv_elf_err = NV_ELF_E_NOMEM;
+      return NULL;
+   }
+   elf->image = image;
+   elf->size = size;
+   elf->ehdr = eh;
+
+   if (eh->e_shoff != 0) {
+      if (eh->e_shentsize != sizeof(Elf64_Shdr) || !nv_elf_in_range(elf, eh->e_shoff, sizeof(Elf64_Shdr)))
+         goto bad;
+      const Elf64_Shdr *sh0 = (const Elf64_Shdr *)(image + eh->e_shoff);
+      elf->shnum = eh->e_shnum != 0 ? eh->e_shnum : (size_t)sh0->sh_size;
+      elf->shstrndx = eh->e_shstrndx != SHN_XINDEX ? eh->e_shstrndx : sh0->sh_link;
+      if (elf->shnum > (size - eh->e_shoff) / sizeof(Elf64_Shdr) ||
+          !nv_elf_in_range(elf, eh->e_shoff, (uint64_t)elf->shnum * sizeof(Elf64_Shdr)))
+         goto bad;
+      if (elf->shstrndx >= elf->shnum && elf->shstrndx != SHN_UNDEF)
+         goto bad;
+
+      elf->scns = calloc(elf->shnum ? elf->shnum : 1, sizeof(Elf_Scn));
+      if (elf->scns == NULL) {
+         free(elf);
+         nv_elf_err = NV_ELF_E_NOMEM;
+         return NULL;
+      }
+      for (size_t i = 0; i < elf->shnum; i++) {
+         elf->scns[i].elf = elf;
+         elf->scns[i].index = i;
+      }
+   }
+   return elf;
+
+bad:
+   free(elf);
+   nv_elf_err = NV_ELF_E_RANGE;
+   return NULL;
+}
+
+Elf_Kind
+elf_kind(Elf *elf)
+{
+   return elf != NULL ? ELF_K_ELF : ELF_K_NONE;
+}
+
+int
+elf_end(Elf *elf)
+{
+   if (elf != NULL) {
+      free(elf->scns);
+      free(elf);
+   }
+   return 0;
+}
+
+Elf64_Ehdr *
+elf64_getehdr(Elf *elf)
+{
+   if (elf == NULL) {
+      nv_elf_err = NV_ELF_E_ARG;
+      return NULL;
+   }
+   return elf->ehdr;
+}
+
+int
+elf_getshdrstrndx(Elf *elf, size_t *dst)
+{
+   if (elf == NULL || dst == NULL) {
+      nv_elf_err = NV_ELF_E_ARG;
+      return -1;
+   }
+   *dst = elf->shstrndx;
+   return 0;
+}
+
+Elf_Scn *
+elf_getscn(Elf *elf, size_t index)
+{
+   if (elf == NULL || index >= elf->shnum) {
+      nv_elf_err = NV_ELF_E_RANGE;
+      return NULL;
+   }
+   return &elf->scns[index];
+}
+
+Elf_Scn *
+elf_nextscn(Elf *elf, Elf_Scn *scn)
+{
+   if (elf == NULL)
+      return NULL;
+   const size_t next = scn == NULL ? 1 : scn->index + 1;
+   return next < elf->shnum ? &elf->scns[next] : NULL;
+}
+
+Elf64_Shdr *
+elf64_getshdr(Elf_Scn *scn)
+{
+   if (scn == NULL) {
+      nv_elf_err = NV_ELF_E_ARG;
+      return NULL;
+   }
+   return nv_elf_shdr(scn->elf, scn->index);
+}
+
+Elf_Data *
+elf_getdata(Elf_Scn *scn, Elf_Data *data)
+{
+   if (scn == NULL || data != NULL)
+      return NULL;   /* one data descriptor per section */
+   if (!scn->data_ready) {
+      const Elf *elf = scn->elf;
+      const Elf64_Shdr *sh = nv_elf_shdr(elf, scn->index);
+      memset(&scn->data, 0, sizeof(scn->data));
+      scn->data.d_version = EV_CURRENT;
+      scn->data.d_align = sh->sh_addralign;
+      if (sh->sh_type == SHT_NOBITS || sh->sh_type == SHT_NULL) {
+         scn->data.d_buf = NULL;
+         scn->data.d_size = sh->sh_type == SHT_NOBITS ? sh->sh_size : 0;
+      } else {
+         if (!nv_elf_in_range(elf, sh->sh_offset, sh->sh_size)) {
+            nv_elf_err = NV_ELF_E_RANGE;
+            return NULL;
+         }
+         scn->data.d_buf = (void *)(elf->image + sh->sh_offset);
+         scn->data.d_size = sh->sh_size;
+      }
+      scn->data_ready = 1;
+   }
+   return &scn->data;
+}
+
+char *
+elf_strptr(Elf *elf, size_t section, size_t offset)
+{
+   if (elf == NULL || section >= elf->shnum) {
+      nv_elf_err = NV_ELF_E_RANGE;
+      return NULL;
+   }
+   const Elf64_Shdr *sh = nv_elf_shdr(elf, section);
+   if (sh->sh_type == SHT_NOBITS || !nv_elf_in_range(elf, sh->sh_offset, sh->sh_size) || offset >= sh->sh_size) {
+      nv_elf_err = NV_ELF_E_RANGE;
+      return NULL;
+   }
+   const char *s = elf->image + sh->sh_offset + offset;
+   /* the string must end inside its section */
+   if (memchr(s, '\0', sh->sh_size - offset) == NULL) {
+      nv_elf_err = NV_ELF_E_RANGE;
+      return NULL;
+   }
+   return (char *)s;
+}
+
+int
+elf_errno(void)
+{
+   int e = nv_elf_err;
+   nv_elf_err = NV_ELF_E_NONE;
+   return e;
+}
+
+const char *
+elf_errmsg(int error)
+{
+   switch (error == -1 ? nv_elf_err : error) {
+   case NV_ELF_E_NONE:    return NULL;
+   case NV_ELF_E_VERSION: return "elf_version() not called, or unsupported version";
+   case NV_ELF_E_NOMEM:   return "out of memory";
+   case NV_ELF_E_HEADER:  return "not a 64-bit little-endian ELF image";
+   case NV_ELF_E_RANGE:   return "offset or size outside the ELF image";
+   case NV_ELF_E_ARG:     return "invalid argument";
+   default:               return "unknown ELF error";
+   }
+}
