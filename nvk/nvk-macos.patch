+const struct nvk_gdq_cfg *
+nvk_gdq_cfg(void)
+{
+   /* NVMTL_GDQ: read once; a race between two first callers writes the same values */
+   static struct nvk_gdq_cfg cfg;
+   static volatile bool done;
+   if (!done) {
+      const char *s;
+      struct nvk_gdq_cfg c = { .pcas = 3, .membar = 1 };
+      /* k5: chains on by default; NVMTL_GDQ_DQ=0 restores the push-buffer barrier (control arm) */
+      c.dq = !(s = nvmtl_conf_getenv("NVMTL_GDQ_DQ")) || atoi(s);
+      c.noinv = (s = nvmtl_cfg_getenv("NVMTL_GDQ_NOINV")) ? (uint32_t)atoi(s) : 0;
+      if ((s = nvmtl_cfg_getenv("NVMTL_GDQ_PCAS")))
+         c.pcas = strtoul(s, NULL, 0) & 0xf;
+      if ((s = nvmtl_cfg_getenv("NVMTL_GDQ_MEMBAR"))) {
+         c.membar = strtoul(s, NULL, 0) & 0x3;
+         c.membar_env = true;
+      }
+      c.invfull = (s = nvmtl_cfg_getenv("NVMTL_GDQ_INVFULL")) && atoi(s);
+      c.stats = (s = nvmtl_cfg_getenv("NVMTL_GDQ_STATS")) && atoi(s);
+      c.res = (s = nvmtl_cfg_getenv("NVMTL_GDQ_RES")) && atoi(s);
+      c.rescap = (s = nvmtl_cfg_getenv("NVMTL_GDQ_RESCAP")) && atoi(s) > 0 ? (uint32_t)atoi(s) : 16;
+      cfg = c;
+      done = true;
+   }
+   return &cfg;
+}
+
+/* NVMTL_GDQ: push the barrier methods an open chain erased.  Called by the first push that is not part of the chain
+ * (nvk_cmd_buffer_push), and by EndCommandBuffer / ExecuteCommands / push_indirect, which bypass it.
+ */
+void
+nvk_cmd_gdq_close_chain(struct nvk_cmd_buffer *cmd)
+{
+   struct nvk_compute_state *cs = &cmd->state.cs;
+   if (!cs->gdq_chain_open)
+      return;
+
+   cs->gdq_chain_open = false;   /* first: the push below must not re-enter */
+   cs->gdq_prev_qmd = NULL;
+   cs->gdq_push_after_bar = NULL;
+
+   const uint32_t n = cs->gdq_saved_bar_dw;
+   cs->gdq_saved_bar_dw = 0;
+   if (n == 0)
+      return;
+
+   struct nv_push *p = nvk_cmd_buffer_push(cmd, n);
+   memcpy(p->end, cs->gdq_saved_bar, n * 4);
+   p->end += n;
+   /* whole method groups were copied: nothing may be appended to their headers */
+   p->last_hdr = NULL;
+   p->last_hdr_dw = 0;
+}
+
+/* NVMTL_GDQ_STATS: process-wide counts, printed once at exit (a measurement aid; never read by the driver) */
+static uint64_t nvk_gdq_stats[NVK_GDQ_STAT_COUNT];
+
+static void
+nvk_gdq_stats_print(void)
+{
+   const uint64_t *n = nvk_gdq_stats;
+   fprintf(stderr, "NVMTL_GDQ_STATS: barriers %llu chainable %llu not(image %llu fence %llu pos %llu) "
+           "chained %llu dispatches %llu resident %llu res_miss %llu res_break %llu\n",
+           (unsigned long long)n[NVK_GDQ_STAT_BARRIER], (unsigned long long)n[NVK_GDQ_STAT_CHAINABLE],
+           (unsigned long long)n[NVK_GDQ_STAT_NOT_IMAGE], (unsigned long long)n[NVK_GDQ_STAT_NOT_FENCE],
+           (unsigned long long)n[NVK_GDQ_STAT_NOT_POS], (unsigned long long)n[NVK_GDQ_STAT_CHAINED],
+           (unsigned long long)n[NVK_GDQ_STAT_DISPATCH], (unsigned long long)n[NVK_GDQ_STAT_RESIDENT],
+           (unsigned long long)n[NVK_GDQ_STAT_RES_MISS], (unsigned long long)n[NVK_GDQ_STAT_RES_BREAK]);
+}
+
+void
+nvk_gdq_stat(enum nvk_gdq_stat s)
+{
+   if (likely(!nvk_gdq_cfg()->stats))
+      return;
+   static volatile int registered;
+   if (!__atomic_exchange_n(&registered, 1, __ATOMIC_ACQ_REL))
+      atexit(nvk_gdq_stats_print);
+   __atomic_fetch_add(&nvk_gdq_stats[s], 1, __ATOMIC_RELAXED);
+}
+
+/* NVMTL_GDQ: set bits [lo, hi] of a QMD to v (bit positions from clcdc0qmd.h, QMD v5.00) */
+static void
+nvk_gdq_qmd_set(uint32_t *qmd, unsigned lo, unsigned hi, uint32_t v)
+{
+   for (unsigned b = lo; b <= hi; b++) {
+      const uint32_t bit = (v >> (b - lo)) & 1;
+      qmd[b / 32] = (qmd[b / 32] & ~(1u << (b % 32))) | (bit << (b % 32));
+   }
+}
