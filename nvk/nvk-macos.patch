+
+/* Does `instr` (any type) read `def`? */
+struct nak_cg_reads_state { const nir_def *def; bool hit; };
+static bool
+nak_cg_reads_cb(nir_src *src, void *data)
+{
+   struct nak_cg_reads_state *st = data;
+   if (src->ssa == st->def)
+      st->hit = true;
+   return true;
+}
+static bool
+nak_cg_reads(nir_instr *instr, const nir_def *def)
+{
+   struct nak_cg_reads_state st = { def, false };
+   nir_foreach_src(instr, nak_cg_reads_cb, &st);
+   return st.hit;
+}
