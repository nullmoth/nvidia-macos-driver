+   NvHandle hCtxDma;
+   NvHandle hChannel;
+   /* b81 610 recipe: the TSG and SYNC ctxshare this channel lives in (0 = bare channel, the b80 shape), the zcull
+    * context buffer bound to it, and whether it is a copy-engine-only channel (the upload queue, 610's COPY4). */
+   NvHandle hTsg, hCtxShare;
