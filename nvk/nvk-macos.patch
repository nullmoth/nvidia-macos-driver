+    /* Default entrypoint matches are EXACT; neither 'main' nor a function
+     * containing the target as a substring is implicitly a RAW kernel. */
+    const char *targets[] = {"kNx1RGBA6X1Yf", "k1xNRGBA1X6Yf"};
+    for (unsigned i = 0; i < 2; ++i)
+        if ((entrypoint && !strcmp(entrypoint, targets[i])) ||
+            (name && !strcmp(name, targets[i])) ||
+            (label && !strcmp(label, targets[i]))) return 1;
+    return 0;
+}
+static unsigned nvmtl_small_array_limit(const char *value)
+{
+    if (getenv("NVMTL_NO_SMALL_ARRAYS")) return 0;
+    /* Default 16: per-thread arrays of up to 16 elements are kept in registers (if-else trees) instead of local
+     * memory. Measured over 249 GB7/MPS kernels: 11 change, all lose local loads/stores, none loses occupancy.
+     * 32 also takes a ray tracer's BVH stack and drops it from 36 to 16 warps per SM, so 32 stays opt-in. */
+    if (!value) return 16;
+    if (!strcmp(value, "8")) return 8;
+    if (!strcmp(value, "16")) return 16;
+    if (!strcmp(value, "32")) return 32;
+    return 0;
+}
+#endif
