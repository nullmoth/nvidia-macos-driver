+static VkDeviceSize
+nvk_get_as_size_internal(VkGeometryTypeKHR geometry_type, uint32_t leaf_node_count)
+{
+   uint32_t internal_node_count = MAX2(leaf_node_count, 2) - 1;
+   uint64_t nodes_size = (uint64_t)internal_node_count * sizeof(struct nvk_bvh_box_node);
+
+   uint32_t ir_leaf_node_size = 0, output_leaf_node_size = 0;
+   nvk_get_leaf_node_size(geometry_type, &ir_leaf_node_size, &output_leaf_node_size);
+   nodes_size += (uint64_t)leaf_node_count * output_leaf_node_size;
+
+   nodes_size = util_align_npot(nodes_size, NVK_BVH_NODE_PREFETCH_SIZE);
+
+   return sizeof(struct nvk_bvh_header) + nodes_size;
+}
