+static struct nvkmd_nvrm_sync *
+to_nvkmd_nvrm_sync(struct vk_sync *sync)
+{
+   assert(vk_sync_type_is_nvkmd_nvrm_sync(sync->type));
+   return container_of(sync, struct nvkmd_nvrm_sync, base);
