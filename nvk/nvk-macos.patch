+const struct nvkmd_mem_ops nvkmd_nvrm_mem_ops = {
+   .free = nvkmd_nvrm_mem_free,
+   .map = nvkmd_nvrm_mem_map,
+   .unmap = nvkmd_nvrm_mem_unmap,
+   .overmap = nvkmd_nvrm_mem_overmap,
+   .export_dma_buf = nvkmd_nvrm_mem_export_dma_buf,
