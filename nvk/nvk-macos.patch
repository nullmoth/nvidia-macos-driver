+nvmtl_raw_entrypoint_name(const nir_shader *nir)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   return impl && impl->function ? impl->function->name : NULL;
+}
+static bool
+nvmtl_raw_selected_nir(const nir_shader *nir)
+{
+   return nvmtl_raw_selected_entrypoint(nir->info.name, nir->info.label,
+                                        nvmtl_raw_entrypoint_name(nir),
+                                        nir->info.source_blake3);
+}
+/* Rust's optional allocator hook reads this without changing dispatch metadata. */
+unsigned nvmtl_raw_budget(const nir_shader *nir);
+unsigned nvmtl_raw_budget(const nir_shader *nir)
+{
