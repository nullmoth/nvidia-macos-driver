+static uint32_t
+nvk_gdq_dep_qmd_inv(const VkDependencyInfo *dep, uint32_t waits, uint32_t *membar)
+{
+   uint32_t inv = 0;
+   bool host = false;
+
+   for (uint32_t i = 0; i < dep->memoryBarrierCount; i++) {
+      const VkMemoryBarrier2 *bar = &dep->pMemoryBarriers[i];
+      inv |= nvk_barrier_invalidates(bar->dstStageMask, bar->dstAccessMask);
+      host |= (bar->dstStageMask & VK_PIPELINE_STAGE_2_HOST_BIT) != 0;
+   }
+
+   for (uint32_t i = 0; i < dep->bufferMemoryBarrierCount; i++) {
+      const VkBufferMemoryBarrier2 *bar = &dep->pBufferMemoryBarriers[i];
+      inv |= nvk_barrier_invalidates(bar->dstStageMask, bar->dstAccessMask);
+      host |= (bar->dstStageMask & VK_PIPELINE_STAGE_2_HOST_BIT) != 0;
+   }
+
+   uint32_t bits = 0;
+   if (inv & NVK_BARRIER_INVALIDATE_TEX_DATA)
+      bits |= 1u << 2;
+   if ((inv & NVK_BARRIER_INVALIDATE_SHADER_DATA) || (waits & NVK_BARRIER_FLUSH_SHADER_DATA))
+      bits |= 1u << 3;
+   if (inv & NVK_BARRIER_INVALIDATE_CONSTANT)
+      bits |= 1u << 5;
+   *membar = host ? 1 : 3;
+   return bits;
+}
