+
+/* NAK emits these with no instruction of their own (a zero-extended pair, a
+ * register rename), so a use of one is a use of the phi's register. */
+static bool
+nak_cg_sink_is_alias(const nir_instr *instr, const nir_def *of)
+{
+   if (instr->type != nir_instr_type_alu)
+      return false;
+   const nir_alu_instr *alu = nir_instr_as_alu(instr);
+   if (alu->op != nir_op_u2u64 && alu->op != nir_op_i2i64 && alu->op != nir_op_mov)
+      return false;
+   return alu->src[0].src.ssa == of;
