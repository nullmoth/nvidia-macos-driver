+static bool
+nak_cg_sink_one(nir_phi_instr *phi, nir_block *header)
+{
+   nir_alu_instr *s = NULL;
+   nir_foreach_phi_src(ps, phi) {
+      if (ps->pred->index < header->index)
+         continue;                       /* the preheader edge */
+      nir_instr *pi = nir_def_instr(ps->src.ssa);
+      if (s != NULL || pi->type != nir_instr_type_alu)
+         return false;                   /* one back edge, from an ALU */
+      s = nir_instr_as_alu(pi);
+   }
+   if (s == NULL || s->instr.block->index < header->index)
+      return false;
+   bool reads_phi = false;
+   for (unsigned i = 0; i < nir_op_infos[s->op].num_inputs; i++)
+      reads_phi |= s->src[i].src.ssa == &phi->def;
+   if (!reads_phi)
+      return false;
+
+   nir_block *b = s->instr.block;
+   /* Aliases of the phi: defined in b by a free op. */
+   const nir_def *alias[8];
+   unsigned n_alias = 0;
+   alias[n_alias++] = &phi->def;
+
+   /* Every use of the phi and its aliases must be in b, and S's uses after the target. */
+   nir_instr *target = &s->instr;
+   bool past_s = false, if_use = false;
+   nir_foreach_instr(instr, b) {
+      if (instr == &s->instr) {
+         past_s = true;
+         continue;
+      }
+      bool uses = false;
+      for (unsigned a = 0; a < n_alias; a++)
+         uses |= nak_cg_reads(instr, alias[a]);
+      if (uses && nak_cg_sink_is_alias(instr, alias[0]) && n_alias < 8) {
+         alias[n_alias++] = nir_instr_def(instr);
+      } else if (uses) {
+         for (unsigned a = 1; a < n_alias; a++)
+            if (nak_cg_sink_is_alias(instr, alias[a]) && n_alias < 8) {
+               alias[n_alias++] = nir_instr_def(instr);
+               break;
+            }
+      }
+      if (past_s && uses)
+         target = instr;
+   }
+
+   /* No use of an alias (or the phi) may live outside b, other than S itself. */
+   for (unsigned a = 0; a < n_alias; a++) {
+      nir_foreach_use_including_if(use, (nir_def *)alias[a]) {
+         if (nir_src_is_if(use)) {
+            nir_if *nif = nir_src_use_if(use);
+            if (nir_cf_node_prev(&nif->cf_node) != &b->cf_node)
+               return false;
+            if_use = true;               /* live to the end of b */
+            continue;
+         }
+         nir_instr *ui = nir_src_use_instr(use);
+         if (ui == &s->instr)
