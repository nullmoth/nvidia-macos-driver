diff -ruN a/src/nouveau/vulkan/nvk_bvh.h b/src/nouveau/vulkan/nvk_bvh.h
--- a/src/nouveau/vulkan/nvk_bvh.h	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/nvk_bvh.h	2026-10-05 09:23:46
@@ -0,0 +1,109 @@
+/*
+ * nvk_bvh.h — rung 3 of the NVIDIA-on-macOS program: SOFTWARE RAY TRACING ON NVK.
+ *
+ * The BVH NVK traverses on the SMs (there is no RT-core path in Mesa's NVIDIA driver; NAK has no TTU instructions).
+ * The layout is lavapipe's (src/gallium/frontends/lavapipe/lvp_acceleration_structure.h), the one Mesa driver that does
+ * ray queries with no ray-tracing hardware on the same shared builder NVK uses: a binary tree of box nodes with two children,
+ * and triangle / AABB / instance leaves, one header at offset 0. A node id is its byte offset from the BVH base with the node
+ * type in the low two bits. Shared between C (the driver, the NIR traversal) and GLSL (bvh/encode.comp) like RADV's bvh/bvh.h.
+ *
+ * Every offset here is read by nvk_nir_ray_tracing.c through offsetof and by encode.comp through the GLSL structs: the two
+ * must stay byte-identical, which is why there is one header. NVK_BVH_HEADER_SIZE is asserted against sizeof in C.
+ */
+#ifndef NVK_BVH_H
+#define NVK_BVH_H
+
+#ifdef VULKAN
+#include "vk_bvh_helpers.h"   /* 26.3: was vk_build_helpers.h */
+#else
+#include <stdint.h>
+#include "bvh/vk_bvh_defines.h"   /* 26.3: vk_bvh.h merged into vk_bvh_defines.h */
+#endif
+
+#define NVK_GEOMETRY_OPAQUE (1u << 31)
+
+#define NVK_INSTANCE_FORCE_OPAQUE                 (1u << 31)
+#define NVK_INSTANCE_NO_FORCE_NOT_OPAQUE          (1u << 30)
+#define NVK_INSTANCE_TRIANGLE_FACING_CULL_DISABLE (1u << 29)
+#define NVK_INSTANCE_TRIANGLE_FLIP_FACING         (1u << 28)
+
+/* Node types in the low two bits of a node id. Same numbering as the shared builder's IR (vk_ir_node_*). */
+#define nvk_bvh_node_triangle 0
+#define nvk_bvh_node_internal 1
+#define nvk_bvh_node_instance 2
+#define nvk_bvh_node_aabb     3
+
+struct nvk_bvh_triangle_node {
+   float coords[3][3];
+   uint32_t padding;
+   uint32_t primitive_id;
+   /* flags in the upper 4 bits */
+   uint32_t geometry_id_and_flags;
+};
+
+struct nvk_bvh_aabb_node {
+   vk_aabb bounds;
+   uint32_t primitive_id;
+   /* flags in the upper 4 bits */
+   uint32_t geometry_id_and_flags;
+};
+
+struct nvk_bvh_instance_node {
+   uint64_t bvh_ptr;
+   /* lower 24 bits are the custom instance index, upper 8 bits are the visibility mask */
+   uint32_t custom_instance_and_mask;
+   /* lower 24 bits are the sbt offset, upper 8 bits are VkGeometryInstanceFlagsKHR (NVK_INSTANCE_*) */
+   uint32_t sbt_offset_and_flags;
+   /* World-to-object, three rows of (a b c t): consecutive floats are one row, translation last. */
+   mat3x4 wto_matrix;
+   uint32_t padding;
+   uint32_t instance_id;
+   /* Object-to-world, the instance's transform as given, same row layout. */
+   mat3x4 otw_matrix;
+};
+
+struct nvk_bvh_box_node {
+   vk_aabb bounds[2];
+   uint32_t children[2];
+};
+
+/* The traversal loads this many bytes of a node up front (covers a box node, a triangle node, and the first four dwords of
+ * an instance node: bvh_ptr, custom_instance_and_mask, sbt_offset_and_flags). */
+#define NVK_BVH_NODE_PREFETCH_SIZE 56
+
+struct nvk_bvh_header {
+   /* offset 0: the root bounds. The shared builder writes them here (build_args.bvh_bounds_offset == 0) and the encode
+    * shader writes the same value. */
+   vk_aabb bounds;
+   /* offset 24: root cull flags, written by the shared builder when it propagates them (build_args.root_flags_offset). */
+   uint32_t root_flags;
+   uint32_t compacted_size;
+   uint32_t serialization_size;
+   uint32_t instance_count;
+   uint32_t leaf_nodes_offset;
+   uint32_t padding;
+};
+
+#define NVK_BVH_HEADER_SIZE      48
+#define NVK_BVH_ROOT_NODE_OFFSET NVK_BVH_HEADER_SIZE
+#define NVK_BVH_ROOT_NODE        (NVK_BVH_ROOT_NODE_OFFSET | nvk_bvh_node_internal)
+#define NVK_BVH_INVALID_NODE     0xFFFFFFFF
+
+/* Traversal stack entries per ray query (lavapipe: 48, with a CPU-side re-balance of trees deeper than 24; NVK keeps
+ * the whole tree as built and gives the stack more room instead — a tree deeper than this is a known limit, not a crash:
+ * the push simply drops the node). Chosen by us. */
+#define NVK_BVH_TRAVERSAL_STACK 64
+
+#ifdef VULKAN
+TYPE(nvk_bvh_triangle_node, 4);
+TYPE(nvk_bvh_aabb_node, 4);
+TYPE(nvk_bvh_instance_node, 8);
+TYPE(nvk_bvh_box_node, 4);
+TYPE(nvk_bvh_header, 4);
+#else
+struct nvk_device;
+VkResult nvk_device_init_accel_struct_state(struct nvk_device *dev);
+void nvk_device_finish_accel_struct_state(struct nvk_device *dev);
+#endif
+
+#endif /* NVK_BVH_H */
