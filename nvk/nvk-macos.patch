+bool
+nvkmd_nvrm_diag_on(void)
+{
+   static int on = -1;
+   if (on < 0) {
+      const char *e = nvmtl_conf_getenv("NVK_DIAG");
+      on = e && e[0] == '1';
+      if (on) {
+         char path[128]; snprintf(path, sizeof path, "/private/tmp/nvk-diag-%d.log", (int)getpid());
+         int fd = open(path, O_WRONLY | O_CREAT | O_APPEND, 0644);
+         if (fd >= 0) { dup2(fd, 2); close(fd); setvbuf(stderr, NULL, _IOLBF, 0); }
+         fprintf(stderr, "nvk-diag: on in %s pid %d, async %d\n", getprogname(), (int)getpid(), (int)nvkmd_nvrm_async_on());
+      }
+   }
+   return on;
+}
