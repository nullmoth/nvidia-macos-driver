+
+static VkResult
+nvkmd_nvrm_create_exec_ctx_on(struct nvkmd_dev *_dev,
+                              struct vk_object_base *log_obj,
+                              enum nvkmd_engines engines,
+                              bool allowCe,
+                              struct nvkmd_ctx **ctx_out)
+{
+   struct nvkmd_nvrm_dev *dev = nvkmd_nvrm_dev(_dev);
+   struct nvkmd_nvrm_pdev *pdev = nvkmd_nvrm_pdev(dev->base.pdev);
+   VkResult vkRes;
+
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+
+   struct nvkmd_nvrm_exec_ctx *ctx = CALLOC_STRUCT(nvkmd_nvrm_exec_ctx);
+   if (ctx == NULL)
+      return vk_error(log_obj, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   ctx->base.ops = &nvkmd_nvrm_exec_ctx_ops;
+   ctx->base.dev = &dev->base;
+
+   ctx->osEvent = -1;
+
+   VK_CHECK(nvkmd_dev_alloc_mapped_mem(_dev, log_obj,  0x1000,  0x1000, NVKMD_MEM_GART, NVKMD_MEM_MAP_RDWR,  &ctx->notifier));
+   VK_CHECK(nvkmd_dev_alloc_mapped_mem(_dev, log_obj, 0x80000, 0x10000, NVKMD_MEM_LOCAL, NVKMD_MEM_MAP_RDWR, &ctx->userD));
+   VK_CHECK(nvkmd_dev_alloc_mapped_mem(_dev, log_obj, 0x40000,  0x1000, NVKMD_MEM_GART, NVKMD_MEM_MAP_RDWR,  &ctx->gpFifo));
+   VK_CHECK(nvkmd_dev_alloc_mapped_mem(_dev, log_obj, 0x10000,  0x1000, NVKMD_MEM_GART, NVKMD_MEM_MAP_RDWR,  &ctx->cmdBuf));
+   VK_CHECK(nvkmd_dev_alloc_mapped_mem(_dev, log_obj,  0x1000,  0x1000, NVKMD_MEM_GART, NVKMD_MEM_MAP_RDWR,  &ctx->sem));
+
+	NV_CONTEXT_DMA_ALLOCATION_PARAMS ctxDmaParams = {
+		.flags =
+			DRF_DEF(OS03, _FLAGS, _MAPPING, _KERNEL) |
+			DRF_DEF(OS03, _FLAGS, _HASH_TABLE, _DISABLE),
+
+		.hMemory = nvkmd_nvrm_mem(ctx->notifier)->hMemoryPhys,
+		.offset = 0,
+		.limit = ctx->notifier->size_B - 1,
+	};
+   NV_CHECK(nvRmApiAlloc(&rm, pdev->hDevice, &ctx->hCtxDma, NV01_CONTEXT_DMA, &ctxDmaParams));
+
+
+
+   ctx->ceOnly = allowCe && engines == NVKMD_ENGINE_COPY && nvrm610_on("CECHAN");
+   NvU32 engineType = ctx->ceOnly ? NV2080_ENGINE_TYPE_COPY4 : NV2080_ENGINE_TYPE_GRAPHICS;
+   NvHandle chanParent = pdev->hDevice;
+   if (!ctx->ceOnly && nvrm610_on("TSG")) {
+      NV_CHANNEL_GROUP_ALLOCATION_PARAMETERS tp = { .hVASpace = pdev->hVaSpace, .engineType = engineType };
+      NV_STATUS ts = nvRmApiAlloc(&rm, pdev->hDevice, &ctx->hTsg, KEPLER_CHANNEL_GROUP_A, &tp);
+      if (ts == NV_OK) {
+         NV_CTXSHARE_ALLOCATION_PARAMETERS cp = { .hVASpace = pdev->hVaSpace,
+                                                  .flags = NV_CTXSHARE_ALLOCATION_FLAGS_SUBCONTEXT_SYNC, .subctxId = 0 };
+         NV_STATUS cs = nvRmApiAlloc(&rm, ctx->hTsg, &ctx->hCtxShare, FERMI_CONTEXT_SHARE_A, &cp);
+         if (cs == NV_OK) {
+            chanParent = ctx->hTsg;
+         } else {
+            fprintf(stderr, "nvrm: b81 ctxshare refused rc 0x%x - bare channel (b80 shape)\n", (unsigned)cs);
+            nvRmApiFree(&rm, ctx->hTsg); ctx->hTsg = 0; ctx->hCtxShare = 0;
+         }
+      } else {
+         fprintf(stderr, "nvrm: b81 TSG refused rc 0x%x - bare channel (b80 shape)\n", (unsigned)ts);
+         ctx->hTsg = 0;
+      }
+   }
+	NV_CHANNEL_ALLOC_PARAMS createChannelParams = {
+		.hObjectError  = ctx->hCtxDma,
+		.gpFifoOffset  = ctx->gpFifo->va->addr,
+		.gpFifoEntries = 0x8000,
+		.flags         = (ctx->hCtxShare || ctx->ceOnly) ? DRF_DEF(OS04, _FLAGS, _PRIVILEGED_CHANNEL, _TRUE) : 0,
+		.hContextShare = ctx->hCtxShare,
+		.hVASpace      = ctx->hCtxShare ? 0 : pdev->hVaSpace,
+		.hUserdMemory  = {nvkmd_nvrm_mem(ctx->userD)->hMemoryPhys},
+		.userdOffset   = {0},
+		.engineType    = engineType,
+	};
+   {
+      NV_STATUS chs = nvRmApiAlloc(&rm, chanParent, &ctx->hChannel, pdev->channelClass, &createChannelParams);
+      if (chs != NV_OK && createChannelParams.flags) {
+         fprintf(stderr, "nvrm: b81 PRIVILEGED channel refused rc 0x%x - retried unprivileged\n", (unsigned)chs);
+         createChannelParams.flags = 0; ctx->hChannel = 0;
+         chs = nvRmApiAlloc(&rm, chanParent, &ctx->hChannel, pdev->channelClass, &createChannelParams);
+      }
+      if (chs != NV_OK && ctx->ceOnly) {
+         fprintf(stderr, "nvrm: b81 COPY4 channel refused rc 0x%x - graphics channel for the upload queue (b80 shape)\n", (unsigned)chs);
+         ctx->ceOnly = false; engineType = NV2080_ENGINE_TYPE_GRAPHICS; createChannelParams.engineType = engineType; ctx->hChannel = 0;
+         chs = nvRmApiAlloc(&rm, chanParent, &ctx->hChannel, pdev->channelClass, &createChannelParams);
+      }
+      NV_CHECK(chs);
+   }
+
+	NVA06F_CTRL_BIND_PARAMS bindParams = {.engineType = engineType};
+	NV_CHECK(nvRmApiControl(&rm, ctx->hChannel, NVA06F_CTRL_CMD_BIND, &bindParams, sizeof(bindParams)));
+
+	if (nvmtl_cfg_getenv("NVK_PREEMPT_LOG"))
+		fprintf(stderr, "nvrm: gq channel 0x%x engineType %u (own internal TSG)\n",
+		        (unsigned)ctx->hChannel, (unsigned)engineType);
+
+	NVA06F_CTRL_GPFIFO_SCHEDULE_PARAMS scheduleParams = {.bEnable = NV_TRUE};
+	NV_CHECK(nvRmApiControl(&rm, ctx->hChannel, NVA06F_CTRL_CMD_GPFIFO_SCHEDULE, &scheduleParams, sizeof(scheduleParams)));
+
+	NVC36F_CTRL_GPFIFO_SET_WORK_SUBMIT_TOKEN_NOTIF_INDEX_PARAMS notifParams = {
+		.index = NV_CHANNELGPFIFO_NOTIFICATION_TYPE_WORK_SUBMIT_TOKEN
+	};
+	NV_CHECK(nvRmApiControl(&rm,
+		ctx->hChannel,
+		NVC36F_CTRL_CMD_GPFIFO_SET_WORK_SUBMIT_TOKEN_NOTIF_INDEX,
+		&notifParams,
+		sizeof(notifParams)
+	));
+
+	NVC36F_CTRL_CMD_GPFIFO_GET_WORK_SUBMIT_TOKEN_PARAMS tokenParams = {0};
+	NV_CHECK(nvRmApiControl(&rm,
+		ctx->hChannel,
+		NVC36F_CTRL_CMD_GPFIFO_GET_WORK_SUBMIT_TOKEN,
+		&tokenParams,
+		sizeof(tokenParams)
+	));
+
+   /* GTX 1650 (TU117), 10-07: the copy object on a GRAPHICS channel failed here (VK_ERROR_UNKNOWN) and no queue came up.
+    * Ampere+ RM pairs a CE object on a GR channel with the GR engine's partner CE itself (channel_descendant.c, "GRCE
+    * case"); Turing takes the legacy path, where the CE engine comes from NVB0B5_ALLOCATION_PARAMETERS
+    * (kceGetEngineDescFromAllocParams) and NULL params leave RM no engine. Name the partner CE the way RM does on
+    * Ampere (NV2080_CTRL_CMD_GPU_GET_ENGINE_PARTNERLIST). Ampere and later ignore these params. */
+   /* 10-07: passing the partner CE first changed the copy path on the RTX 5060 (screen 2, which WindowServer fills by
+    * copies, went black then flickered). The pre-10-07 call stays FIRST, so every card that works keeps it unchanged;
+    * the partner CE is only the retry, for Turing, where the plain call is refused. */
+   NV_STATUS cs = nvRmApiAlloc(&rm, ctx->hChannel, &ctx->subchannels.hCopy, pdev->base.dev_info.cls_copy, NULL);
+   if (cs != NV_OK && !ctx->ceOnly) {
+      NV2080_CTRL_GPU_GET_ENGINE_PARTNERLIST_PARAMS pl = { .engineType = NV2080_ENGINE_TYPE_GRAPHICS,
+                                                           .partnershipClassId = pdev->base.dev_info.cls_copy, .runqueue = 0 };
+      NV_STATUS ps = nvRmApiControl(&rm, pdev->hSubdevice, NV2080_CTRL_CMD_GPU_GET_ENGINE_PARTNERLIST, &pl, sizeof(pl));
+      fprintf(stderr, "nvrm: copy object on the graphics channel refused rc 0x%x - partner CE lookup rc 0x%x, %u partner(s)\n",
+              (unsigned)cs, (unsigned)ps, (unsigned)pl.numPartners);
+      if (ps == NV_OK && pl.numPartners >= 1) {
+         NVB0B5_ALLOCATION_PARAMETERS ceParams = { .version = NVB0B5_ALLOCATION_PARAMETERS_VERSION_1, .engineType = pl.partnerList[0] };
+         cs = nvRmApiAlloc(&rm, ctx->hChannel, &ctx->subchannels.hCopy, pdev->base.dev_info.cls_copy, &ceParams);
+      }
+   }
+   NV_CHECK(cs);
+   if (!ctx->ceOnly) {
+   NV_CHECK(nvRmApiAlloc(&rm, ctx->hChannel, &ctx->subchannels.hEng2d, pdev->base.dev_info.cls_eng2d, NULL));
+   NV_CHECK(nvRmApiAlloc(&rm, ctx->hChannel, &ctx->subchannels.hEng3d, pdev->base.dev_info.cls_eng3d, NULL));
+   NV_CHECK(nvRmApiAlloc(&rm, ctx->hChannel, &ctx->subchannels.hM2mf, pdev->base.dev_info.cls_m2mf, NULL));
+   NV_CHECK(nvRmApiAlloc(&rm, ctx->hChannel, &ctx->subchannels.hCompute, pdev->base.dev_info.cls_compute, NULL));
+   }
+
+   if (!ctx->ceOnly && !nvrm610_on("PREEMPT")) {
+      NV2080_CTRL_GR_GET_CTXSW_MODES_PARAMS before = { .hChannel = ctx->hChannel };
+      NV_STATUS g0 = nvRmApiControl(&rm, pdev->hSubdevice, NV2080_CTRL_CMD_GR_GET_CTXSW_MODES, &before, sizeof(before));
+      static const struct { NvU32 engineId, slot; const char *name; } pbuf[] = {
+         { NV0080_CTRL_FIFO_GET_ENGINE_CONTEXT_PROPERTIES_ENGINE_ID_GRAPHICS_PREEMPT,  NV2080_CTRL_CMD_GR_CTXSW_PREEMPTION_BIND_BUFFERS_MAIN,     "main" },
+         { NV0080_CTRL_FIFO_GET_ENGINE_CONTEXT_PROPERTIES_ENGINE_ID_GRAPHICS_SPILL,    NV2080_CTRL_CMD_GR_CTXSW_PREEMPTION_BIND_BUFFERS_SPILL,    "spill" },
+         { NV0080_CTRL_FIFO_GET_ENGINE_CONTEXT_PROPERTIES_ENGINE_ID_GRAPHICS_PAGEPOOL, NV2080_CTRL_CMD_GR_CTXSW_PREEMPTION_BIND_BUFFERS_PAGEPOOL, "pagepool" },
+         { NV0080_CTRL_FIFO_GET_ENGINE_CONTEXT_PROPERTIES_ENGINE_ID_GRAPHICS_BETACB,   NV2080_CTRL_CMD_GR_CTXSW_PREEMPTION_BIND_BUFFERS_BETACB,   "betacb" },
+         { NV0080_CTRL_FIFO_GET_ENGINE_CONTEXT_PROPERTIES_ENGINE_ID_GRAPHICS_RTV,      NV2080_CTRL_CMD_GR_CTXSW_PREEMPTION_BIND_BUFFERS_RTV,      "rtv" },
+      };
+      NV2080_CTRL_GR_CTXSW_PREEMPTION_BIND_PARAMS bp = {
+         .flags = DRF_DEF(2080_CTRL_GR, _SET_CTXSW_PREEMPTION_MODE_FLAGS, _CILP, _SET) | DRF_DEF(2080_CTRL_GR, _SET_CTXSW_PREEMPTION_MODE_FLAGS, _GFXP, _SET),
+         .gfxpPreemptMode = NV2080_CTRL_SET_CTXSW_PREEMPTION_MODE_GFX_GFXP,
+         .hClient = pdev->hClient,
+         .hChannel = ctx->hChannel,
+         .cilpPreemptMode = NV2080_CTRL_SET_CTXSW_PREEMPTION_MODE_COMPUTE_CTA,
+      };
+      char sizes[256]; int sl = 0; sizes[0] = 0;
+      for (unsigned b = 0; b < ARRAY_SIZE(pbuf); b++) {
+         NV0080_CTRL_FIFO_GET_ENGINE_CONTEXT_PROPERTIES_PARAMS ep = { .engineId = pbuf[b].engineId };
+         NV_STATUS es = nvRmApiControl(&rm, pdev->hDevice, NV0080_CTRL_CMD_FIFO_GET_ENGINE_CONTEXT_PROPERTIES, &ep, sizeof(ep));
+         if (sl < (int)sizeof(sizes) - 48)
+            sl += snprintf(sizes + sl, sizeof(sizes) - sl, " %s %u/%u(rc 0x%x)", pbuf[b].name, (unsigned)ep.size, (unsigned)ep.alignment, (unsigned)es);
+         if (es != NV_OK || ep.size == 0)
+            continue;
+         uint64_t align = ep.alignment > 0x1000 ? ep.alignment : 0x1000;
+         if (nvkmd_dev_alloc_mem(_dev, log_obj, align64(ep.size, align), align, NVKMD_MEM_LOCAL, &ctx->preempt[b]) == VK_SUCCESS)
+            bp.vMemPtrs[pbuf[b].slot] = ctx->preempt[b]->va->addr;
+      }
+      NV_STATUS sp = nvRmApiControl(&rm, pdev->hSubdevice, NV2080_CTRL_CMD_GR_CTXSW_PREEMPTION_BIND, &bp, sizeof(bp));
+      if (sp != NV_OK) {
+         NV2080_CTRL_GR_SET_CTXSW_PREEMPTION_MODE_PARAMS pm = {
+            .flags = NV2080_CTRL_GR_SET_CTXSW_PREEMPTION_MODE_FLAGS_CILP_SET,
+            .hChannel = ctx->hChannel,
+            .cilpPreemptMode = NV2080_CTRL_SET_CTXSW_PREEMPTION_MODE_COMPUTE_CTA,
+         };
+         NV_STATUS s2 = nvRmApiControl(&rm, pdev->hSubdevice, NV2080_CTRL_CMD_GR_SET_CTXSW_PREEMPTION_MODE, &pm, sizeof(pm));
+         fprintf(stderr, "nvrm: preemption BIND refused rc 0x%x; mode-only SET rc 0x%x\n", (unsigned)sp, (unsigned)s2);
+      }
+      NV2080_CTRL_GR_GET_CTXSW_MODES_PARAMS after = { .hChannel = ctx->hChannel };
+      NV_STATUS g1 = nvRmApiControl(&rm, pdev->hSubdevice, NV2080_CTRL_CMD_GR_GET_CTXSW_MODES, &after, sizeof(after));
+      if (sp != NV_OK || g1 != NV_OK || after.cilpPreemptMode != NV2080_CTRL_SET_CTXSW_PREEMPTION_MODE_COMPUTE_CTA || nvmtl_cfg_getenv("NVK_PREEMPT_LOG")) {
+      fprintf(stderr, "nvrm: preemption buffers:%s\n", sizes);
+      fprintf(stderr, "nvrm: compute preemption: before cilp %u gfxp %u (rc 0x%x) -> bind rc 0x%x -> after cilp %u gfxp %u (rc 0x%x)\n",
+              (unsigned)before.cilpPreemptMode, (unsigned)before.gfxpPreemptMode, (unsigned)g0, (unsigned)sp,
+              (unsigned)after.cilpPreemptMode, (unsigned)after.gfxpPreemptMode, (unsigned)g1);
+      }
+   }
+
+   if (!ctx->ceOnly && nvrm610_on("PREEMPT")) {
+
+      NV2080_CTRL_GR_SET_CTXSW_PREEMPTION_MODE_PARAMS pm = {
+         .flags = NV2080_CTRL_GR_SET_CTXSW_PREEMPTION_MODE_FLAGS_CILP_SET,
+         .hChannel = ctx->hTsg ? ctx->hTsg : ctx->hChannel,
+         .gfxpPreemptMode = NV2080_CTRL_SET_CTXSW_PREEMPTION_MODE_GFX_WFI,
+         .cilpPreemptMode = NV2080_CTRL_SET_CTXSW_PREEMPTION_MODE_COMPUTE_CTA,
+      };
+      NV_STATUS ps = nvRmApiControl(&rm, pdev->hSubdevice, NV2080_CTRL_CMD_GR_SET_CTXSW_PREEMPTION_MODE, &pm, sizeof pm);
+      NV2080_CTRL_GR_GET_CTXSW_MODES_PARAMS after = { .hChannel = ctx->hChannel };
+      NV_STATUS gs = nvRmApiControl(&rm, pdev->hSubdevice, NV2080_CTRL_CMD_GR_GET_CTXSW_MODES, &after, sizeof after);
+      if (ps != NV_OK || gs != NV_OK || after.cilpPreemptMode != NV2080_CTRL_SET_CTXSW_PREEMPTION_MODE_COMPUTE_CTA || nvmtl_cfg_getenv("NVK_PREEMPT_LOG"))
+         fprintf(stderr, "nvrm: b81 preemption CILP_SET cta/wfi on %s rc 0x%x -> cilp %u gfxp %u (rc 0x%x)\n",
+                 ctx->hTsg ? "TSG" : "channel", (unsigned)ps, (unsigned)after.cilpPreemptMode, (unsigned)after.gfxpPreemptMode, (unsigned)gs);
+   }
+   if (!ctx->ceOnly && nvrm610_on("LGPROMO")) {
+      NV0090_CTRL_SET_LG_SECTOR_PROMOTION_PARAMS lp = { .promoType = NV0090_CTRL_SET_LG_SECTOR_PROMOTION_64B };
+      NV_STATUS ls = nvRmApiControl(&rm, ctx->hChannel, NV0090_CTRL_CMD_SET_LG_SECTOR_PROMOTION, &lp, sizeof lp);
+      if (ls != NV_OK || nvmtl_cfg_getenv("NVK_PREEMPT_LOG"))
+         fprintf(stderr, "nvrm: b81 SET_LG_SECTOR_PROMOTION 64B rc 0x%x\n", (unsigned)ls);
+   }
+   if (!ctx->ceOnly && nvrm610_on("ZCULL")) {
+
+      NV0080_CTRL_FIFO_GET_ENGINE_CONTEXT_PROPERTIES_PARAMS zp = { .engineId = NV0080_CTRL_FIFO_GET_ENGINE_CONTEXT_PROPERTIES_ENGINE_ID_GRAPHICS_ZCULL };
+      NV_STATUS zs = nvRmApiControl(&rm, pdev->hDevice, NV0080_CTRL_CMD_FIFO_GET_ENGINE_CONTEXT_PROPERTIES, &zp, sizeof zp);
+      if (zs == NV_OK && zp.size > 0) {
+         uint64_t zal = zp.alignment > 0x1000 ? zp.alignment : 0x1000;
+         if (nvkmd_dev_alloc_mem(_dev, log_obj, align64(zp.size, zal), zal, NVKMD_MEM_LOCAL, &ctx->zcull) == VK_SUCCESS) {
+            NV2080_CTRL_GR_CTXSW_ZCULL_BIND_PARAMS zb = { .hClient = pdev->hClient, .hChannel = ctx->hChannel,
+                                                          .vMemPtr = ctx->zcull->va->addr,
+                                                          .zcullMode = NV2080_CTRL_CTXSW_ZCULL_MODE_SEPARATE_BUFFER };
+            NV_STATUS bs = nvRmApiControl(&rm, pdev->hSubdevice, NV2080_CTRL_CMD_GR_CTXSW_ZCULL_BIND, &zb, sizeof zb);
+            if (bs != NV_OK || nvmtl_cfg_getenv("NVK_PREEMPT_LOG"))
+               fprintf(stderr, "nvrm: b81 ZCULL_BIND %u B SEPARATE rc 0x%x\n", (unsigned)zp.size, (unsigned)bs);
+         }
+      } else if (nvmtl_cfg_getenv("NVK_PREEMPT_LOG")) {
+         fprintf(stderr, "nvrm: b81 zcull context properties rc 0x%x size %u - not bound\n", (unsigned)zs, (unsigned)zp.size);
+      }
+   }
+   if (nvmtl_cfg_getenv("NVK_PREEMPT_LOG"))
+      fprintf(stderr, "nvrm: b81 channel 0x%x %s: tsg 0x%x ctxshare 0x%x engineType %u\n", (unsigned)ctx->hChannel,
+              ctx->ceOnly ? "COPY-ENGINE" : "graphics", (unsigned)ctx->hTsg, (unsigned)ctx->hCtxShare, (unsigned)engineType);
+
+
+
+
+
+   nv_push_init(&ctx->push, ctx->cmdBuf->map, 0x10000 / 4, BITFIELD_BIT(SUBC_NV9097));
+   nvrm_gsub_register(ctx);
+
+   *ctx_out = &ctx->base;
+   return VK_SUCCESS;
+
+error:
+   nvkmd_ctx_destroy(&ctx->base);
+	return vkRes;
+}
+
+/* RTX 3060 Ti (GA104): RM created the COPY4 channel and then refused the copy object on it ("bad class 0xc7b5"), so
+ * every vkCreateDevice failed. COPY4 is the async copy engine NVIDIA's driver uses on Blackwell; copy engine numbering
+ * and the classes each one exposes differ per chip. When the copy-engine context cannot be built on this GPU, build the
+ * copy queue on a graphics channel instead, which every chip runs. */
+static VkResult
+nvkmd_nvrm_create_exec_ctx(struct nvkmd_dev *_dev,
+                              struct vk_object_base *log_obj,
+                              enum nvkmd_engines engines,
+                              struct nvkmd_ctx **ctx_out)
+{
+   VkResult r = nvkmd_nvrm_create_exec_ctx_on(_dev, log_obj, engines, true, ctx_out);
+   if (r != VK_SUCCESS && engines == NVKMD_ENGINE_COPY && nvrm610_on("CECHAN")) {
+      fprintf(stderr, "nvrm: copy-engine queue could not be built on this GPU (VkResult %d) - copy queue on a graphics channel\n", (int)r);
+      r = nvkmd_nvrm_create_exec_ctx_on(_dev, log_obj, engines, false, ctx_out);
+   }
+   return r;
+}
