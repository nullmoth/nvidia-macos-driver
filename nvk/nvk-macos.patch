+    fn verify(&self, physical_gprs: u32) {
+        if self.cap != 0 {
+            assert!(NVMTL_RA_BUDGET.with(|v| v.get().1),
+                    "RAW cap enabled but integrated assign_regs hook did not participate");
+            assert!(physical_gprs <= self.cap, "RAW physical GPR cap was exceeded");
+            eprintln!("NVMTL_RAW_RA requested={} actual={} (physical GPRs)", self.cap, physical_gprs);
+        }
+    }
+}
+impl Drop for NvmtlRaBudgetGuard {
+    fn drop(&mut self) { NVMTL_RA_BUDGET.with(|v| v.set(self.old)); }
