+static void
+nvk_encode(VkCommandBuffer commandBuffer, struct vk_device *vk_device, struct vk_meta_device *meta,
+           const struct vk_acceleration_structure_build_args *build_args,
+           struct vk_acceleration_structure_build_state *states, uint32_t build_count,
+           bool flushed_compute_after_init_update_scratch)
+{
+   VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+
+   vk_bvh_build_barrier_compute_to_compute(commandBuffer, true);
+
+   VkPipeline pipeline;
+   VkResult result = vk_get_bvh_build_pipeline_spv(vk_device, meta,
+                                                   (enum vk_meta_object_key_type)NVK_META_OBJECT_KEY_BVH_ENCODE,
+                                                   nvk_encode_spv, sizeof(nvk_encode_spv),
+                                                   sizeof(struct nvk_encode_args), build_args, 0, &pipeline,
+                                                   false );
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+   VkPipelineLayout layout;
+   result = vk_get_bvh_build_pipeline_layout(vk_device, meta, sizeof(struct nvk_encode_args), &layout);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+
+   dev->vk.dispatch_table.CmdBindPipeline(commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+
+   for (uint32_t i = 0; i < build_count; i++) {
+      const struct vk_acceleration_structure_build_state *state = &states[i];
+      VK_FROM_HANDLE(vk_acceleration_structure, dst, state->build_info->dstAccelerationStructure);
+
+      const VkGeometryTypeKHR geometry_type = vk_get_as_geometry_type(state->build_info);
+      const struct nvk_encode_args args = {
+         .intermediate_bvh = state->build_info->scratchData.deviceAddress + state->scratch.ir_offset,
+         .output_bvh = vk_acceleration_structure_get_va(dst),
+         .header = state->build_info->scratchData.deviceAddress + state->scratch.header_offset,
+         .leaf_node_count = state->leaf_node_count,
+         .geometry_type = geometry_type,
+         .bvh_size = (uint32_t)nvk_get_as_size_internal(geometry_type, state->leaf_node_count),
+      };
+      dev->vk.dispatch_table.CmdPushConstants(commandBuffer, layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(args), &args);
+
+      const uint32_t local_x = 64;
+      const uint32_t groups_x = DIV_ROUND_UP(MAX2(state->leaf_node_count, 1), local_x);
+      dev->vk.dispatch_table.CmdDispatchBase(commandBuffer, 0, 0, 0, groups_x, 1, 1);
+   }
