+static int gTrace = -1;
+
+#define NVRM_XNU_MAX_FD 32768
+#define NVRM_XNU_MAX_MAP 16384
+enum { SEL_GO = 0, SEL_ESC = 1, SEL_GETFD = 2, SEL_BINDFD = 3 };
+static io_connect_t gConn[NVRM_XNU_MAX_FD];
+static struct { void *addr; size_t len; io_connect_t conn; } gMaps[NVRM_XNU_MAX_MAP];
+static pthread_mutex_t gLock = PTHREAD_MUTEX_INITIALIZER;
+#define NVRM_XNU_POOL 128
+static io_connect_t gPoolConn[NVRM_XNU_POOL];
+static uint32_t     gPoolType[NVRM_XNU_POOL];
+static int          gPoolN;
+static uint32_t     gConnType[NVRM_XNU_MAX_FD];
+static unsigned long gPoolHit, gPoolMiss, gPoolPut, gPoolDrop;
+
+static io_connect_t pool_take(uint32_t type)
+{
+    for (int i = gPoolN - 1; i >= 0; i--)
+        if (gPoolType[i] == type) {
+            io_connect_t c = gPoolConn[i];
+            gPoolConn[i] = gPoolConn[gPoolN - 1];
+            gPoolType[i] = gPoolType[gPoolN - 1];
+            gPoolN--;
+            return c;
+        }
+    return 0;
+}
+static int pool_put(io_connect_t conn, uint32_t type)
+{
+    if (gPoolN >= NVRM_XNU_POOL) return 0;
+    gPoolConn[gPoolN] = conn; gPoolType[gPoolN] = type; gPoolN++;
+    return 1;
+}
+
+
+int nvrm_xnu_open(const char *node)
+{
+    uint32_t type = (node && strstr(node, "ctl")) ? 0 : 1;
+    pthread_mutex_lock(&gLock);
+    io_connect_t reuse = pool_take(type);
+    if (reuse) gPoolHit++; else gPoolMiss++;
+    pthread_mutex_unlock(&gLock);
+    if (reuse) {
+        int rfd = open("/dev/null", O_RDONLY | O_CLOEXEC);
+        if (rfd < 0 || rfd >= NVRM_XNU_MAX_FD) {
+            if (rfd >= 0) close(rfd);
+            pthread_mutex_lock(&gLock);
+            if (!pool_put(reuse, type)) { pthread_mutex_unlock(&gLock); IOServiceClose(reuse); pthread_mutex_lock(&gLock); }
+            pthread_mutex_unlock(&gLock);
+            errno = EMFILE; return -1;
+        }
+        uint64_t rin = (uint64_t)rfd;
+        IOConnectCallScalarMethod(reuse, SEL_BINDFD, &rin, 1, NULL, NULL);
+        pthread_mutex_lock(&gLock); gConn[rfd] = reuse; gConnType[rfd] = type; pthread_mutex_unlock(&gLock);
+        return rfd;
+    }
+    io_service_t svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("NVAccel"));
+    uint32_t open_type = 0x4E560000u | type;
+    if (!svc) {
+        svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("NVRM"));
+        open_type = type;
+    }
+    if (!svc) { fprintf(stderr, "nvrm_xnu: no NVAccel and no NVRM service\n"); errno = ENODEV; return -1; }
+    io_connect_t conn = 0;
+    kern_return_t kr = IOServiceOpen(svc, mach_task_self(), open_type, &conn);
+    if (kr != KERN_SUCCESS && open_type != type) {
+        fprintf(stderr, "nvrm_xnu: IOServiceOpen(NVAccel, 0x%08x) 0x%08x — falling back to NVRM\n", open_type, kr);
+        IOObjectRelease(svc);
+        svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("NVRM"));
+        if (svc) kr = IOServiceOpen(svc, mach_task_self(), type, &conn);
+    }
+    if (svc) IOObjectRelease(svc);
+    if (kr != KERN_SUCCESS) { fprintf(stderr, "nvrm_xnu: IOServiceOpen(type %u) 0x%08x\n", type, kr); errno = EIO; return -1; }
+    // read-only: the fd is only a handle number; browser GPU sandboxes allow reading /dev/null but not opening it
+    // read-write, so with O_RDWR Safari/Chromium GPU processes saw no device and no WebGL (user report 10-10)
+    int fd = open("/dev/null", O_RDONLY | O_CLOEXEC);
+    if (fd < 0 || fd >= NVRM_XNU_MAX_FD) { IOServiceClose(conn); if (fd >= 0) close(fd); errno = EMFILE; return -1; }
+    uint64_t in = (uint64_t)fd;
+    IOConnectCallScalarMethod(conn, SEL_BINDFD, &in, 1, NULL, NULL);
+    pthread_mutex_lock(&gLock); gConn[fd] = conn; gConnType[fd] = type; pthread_mutex_unlock(&gLock);
+    return fd;
+}
+static io_connect_t conn_of(int fd) { return (fd >= 0 && fd < NVRM_XNU_MAX_FD) ? gConn[fd] : 0; }
+
+int64_t nvrm_xnu_wait_event(int fd, uint32_t seen, uint32_t timeout_us)
+{
+    io_connect_t conn = conn_of(fd); if (!conn) return -1;
+    uint64_t in[2] = { seen, timeout_us }, out = 0; uint32_t n = 1;
+    kern_return_t kr = IOConnectCallScalarMethod(conn, 6, in, 2, &out, &n);
+    return kr == KERN_SUCCESS ? (int64_t)(uint32_t)out : -1;
+}
+int nvrm_xnu_ioctl(int fd, uint32_t cmd, void *data, uint32_t size)
+{
+    io_connect_t conn = conn_of(fd); if (!conn) return EBADF;
+    uint64_t in = cmd; size_t out = size;
+    kern_return_t kr = IOConnectCallMethod(conn, SEL_ESC, &in, 1, data, size, NULL, NULL, data, &out);
+    if (kr != KERN_SUCCESS) { fprintf(stderr, "nvrm_xnu: esc 0x%02x (%u bytes) -> 0x%08x\n", cmd, size, kr); return EINVAL; }
+    if (gTrace < 0) gTrace = nvmtl_cfg_getenv("NVRM_XNU_TRACE") ? 1 : 0;
+    if (gTrace) {
+        switch (cmd) {
+        case NV_ESC_RM_ALLOC: { NVOS21_PARAMETERS *p = data; fprintf(stderr, "nvrm: ALLOC class 0x%04x parent 0x%08x -> 0x%08x status 0x%x\n", p->hClass, p->hObjectParent, p->hObjectNew, p->status); break; }
+        case NV_ESC_RM_FREE: { NVOS00_PARAMETERS *p = data; fprintf(stderr, "nvrm: FREE 0x%08x status 0x%x\n", p->hObjectOld, p->status); break; }
+        case NV_ESC_RM_CONTROL: { NVOS54_PARAMETERS *p = data; fprintf(stderr, "nvrm: CONTROL 0x%08x cmd 0x%08x status 0x%x\n", p->hObject, p->cmd, p->status); break; }
+        case NV_ESC_RM_MAP_MEMORY: { nv_ioctl_nvos33_parameters_with_fd *p = data; fprintf(stderr, "nvrm: MAP_MEMORY 0x%08x len 0x%llx fd %d status 0x%x\n", p->params.hMemory, (unsigned long long)p->params.length, p->fd, p->params.status); break; }
+        case NV_ESC_RM_UNMAP_MEMORY: { NVOS34_PARAMETERS *p = data; fprintf(stderr, "nvrm: UNMAP_MEMORY 0x%08x status 0x%x\n", p->hMemory, p->status); break; }
+        case NV_ESC_RM_MAP_MEMORY_DMA: { NVOS46_PARAMETERS *p = data; fprintf(stderr, "nvrm: MAP_MEMORY_DMA mem 0x%08x dma 0x%08x len 0x%llx -> 0x%llx status 0x%x\n", p->hMemory, p->hDma, (unsigned long long)p->length, (unsigned long long)p->dmaOffset, p->status); break; }
+        case NV_ESC_RM_UNMAP_MEMORY_DMA: { NVOS47_PARAMETERS *p = data; fprintf(stderr, "nvrm: UNMAP_MEMORY_DMA mem 0x%08x status 0x%x\n", p->hMemory, p->status); break; }
+        case NV_ESC_ALLOC_OS_EVENT: { nv_ioctl_alloc_os_event_t *p = data; fprintf(stderr, "nvrm: ALLOC_OS_EVENT fd %u status 0x%x\n", p->fd, p->Status); break; }
+        case NV_ESC_FREE_OS_EVENT: { nv_ioctl_free_os_event_t *p = data; fprintf(stderr, "nvrm: FREE_OS_EVENT fd %u status 0x%x\n", p->fd, p->Status); break; }
+        case NV_ESC_REGISTER_FD: { nv_ioctl_register_fd_t *p = data; fprintf(stderr, "nvrm: REGISTER_FD ctl_fd %d on fd %d\n", p->ctl_fd, fd); break; }
+        default: fprintf(stderr, "nvrm: esc 0x%02x (%u bytes)\n", cmd, size); break;
+        }
+    }
+    return 0;
+}
+void *nvrm_xnu_mmap(int fd, size_t length) { return nvrm_xnu_mmap_wc(fd, length, 0); }
+void *nvrm_xnu_mmap_wc(int fd, size_t length, int writeCombine)
+{
+    io_connect_t conn = conn_of(fd); if (!conn) { errno = EBADF; return MAP_FAILED; }
+    mach_vm_address_t addr = 0; mach_vm_size_t len = 0;
+    kern_return_t kr = IOConnectMapMemory64(conn, 0, mach_task_self(), &addr, &len,
+                                            kIOMapAnywhere | (writeCombine ? kIOMapWriteCombineCache : 0));
+    if (kr != KERN_SUCCESS) { fprintf(stderr, "nvrm_xnu: IOConnectMapMemory64 -> 0x%08x\n", kr); errno = EIO; return MAP_FAILED; }
+    pthread_mutex_lock(&gLock);
+    int stored = 0;
+    for (int i = 0; i < NVRM_XNU_MAX_MAP; i++) if (!gMaps[i].addr) { gMaps[i].addr = (void *)(uintptr_t)addr; gMaps[i].len = (size_t)len; gMaps[i].conn = conn; stored = 1; break; }
+    pthread_mutex_unlock(&gLock);
+    if (!stored) {
+        static int told; if (!told) { told = 1;
+            fprintf(stderr, "nvrm_xnu: MAPPING TABLE FULL (%d) -- this mapping is untracked and its "
+                            "connection can never be closed\n", NVRM_XNU_MAX_MAP); }
+    }
+    return (void *)(uintptr_t)addr;
+}
+static io_connect_t gPendingClose[NVRM_XNU_MAX_MAP];
+static int maps_on(io_connect_t conn) { int n = 0; for (int i = 0; i < NVRM_XNU_MAX_MAP; i++) if (gMaps[i].addr && gMaps[i].conn == conn) n++; return n; }
+static int pending_close(io_connect_t conn) { for (int i = 0; i < NVRM_XNU_MAX_MAP; i++) if (gPendingClose[i] == conn) return i; return -1; }
+int nvrm_xnu_munmap(void *addr, size_t length)
+{
+    io_connect_t conn = 0;
+    pthread_mutex_lock(&gLock);
+    for (int i = 0; i < NVRM_XNU_MAX_MAP; i++) if (gMaps[i].addr == addr) { conn = gMaps[i].conn; gMaps[i].addr = NULL; break; }
+    int closeNow = 0, pi = -1;
+    if (conn && maps_on(conn) == 0 && (pi = pending_close(conn)) >= 0) { gPendingClose[pi] = 0; closeNow = 1; }
+    pthread_mutex_unlock(&gLock);
+    if (!conn) { errno = EINVAL; return -1; }
+    IOConnectUnmapMemory64(conn, 0, mach_task_self(), (mach_vm_address_t)(uintptr_t)addr);
+    if (closeNow) IOServiceClose(conn);
+    return 0;
+}
+int nvrm_xnu_close(int fd)
+{
+    io_connect_t conn = conn_of(fd);
+    if (conn) {
+        pthread_mutex_lock(&gLock);
+        gConn[fd] = 0;
+        int live = maps_on(conn);
+        if (live) {
+            int parked = 0;
+            for (int i = 0; i < NVRM_XNU_MAX_MAP; i++) if (!gPendingClose[i]) { gPendingClose[i] = conn; parked = 1; break; }
+            if (!parked) {
+                static int told; if (!told) { told = 1;
+                    fprintf(stderr, "nvrm_xnu: PENDING-CLOSE TABLE FULL (%d) -- this connection will "
+                                    "never be closed\n", NVRM_XNU_MAX_MAP); }
+            }
+        }
+        pthread_mutex_unlock(&gLock);
+        if (live) {
+            uint64_t in = (uint64_t)(int64_t)-2;
+            IOConnectCallScalarMethod(conn, SEL_BINDFD, &in, 1, NULL, NULL);
+        }
+        if (!live) {
+            pthread_mutex_lock(&gLock);
+            int pooled = pool_put(conn, gConnType[fd]);
+            if (pooled) gPoolPut++; else gPoolDrop++;
+            pthread_mutex_unlock(&gLock);
+            if (!pooled) IOServiceClose(conn);
+        }
+    }
+    return close(fd);
+}
