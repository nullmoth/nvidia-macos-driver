#version 460
#extension GL_EXT_ray_query : require

// One ray per invocation, the committed hit written out. Non-opaque candidates are confirmed, so the answer is the nearest
// hit under the ray flags; the host compares it with a CPU reference.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1) buffer Rays { vec4 r[]; } rays;      // two vec4 per ray: origin and tmin, direction and tmax
layout(set = 0, binding = 2) buffer Out { uvec4 o[]; } outb;       // per ray: distance bits, primitive, instance, type | front << 8
layout(push_constant) uniform P { uint flags; uint mask; uint count; } pc;

void main()
{
   uint i = gl_GlobalInvocationID.x;
   if (i >= pc.count) return;
   vec4 a = rays.r[2 * i], b = rays.r[2 * i + 1];
   rayQueryEXT rq;
   rayQueryInitializeEXT(rq, tlas, pc.flags, pc.mask, a.xyz, a.w, b.xyz, b.w);
   while (rayQueryProceedEXT(rq)) {
      if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT)
         rayQueryConfirmIntersectionEXT(rq);
   }
   uint ty = rayQueryGetIntersectionTypeEXT(rq, true);
   if (ty == gl_RayQueryCommittedIntersectionNoneEXT) {
      outb.o[i] = uvec4(0xffffffffu, 0, 0, 0);
      return;
   }
   outb.o[i] = uvec4(floatBitsToUint(rayQueryGetIntersectionTEXT(rq, true)),
                     uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true)),
                     uint(rayQueryGetIntersectionInstanceIdEXT(rq, true)),
                     1u | (rayQueryGetIntersectionFrontFaceEXT(rq, true) ? 256u : 0u));
}
