+/* The hardware part: clear each appendix, then write it from the same intermediate BVH the software encode just read. */
+static void
+nvk_hwrt_encode(VkCommandBuffer commandBuffer, struct vk_device *vk_device, struct vk_meta_device *meta,
+                const struct vk_acceleration_structure_build_args *build_args,
+                struct vk_acceleration_structure_build_state *states, uint32_t build_count)
+{
+   VK_FROM_HANDLE(nvk_cmd_buffer, cmd, commandBuffer);
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+
+   VkPipeline pipeline;
+   VkResult result = vk_get_bvh_build_pipeline_spv(vk_device, meta,
+                                                   (enum vk_meta_object_key_type)NVK_META_OBJECT_KEY_BVH_ENCODE_TTU,
+                                                   nvk_encode_ttu_spv, sizeof(nvk_encode_ttu_spv),
+                                                   sizeof(struct nvk_hwrt_encode_args), build_args, 0, &pipeline, false);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+   VkPipelineLayout layout;
+   result = vk_get_bvh_build_pipeline_layout(vk_device, meta, sizeof(struct nvk_hwrt_encode_args), &layout);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+   dev->vk.dispatch_table.CmdBindPipeline(commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+
+   /* the software encode wrote hw_offset = 0 into the header; the hardware pass sets it, so it must come after */
+   vk_bvh_build_barrier_compute_to_compute(commandBuffer, true);
+
+   for (uint32_t pass = 0; pass < 2; pass++) {
+      for (uint32_t i = 0; i < build_count; i++) {
+         const struct vk_acceleration_structure_build_state *state = &states[i];
