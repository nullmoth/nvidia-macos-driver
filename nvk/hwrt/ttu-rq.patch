+/* Where the hardware part sits in a structure of this build, relative to the structure base, and how large it is. */
+struct nvk_hwrt_place {
+   uint32_t hw_offset;               /* appendix, 256-aligned after the software BVH */
+   uint32_t hw_size;                 /* the hardware structure */
+   uint32_t geometry_table_offset;   /* from the appendix; after the hardware structure */
+   uint32_t geometry_count;
+   uint64_t total;                   /* the whole acceleration structure */
+};
+
+static struct nvk_hwrt_place
+nvk_hwrt_place(VkGeometryTypeKHR geometry_type, uint32_t leaf_node_count, uint32_t geometry_count)
+{
+   struct nvk_hwrt_place p;
+   const uint32_t leaf_size = geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR ? NVK_HWL_INST_LEAF_SIZE
+                              : geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR   ? NVK_HWL_BOX_LEAF_SIZE
+                                                                              : NVK_HWL_TRI_LEAF_SIZE;
+   const uint64_t sw = nvk_get_as_size_internal(geometry_type, leaf_node_count);
+   p.hw_offset = (uint32_t)align64(sw, NVK_HWRT_ALIGN);
+   p.hw_size = (uint32_t)align64(NVK_HWL_HEADER_SIZE + (uint64_t)NVK_HWL_NODES_FOR(leaf_node_count) * NVK_HWL_NODE_SIZE +
+                                 (uint64_t)leaf_node_count * leaf_size, NVK_HWRT_ALIGN);
+   p.geometry_count = geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR ? 0 : geometry_count;
+   p.geometry_table_offset = NVK_HWRT_STRUCT_OFFSET + p.hw_size;
+   p.total = (uint64_t)p.hw_offset + p.geometry_table_offset + (uint64_t)p.geometry_count * sizeof(struct nvk_hwrt_geometry);
