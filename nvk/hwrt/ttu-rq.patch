diff -ruN a/src/nouveau/vulkan/bvh/encode_ttu.comp b/src/nouveau/vulkan/bvh/encode_ttu.comp
--- a/src/nouveau/vulkan/bvh/encode_ttu.comp	1969-12-31 16:00:00
+++ b/src/nouveau/vulkan/bvh/encode_ttu.comp	2026-11-08 23:56:44
@@ -0,0 +1,241 @@
+/*
+ * encode_ttu.comp - the hardware half of an acceleration structure build (docs/HWRT.md).
+ *
+ * Runs after encode.comp, from the same intermediate BVH, and writes struct nvk_hwrt_appendix, the geometry table and the
+ * structure the RT cores walk (nvk_hwrt_layout.h, generation NVK_HWRT_LAYOUT_PROVISIONAL). The mapping is the one encode.comp
+ * uses: index arithmetic only, one invocation per leaf that also writes internal node x, no atomics except the top level's
+ * has-procedural word.
+ *   leaf i      -> leaves_base + i * leaf_size
+ *   IR box j    -> header + (internal_count - 1 - j) * node_size      (the root becomes node 0)
+ * mode 1 (after a copy of a finished structure) rewrites the structure's own address and nothing else.
+ */
+#version 460
+
+#extension GL_GOOGLE_include_directive : require
+
+#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_EXT_scalar_block_layout : require
+#extension GL_EXT_buffer_reference : require
+#extension GL_EXT_buffer_reference2 : require
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+#define VK_USED_BUILD_FLAGS 0
+#include "vk_bvh_helpers.h"
+#include "nvk_build_interface.h"
+#include "nvk_bvh.h"
+#include "nvk_hwrt.h"
+#include "nvk_hwrt_layout.h"
+
+#ifndef VK_GEOMETRY_TYPE_TRIANGLES_KHR
+#define VK_GEOMETRY_TYPE_TRIANGLES_KHR 0
+#define VK_GEOMETRY_TYPE_AABBS_KHR     1
+#define VK_GEOMETRY_TYPE_INSTANCES_KHR 2
+#endif
+
+layout(push_constant) uniform CONSTS {
+   nvk_hwrt_encode_args args;
+};
+
+void
+put32(uint64_t base, uint32_t off, uint32_t v)
+{
+   DEREF(REF(nvk_hwrt_word32)(OFFSET(base, off))).v = v;
+}
+
+void
+put64(uint64_t base, uint32_t off, uint64_t v)
+{
+   DEREF(REF(nvk_hwrt_word64)(OFFSET(base, off))).v = v;
+}
+
+void
+putf(uint64_t base, uint32_t off, float v)
+{
+   put32(base, off, floatBitsToUint(v));
+}
+
+void
+main()
+{
+   uint32_t gid = gl_GlobalInvocationID.x;
+   /* mode 1 runs on a finished structure, so it reads where the appendix is from the structure itself */
+   uint32_t hw_offset = args.mode == 1u ? DEREF(REF(nvk_bvh_header)(args.output_bvh)).hw_offset : args.hw_offset;
+   uint64_t app_addr = OFFSET(args.output_bvh, hw_offset);
+   uint64_t hw = OFFSET(app_addr, NVK_HWRT_STRUCT_OFFSET);
+
+   if (args.mode == 1u) {
+      if (gid == 0u && hw_offset != 0u)
+         put64(hw, NVK_HWL_OFF_SELF, hw);
+      return;
+   }
+   if (args.mode == 2u) {
+      /* clear the appendix before the pass: the top level ORs into it */
+      if (gid == 0u) {
+         REF(nvk_hwrt_appendix) a = REF(nvk_hwrt_appendix)(app_addr);
+         DEREF(a).magic = 0u;
+         DEREF(a).generation = 0u;
+         DEREF(a).structure_size = 0u;
+         DEREF(a).geometry_table_offset = 0u;
+         DEREF(a).geometry_count = 0u;
+         DEREF(a).has_procedural = 0u;
+         DEREF(a).padding[0] = 0u;
+         DEREF(a).padding[1] = 0u;
+      }
+      return;
+   }
+
+   uint32_t leaf_count = args.leaf_node_count;
+   uint32_t ir_leaf_size;
+   uint32_t out_leaf_size;
+   uint32_t leaf_type;
+   switch (args.geometry_type) {
+   case VK_GEOMETRY_TYPE_TRIANGLES_KHR:
+      ir_leaf_size = SIZEOF(vk_ir_triangle_node);
+      out_leaf_size = NVK_HWL_TRI_LEAF_SIZE;
+      leaf_type = nvk_bvh_node_triangle;
+      break;
+   case VK_GEOMETRY_TYPE_AABBS_KHR:
+      ir_leaf_size = SIZEOF(vk_ir_aabb_node);
+      out_leaf_size = NVK_HWL_BOX_LEAF_SIZE;
+      leaf_type = nvk_bvh_node_aabb;
+      break;
+   default:
+      ir_leaf_size = SIZEOF(vk_ir_instance_node);
+      out_leaf_size = NVK_HWL_INST_LEAF_SIZE;
+      leaf_type = nvk_bvh_node_instance;
+      break;
+   }
+
+   uint32_t internal_count = max(DEREF(args.header).ir_internal_node_count, 1u);
+   uint32_t leaves_base = NVK_HWL_HEADER_SIZE + internal_count * NVK_HWL_NODE_SIZE;
+   uint32_t root_offset = leaf_count * ir_leaf_size;
+
+   if (gid < leaf_count) {
+      VOID_REF src = OFFSET(args.intermediate_bvh, gid * ir_leaf_size);
+      uint64_t dst = OFFSET(hw, leaves_base + gid * out_leaf_size);
+      switch (args.geometry_type) {
+      case VK_GEOMETRY_TYPE_TRIANGLES_KHR: {
+         vk_ir_triangle_node s = DEREF(REF(vk_ir_triangle_node)(src));
+         for (uint32_t i = 0; i < 3; i++)
+            for (uint32_t j = 0; j < 3; j++)
+               putf(dst, (i * 3 + j) * 4, s.coords[i][j]);
+         put32(dst, 36, s.triangle_id);
+         put32(dst, 40, s.geometry_id_and_flags);
+         /* the lowering reads these per geometry; the first primitive of a geometry names it */
+         if (s.triangle_id == 0u) {
+            uint32_t geom = s.geometry_id_and_flags & 0xFFFFFFu;
+            uint64_t entry = OFFSET(app_addr, args.geometry_table_offset + geom * 8u);
+            put32(entry, 0, s.geometry_id_and_flags);
+            put32(entry, 4, gid);
+         }
+         break;
+      }
+      case VK_GEOMETRY_TYPE_AABBS_KHR: {
+         vk_ir_aabb_node s = DEREF(REF(vk_ir_aabb_node)(src));
+         for (uint32_t j = 0; j < 3; j++) {
+            putf(dst, j * 4, s.base.aabb.min[j]);
+            putf(dst, 12 + j * 4, s.base.aabb.max[j]);
+         }
+         put32(dst, 24, s.primitive_id);
+         put32(dst, 28, s.geometry_id_and_flags);
+         break;
+      }
+      default: {
+         vk_ir_instance_node s = DEREF(REF(vk_ir_instance_node)(src));
+         mat3x4 o = s.otw_matrix;
+         for (uint32_t r = 0; r < 3; r++)
+            for (uint32_t c = 0; c < 4; c++)
+               putf(dst, NVK_HWL_INST_XFORM + (r * 4 + c) * 4, o[r][c]);
+         uint64_t root = 0ul;
+         uint32_t missing = 0u;
+         if (s.base_ptr != 0ul) {
+            uint32_t blas_hw_off = DEREF(REF(nvk_bvh_header)(s.base_ptr)).hw_offset;
+            if (blas_hw_off != 0u) {
+               uint64_t blas_app = OFFSET(s.base_ptr, blas_hw_off);
+               uint64_t blas_hw = OFFSET(blas_app, NVK_HWRT_STRUCT_OFFSET);
+               root = blas_hw;
+               atomicOr(DEREF(REF(nvk_hwrt_appendix)(app_addr)).has_procedural,
+                        DEREF(REF(nvk_hwrt_appendix)(blas_app)).has_procedural & 1u);
+            } else {
+               missing = 2u;
+            }
+         }
+         if (missing != 0u)
+            atomicOr(DEREF(REF(nvk_hwrt_appendix)(app_addr)).has_procedural, missing);
+         put64(dst, NVK_HWL_INST_ROOT, root);
+         put32(dst, NVK_HWL_INST_MASK, s.custom_instance_and_mask >> 24);
+         put32(dst, NVK_HWL_INST_INDEX, gid);
+         put32(dst, NVK_HWL_INST_SBT, s.sbt_offset_and_flags & 0xFFFFFFu);
+         put32(dst, NVK_HWL_INST_CUSTOM, s.custom_instance_and_mask & 0xFFFFFFu);
+         put32(dst, NVK_HWL_INST_FLAGS, s.sbt_offset_and_flags >> 24);
+         break;
+      }
+      }
+   }
+
+   if (gid >= internal_count)
+      return;
+
+   uint32_t src_index = internal_count - 1 - gid;
+   REF(vk_ir_box_node) src =
+      REF(vk_ir_box_node)(OFFSET(args.intermediate_bvh, root_offset + src_index * SIZEOF(vk_ir_box_node)));
+   uint64_t dst = OFFSET(hw, NVK_HWL_HEADER_SIZE + gid * NVK_HWL_NODE_SIZE);
+   bool built = DEREF(args.header).ir_internal_node_count > 0;
+
+   for (uint32_t c = 0; c < 2; c++) {
+      uint32_t child = built ? DEREF(src).children[c] : VK_BVH_INVALID_NODE;
+      uint32_t slot = c * 56u;
+      if (child == VK_BVH_INVALID_NODE) {
+         for (uint32_t k = 0; k < 6; k++)
+            putf(dst, slot + k * 4, uintBitsToFloat(0x7fc00000u));
+         put32(dst, slot + 24, NVK_BVH_INVALID_NODE);
+         continue;
+      }
+      uint32_t child_offset = child & ~3u;
+      vk_aabb aabb = DEREF(REF(vk_ir_node)(OFFSET(args.intermediate_bvh, child_offset))).aabb;
+      /* the same watertight growth encode.comp applies */
+      aabb.min -= max(abs(aabb.min), vec3(1.0)) * 1.1920929e-7;
+      aabb.max += max(abs(aabb.max), vec3(1.0)) * 1.1920929e-7;
+      for (uint32_t k = 0; k < 3; k++) {
+         putf(dst, slot + k * 4, aabb.min[k]);
+         putf(dst, slot + 12 + k * 4, aabb.max[k]);
+      }
+      if (child_offset < root_offset) {
+         uint32_t leaf_index = child_offset / ir_leaf_size;
+         put32(dst, slot + 24, (leaves_base + leaf_index * out_leaf_size) | leaf_type);
+      } else {
+         uint32_t si = (child_offset - root_offset) / SIZEOF(vk_ir_box_node);
+         uint32_t di = internal_count - si - 1;
+         put32(dst, slot + 24, (NVK_HWL_HEADER_SIZE + di * NVK_HWL_NODE_SIZE) | nvk_bvh_node_internal);
+      }
+   }
+
+   if (gid == 0u) {
+      bool tlas = args.geometry_type == VK_GEOMETRY_TYPE_INSTANCES_KHR;
+      REF(nvk_hwrt_appendix) app = REF(nvk_hwrt_appendix)(app_addr);
+      DEREF(app).magic = NVK_HWRT_APPENDIX_MAGIC;
+      DEREF(app).generation = NVK_HWRT_LAYOUT_PROVISIONAL;
+      DEREF(app).structure_size = args.hw_size;
+      DEREF(app).geometry_table_offset = tlas ? 0u : args.geometry_table_offset;
+      DEREF(app).geometry_count = tlas ? 0u : args.geometry_count;
+      if (args.geometry_type == VK_GEOMETRY_TYPE_AABBS_KHR)
+         DEREF(app).has_procedural = 1u;   /* the top level's word is cleared by mode 2 and only OR-ed into */
+      DEREF(app).magic = NVK_HWRT_APPENDIX_MAGIC;
+      put32(hw, 0x000, tlas ? NVK_HWL_MAGIC_TLAS : NVK_HWL_MAGIC_BLAS);
+      put32(hw, NVK_HWL_OFF_FLAGS, NVK_HWL_BUILD_FLAGS);
+      put32(hw, NVK_HWL_OFF_SIZE, args.hw_size);
+      put32(hw, NVK_HWL_OFF_LEAVES, leaves_base);
+      put64(hw, NVK_HWL_OFF_ROOT, uint64_t(NVK_HWL_HEADER_SIZE));
+      put64(hw, NVK_HWL_OFF_SENTINEL, ~0ul);
+      put32(hw, NVK_HWL_OFF_NODES, NVK_HWL_NODES_VALUE);
+      put32(hw, NVK_HWL_OFF_GEOMS, tlas ? 0u : args.geometry_count);
+      put32(hw, NVK_HWL_OFF_PRIMS, leaf_count);
+      put64(hw, NVK_HWL_OFF_SELF, hw);
+      DEREF(REF(nvk_bvh_header)(args.output_bvh)).hw_offset = args.hw_offset;
+   }
+}
