+    }
+}
+
+/// Instructions in one TTU query region (see OpTtuQuery).
+const TTU_QUERY_INSTRS: usize = 15;
+/// TTU input block offsets, in OpTtuQuery::srcs order.
+const TTU_STORE_OFFSETS: [u16; 5] = [0, 64, 80, 128, 512];
+/// TTU output block offsets, in OpTtuQuery::dsts order. The last load closes
+/// the context.
+const TTU_LOAD_OFFSETS: [u16; 6] = [896, 960, 976, 800, 784, 768];
+
+/// A 128-bit TTU payload is two 64-bit register pairs.
+fn ttu_reg_pairs(reg: RegRef) -> (RegRef, RegRef) {
+    assert!(reg.file() == RegFile::GPR && reg.comps() == 4);
+    assert!(reg.base_idx() % 2 == 0 && reg.base_idx() <= 250);
+    (
+        RegRef::new(RegFile::GPR, reg.base_idx(), 2),
+        RegRef::new(RegFile::GPR, reg.base_idx() + 2, 2),
+    )
+}
+
+/// Emits the 15-instruction region for one SM120 hardware query. Opcodes,
+/// field positions and delays were measured on an RTX 5060 (32 of 32 rays
+/// exact); check_ttu_region.py judges every emitted word against the field
+/// table in docs/HWRT.md. The region waits on whatever calc_instr_deps asked
+/// for, uses scoreboards 0-5 for its six result loads and waits on all six
+/// before the next instruction.
+fn encode_ttu_query(
+    sm: u8,
+    op: &OpTtuQuery,
+    deps: &InstrDeps,
+    labels: &FxHashMap<Label, usize>,
+    encoded: &mut Vec<u32>,
+) {
+    assert!(sm == 120, "the TTU query encoding is only known for SM120");
+    let mut emit = |deps: InstrDeps, f: &dyn Fn(&mut SM70Encoder<'_>)| {
+        let mut e = SM70Encoder {
+            sm,
+            ip: encoded.len(),
+            labels,
+            inst: [0_u32; 4],
+        };
+        f(&mut e);
+        e.set_pred(&Pred::from(true));
+        e.set_instr_deps(&deps);
+        encoded.extend_from_slice(&e.inst[..]);
+    };
+    let with_delay = |delay: u8| {
+        let mut d = InstrDeps::new();
+        d.set_delay(delay);
+        d
+    };
+
+    // TTUOPEN: waits for the payload loads and anything still in flight.
+    let mut open = with_delay(6);
+    open.add_wt_bar_mask(deps.wt_bar_mask);
+    emit(open, &|e| {
+        e.set_opcode(0x3d0);
+        e.set_bit(72, op.initialize);
+    });
+
+    // TTUCCTL: the number of instructions from here to the closing load.
+    emit(with_delay(4), &|e| {
+        e.set_opcode(0x9d4);
+        e.set_field(40..56, 12_u16);
+    });
+
+    for (src, offset) in op.srcs.iter().zip(TTU_STORE_OFFSETS) {
+        let reg = *src.src_ref.as_reg().expect("TTU payload must be in GPRs");
+        let (lo, hi) = ttu_reg_pairs(reg);
+        emit(with_delay(1), &|e| {
+            e.set_opcode(0x3d1);
+            e.set_field(40..56, offset);
+            e.set_reg(64..72, lo);
+            e.set_reg(32..40, hi);
+        });
+    }
+
+    emit(with_delay(1), &|e| e.set_opcode(0x3d3)); // TTUGO
+
+    for (i, (dst, offset)) in op.dsts.iter().zip(TTU_LOAD_OFFSETS).enumerate()
+    {
+        let reg = *dst.as_reg().expect("TTU results must be in GPRs");
+        let (lo, hi) = ttu_reg_pairs(reg);
+        let close = i == TTU_LOAD_OFFSETS.len() - 1;
+        let mut d = with_delay(if close { 2 } else { 1 });
+        d.set_wr_bar(i as u8);
+        emit(d, &|e| {
+            e.set_opcode(0x3d2);
+            e.set_field(40..56, offset);
+            e.set_reg(16..24, lo);
+            e.set_reg(64..72, hi);
+            e.set_field(81..84, 7_u8);
+            e.set_bit(74, close);
+        });
+    }
+
+    // Drain the six result scoreboards so the results are plain registers.
+    let mut drain = with_delay(4);
+    drain.add_wt_bar_mask(0x3f);
+    emit(drain, &|e| e.set_opcode(0x918));
+}
