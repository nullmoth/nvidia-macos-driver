+/// One hardware traversal query on the SM120 RT core (TTU).
+///
+/// The TTU holds a per-lane context that the open/store/go/load instructions
+/// read and write without naming it, so the whole sequence is a single op:
+/// register allocation and scheduling can place its inputs before it and its
+/// results after it, but never put an instruction inside it. The encoder
+/// emits the 15-instruction region measured on an RTX 5060 for one query
+/// (TTUOPEN, TTUCCTL, 5 TTUST, TTUGO, 6 TTULD, scoreboard drain).
+///
+/// srcs are the TTU input blocks at offsets 0, 64, 80, 128 and 512. dsts[0]
+/// and dsts[1] receive the blocks at 896 and 960 (loaded because the protocol
+/// reads all six); dsts[2..6] are the blocks at 976, 800, 784 and 768.
+#[repr(C)]
+#[derive(SrcsAsSlice, DstsAsSlice)]
+pub struct OpTtuQuery {
+    #[src_type(GPR)]
+    pub srcs: [Src; 5],
+    pub dsts: [Dst; 6],
+    pub initialize: bool,
+}
+
+impl DisplayOp for OpTtuQuery {
+    fn fmt_op(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "ttu.query{}", if self.initialize { ".init" } else { "" })?;
+        for src in &self.srcs {
+            write!(f, " {}", src)?;
+        }
+        Ok(())
+    }
+}
+impl_display_for_op!(OpTtuQuery);
