+/* NVRM_610_BOOST: how the GPU is kept at full clocks while this process works. */
+enum {
+   NVKMD_NVRM_BOOST_OFF,     /* NVRM_610_BOOST=0: never ask, the GPU follows its own idle policy */
+   NVKMD_NVRM_BOOST_BURST,   /* default: a short lease, renewed by submissions, so an idle GPU drops to low power */
+   NVKMD_NVRM_BOOST_HOLD,    /* NVRM_610_BOOST=hold: one boost for the life of the device (compute-style) */
+};
+
+/* Called on every command submission; asks for full clocks at most once a second and only while work is flowing. */
+void nvkmd_nvrm_boost_burst(struct nvkmd_nvrm_pdev *pdev);
