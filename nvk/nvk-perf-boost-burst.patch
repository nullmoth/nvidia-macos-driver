+/* How long one lease lasts, and how often a busy process renews it. The lease outlives the renewal interval, so
+ * it never lapses while submissions keep coming; a process that stops submitting falls out of boost within
+ * NVKMD_NVRM_BOOST_LEASE_S seconds and the GPU can drop to its idle state. */
+#define NVKMD_NVRM_BOOST_LEASE_S   3
+#define NVKMD_NVRM_BOOST_RENEW_NS  1000000000ull
+
+void
+nvkmd_nvrm_boost_burst(struct nvkmd_nvrm_pdev *pdev)
+{
+   if (pdev->boostMode != NVKMD_NVRM_BOOST_BURST)
+      return;
+
+   const uint64_t now = os_time_get_nano();
+   uint64_t due = __atomic_load_n(&pdev->boostRenewNs, __ATOMIC_RELAXED);
+   if (now < due)
+      return;
+   /* One thread wins the renewal; the others see the new deadline and go on. */
+   if (!__atomic_compare_exchange_n(&pdev->boostRenewNs, &due, now + NVKMD_NVRM_BOOST_RENEW_NS, false,
+                                    __ATOMIC_RELAXED, __ATOMIC_RELAXED))
+      return;
+
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+   NV2080_CTRL_PERF_BOOST_PARAMS bp = {
+      .flags = NV2080_CTRL_PERF_BOOST_FLAGS_CMD_BOOST_TO_MAX,
+      .duration = NVKMD_NVRM_BOOST_LEASE_S,
+   };
+   NV_STATUS bs = nvRmApiControl(&rm, pdev->hSubdevice, NV2080_CTRL_CMD_PERF_BOOST, &bp, sizeof bp);
+   if (bs != NV_OK) {
+      /* Not supported here: stop asking rather than fail every second. */
+      __atomic_store_n(&pdev->boostMode, NVKMD_NVRM_BOOST_OFF, __ATOMIC_RELAXED);
+      if (nvkmd_nvrm_diag_on())
+         fprintf(stderr, "nvrm: PERF_BOOST lease refused (rc 0x%x), not asking again\n", (unsigned)bs);
+   }
+}
