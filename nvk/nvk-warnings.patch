diff -ru a/src/nouveau/headers/drf.h b/src/nouveau/headers/drf.h
--- a/src/nouveau/headers/drf.h	2026-11-09 03:32:38
+++ b/src/nouveau/headers/drf.h	2026-11-09 03:33:16
@@ -28,6 +28,8 @@
 #define DRF_LO(drf)    (0 ? drf)
 #define DRF_HI(drf)    (1 ? drf)
 #define DRF_BITS(drf)  (DRF_HI(drf) - DRF_LO(drf) + 1)
+/* NVIDIA's nvmisc.h defines its own DRF_MASK; whichever header comes later wins, as it always did */
+#undef DRF_MASK
 #define DRF_MASK(drf)  (~UINT64_C(0) >> (64 - DRF_BITS(drf)))
 #define DRF_SMASK(drf) (DRF_MASK(drf) << DRF_LO(drf))
 
