--- a/src/nouveau/vulkan/nvkmd/nvrm/nvrm_floor_shim.c
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvrm_floor_shim.c
@@ -0,0 +1,44 @@
+/* nvrm_floor_shim.c: two libSystem calls that arrive with macOS 10.12, for a build whose floor is OS X 10.11.
+ *
+ * The Rust standard library inside this driver is built for 10.12 and binds clock_gettime and fclonefileat as required
+ * symbols; 10.11 exports neither, so the library would not load there. Defined here, both names resolve inside the
+ * library itself. On a system that has the real call it is used (looked up in the next image); on 10.11 the clock is
+ * the Mach absolute time (wall time for the real-time clock) and the clone call reports "not supported", which makes
+ * its caller copy the file the ordinary way. A build for 10.12 or later compiles nothing from this file. */
+#include <Availability.h>
+#if defined(__MAC_OS_X_VERSION_MIN_REQUIRED) && __MAC_OS_X_VERSION_MIN_REQUIRED < 101200
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdint.h>
+#include <time.h>
+#include <sys/time.h>
+#include <mach/mach_time.h>
+
+int clock_gettime(clockid_t id, struct timespec *ts)
+{
+    static int (*real)(clockid_t, struct timespec *); static int looked;
+    if (!looked) { real = (int (*)(clockid_t, struct timespec *))dlsym(RTLD_NEXT, "clock_gettime"); looked = 1; }
+    if (real) return real(id, ts);
+    if (!ts) { errno = EINVAL; return -1; }
+    if (id == _CLOCK_REALTIME) {
+        struct timeval tv; gettimeofday(&tv, NULL);
+        ts->tv_sec = tv.tv_sec; ts->tv_nsec = (long)tv.tv_usec * 1000; return 0;
+    }
+    static mach_timebase_info_data_t tb;
+    if (!tb.denom) mach_timebase_info(&tb);
+    const uint64_t ns = mach_absolute_time() * tb.numer / tb.denom;
+    ts->tv_sec = (time_t)(ns / 1000000000ull); ts->tv_nsec = (long)(ns % 1000000000ull);
+    return 0;
+}
+
+int fclonefileat(int srcfd, int dst_dirfd, const char *dst, uint32_t flags);
+int fclonefileat(int srcfd, int dst_dirfd, const char *dst, uint32_t flags)
+{
+    static int (*real)(int, int, const char *, uint32_t); static int looked;
+    if (!looked) { real = (int (*)(int, int, const char *, uint32_t))dlsym(RTLD_NEXT, "fclonefileat"); looked = 1; }
+    if (real) return real(srcfd, dst_dirfd, dst, flags);
+    errno = ENOTSUP; return -1;
+}
+#else
+typedef int nvrm_floor_shim_is_empty_at_this_floor;
+#endif
