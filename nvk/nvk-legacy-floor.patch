NVK for a macOS floor below 12: applied last with NVK_EXTRA_PATCHES=nvk-legacy-floor (build/build_nvk.sh, NVK_FLOOR=<floor>).
The device open no longer reads the main-port data symbol that only macOS 12 and later export, and the window-surface
code checks at run time for the layer and colour-space features that arrived after the floor. A build for macOS 15
behaves as before: every check is constant there.

diff -ruN a/src/nouveau/vulkan/nvkmd/nvrm/nvrm_xnu.c b/src/nouveau/vulkan/nvkmd/nvrm/nvrm_xnu.c
--- a/src/nouveau/vulkan/nvkmd/nvrm/nvrm_xnu.c	2026-11-11 04:21:16
+++ b/src/nouveau/vulkan/nvkmd/nvrm/nvrm_xnu.c	2026-11-11 04:21:35
@@ -1,6 +1,9 @@
 #include "../../nvmtl_cfg.h"
 #include "nvrm_xnu.h"
 #include <IOKit/IOKitLib.h>
+/* The I/O Kit calls take a null port to mean the default main port. kIOMainPortDefault is the named form of that null
+ * and is a data symbol only macOS 12 and later export, so a build for an older floor must not read it. */
+#define NVRM_IO_MAIN_PORT ((mach_port_t)MACH_PORT_NULL)
 #include <mach/mach.h>
 #include <sys/mman.h>
 #include <fcntl.h>
@@ -143,16 +146,16 @@
     if (want_id && *want_id) {
         char *end = NULL; unsigned long long id = strtoull(want_id, &end, 10);
         if (*end == 0 && id) {
-            svc = IOServiceGetMatchingService(kIOMainPortDefault, IORegistryEntryIDMatching(id));
+            svc = IOServiceGetMatchingService(NVRM_IO_MAIN_PORT, IORegistryEntryIDMatching(id));
             if (svc && !IOObjectConformsTo(svc, "NVAccel")) { IOObjectRelease(svc); svc = 0; }
         }
         if (!svc) { fprintf(stderr, "nvrm_xnu: NVK_ACCEL_ID=%s names no NVAccel\n", want_id); errno = ENODEV; return -1; }
     } else {
-        svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("NVAccel"));
+        svc = IOServiceGetMatchingService(NVRM_IO_MAIN_PORT, IOServiceMatching("NVAccel"));
     }
     uint32_t open_type = 0x4E560000u | type;
     if (!svc) {
-        svc = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("NVRM"));
+        svc = IOServiceGetMatchingService(NVRM_IO_MAIN_PORT, IOServiceMatching("NVRM"));
         open_type = type;
     }
     if (!svc) { fprintf(stderr, "nvrm_xnu: no NVAccel and no NVRM service\n"); errno = ENODEV; return -1; }
@@ -162,7 +165,7 @@
         // the accelerator is there but would not vend one — fall back rather than lose the GPU
         fprintf(stderr, "nvrm_xnu: IOServiceOpen(NVAccel, 0x%08x) 0x%08x — falling back to NVRM\n", open_type, kr);
         IOObjectRelease(svc);
-        svc = (want_id && *want_id) ? 0 : IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("NVRM"));
+        svc = (want_id && *want_id) ? 0 : IOServiceGetMatchingService(NVRM_IO_MAIN_PORT, IOServiceMatching("NVRM"));
         if (svc) kr = IOServiceOpen(svc, mach_task_self(), type, &conn);
     }
     if (svc) IOObjectRelease(svc);
