+static bool
+split_wide_global_load(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_global_nv)
+      return false;
+   const unsigned comp_bytes = intr->def.bit_size / 8;
+   const unsigned bytes = comp_bytes * intr->def.num_components;
+   const unsigned align = nir_intrinsic_align(intr);
+   if (bytes <= align || intr->def.num_components == 1 || comp_bytes > align)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *comps[NIR_MAX_VEC_COMPONENTS];
+   const int base = nir_intrinsic_has_base(intr) ? nir_intrinsic_base(intr) : 0;
+   for (unsigned i = 0; i < intr->def.num_components; i++) {
+      nir_def *v = nir_load_global_nv(b, 1, intr->def.bit_size, intr->src[0].ssa, intr->src[1].ssa,
+                                      intr->src[2].ssa);
+      nir_intrinsic_instr *one = nir_def_as_intrinsic(v);
+      if (nir_intrinsic_has_base(one))
+         nir_intrinsic_set_base(one, base + (int)(i * comp_bytes));
+      nir_intrinsic_set_access(one, nir_intrinsic_access(intr));
+      nir_intrinsic_set_align_mul(one, comp_bytes);
+      nir_intrinsic_set_align_offset(one, 0);
+      comps[i] = v;
+   }
+   nir_def_replace(&intr->def, nir_vec(b, comps, intr->def.num_components));
+   return true;
 }
 
+static bool
+nak_nir_split_wide_global_loads(nir_shader *nir)
+{
+   return nir_shader_intrinsics_pass(nir, split_wide_global_load, nir_metadata_control_flow, NULL);
+}
