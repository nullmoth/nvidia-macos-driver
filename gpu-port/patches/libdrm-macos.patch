+#ifdef __APPLE__
+#include <pthread.h>
+#include <sys/ioctl.h>
+
+/* the NullMoth DRM node ioctls (the kext's nmx_drm_uapi.h; the two must stay identical) */
+struct nmx_drm_mmap {
+    uint64_t offset;
+    uint64_t size;
+    uint32_t prot;
+    uint32_t flags;
+    uint64_t addr;
+};
+struct nmx_drm_munmap {
+    uint64_t addr;
+    uint64_t size;
+};
+#define NMX_DRM_IOCTL_MMAP _IOWR('N', 0x40, struct nmx_drm_mmap)
+#define NMX_DRM_IOCTL_MUNMAP _IOW('N', 0x41, struct nmx_drm_munmap)
+
+/* mappings made through a node, so drm_munmap (which has no fd) can release them through the right one */
+struct nmx_map {
+    void *addr;
+    size_t length;
+    int fd;
+    struct nmx_map *next;
+};
+static struct nmx_map *nmx_maps;
+static pthread_mutex_t nmx_maps_lock = PTHREAD_MUTEX_INITIALIZER;
+
+drm_public void *drmNmxMmap(size_t length, int prot, int flags, int fd, off_t offset)
+{
+    struct nmx_drm_mmap req = { (uint64_t)offset, (uint64_t)length, (uint32_t)prot, 0, 0 };
+    struct nmx_map *m;
+
+    if (drmIoctl(fd, NMX_DRM_IOCTL_MMAP, &req) != 0) {
+        /* ENOTTY: not a NullMoth node (drm-shim interposes mmap(2) itself) */
+        if (errno == ENOTTY)
+            return mmap(NULL, length, prot, flags, fd, offset);
+        return MAP_FAILED;
+    }
+    m = malloc(sizeof(*m));
+    if (m == NULL) {
+        struct nmx_drm_munmap un = { req.addr, (uint64_t)length };
+        drmIoctl(fd, NMX_DRM_IOCTL_MUNMAP, &un);
+        errno = ENOMEM;
+        return MAP_FAILED;
+    }
+    m->addr = (void *)(uintptr_t)req.addr;
+    m->length = length;
+    m->fd = fd;
+    pthread_mutex_lock(&nmx_maps_lock);
+    m->next = nmx_maps;
+    nmx_maps = m;
+    pthread_mutex_unlock(&nmx_maps_lock);
+    return m->addr;
+}
+
+drm_public int drmNmxMunmap(void *addr, size_t length)
+{
+    struct nmx_map **pp, *m = NULL;
+    struct nmx_drm_munmap un;
+    int r;
+
+    pthread_mutex_lock(&nmx_maps_lock);
+    for (pp = &nmx_maps; *pp; pp = &(*pp)->next) {
+        if ((*pp)->addr == addr) {
+            m = *pp;
+            *pp = m->next;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&nmx_maps_lock);
+    if (m == NULL)
+        return munmap(addr, length);        /* made by mmap(2) */
+    un.addr = (uint64_t)(uintptr_t)addr;
+    un.size = (uint64_t)m->length;
+    r = drmIoctl(m->fd, NMX_DRM_IOCTL_MUNMAP, &un);
+    free(m);
+    return r;
+}
+#endif
