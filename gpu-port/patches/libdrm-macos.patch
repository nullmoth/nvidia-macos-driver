+/* Darwin assigns character majors at run time and its devname_r searches only the top level of /dev, so a DRM
+ * node is recognised by finding its device number among the entries of /dev/dri. */
+static bool drm_darwin_node_exists(int maj, int min)
+{
+    DIR *dir = opendir(DRM_DIR_NAME);
+    struct dirent *ent;
+    bool found = false;
+
+    if (!dir)
+        return false;
+    while (!found && (ent = readdir(dir)) != NULL) {
+        char path[PATH_MAX];
+        struct stat sbuf;
+
+        if (ent->d_name[0] == '.')
+            continue;
+        snprintf(path, sizeof(path), "%s/%s", DRM_DIR_NAME, ent->d_name);
+        found = stat(path, &sbuf) == 0 && S_ISCHR(sbuf.st_mode) &&
+                (int)major(sbuf.st_rdev) == maj && (int)minor(sbuf.st_rdev) == min;
+    }
+    closedir(dir);
+    return found;
+}
