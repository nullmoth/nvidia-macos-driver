               munmap(addr, length)
 
 
+#elif defined(__APPLE__)
+/*
+ * macOS: a kext cannot implement mmap(2) on a device node, so the NullMoth DRM nodes map GPU memory through an
+ * ioctl, and xf86drm.c remembers which node each mapping came from so it can be released. Other nodes (drm-shim)
+ * fall back to mmap(2).
+ */
+#include <sys/types.h>
+extern void *drmNmxMmap(size_t length, int prot, int flags, int fd, off_t offset);
+extern int drmNmxMunmap(void *addr, size_t length);
+#  define drm_mmap(addr, length, prot, flags, fd, offset) \
+              drmNmxMmap((length), (prot), (flags), (fd), (offset))
+#  define drm_munmap(addr, length) \
+              drmNmxMunmap((addr), (length))
+
 #else
 
 /* assume large file support exists */
