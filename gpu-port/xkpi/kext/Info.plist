<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>com.nullmoth.NMXAMD</string>
  <key>CFBundleName</key><string>NMXAMD</string>
  <key>CFBundleExecutable</key><string>NMXAMD</string>
  <key>CFBundlePackageType</key><string>KEXT</string>
  <key>CFBundleVersion</key><string>1.0.0</string>
  <key>CFBundleShortVersionString</key><string>1.0.0</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>IOKitPersonalities</key><dict>
    <key>NMXAMDGPU</key><dict>
      <key>CFBundleIdentifier</key><string>com.nullmoth.NMXAMD</string>
      <key>IOClass</key><string>NMXAMDGPU</string>
      <key>IOProviderClass</key><string>IOPCIDevice</string>
      <!-- AMD display-class functions; probe() declines every one the user did not opt in (nmxamd=1 or the
           "nullmoth-amdgpu" device property), so the score only matters for devices the user handed to this driver -->
      <key>IOPCIPrimaryMatch</key><string>0x00001002&amp;0x0000ffff</string>
      <key>IOPCIClassMatch</key><string>0x03000000&amp;0xff000000</string>
      <key>IOProbeScore</key><integer>60000</integer>
    </dict>
  </dict>
  <key>OSBundleLibraries</key><dict>
    <key>com.apple.kpi.bsd</key><string>8.0</string>
    <key>com.apple.kpi.iokit</key><string>8.0</string>
    <key>com.apple.kpi.libkern</key><string>8.0</string>
    <key>com.apple.kpi.mach</key><string>8.0</string>
    <key>com.apple.kpi.unsupported</key><string>8.0</string>
    <key>com.apple.iokit.IOPCIFamily</key><string>1.0.0</string>
    <key>com.apple.iokit.IOACPIFamily</key><string>1.0.0</string>
  </dict>
</dict></plist>
