<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>com.nullmoth.NMXNPU</string>
  <key>CFBundleName</key><string>NMXNPU</string>
  <key>CFBundleExecutable</key><string>NMXNPU</string>
  <key>CFBundlePackageType</key><string>KEXT</string>
  <key>CFBundleVersion</key><string>1.0.0</string>
  <key>CFBundleShortVersionString</key><string>1.0.0</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>IOKitPersonalities</key><dict>
    <key>NMXNPUIntel</key><dict>
      <key>CFBundleIdentifier</key><string>com.nullmoth.NMXNPU</string>
      <key>IOClass</key><string>NMXNPU</string>
      <key>IOProviderClass</key><string>IOPCIDevice</string>
      <!-- Intel processing accelerators (class 0x12: the NPU); opt-in with nmxnpu=1 or nullmoth-npu, probe() declines otherwise -->
      <key>IOPCIPrimaryMatch</key><string>0x00008086&amp;0x0000ffff</string>
      <key>IOPCIClassMatch</key><string>0x12000000&amp;0xff000000</string>
      <key>IOProbeScore</key><integer>60000</integer>
    </dict>
    <key>NMXNPUAMD</key><dict>
      <key>CFBundleIdentifier</key><string>com.nullmoth.NMXNPU</string>
      <key>IOClass</key><string>NMXNPU</string>
      <key>IOProviderClass</key><string>IOPCIDevice</string>
      <!-- AMD NPUs (Ryzen AI, XDNA: signal-processing class 0x1180); opt-in with nmxnpu=1 or nullmoth-npu -->
      <key>IOPCIPrimaryMatch</key><string>0x00001022&amp;0x0000ffff</string>
      <key>IOPCIClassMatch</key><string>0x11800000&amp;0xffff0000</string>
      <key>IOProbeScore</key><integer>60000</integer>
    </dict>
  </dict>
  <key>OSBundleLibraries</key><dict>
    <key>com.apple.kpi.bsd</key><string>8.0</string>
    <key>com.apple.kpi.iokit</key><string>8.0</string>
    <key>com.apple.kpi.libkern</key><string>8.0</string>
    <key>com.apple.kpi.mach</key><string>8.0</string>
    <key>com.apple.kpi.unsupported</key><string>8.0</string>
    <key>com.apple.iokit.IOPCIFamily</key><string>1.0.0</string>
    <key>com.apple.iokit.IOACPIFamily</key><string>1.0.0</string>
  </dict>
</dict></plist>
