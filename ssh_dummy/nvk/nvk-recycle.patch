+ * SPDX-License-Identifier: MIT
+ */
+#ifndef NVKMD_NVRM_FENCE_H
+#define NVKMD_NVRM_FENCE_H
+
+/* A point in every channel's submission stream, for memory that is kept instead of freed (nvk_cmd_mem_recycle.h).
+ * It is the snapshot nvkmd_nvrm_defer takes for a free: for each of the device's channels with work in flight, the
+ * last sequence number flushed. It has passed once every one of those channels has completed that sequence (or was
+ * idled and unregistered, which the generation records). Kept in its own header so nvkmd.h, which every object
+ * includes, does not change. */
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define NVKMD_NVRM_FENCE_CTX 32   /* = NVRM_CTX_MAX, checked in nvkmd_nvrm_ctx.c */
+
+struct nvkmd_dev;
+struct nvkmd_nvrm_fence {
+   uint32_t gen[NVKMD_NVRM_FENCE_CTX];
+   uint64_t seq[NVKMD_NVRM_FENCE_CTX];   /* 0 = that channel owed nothing */
+};
+
+void nvkmd_nvrm_fence_snapshot(struct nvkmd_dev *dev, struct nvkmd_nvrm_fence *out);
+bool nvkmd_nvrm_fence_passed(const struct nvkmd_nvrm_fence *f);
+
+#endif
