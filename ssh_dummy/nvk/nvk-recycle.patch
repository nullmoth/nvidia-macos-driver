+#include "nvkmd_nvrm_fence.h"
+_Static_assert(NVKMD_NVRM_FENCE_CTX == NVRM_CTX_MAX, "the fence snapshot must cover every channel slot");
+
+/* The snapshot a deferred free would take now, without queueing anything: see nvkmd_nvrm_fence.h. With asynchronous
+ * submission off every flush has completed before it returns, so nothing is owed and the snapshot passes at once. */
+void
+nvkmd_nvrm_fence_snapshot(struct nvkmd_dev *dev, struct nvkmd_nvrm_fence *out)
+{
+   memset(out, 0, sizeof(*out));
+   if (!nvkmd_nvrm_async_on())
+      return;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   for (unsigned i = 0; i < NVRM_CTX_MAX; i++) {
+      const struct nvkmd_nvrm_slot *s = &nvkmd_nvrm_slots[i];
+      if (s->ctx != NULL && s->dev == dev && __atomic_load_n(s->sem, __ATOMIC_ACQUIRE) < s->flushed) {
+         out->gen[i] = s->gen;
+         out->seq[i] = s->flushed;
+      }
+   }
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+}
+
+bool
+nvkmd_nvrm_fence_passed(const struct nvkmd_nvrm_fence *f)
+{
+   bool owed = false;
+   for (unsigned i = 0; i < NVRM_CTX_MAX && !owed; i++)
+      owed = f->seq[i] != 0;
+   if (!owed)
+      return true;
+   bool done = true;
+   pthread_mutex_lock(&nvkmd_nvrm_gsub_mtx);
+   for (unsigned i = 0; i < NVRM_CTX_MAX && done; i++)
+      if (f->seq[i] != 0 && !nvkmd_nvrm_seq_done(i, f->gen[i], f->seq[i]))
+         done = false;
+   pthread_mutex_unlock(&nvkmd_nvrm_gsub_mtx);
+   return done;
+}
