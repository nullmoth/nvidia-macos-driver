<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>com.nullmoth.NMIntelFBVirtual</string>
  <key>CFBundleName</key><string>NMIntelFBVirtual</string>
  <key>CFBundleExecutable</key><string>NMIntelFBVirtual</string>
  <key>CFBundlePackageType</key><string>KEXT</string>
  <key>CFBundleVersion</key><string>0.1</string>
  <key>CFBundleShortVersionString</key><string>0.1</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>IOKitPersonalities</key><dict>
    <key>NMIntelFBVirtual</key><dict>
      <key>CFBundleIdentifier</key><string>com.nullmoth.NMIntelFBVirtual</string>
      <key>IOClass</key><string>NMIntelFBLoader</string>
      <!-- a loader only: it attaches the virtual panel under the NVIDIA PCI device when debug.nmintelfb_attach=1 is written
           after boot, so a hang there never needs hands (10-10) -->
      <key>IOProviderClass</key><string>IOResources</string>
      <key>IOResourceMatch</key><string>IOKit</string>
      <key>IOMatchCategory</key><string>NMIntelFBVirtual</string>
    </dict>
    <key>NMIntelFB</key><dict>
      <key>CFBundleIdentifier</key><string>com.nullmoth.NMIntelFBVirtual</string>
      <key>IOClass</key><string>NMIntelFB</string>
      <!-- the Intel-panel nub only; above NVRMFB (1000) so NVRMFB never starts on it -->
      <key>IOProviderClass</key><string>NVRMDisplay</string>
      <key>IOPropertyMatch</key><dict><key>nm-intel-panel</key><true/></dict>
      <key>IOProbeScore</key><integer>60000</integer>
    </dict>
  </dict>
  <key>OSBundleLibraries</key><dict>
    <key>com.apple.kpi.iokit</key><string>8.0</string>
    <key>com.apple.kpi.libkern</key><string>8.0</string>
    <key>com.apple.kpi.mach</key><string>8.0</string>
    <key>com.apple.iokit.IOPCIFamily</key><string>1.0.0</string>
    <key>com.apple.iokit.IOGraphicsFamily</key><string>1.0.0</string>
  </dict>
</dict></plist>
