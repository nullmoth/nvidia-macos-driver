+/* NullMoth opt-in diagnostic: no modesets and no replacement of client replies. */
+
+#define Y420_LOG(...) do { \
+    char text[512]; \
+    nvkms_snprintf(text, sizeof(text), __VA_ARGS__); \
+    nvkms_log(NVKMS_LOG_LEVEL_INFO, NULL, text); \
+} while (0)
+
+static const char *Yuv420DiagName(enum NvYuv420Mode mode)
+{
+    switch (mode) {
+    case NV_YUV420_MODE_NONE: return "NONE";
+    case NV_YUV420_MODE_SW: return "SW";
+    case NV_YUV420_MODE_HW: return "HW";
+    default: return "UNKNOWN";
+    }
+}
+
+static void Yuv420DiagEnumerate(struct NvKmsKapiDevice *device,
+                                NvKmsKapiDisplay display)
+{
+    struct NvKmsValidateModeIndexParams *p = nvKmsKapiCalloc(1, sizeof(*p));
+    char *info = nvKmsKapiCalloc(1, NVKMS_MODE_VALIDATION_MAX_INFO_STRING_LENGTH);
+    unsigned pass;
+    if (p == NULL || info == NULL) {
+        Y420_LOG("Y420-AB dpy=0x%x ABORT allocation failed", display);
+        goto out;
+    }
+    for (pass = 0; pass < 2; pass++) {
+        NvU32 index, matches = 0;
+        NvBool complete = NV_FALSE;
+        const char label = pass ? 'B' : 'A';
+        Y420_LOG("Y420-AB dpy=0x%x pass=%c BEGIN prefer420=%u", display, label, pass);
+        /* Bound boot-time diagnostic work; reaching the bound is not success. */
+        for (index = 0; index < 512; index++) {
+            const NvModeTimings *t;
+            nvkms_memset(p, 0, sizeof(*p));
+            nvkms_memset(info, 0, NVKMS_MODE_VALIDATION_MAX_INFO_STRING_LENGTH);
+            p->request.deviceHandle = device->hKmsDevice;
+            p->request.dispHandle = device->hKmsDisp;
+            p->request.dpyId = nvNvU32ToDpyId(display);
+            InitNvKmsModeValidationParams(device, &p->request.modeValidation);
+            p->request.modeValidation.preferYUV420 = pass ? NV_TRUE : NV_FALSE;
+            p->request.modeIndex = index;
+            p->request.pInfoString = nvKmsPointerToNvU64(info);
+            p->request.infoStringSize = NVKMS_MODE_VALIDATION_MAX_INFO_STRING_LENGTH;
+            if (!nvkms_ioctl_from_kapi(device->pKmsOpen,
+                    NVKMS_IOCTL_VALIDATE_MODE_INDEX, p, sizeof(*p))) {
+                Y420_LOG("Y420-AB dpy=0x%x pass=%c ABORT ioctl index=%u", display, label, index);
+                break;
+            }
+            if (p->reply.end) {
+                complete = NV_TRUE;
+                break;
+            }
+            t = &p->reply.mode.timings;
+            if (t->hVisible == 3840 && t->vVisible == 2160 &&
+                t->RRx1k >= 59000 && t->RRx1k <= 61000) {
+                struct NvKmsKapiDisplayMode wire;
+                struct NvKmsMode back;
+                NvU32 offset = 0;
+                matches++;
+                NvKmsModeToKapi(&p->reply.mode, &wire);
+                NvKmsKapiDisplayModeToKapi(&wire, &back);
+                Y420_LOG("Y420-AB dpy=0x%x pass=%c index=%u source=%u valid=%u "
+                         "pclkHz=%llu h=%u,%u,%u,%u v=%u,%u,%u,%u rrMilliHz=%u "
+                         "sync=%u,%u,%u,%u interlace=%u doublescan=%u",
+                         display, label, index, p->reply.source, p->reply.valid,
+                         (unsigned long long)t->pixelClockHz, t->hVisible, t->hSyncStart, t->hSyncEnd, t->hTotal,
+                         t->vVisible, t->vSyncStart, t->vSyncEnd, t->vTotal, t->RRx1k,
+                         t->hSyncPos, t->hSyncNeg, t->vSyncPos, t->vSyncNeg,
+                         t->interlaced, t->doubleScan);
+                Y420_LOG("Y420-AB dpy=0x%x pass=%c index=%u yuv420=%s roundtrip=%s lost=%u",
+                         display, label, index, Yuv420DiagName(t->yuv420Mode),
+                         Yuv420DiagName(back.timings.yuv420Mode),
+                         t->yuv420Mode != back.timings.yuv420Mode);
+                info[NVKMS_MODE_VALIDATION_MAX_INFO_STRING_LENGTH - 1] = '\0';
+                while (info[offset]) {
+                    NvU32 n = 0;
+                    while (n < 160 && info[offset + n] && info[offset + n] != '\n') n++;
+                    if (n) Y420_LOG("Y420-AB dpy=0x%x pass=%c index=%u info: %.*s",
+                                   display, label, index, (int)n, info + offset);
+                    offset += n;
+                    if (info[offset] == '\n') offset++;
+                }
+                if (p->reply.infoStringLenWritten >= NVKMS_MODE_VALIDATION_MAX_INFO_STRING_LENGTH)
+                    Y420_LOG("Y420-AB dpy=0x%x pass=%c index=%u INFO_MAY_BE_TRUNCATED", display, label, index);
+            }
+        }
+        Y420_LOG("Y420-AB dpy=0x%x pass=%c %s queried=%u matches=%u",
+                 display, label, complete ? "COMPLETE" : "INCOMPLETE",
+                 index < 512 ? index + 1 : index, matches);
+    }
+out:
+    nvKmsKapiFree(info);
+    nvKmsKapiFree(p);
+}
+
+#undef Y420_LOG
 
