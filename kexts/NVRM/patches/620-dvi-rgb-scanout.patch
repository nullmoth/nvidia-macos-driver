+/* DVI scanout is RGB at eight bits per component.  In particular, do not
+ * expose timings which NVKMS can accept only after changing them to YUV420:
+ * the KAPI mode has no YUV disposition and this client supplies RGB surfaces
+ * and requires its own primary completion notifier. */
+static NvBool KapiDviRgb8(
+    struct NvKmsKapiDevice *device, NvKmsKapiDisplay display,
+    struct NvKmsDpyOutputColorParams *color)
+{
+    struct NvKmsKapiStaticDisplayInfo dpy = { };
+    struct NvKmsKapiConnectorInfo connector = { };
+
+    if (!GetStaticDisplayInfo(device, display, &dpy) ||
+        !GetConnectorInfo(device, dpy.connectorHandle, &connector) ||
+        connector.signalFormat != NVKMS_CONNECTOR_SIGNAL_FORMAT_TMDS ||
+        (connector.type != NVKMS_CONNECTOR_TYPE_DVI_D &&
+         connector.type != NVKMS_CONNECTOR_TYPE_DVI_I)) {
+        return NV_FALSE;
+    }
+
+    color->format = NV_KMS_DPY_ATTRIBUTE_REQUESTED_COLOR_FORMAT_RGB;
+    color->formatSpecified = NV_TRUE;
+    color->bpc = NV_KMS_DPY_ATTRIBUTE_CURRENT_COLOR_BPC_8;
+    color->bpcSpecified = NV_TRUE;
+    return NV_TRUE;
+}
