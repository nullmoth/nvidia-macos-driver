+static NvBool Y420HwValidateMode
 (
     struct NvKmsKapiDevice *device,
     NvKmsKapiDisplay display, const struct NvKmsKapiDisplayMode *mode
 )
 {
+    struct NvKmsValidateModeParams *params = nvKmsKapiCalloc(1, sizeof(*params));
+    NvBool ok = NV_FALSE;
+
+    if (params == NULL) {
+        return NV_FALSE;
+    }
+
+    params->request.deviceHandle = device->hKmsDevice;
+    params->request.dispHandle   = device->hKmsDisp;
+    params->request.dpyId        = nvNvU32ToDpyId(display);
+    InitNvKmsModeValidationParams(device, &params->request.modeValidation);
+    params->request.modeValidation.preferYUV420 = NV_TRUE;
+    NvKmsKapiDisplayModeToKapi(mode, &params->request.mode);
+
+    if (nvkms_ioctl_from_kapi(device->pKmsOpen, NVKMS_IOCTL_VALIDATE_MODE,
+                              params, sizeof(*params)) &&
+        params->reply.valid &&
+        params->reply.yuv420Mode == NV_YUV420_MODE_HW) {
+        ok = NV_TRUE;
+    }
+
+    nvKmsKapiFree(params);
+    return ok;
+}
