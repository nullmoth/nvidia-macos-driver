+/*
+ * HDMI 4K60 that RGB 4:4:4 cannot carry (a DisplayPort-to-HDMI adapter or a TMDS link limited to HDMI 1.4 rates): NVKMS
+ * refuses the mode with its default preference, but validates the very same timing when asked to prefer YUV 4:2:0 and
+ * the GPU can do it in hardware. A mode refused as RGB is therefore listed, validated and set again with that
+ * preference, and only when the retry
+ *   - is valid, and
+ *   - was decided as HARDWARE 4:2:0 (software 4:2:0 would need the client to convert the surface, which none does), and
+ *   - describes the same timing as the one that was refused.
+ * Modes that RGB already accepts are never touched.
+ */
+static NvBool Y420SameTiming(const NvModeTimings *a, const NvModeTimings *b)
+{
+    return a->pixelClockHz == b->pixelClockHz &&
+           a->hVisible == b->hVisible && a->hSyncStart == b->hSyncStart && a->hSyncEnd == b->hSyncEnd &&
+           a->hTotal == b->hTotal && a->vVisible == b->vVisible && a->vSyncStart == b->vSyncStart &&
+           a->vSyncEnd == b->vSyncEnd && a->vTotal == b->vTotal &&
+           a->interlaced == b->interlaced && a->doubleScan == b->doubleScan;
+}
