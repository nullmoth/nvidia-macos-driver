+static NvBool GetFlipPendingStatus(
+    const struct NvKmsKapiDevice *device,
+    const NvU32 head, const NvU32 layer, NvBool *pending)
+{
+    if (pending != NULL) *pending = NV_TRUE;
+    if (device == NULL || pending == NULL ||
+        head >= NVKMS_KAPI_MAX_HEADS || head >= device->numHeads ||
+        layer >= NVKMS_KAPI_LAYER_MAX || layer >= device->numLayers[head] ||
+        !device->notifier.mapped || device->notifier.pLinearAddress == NULL) {
+        return NV_FALSE;
+    }
+    const NvU32 index = device->layerState[head][layer].currFlipNotifierIndex;
+    if (index >= NVKMS_KAPI_MAX_NOTIFERS_PER_LAYER) return NV_FALSE;
+    struct nvKmsParsedNotifier parsed = { };
+    nvKmsParseNotifier(NVKMS_KAPI_NOTIFIER_INDEX(head, layer, index),
+                      device->notifier.pLinearAddress, &parsed);
+    static NvU32 reports = 0;
+    if (reports++ < 16) nvKmsKapiLogDeviceDebug(device,
+        "Flip completion head %u layer %u slot %u status %u format %u",
+        head, layer, index, (NvU32)parsed.status, (NvU32)device->notifier.format);
+    switch (parsed.status) {
+        // EVO signals a latched display flip with BEGUN (IsPreviousFlipDone in nvkms-headsurface.c).
+        case NVKMS_NOTIFIER_STATUS_BEGUN:
+        case NVKMS_NOTIFIER_STATUS_FINISHED: *pending = NV_FALSE; return NV_TRUE;
+        case NVKMS_NOTIFIER_STATUS_NOT_BEGUN: return NV_TRUE;
+        default: return NV_FALSE;
+    }
+}
